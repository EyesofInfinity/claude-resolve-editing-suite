// Develop Texture: ready textures laid over or into the picture, in one transform DCTL, each
// built from the thing it looks like and moving slowly by TIMELINE_FRAME_INDEX (Speed 0 holds it):
//   0 Cells: living cells under a microscope, thin bright walls, a darker nucleus in each, granules in the cytoplasm;
//     the cells drift and jostle.
//   1 Flux: the streamlines of a slow turbulent flow (the lines of ink in moving water), bending as the flow changes.
//   2 Neurons: cultured neurons seen in fluorescence, round cell bodies joined by fine neurites that thin away from
//     them, a finer mesh of twigs, each cell glowing and fading on its own as calcium imaging shows them.
//   3 Ridges: eroded ridges seen from above, a ridged relief lit from the upper left, slowly weathering.
//   4 Folded: crumpled paper, flat facets meeting at sharp creases at two scales, lit from the upper left.
//   5 Plasma: the glow of a turbulent ionised gas with brighter filaments, violet to rose (Hue turns it).
//   6 Weave: plain-woven canvas, round threads passing over and under, fibres along each, the threads wandering a little.
// Blend: 0 Overlay (on display values, the texture centred on its own average so the picture keeps its level),
// 1 Multiply (on display values, the texture laid on the picture as a print: its light parts clear), 2 Screen (the texture's light parts added in
// linear, as a double exposure), 3 Displace (the picture seen through glass pressed with the texture's relief, sampled bilinear).
// Hue 0 keeps each texture's own colour (grey for most, fluorescent green for Neurons, violet for Plasma); above 0 it
// tints them. Amount mixes with the picture in display terms; Amount 0 is the input exactly. MIT License.

DEFINE_UI_PARAMS(txAmount,   Texture,   DCTLUI_SLIDER_FLOAT, 100.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(txKind,     Kind,      DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 6.0, 1.0)
DEFINE_UI_PARAMS(txBlend,    Blend,     DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 3.0, 1.0)
DEFINE_UI_PARAMS(txStrength, Strength,  DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(txSize,     Size,      DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(txDetail,   Detail,    DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(txSpeed,    Speed,     DCTLUI_SLIDER_FLOAT, 30.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(txColour,   Colour,    DCTLUI_SLIDER_FLOAT, 100.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(txHue,      Hue,       DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(txSeed,     Seed,      DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)

DEFINE_UI_TOOLTIP(Kind, "0 Cells, 1 Flux, 2 Neurons, 3 Ridges, 4 Folded, 5 Plasma, 6 Weave")
DEFINE_UI_TOOLTIP(Blend, "0 Overlay, 1 Multiply, 2 Screen, 3 Displace")
DEFINE_UI_TOOLTIP(Strength, "How strongly the texture works: contrast, depth, light added, or how far the glass bends")
DEFINE_UI_TOOLTIP(Speed, "How fast it moves; 0 holds it")
DEFINE_UI_TOOLTIP(Hue, "0 the texture's own colour; above 0 a tint round the colour wheel")

#include "../light/light.h"
#include "../glitch/glitch.h"

__DEVICE__ float3 specT(float t)
{
    float a = 6.2831853f * t;
    return make_float3(0.5f + 0.5f * _cosf(a), 0.5f + 0.5f * _cosf(a - 2.0943951f), 0.5f + 0.5f * _cosf(a - 4.1887902f));
}

__DEVICE__ float3 bilin(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, float fx, float fy, int w, int h)
{
    float x = _clampf(fx, 0.0f, (float)(w - 1)), y = _clampf(fy, 0.0f, (float)(h - 1));
    float x0f = _floorf(x), y0f = _floorf(y);
    int x0 = (int)(x0f), y0 = (int)(y0f);
    int x1 = x0 + 1 < w ? x0 + 1 : w - 1, y1 = y0 + 1 < h ? y0 + 1 : h - 1;
    float ax = x - x0f, ay = y - y0f;
    float3 a = rgbAt(tr, tg, tb, x0, y0, w, h), b = rgbAt(tr, tg, tb, x1, y0, w, h);
    float3 c = rgbAt(tr, tg, tb, x0, y1, w, h), d = rgbAt(tr, tg, tb, x1, y1, w, h);
    return make_float3(lerp1(lerp1(a.x, b.x, ax), lerp1(c.x, d.x, ax), ay), lerp1(lerp1(a.y, b.y, ax), lerp1(c.y, d.y, ax), ay),
                       lerp1(lerp1(a.z, b.z, ax), lerp1(c.z, d.z, ax), ay));
}

__DEVICE__ float gcorner(int ix, int iy, int iz, float dx, float dy, float dz, uint s)
{
    int h = (int)(hash01((uint)(ix + 65536), (uint)(iy + 65536), (uint)(iz + 65536) + s * 7919u) * 16.0f);
    float a = h < 8 ? dx : dy;
    float b = h < 4 ? dy : ((h == 12 || h == 14) ? dx : dz);
    return ((h & 1) == 0 ? a : -a) + ((h & 2) == 0 ? b : -b);
}

__DEVICE__ float gn3(float x, float y, float z, uint s)
{
    float fx = _floorf(x), fy = _floorf(y), fz = _floorf(z);
    int ix = (int)(fx), iy = (int)(fy), iz = (int)(fz);
    float dx = x - fx, dy = y - fy, dz = z - fz;
    float u = fade(dx), v = fade(dy), w = fade(dz);
    float a0 = lerp1(gcorner(ix, iy, iz, dx, dy, dz, s), gcorner(ix + 1, iy, iz, dx - 1.0f, dy, dz, s), u);
    float a1 = lerp1(gcorner(ix, iy + 1, iz, dx, dy - 1.0f, dz, s), gcorner(ix + 1, iy + 1, iz, dx - 1.0f, dy - 1.0f, dz, s), u);
    float b0 = lerp1(gcorner(ix, iy, iz + 1, dx, dy, dz - 1.0f, s), gcorner(ix + 1, iy, iz + 1, dx - 1.0f, dy, dz - 1.0f, s), u);
    float b1 = lerp1(gcorner(ix, iy + 1, iz + 1, dx, dy - 1.0f, dz - 1.0f, s), gcorner(ix + 1, iy + 1, iz + 1, dx - 1.0f, dy - 1.0f, dz - 1.0f, s), u);
    return lerp1(lerp1(a0, a1, v), lerp1(b0, b1, v), w);
}

__DEVICE__ float fbmg(float x, float y, float z, int n, float gain, uint s)
{
    float sum = 0.0f, amp = 1.0f, tot = 0.0f;
    for (int i = 0; i < 6; i++) {
        if (i >= n) break;
        sum += amp * gn3(x, y, z, s + (uint)(i) * 13u);
        tot += amp; amp *= gain;
        float nx = 1.6f * x - 1.2f * y + 17.3f, ny = 1.2f * x + 1.6f * y + 5.1f;
        x = nx; y = ny; z = z * 1.7f + 3.3f;
    }
    return sum / tot;
}

__DEVICE__ float ridged(float x, float y, float z, int n, float gain, uint s)
{
    float sum = 0.0f, amp = 0.5f, wt = 1.0f, tot = 0.0f, rnd = 0.03f;
    for (int i = 0; i < 6; i++) {
        if (i >= n) break;
        float g = gn3(x, y, z, s + (uint)(i) * 13u);
        float r = 1.0f - _sqrtf(g * g + rnd);
        rnd *= 2.2f;
        r = r * r * wt;
        wt = _saturatef(r * 1.8f);
        sum += r * amp; tot += amp; amp *= gain;
        float nx = 1.6f * x - 1.2f * y + 17.3f, ny = 1.2f * x + 1.6f * y + 5.1f;
        x = nx; y = ny; z = z * 1.7f + 3.3f;
    }
    return sum / tot;
}

__DEVICE__ float2 cellPt(int ix, int iy, float t, float lo, float wob, uint s)
{
    float sp = 1.0f - 2.0f * lo - 2.0f * wob;
    float ph = 6.2831853f * rnd3(ix, iy, s + 3u), rate = 0.6f + 0.8f * rnd3(ix, iy, s + 4u);
    float px = (float)(ix) + lo + wob + sp * rnd3(ix, iy, s + 1u) + wob * _sinf(t * rate + ph);
    float py = (float)(iy) + lo + wob + sp * rnd3(ix, iy, s + 2u) + wob * _cosf(t * rate * 0.8f + ph * 1.3f);
    return make_float2(px, py);
}

__DEVICE__ float4 worley(float gx, float gy, float t, float lo, float wob, uint s)
{
    float cx = _floorf(gx), cy = _floorf(gy);
    int ix = (int)(cx), iy = (int)(cy);
    float f1 = 9.0f, f2 = 9.0f, nx = 0.0f, ny = 0.0f;
    for (int j = -2; j <= 2; j++) {
        for (int i = -2; i <= 2; i++) {
            float2 p = cellPt(ix + i, iy + j, t, lo, wob, s);
            float d = _sqrtf((gx - p.x) * (gx - p.x) + (gy - p.y) * (gy - p.y));
            if (d < f1) { f2 = f1; f1 = d; nx = (float)(ix + i); ny = (float)(iy + j); }
            else if (d < f2) { f2 = d; }
        }
    }
    return make_float4(f1, f2, nx, ny);
}

__DEVICE__ float4 cellEdge(float gx, float gy, float t, float lo, float wob, uint s)
{
    float4 w = worley(gx, gy, t, lo, wob, s);
    int nx = (int)(w.z), ny = (int)(w.w);
    float2 p1 = cellPt(nx, ny, t, lo, wob, s);
    float e = 9.0f;
    for (int j = -2; j <= 2; j++) {
        for (int i = -2; i <= 2; i++) {
            if (i == 0 && j == 0) continue;
            float2 q = cellPt(nx + i, ny + j, t, lo, wob, s);
            float dx = q.x - p1.x, dy = q.y - p1.y, dl = _sqrtf(dx * dx + dy * dy);
            float mx = 0.5f * (p1.x + q.x), my = 0.5f * (p1.y + q.y);
            e = _fminf(e, ((mx - gx) * dx + (my - gy) * dy) / dl);
        }
    }
    return make_float4(_fmaxf(e, 0.0f), w.x, w.z, w.w);
}

__DEVICE__ float neuroLayer(float gx, float gy, float t, float wc, float prob, float soma, uint s)
{
    float cx = _floorf(gx), cy = _floorf(gy);
    int ix = (int)(cx), iy = (int)(cy);
    float sum = 0.0f;
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            int ax = ix + i, ay = iy + j;
            float2 pa = cellPt(ax, ay, t * 0.3f, 0.26f, 0.04f, s);
            float ga = 0.35f + 0.65f * (0.5f + 0.5f * _sinf(t * (0.5f + rnd3(ax, ay, s + 9u)) + 6.2831853f * rnd3(ax, ay, s + 10u)));
            float has = rnd3(ax, ay, s + 11u) < soma ? 1.0f : 0.0f;
            float da = _sqrtf((gx - pa.x) * (gx - pa.x) + (gy - pa.y) * (gy - pa.y));
            float rs = 0.045f + 0.03f * rnd3(ax, ay, s + 12u);
            sum += has * ga * (_expf(-(da / rs) * (da / rs)) * 1.3f + 0.25f * _expf(-(da / (rs * 2.0f)) * (da / (rs * 2.0f))));
            for (int k = 0; k < 4; k++) {
                int ox = k == 1 ? 0 : 1, oy = k == 0 ? 0 : (k == 3 ? -1 : 1);
                int bx = ax + ox, by = ay + oy;
                if (bx < ix - 1 || bx > ix + 1 || by < iy - 1 || by > iy + 1) continue;
                if (rnd3(ax * 4 + k, ay, s + 13u) > prob) continue;
                float2 pb = cellPt(bx, by, t * 0.3f, 0.26f, 0.04f, s);
                float ex = pb.x - pa.x, ey = pb.y - pa.y, len2 = ex * ex + ey * ey;
                float hh = _saturatef(((gx - pa.x) * ex + (gy - pa.y) * ey) / len2);
                float qx = gx - pa.x - hh * ex, qy = gy - pa.y - hh * ey;
                float ds = _sqrtf(qx * qx + qy * qy);
                float end = _fminf(hh, 1.0f - hh) * _sqrtf(len2);
                float w = wc * (1.0f + 1.4f * _expf(-end / 0.10f));
                float gb = 0.35f + 0.65f * (0.5f + 0.5f * _sinf(t * (0.5f + rnd3(bx, by, s + 9u)) + 6.2831853f * rnd3(bx, by, s + 10u)));
                sum += 0.55f * lerp1(ga, gb, hh) * (_expf(-(ds / w) * (ds / w)) + 0.15f * _expf(-(ds / (w * 3.0f)) * (ds / (w * 3.0f))));
            }
        }
    }
    return sum;
}

__DEVICE__ float4 texAt(int k, float u, float v, float t, float S, float pix, float det, uint sd)
{
    float val = 0.0f, aux = 0.0f, sx = 0.0f, sy = 0.0f;
    int oct = 3 + (int)(det * 3.0f + 0.5f);
    float gain = 0.40f + 0.22f * det;
    if (k == 0) {
        float cs = S * 0.6f;
        float wu = u / cs + 0.16f * fbmg(u / cs * 0.9f, v / cs * 0.9f, t * 0.05f, 2, 0.5f, sd + 1u);
        float wv = v / cs + 0.16f * fbmg(u / cs * 0.9f + 3.1f, v / cs * 0.9f + 7.7f, t * 0.05f, 2, 0.5f, sd + 2u);
        float4 w = cellEdge(wu, wv, t * 0.35f, 0.08f, 0.05f, sd);
        float e = w.x, ww = 0.8f * pix / cs;
        float wall = 1.0f - sstep(0.4f * ww, ww * 2.0f + 0.004f, e);
        float halo = 1.0f - sstep(0.0f, 0.09f, e);
        int cx = (int)(w.z), cy = (int)(w.w);
        float gran = fbmg(u / (cs * 0.07f), v / (cs * 0.07f), t * 0.3f, 2, 0.5f, sd + 5u);
        float inner = 0.40f + 0.10f * rnd3(cx, cy, sd + 6u) - 0.12f * w.y + 0.10f * gran * (0.5f + det);
        float nr = 0.10f + 0.05f * rnd3(cx, cy, sd + 7u);
        float nuc = 1.0f - sstep(nr, nr + 0.04f, w.y);
        inner = inner * (1.0f - 0.45f * nuc) * (1.0f - 0.25f * (1.0f - sstep(0.015f, 0.035f, w.y)));
        val = lerp1(inner + 0.12f * halo, 0.95f, wall);
        aux = rnd3(cx, cy, sd + 8u);
    } else if (k == 1) {
        float f = 1.0f / S;
        float qx = fbmg(u * f - t * 0.15f, v * f, t * 0.08f, 3, 0.5f, sd), qy = fbmg(u * f + 5.2f - t * 0.15f, v * f + 1.3f, t * 0.08f, 3, 0.5f, sd + 3u);
        float rx = u * f + 0.9f * qx, ry = v * f + 0.9f * qy;
        float phi = (ry + 0.25f * rx) * 0.55f + 0.55f * fbmg(rx * 0.6f - t * 0.1f, ry * 0.6f, t * 0.05f, 2 + (int)(det * 2.0f + 0.5f), 0.45f, sd + 7u);
        float nl = 4.0f + 6.0f * det;
        float band = 0.5f + 0.5f * _cosf(6.2831853f * phi * nl);
        float b2 = band * band, b4 = b2 * b2, b8 = b4 * b4, b16 = b8 * b8;
        float line = b16 * b16;
        val = 0.10f + 0.70f * line + 0.20f * b8;
        aux = phi;
    } else if (k == 2) {
        float cs = S * 0.7f;
        float gx = u / cs, gy = v / cs;
        float wx = gx + 0.40f * fbmg(gx * 1.3f, gy * 1.3f, t * 0.04f, 3, 0.5f, sd + 21u);
        float wy = gy + 0.40f * fbmg(gx * 1.3f + 7.1f, gy * 1.3f + 2.9f, t * 0.04f, 3, 0.5f, sd + 22u);
        float a = neuroLayer(wx, wy, t, 1.1f * pix / cs, 0.45f, 0.7f, sd);
        float b = neuroLayer(wx * 2.3f + 11.0f, wy * 2.3f + 4.0f, t * 1.3f, 0.9f * pix * 2.3f / cs, 0.30f + 0.4f * det, 0.0f, sd + 31u);
        val = 1.0f - _expf(-(a + 0.45f * b));
    } else if (k == 3) {
        float f = 1.2f / S;
        val = ridged(u * f, v * f, t * 0.03f, oct, gain, sd);
    } else if (k == 4) {
        int nf = 20 + (int)(det * 20.0f + 0.5f);
        float ksz = 1.0f / (S * 1.2f);
        float cu = u * ksz, cv = v * ksz, wr = 1.5f * pix * ksz;
        cu += 0.06f * fbmg(cu * 0.8f, cv * 0.8f, 2.5f, 2, 0.5f, sd + 53u);
        cv += 0.06f * fbmg(cu * 0.8f + 6.1f, cv * 0.8f, 2.5f, 2, 0.5f, sd + 54u);
        float press = 0.45f + 1.1f * _saturatef(0.5f + 1.2f * fbmg(cu * 1.5f, cv * 1.5f, 3.5f, 2, 0.5f, sd + 55u));
        float crease = 0.0f;
        for (int i = 0; i < 40; i++) {
            if (i >= nf) break;
            float an = 3.1415927f * rnd3(i, 1, sd + 41u);
            float nx = _cosf(an), ny = _sinf(an);
            float mid = (0.889f * nx + 0.5f * ny) * ksz;
            float off = mid + (rnd3(i, 2, sd + 42u) - 0.5f) * 2.0f * ksz + 0.04f * _sinf(t * 0.3f + 6.2831853f * rnd3(i, 3, sd + 43u));
            float d = cu * nx + cv * ny - off;
            float sn = rnd3(i, 4, sd + 44u) < 0.5f ? -1.0f : 1.0f;
            float sg = sn * (0.015f + 0.035f * rnd3(i, 5, sd + 45u));
            float th = _tanhf(d / wr), th0 = mid > off ? 1.0f : -1.0f;
            sx += sg * (th - th0) * nx; sy += sg * (th - th0) * ny;
            float side = d / wr;
            float lit = -(nx * -0.7071f + ny * -0.7071f);
            crease += sn * (0.5f + 0.5f * rnd3(i, 6, sd + 46u)) * _expf(-side * side * 0.6f) * (0.35f * lit * _tanhf(side * 1.5f) + 0.12f);
        }
        sx += 0.05f * fbmg(cu * 2.0f, cv * 2.0f, 1.5f, 3, 0.5f, sd + 49u) + 0.02f * fbmg(u / pix * 0.2f, v / pix * 0.2f, 0.5f, 1, 0.5f, sd + 51u);
        sy += 0.05f * fbmg(cu * 2.0f + 4.4f, cv * 2.0f, 1.5f, 3, 0.5f, sd + 50u) + 0.02f * fbmg(u / pix * 0.2f + 9.0f, v / pix * 0.2f, 0.5f, 1, 0.5f, sd + 52u);
        val = 0.5f + crease * press;
        aux = 0.0f;
    } else if (k == 5) {
        float f = 0.8f / S;
        float qx = fbmg(u * f, v * f, t * 0.12f, 3, 0.5f, sd), qy = fbmg(u * f + 5.2f, v * f + 1.3f, t * 0.12f, 3, 0.5f, sd + 3u);
        float rx = u * f + 1.3f * qx, ry = v * f + 1.3f * qy;
        float phi = fbmg(rx, ry, t * 0.09f, oct, gain, sd + 7u);
        float glow = sstep(-0.25f, 0.55f, phi);
        float fil = 1.0f - _fabs(gn3(rx * 2.5f, ry * 2.5f, t * 0.2f, sd + 9u));
        fil = fil * fil; fil = fil * fil; fil = fil * fil;
        val = _saturatef(glow * glow * 0.85f + 0.5f * fil * glow);
        aux = 0.5f + 0.5f * fbmg(rx * 0.5f + 9.0f, ry * 0.5f, t * 0.05f, 2, 0.5f, sd + 11u);
    } else {
        float pitch = (7.0f + 18.0f * S / 0.4f) / 1080.0f;
        float a = u / pitch + 0.6f * fbmg(v * 3.0f, u * 0.5f, 0.0f, 2, 0.5f, sd + 61u) + t * 0.6f;
        float b = v / pitch + 0.6f * fbmg(u * 3.0f, v * 0.5f, 0.0f, 2, 0.5f, sd + 62u) + t * 0.4f;
        float fa0 = _floorf(a), fb0 = _floorf(b);
        int ia = (int)(fa0), ib = (int)(fb0);
        float fa = a - fa0, fb = b - fb0;
        float twa = 0.70f + 0.14f * rnd3(ia, 7, sd + 63u) + 0.12f * fbmg((float)(ia) * 0.37f, b * 0.35f, 0.0f, 2, 0.5f, sd + 67u);
        float twb = 0.70f + 0.14f * rnd3(ib, 9, sd + 64u) + 0.12f * fbmg(a * 0.35f, (float)(ib) * 0.37f, 0.0f, 2, 0.5f, sd + 68u);
        float ca = (fa - 0.5f) / (0.5f * twa), cb = (fb - 0.5f) / (0.5f * twb);
        float cyla = _sqrtf(_saturatef(1.0f - ca * ca)), cylb = _sqrtf(_saturatef(1.0f - cb * cb));
        float fibA = fbmg(a * 6.0f, b * 0.6f, 0.0f, 2, 0.5f, sd + 65u), fibB = fbmg(a * 0.6f, b * 6.0f, 0.0f, 2, 0.5f, sd + 66u);
        float diveA = 0.45f + 0.55f * _sqrtf(_sqrtf(_sinf(3.1415927f * fb))), diveB = 0.45f + 0.55f * _sqrtf(_sqrtf(_sinf(3.1415927f * fa)));
        float shA = 0.82f + 0.30f * rnd3(ia, 11, sd + 69u), shB = 0.82f + 0.30f * rnd3(ib, 13, sd + 70u);
        float topA = 0.28f + 0.60f * cyla * diveA * shA + 0.20f * fibA * (0.5f + det);
        float topB = 0.28f + 0.60f * cylb * diveB * shB + 0.20f * fibB * (0.5f + det);
        float wA = sstep(0.0f, 0.6f, cyla), wB = sstep(0.0f, 0.6f, cylb);
        int even = ((ia + ib) & 1) == 0 ? 1 : 0;
        float hole = 0.18f;
        val = even == 1 ? lerp1(lerp1(hole, 0.55f * topB, wB), topA, wA) : lerp1(lerp1(hole, 0.55f * topA, wA), topB, wB);
        aux = 0.0f;
    }
    return make_float4(_saturatef(val), aux, sx, sy);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    int W = p_Width, H = p_Height, x = p_X, y = p_Y;
    float3 c0 = rgbAt(p_TexR, p_TexG, p_TexB, x, y, W, H);
    if (txAmount <= 0.0f) return c0;
    int k = (int)(txKind + 0.5f), bl = (int)(txBlend + 0.5f);
    float sc = (float)(H) / 1080.0f, pix = 1.0f / (float)(H);
    float u = ((float)(x) + 0.5f) * pix, v = ((float)(y) + 0.5f) * pix;
    float t = (float)(TIMELINE_FRAME_INDEX) / 24.0f * txSpeed / 100.0f;
    float S = 0.05f + 0.35f * _powf(txSize / 100.0f, 1.5f);
    float det = txDetail / 100.0f, st = txStrength / 100.0f;
    uint sd = (uint)(txSeed) * 131u + 7u;
    float pw = 1.0f / 1080.0f;
    float4 tv = texAt(k, u, v, t, S, pw, det, sd);
    float val = tv.x;
    float gx = tv.z, gy = tv.w;
    if (k == 3 || (bl == 3 && k != 4)) {
        float e = 1.5f * pix;
        float vx = texAt(k, u + e, v, t, S, pw, det, sd).x, vy = texAt(k, u, v + e, t, S, pw, det, sd).x;
        gx = (vx - val) / e * S * 0.25f; gy = (vy - val) / e * S * 0.25f;
    }
    if (k == 3 || k == 4) {
        float nz = 1.0f / _sqrtf(1.0f + gx * gx + gy * gy);
        float lx = -0.54f, ly = -0.54f, lz = 0.643f;
        float sh = (-gx * lx - gy * ly + lz) * nz / lz;
        val = k == 3 ? _saturatef(0.25f + 0.45f * val + 0.40f * (sh - 0.85f)) : _saturatef(val + 0.55f * (sh - 0.88f));
    }
    float hue = txHue / 100.0f, col = txColour / 100.0f;
    float3 own = make_float3(1.0f, 1.0f, 1.0f);
    if (k == 2) own = make_float3(0.45f, 1.0f, 0.55f);
    if (k == 5) own = make_float3(lerp1(0.62f, 1.0f, tv.y), lerp1(0.32f, 0.38f, tv.y), lerp1(1.0f, 0.78f, tv.y));
    float3 tint = hue <= 0.0f ? own : specT(hue + (k == 5 ? 0.15f * tv.y : 0.0f));
    float tl = luma(tint.x, tint.y, tint.z);
    float3 tc = make_float3(lerp1(1.0f, tint.x / tl, col), lerp1(1.0f, tint.y / tl, col), lerp1(1.0f, tint.z / tl, col));
    float mean = k == 0 ? 0.41f : (k == 1 ? 0.10f : (k == 2 ? 0.01f : (k == 3 ? 0.48f : (k == 4 ? 0.59f : (k == 5 ? 0.07f : 0.665f)))));
    float3 o = c0;
    if (bl == 0) {
        float s2 = st * 1.6f;
        float br = _saturatef(0.5f + s2 * (val * tc.x - mean)), bg = _saturatef(0.5f + s2 * (val * tc.y - mean)), bb = _saturatef(0.5f + s2 * (val * tc.z - mean));
        float ar = _saturatef(c0.x), ag = _saturatef(c0.y), ab = _saturatef(c0.z);
        o = make_float3(ar < 0.5f ? 2.0f * ar * br : 1.0f - 2.0f * (1.0f - ar) * (1.0f - br),
                        ag < 0.5f ? 2.0f * ag * bg : 1.0f - 2.0f * (1.0f - ag) * (1.0f - bg),
                        ab < 0.5f ? 2.0f * ab * bb : 1.0f - 2.0f * (1.0f - ab) * (1.0f - bb));
    } else if (bl == 1) {
        float pk = _fmaxf(tc.x, _fmaxf(tc.y, tc.z)), hi = _fminf(mean * 1.7f, 0.95f);
        float fr = _saturatef(val * tc.x / pk / hi), fg = _saturatef(val * tc.y / pk / hi), fb = _saturatef(val * tc.z / pk / hi);
        o = make_float3(c0.x * lerp1(1.0f, fr, st), c0.y * lerp1(1.0f, fg, st), c0.z * lerp1(1.0f, fb, st));
    } else if (bl == 2) {
        float a = 1.5f * st * toLin(sstep(mean, 1.0f, val));
        float ar = a * tc.x, ag = a * tc.y, ab = a * tc.z;
        o = lightOut(toLin(c0.x) + ar, toLin(c0.y) + ag, toLin(c0.z) + ab, _fmaxf(ar, _fmaxf(ag, ab)));
    } else {
        float ks = k == 6 ? 0.07f : 1.0f;
        float dxs = gx * ks, dys = gy * ks, gm = _sqrtf(dxs * dxs + dys * dys);
        float amt = st * 160.0f * sc / (1.0f + 2.0f * gm);
        o = bilin(p_TexR, p_TexG, p_TexB, (float)(x) - amt * dxs, (float)(y) - amt * dys, W, H);
    }
    float am = txAmount / 100.0f;
    return make_float3(_saturatef(lerp1(c0.x, o.x, am)), _saturatef(lerp1(c0.y, o.y, am)), _saturatef(lerp1(c0.z, o.z, am)));
}
