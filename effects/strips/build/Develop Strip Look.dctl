// Develop Strip Look: borders, a colour choke, sliced strips, an endless zoom and fluted glass, in one transform
// DCTL. Each built from the real thing:
//   0 Borders: a mat laid over the picture's edge: Size its width, Tone its paper (white to black), a bevel cut lit
//     from the upper left (Level), Roughness turns the cut edge into torn deckle paper, Softness feathers it, and the mat
//     casts a soft shadow onto the picture (Light)
//   1 Colour Choke: the printer's spread and choke. Every colour region grows into its neighbours (Spread above 0, the
//     light colours spread) or shrinks back (below 0, the dark spread), over a round reach of Size; 0 is an even
//     softening over the same reach. Level lets each channel choke on its own, so the colours part at the edges
//   2 Strip Slide: the picture cut into strips along Angle (Size their width), each slid along its length (Level how
//     far), smoothly one to the next or at random (Roughness); Speed keeps them sliding, blurred by their speed
//     (Softness); Light shades the cuts
//   3 Infinite Zoom: the frame holds a copy of itself (Size: how much smaller), that copy holds another, without end, and
//     the camera falls into it forever (Speed, Phase), every loop the same as the last. Level draws a thin frame of Tone
//     round each copy and Light its shadow
//   4 Fluted Glass: the picture seen through reeded glass: each strip (Size wide, along Angle) a convex cylinder lens
//     that bends the picture behind it, turned over and repeated (Level how strongly), a highlight on each ridge and a
//     dark line where two flutes meet (Light), the glass a little soft (Softness)
// An OpenFX DCTL effect or a DCTL plugin node. Rec.709 gamma 2.4 in and out; light and blurs in linear. Look mixes the
// result with the picture; Look 0 is the input exactly. MIT License.

DEFINE_UI_PARAMS(slAmount, Look,        DCTLUI_SLIDER_FLOAT, 100.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(slMode,   Mode,        DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 4.0, 1.0)
DEFINE_UI_PARAMS(slSize,   Size,        DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(slLevel,  Level,       DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(slSoft,   Softness,    DCTLUI_SLIDER_FLOAT, 30.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(slAngle,  Angle,       DCTLUI_SLIDER_FLOAT, 90.0, 0.0, 180.0, 1.0)
DEFINE_UI_PARAMS(slRough,  Roughness,   DCTLUI_SLIDER_FLOAT, 30.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(slLight,  Light,       DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(slTone,   Tone,        DCTLUI_SLIDER_FLOAT, 92.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(slSpread, Spread,      DCTLUI_SLIDER_FLOAT, 40.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(slSpeed,  Speed,       DCTLUI_SLIDER_FLOAT, 30.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(slPhase,  Phase,       DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(slSeed,   Seed,        DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)

DEFINE_UI_TOOLTIP(Mode, "0 Borders, 1 Colour Choke, 2 Strip Slide, 3 Infinite Zoom, 4 Fluted Glass")
DEFINE_UI_TOOLTIP(Size, "The border's width, the choke's reach, the strips' width, how much smaller each copy is, the flutes' width")
DEFINE_UI_TOOLTIP(Level, "The bevel, each channel on its own, how far the strips slide, the copy's frame, the glass's bend")
DEFINE_UI_TOOLTIP(Angle, "Strip Slide and Fluted Glass: the way the strips run (90 upright)")
DEFINE_UI_TOOLTIP(Tone, "Borders and Infinite Zoom: the paper, 0 black to 100 white")
DEFINE_UI_TOOLTIP(Spread, "Colour Choke: above 0 the light colours spread, below 0 they choke back")
DEFINE_UI_TOOLTIP(Speed, "Strip Slide: how fast the strips slide; Infinite Zoom: how fast the camera falls in (below 0 it pulls out)")
DEFINE_UI_TOOLTIP(Phase, "Infinite Zoom: where in its loop the zoom is, for keyframing by hand")

// Develop lens: shared code of Develop Bokeh and Develop Lens, on top of light.h and glitch.h. Bilinear sampling
// with mirrored edges, linear light (Rec.709 gamma 2.4). MIT License.

// Develop light: the shared code of Develop Leak, Develop Burn and Develop Light Dissolve.
// build.py writes it into each effect, so every installed .dctl stands alone. Rec.709 gamma 2.4 in and out;
// light is added in linear. Coordinates are in frame heights (y 0 to 1 top to bottom, x 0 to width/height),
// so a leak keeps its shape at any resolution and aspect. MIT License.

__DEVICE__ float toLin(float x) { return _powf(_fmaxf(x, 0.0f), 2.4f); }
__DEVICE__ float toDisp(float x) { return _powf(_fmaxf(x, 0.0f), 1.0f / 2.4f); }
__DEVICE__ float luma(float r, float g, float b) { return 0.2126f * r + 0.7152f * g + 0.0722f * b; }
__DEVICE__ float lerp1(float a, float b, float t) { return a + (b - a) * t; }
__DEVICE__ float sstep(float a, float b, float x) { float t = _saturatef((x - a) / (b - a)); return t * t * (3.0f - 2.0f * t); }

__DEVICE__ float3 shoulder(float r, float g, float b)
{
    float m = _fmaxf(r, _fmaxf(g, b));
    if (m <= 0.8f) return make_float3(r, g, b);
    float nm = 0.8f + 0.2f * _tanhf((m - 0.8f) / 0.2f);
    float k = nm / m, w = 0.6f * sstep(1.0f, 3.0f, m);
    return make_float3(lerp1(r * k, nm, w), lerp1(g * k, nm, w), lerp1(b * k, nm, w));
}

__DEVICE__ float3 lightOut(float r, float g, float b, float k)
{
    float3 s = shoulder(r, g, b);
    float w = _saturatef(k * 4.0f);
    return make_float3(_saturatef(toDisp(lerp1(r, s.x, w))), _saturatef(toDisp(lerp1(g, s.y, w))), _saturatef(toDisp(lerp1(b, s.z, w))));
}

__DEVICE__ float hash01(uint x, uint y, uint z)
{
    x = x * 1664525u + 1013904223u; y = y * 1664525u + 1013904223u; z = z * 1664525u + 1013904223u;
    x += y * z; y += z * x; z += x * y;
    x ^= x >> 16u; y ^= y >> 16u; z ^= z >> 16u;
    x += y * z; y += z * x; z += x * y;
    return (float)(x >> 8u) * (1.0f / 16777216.0f);
}

__DEVICE__ float fade(float t) { return t * t * t * (t * (t * 6.0f - 15.0f) + 10.0f); }

__DEVICE__ float vnoise3(float x, float y, float z, uint s)
{
    int ix = (int)(x), iy = (int)(y), iz = (int)(z);
    float tx = fade(x - (float)(ix)), ty = fade(y - (float)(iy)), tz = fade(z - (float)(iz));
    uint x0 = (uint)(ix), y0 = (uint)(iy), z0 = (uint)(iz) + s * 7919u;
    float a0 = lerp1(lerp1(hash01(x0, y0, z0), hash01(x0 + 1u, y0, z0), tx), lerp1(hash01(x0, y0 + 1u, z0), hash01(x0 + 1u, y0 + 1u, z0), tx), ty);
    float a1 = lerp1(lerp1(hash01(x0, y0, z0 + 1u), hash01(x0 + 1u, y0, z0 + 1u), tx), lerp1(hash01(x0, y0 + 1u, z0 + 1u), hash01(x0 + 1u, y0 + 1u, z0 + 1u), tx), ty);
    return lerp1(a0, a1, tz);
}

__DEVICE__ float fbm(float x, float y, float z, int n, uint s)
{
    float sum = 0.0f, amp = 0.5f, tot = 0.0f, f = 1.0f;
    for (int i = 0; i < 5; i++) {
        if (i >= n) break;
        sum += amp * vnoise3(x * f + 4096.0f + 37.1f * (float)(i), y * f + 4096.0f + 11.7f * (float)(i), z * f + 4096.0f, s + (uint)(i));
        tot += amp; amp *= 0.5f; f *= 2.03f;
    }
    float v = sum / tot;
    return _saturatef((v - 0.5f) * 1.6f + 0.5f);
}

__DEVICE__ float3 ramp(float pal, float t, float age)
{
    int p = (int)(pal + 0.5f);
    float c0r = 0.30f, c0g = 0.10f, c0b = 0.42f, c1r = 0.62f, c1g = 0.35f, c1b = 0.47f, c2r = 0.86f, c2g = 0.76f, c2b = 0.68f;
    float h0r = 0.73f, h0g = 0.16f, h0b = 0.26f, h1r = 0.89f, h1g = 0.35f, h1b = 0.17f, h2r = 0.94f, h2g = 0.50f, h2b = 0.22f;
    if (p == 1) {
        c0r = 0.45f; c0g = 0.08f; c0b = 0.05f; c1r = 0.85f; c1g = 0.30f; c1b = 0.08f; c2r = 0.98f; c2g = 0.70f; c2b = 0.35f;
        h0r = 0.80f; h0g = 0.20f; h0b = 0.04f; h1r = 0.98f; h1g = 0.55f; h1b = 0.12f; h2r = 1.00f; h2g = 0.85f; h2b = 0.55f;
    }
    if (p == 2) {
        c0r = 0.18f; c0g = 0.10f; c0b = 0.45f; c1r = 0.65f; c1g = 0.25f; c1b = 0.65f; c2r = 0.95f; c2g = 0.70f; c2b = 0.75f;
        h0r = 0.70f; h0g = 0.15f; h0b = 0.50f; h1r = 0.95f; h1g = 0.45f; h1b = 0.45f; h2r = 1.00f; h2g = 0.75f; h2b = 0.55f;
    }
    if (p == 3) {
        c0r = 0.05f; c0g = 0.10f; c0b = 0.35f; c1r = 0.15f; c1g = 0.40f; c1b = 0.75f; c2r = 0.70f; c2g = 0.85f; c2b = 0.98f;
        h0r = 0.10f; h0g = 0.25f; h0b = 0.60f; h1r = 0.35f; h1g = 0.65f; h1b = 0.95f; h2r = 0.85f; h2g = 0.95f; h2b = 1.00f;
    }
    float a = _saturatef(age);
    float r0 = lerp1(c0r, h0r, a), g0 = lerp1(c0g, h0g, a), b0 = lerp1(c0b, h0b, a);
    float r1 = lerp1(c1r, h1r, a), g1 = lerp1(c1g, h1g, a), b1 = lerp1(c1b, h1b, a);
    float r2 = lerp1(c2r, h2r, a), g2 = lerp1(c2g, h2g, a), b2 = lerp1(c2b, h2b, a);
    float u = _saturatef(t);
    float r, g, b;
    if (u < 0.5f) { float k = u * 2.0f; r = lerp1(r0, r1, k); g = lerp1(g0, g1, k); b = lerp1(b0, b1, k); }
    else { float k = u * 2.0f - 1.0f; r = lerp1(r1, r2, k); g = lerp1(g1, g2, k); b = lerp1(b1, b2, k); }
    float hot = sstep(1.0f, 1.4f, t);
    return make_float3(toLin(lerp1(r, 1.0f, hot)), toLin(lerp1(g, 0.96f, hot)), toLin(lerp1(b, 0.90f, hot)));
}

__DEVICE__ float leakField(float x, float y, float aspect, float deg, float w, float sc, float z, uint s)
{
    float a = deg * 0.0174533f, ca = _cosf(a), sa = _sinf(a);
    float ext = 0.5f * (_fabs(ca) * aspect + _fabs(sa));
    float sproj = (x - 0.5f * aspect) * ca + (y - 0.5f) * sa;
    float warp = fbm(x * 1.3f, y * 1.3f, z * 0.35f, 2, s + 40u) - 0.5f;
    float d = _fmaxf(ext - sproj + 0.45f * warp * w * aspect, 0.0f);
    float reach = _fmaxf(w * aspect, 0.02f);
    float e = _expf(-(d / reach) * (d / reach));
    float cloud = fbm(x / sc, y / sc, z, 3, s);
    return _saturatef(e * (0.35f + 1.3f * cloud));
}

__DEVICE__ float burnHeat(float x, float y, float cover, float sc, float z, uint s)
{
    float wx = fbm(x / sc * 0.7f, y / sc * 0.7f, z * 0.6f, 2, s + 90u) - 0.5f;
    float wy = fbm(x / sc * 0.7f + 31.0f, y / sc * 0.7f, z * 0.6f, 2, s + 91u) - 0.5f;
    float h = fbm((x + 0.6f * wx) / sc, (y + 0.6f * wy) / sc, z, 4, s);
    float th = 1.0f - cover;
    return _saturatef((h - th + 0.28f) / 0.62f);
}

__DEVICE__ float dust(int px, int py, int h, float amount, uint z)
{
    float sc = (float)(h) / 1080.0f;
    int cx = (int)((float)(px) / (2.5f * sc)), cy = (int)((float)(py) / (2.5f * sc));
    float r = hash01((uint)(cx), (uint)(cy), z * 13u + 5u);
    float lim = 0.00002f * amount;
    if (r > lim) return 0.0f;
    return hash01((uint)(cx), (uint)(cy), z * 13u + 6u) < 0.6f ? -1.0f : 1.0f;
}

__DEVICE__ float4 burnOver(float r, float g, float b, float x, float y, float aspect, int px, int py, int ph,
                           float cover, float pal, float age, float sc, float show, float grain, float dst,
                           float z, uint fz, uint s)
{
    float k = sstep(0.0f, 0.35f, burnHeat(x, y, cover, sc, z, s));
    uint zi = (uint)(z + 1000.0f);
    float ang = 6.2831853f * ((float)(zi % 1000u) * 0.37f + 0.25f * hash01(zi, s, 71u));
    float ca = _cosf(ang), sa = _sinf(ang), ext = 0.5f * (_fabs(ca) * aspect + _fabs(sa));
    float band = 0.5f + 0.5f * ((x - 0.5f * aspect) * ca + (y - 0.5f) * sa) / ext;
    float cl = fbm(x / (sc * 1.6f), y / (sc * 1.6f), z, 3, s + 200u);
    float t = 0.05f + 0.95f * _saturatef(0.8f * band + 0.95f * (cl - 0.5f) + 0.15f);
    float3 c = ramp(pal, t, age);
    float keep = lerp1(1.0f, show, k);
    float gr = 1.0f + grain * 0.22f * (hash01((uint)(px), (uint)(py), fz * 3u + s) - 0.5f) * k;
    float d = dust(px, py, ph, dst * 100.0f, fz + s) * k;
    float rr = (r * keep + c.x * k) * gr, gg = (g * keep + c.y * k) * gr, bb = (b * keep + c.z * k) * gr;
    if (d < 0.0f) { rr *= 0.15f; gg *= 0.12f; bb *= 0.12f; }
    if (d > 0.0f) { rr = rr + 0.6f; gg = gg + 0.55f; bb = bb + 0.45f; }
    return make_float4(rr, gg, bb, k);
}
// Develop glitch: shared code of the glitch effects, on top of light.h's hash and helpers. MIT License.

__DEVICE__ int clampi(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }

__DEVICE__ float3 rgbAt(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, int x, int y, int w, int h)
{
    int cx = clampi(x, 0, w - 1), cy = clampi(y, 0, h - 1);
    return make_float3(_tex2D(tr, cx, cy), _tex2D(tg, cx, cy), _tex2D(tb, cx, cy));
}

__DEVICE__ float lumaAt(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, int x, int y, int w, int h)
{
    float3 c = rgbAt(tr, tg, tb, x, y, w, h);
    return luma(c.x, c.y, c.z);
}

__DEVICE__ float rnd3(int a, int b, uint c) { return hash01((uint)(a + 65536), (uint)(b + 65536), c); }

__DEVICE__ float bayer8(int cx, int cy)
{
    int bx = cx & 7, by = cy & 7, xr = bx ^ by;
    int v = ((xr & 1) << 5) | ((by & 1) << 4) | ((xr & 2) << 2) | ((by & 2) << 1) | ((xr & 4) >> 1) | ((by & 4) >> 2);
    return ((float)(v) + 0.5f) / 64.0f;
}

__DEVICE__ float3 gritFinish(float3 c, int x, int y, int h, float g, float grit, float dith, uint seed)
{
    if (g <= 0.0f) return c;
    float L = luma(c.x, c.y, c.z);
    float n = hash01((uint)(x + 65536), (uint)(y + 65536), seed) - 0.5f;
    float gr = grit * g * 0.16f * (0.35f + 0.65f * L) * n;
    float r = c.x + gr, gg = c.y + gr, b = c.z + gr;
    float d = dith * g;
    if (d > 0.0f) {
        int cell = (int)(2.0f * (float)(h) / 1080.0f + 0.5f);
        if (cell < 1) cell = 1;
        float t = bayer8((int)(x / cell), (int)(y / cell));
        float lv = 32.0f * (1.0f - d) + 3.0f * d - 1.0f;
        r = _floorf(_saturatef(r) * lv + t) / lv; gg = _floorf(_saturatef(gg) * lv + t) / lv; b = _floorf(_saturatef(b) * lv + t) / lv;
    }
    return make_float3(_saturatef(r), _saturatef(gg), _saturatef(b));
}

__DEVICE__ float3 chromaBleed(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, float3 c, int x, int y, int w, int h, int k)
{
    if (k < 1) return c;
    float3 a = rgbAt(tr, tg, tb, x - k, y, w, h), b = rgbAt(tr, tg, tb, x - (int)(k / 2), y, w, h);
    float3 m = make_float3((a.x + b.x + c.x) / 3.0f, (a.y + b.y + c.y) / 3.0f, (a.z + b.z + c.z) / 3.0f);
    float L = luma(c.x, c.y, c.z), Lm = luma(m.x, m.y, m.z);
    return make_float3(m.x - Lm + L, m.y - Lm + L, m.z - Lm + L);
}

__DEVICE__ int mirL(int i, int n)
{
    int q = 2 * n, m = i % q;
    if (m < 0) m += q;
    if (m >= n) m = q - 1 - m;
    return clampi(m, 0, n - 1);
}

__DEVICE__ float3 bilL(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, float fx, float fy, int w, int h)
{
    float bx = _floorf(fx), by = _floorf(fy);
    float ax = fx - bx, ay = fy - by;
    int x0 = (int)(bx), y0 = (int)(by);
    int xa = mirL(x0, w), xb = mirL(x0 + 1, w), ya = mirL(y0, h), yb = mirL(y0 + 1, h);
    float3 c00 = make_float3(_tex2D(tr, xa, ya), _tex2D(tg, xa, ya), _tex2D(tb, xa, ya));
    if (ax == 0.0f && ay == 0.0f) return c00;
    float3 c10 = make_float3(_tex2D(tr, xb, ya), _tex2D(tg, xb, ya), _tex2D(tb, xb, ya));
    float3 c01 = make_float3(_tex2D(tr, xa, yb), _tex2D(tg, xa, yb), _tex2D(tb, xa, yb));
    float3 c11 = make_float3(_tex2D(tr, xb, yb), _tex2D(tg, xb, yb), _tex2D(tb, xb, yb));
    return make_float3(lerp1(lerp1(c00.x, c10.x, ax), lerp1(c01.x, c11.x, ax), ay),
                       lerp1(lerp1(c00.y, c10.y, ax), lerp1(c01.y, c11.y, ax), ay),
                       lerp1(lerp1(c00.z, c10.z, ax), lerp1(c01.z, c11.z, ax), ay));
}

__DEVICE__ float3 linL(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, float fx, float fy, int w, int h)
{
    float3 c = bilL(tr, tg, tb, fx, fy, w, h);
    return make_float3(toLin(c.x), toLin(c.y), toLin(c.z));
}

__DEVICE__ float aperture(float a, float n, float rot, float rnd)
{
    if (n < 3.0f) return 1.0f;
    float seg = 6.2831853f / n;
    float t = a - rot;
    float m = t - seg * _floorf(t / seg) - 0.5f * seg;
    float poly = _cosf(0.5f * seg) / _cosf(m);
    return lerp1(poly, 1.0f, rnd);
}

__DEVICE__ float3 specL(float t)
{
    float a = 6.2831853f * t;
    float r = 0.5f + 0.5f * _cosf(a), g = 0.5f + 0.5f * _cosf(a - 2.0943951f), b = 0.5f + 0.5f * _cosf(a - 4.1887902f);
    return make_float3(r * r * r, g * g * g, b * b * b);
}

__DEVICE__ float rectSdL(float x, float y, int w, int h, float b, float rc)
{
    float cx = 0.5f * (float)(w - 1), cy = 0.5f * (float)(h - 1);
    float hx = 0.5f * (float)(w) - b - rc, hy = 0.5f * (float)(h) - b - rc;
    float qx = _fabs(x - cx) - hx, qy = _fabs(y - cy) - hy;
    float ox = _fmaxf(qx, 0.0f), oy = _fmaxf(qy, 0.0f);
    return _sqrtf(ox * ox + oy * oy) + _fminf(_fmaxf(qx, qy), 0.0f) - rc;
}

__DEVICE__ float3 boxL(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, float fx, float fy, float fp, int w, int h)
{
    if (fp <= 1.0f) return linL(tr, tg, tb, fx, fy, w, h);
    int k = clampi((int)(fp) + 1, 2, 4);
    float r = 0.0f, g = 0.0f, b = 0.0f;
    for (int j = 0; j < 4; j++) {
        if (j >= k) break;
        for (int i = 0; i < 4; i++) {
            if (i >= k) break;
            float ox = (((float)(i) + 0.5f) / (float)(k) - 0.5f) * fp, oy = (((float)(j) + 0.5f) / (float)(k) - 0.5f) * fp;
            float3 c = linL(tr, tg, tb, fx + ox, fy + oy, w, h);
            r += c.x; g += c.y; b += c.z;
        }
    }
    float n = (float)(k * k);
    return make_float3(r / n, g / n, b / n);
}

__DEVICE__ float3 levelL(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, float qx, float qy, float sn, float R, float bw,
                         float tone, float shade, int w, int h)
{
    float hx = 0.5f * (float)(w), hy = 0.5f * (float)(h);
    float cx = 0.5f * (float)(w - 1), cy = 0.5f * (float)(h - 1);
    float3 c = boxL(tr, tg, tb, cx + qx * sn, cy + qy * sn, sn, w, h);
    float ml = _fmaxf(_fabs(qx) / hx, _fabs(qy) / hy) * sn;
    float e0 = 1.0f / R, e1 = e0 * (1.0f + bw);
    float px = sn / hy;
    if (bw > 0.0f) {
        float fr = sstep(e0 - 0.5f * px, e0 + 0.5f * px, ml) * (1.0f - sstep(e1 - 0.5f * px, e1 + 0.5f * px, ml));
        float t = toLin(tone);
        c = make_float3(lerp1(c.x, t, fr), lerp1(c.y, t * 0.985f, fr), lerp1(c.z, t * 0.96f, fr));
    }
    if (shade > 0.0f) {
        float o = 0.025f * e1;
        float ms = _fmaxf(_fabs(qx * sn / hx - o * (float)(h) / (float)(w)), _fabs(qy * sn / hy - o));
        float sh = shade * (1.0f - sstep(e1, e1 + 0.05f * e1, ms)) * sstep(e1 - 0.5f * px, e1 + 0.5f * px, ml);
        c = make_float3(c.x * (1.0f - sh), c.y * (1.0f - sh), c.z * (1.0f - sh));
    }
    return c;
}

__DEVICE__ float3 fluteL(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, float fx, float fy, float s, float wf, float nx, float ny,
                         float M, float soft, int w, int h)
{
    float sl = s / _sqrtf(0.5625f - s * s);
    float r = 0.0f, g = 0.0f, b = 0.0f;
    for (int i = 0; i < 5; i++) {
        float o = ((float)(i) - 2.0f) * soft;
        float dr = wf * (-M * 1.03f * 0.75f * sl) + o, dg = wf * (-M * 0.75f * sl) + o, db = wf * (-M * 0.97f * 0.75f * sl) + o;
        float3 cr = linL(tr, tg, tb, fx + dr * nx, fy + dr * ny, w, h);
        float3 cg = linL(tr, tg, tb, fx + dg * nx, fy + dg * ny, w, h);
        float3 cb = linL(tr, tg, tb, fx + db * nx, fy + db * ny, w, h);
        r += cr.x; g += cg.y; b += cb.z;
    }
    r /= 5.0f; g /= 5.0f; b /= 5.0f;
    return make_float3(r, g, b);
}

__DEVICE__ float2 fluteLightL(float s, float lgt)
{
    float hi = lgt * (0.9f * _expf(-((s + 0.2f) / 0.045f) * ((s + 0.2f) / 0.045f)) + 0.08f * _expf(-((s + 0.12f) / 0.2f) * ((s + 0.12f) / 0.2f)));
    float dk = 1.0f - lgt * 0.6f * _expf(-((0.5f - _fabs(s)) / 0.05f) * ((0.5f - _fabs(s)) / 0.05f));
    return make_float2(hi, dk);
}

__DEVICE__ float3 slideL(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, int k, float fx, float fy, float dx, float dy,
                         float reach, float rough, float tm, float dtm, float mov, float blur, uint seed, int w, int h)
{
    uint uk = (uint)(k + 4096);
    float wv = _sinf(0.9f * (float)(k) + 6.2831853f * hash01(7u, 7u, seed));
    float still = lerp1(wv, 2.0f * hash01(uk, 3u, seed) - 1.0f, rough);
    float o0 = (2.0f * vnoise3(tm + 4096.0f, (float)(k) * 1.7f + 4096.0f, 0.5f, seed + 9u) - 1.0f);
    float o1 = (2.0f * vnoise3(tm + 0.04f + 4096.0f, (float)(k) * 1.7f + 4096.0f, 0.5f, seed + 9u) - 1.0f);
    float off = reach * lerp1(still, o0 * 1.6f, mov);
    float vel = _fabs(reach * mov * 1.6f * (o1 - o0)) / 0.04f;
    float len = blur * vel * dtm * 0.5f;
    float bx = fx - off * dx, by = fy - off * dy;
    if (len < 0.5f) return linL(tr, tg, tb, bx, by, w, h);
    float r = 0.0f, g = 0.0f, b = 0.0f;
    for (int i = 0; i < 16; i++) {
        float t = (((float)(i) + 0.5f) / 16.0f - 0.5f) * len;
        float3 c = linL(tr, tg, tb, bx + t * dx, by + t * dy, w, h);
        r += c.x; g += c.y; b += c.z;
    }
    return make_float3(r / 16.0f, g / 16.0f, b / 16.0f);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    int W = p_Width, H = p_Height, x = p_X, y = p_Y;
    float3 c0 = rgbAt(p_TexR, p_TexG, p_TexB, x, y, W, H);
    if (slAmount <= 0.0f) return c0;
    int md = (int)(slMode + 0.5f);
    float fx = (float)(x), fy = (float)(y), hh = (float)(H), sc = hh / 1080.0f;
    float Cx = 0.5f * (float)(W - 1), Cy = 0.5f * (float)(H - 1);
    float sz = slSize / 100.0f, lv = slLevel / 100.0f, soft = slSoft / 100.0f, rough = slRough / 100.0f;
    float lgt = slLight / 100.0f, tone = slTone / 100.0f;
    uint seed = (uint)(slSeed) * 131u + 23u;
    float tf = (float)(TIMELINE_FRAME_INDEX);
    float r = 0.0f, g = 0.0f, b = 0.0f, k = 0.0f;
    if (md == 0) {
        float bw = (0.01f + 0.12f * sz) * hh, rc = 0.06f * bw;
        float sd = rectSdL(fx, fy, W, H, bw, rc);
        float tear = rough * bw * 0.35f * (2.0f * fbm(fx / (0.03f * hh), fy / (0.03f * hh), 0.5f, 4, seed) - 1.0f)
                   + rough * 2.0f * sc * (2.0f * vnoise3(fx / (2.5f * sc) + 4096.0f, fy / (2.5f * sc) + 4096.0f, 0.5f, seed + 3u) - 1.0f);
        float sdt = sd + tear;
        float fe = 0.5f + soft * 0.3f * bw;
        float cov = 1.0f - sstep(-fe, fe, sdt);
        float tooth = 1.0f + 0.04f * rough * (vnoise3(fx / (1.5f * sc) + 4096.0f, fy / (1.5f * sc) + 4096.0f, 1.5f, seed + 5u) - 0.5f);
        float mr = toLin(tone) * tooth, mg = toLin(tone * 0.985f) * tooth, mb = toLin(tone * 0.96f) * tooth;
        float bv = lv * 0.2f * bw + 0.5f;
        float gx = rectSdL(fx + 1.0f, fy, W, H, bw, rc) - rectSdL(fx - 1.0f, fy, W, H, bw, rc);
        float gy = rectSdL(fx, fy + 1.0f, W, H, bw, rc) - rectSdL(fx, fy - 1.0f, W, H, bw, rc);
        float gl = _sqrtf(gx * gx + gy * gy) + 1e-6f;
        float lit = (gx * 0.7071f + gy * 0.7071f) / gl;
        float onb = lv > 0.0f ? sstep(-0.5f, 0.5f, sdt) * (1.0f - sstep(bv - 0.5f, bv + 0.5f, sdt)) * (1.0f - rough * 0.8f) : 0.0f;
        float core = toLin(lerp1(tone, 0.97f, 0.6f)) * (1.0f + 0.9f * lit * (0.4f + 0.6f * lgt));
        mr = lerp1(mr, core, onb); mg = lerp1(mg, core * 0.99f, onb); mb = lerp1(mb, core * 0.97f, onb);
        float so = (0.02f + 0.06f * lv) * bw + 1.0f;
        float sds = rectSdL(fx - so, fy - so, W, H, bw, rc) + tear;
        float sh = lgt * 0.55f * sstep(-0.35f * bw, 0.15f * bw, sds);
        float3 c = linL(p_TexR, p_TexG, p_TexB, fx, fy, W, H);
        float pr = c.x * (1.0f - sh), pg = c.y * (1.0f - sh), pb = c.z * (1.0f - sh);
        r = lerp1(mr, pr, cov); g = lerp1(mg, pg, cov); b = lerp1(mb, pb, cov);
    } else if (md == 1) {
        float rad = 0.5f + 6.0f * sz * sc;
        int ri = (int)(rad + 1.0f);
        float kk = slSpread / 100.0f * 40.0f;
        float3 cc = linL(p_TexR, p_TexG, p_TexB, fx, fy, W, H);
        float L0 = luma(cc.x, cc.y, cc.z);
        float sr = 0.0f, sg = 0.0f, sb = 0.0f, wl = 0.0f, ar = 0.0f, ag = 0.0f, ab = 0.0f, wr = 0.0f, wg = 0.0f, wb = 0.0f;
        for (int j = -7; j <= 7; j++) {
            if (j < -ri || j > ri) continue;
            for (int i = -7; i <= 7; i++) {
                if (i < -ri || i > ri) continue;
                float d = _sqrtf((float)(i * i + j * j));
                float wc = _saturatef(rad + 0.5f - d);
                if (wc <= 0.0f) continue;
                float3 s = rgbAt(p_TexR, p_TexG, p_TexB, x + i, y + j, W, H);
                float L = luma(s.x, s.y, s.z);
                float w1 = wc * _expf(_fminf(kk * (L - L0), 30.0f));
                sr += w1 * s.x; sg += w1 * s.y; sb += w1 * s.z; wl += w1;
                float qr = wc * _expf(_fminf(kk * (s.x - c0.x), 30.0f)), qg = wc * _expf(_fminf(kk * (s.y - c0.y), 30.0f)), qb = wc * _expf(_fminf(kk * (s.z - c0.z), 30.0f));
                ar += qr * s.x; ag += qg * s.y; ab += qb * s.z; wr += qr; wg += qg; wb += qb;
            }
        }
        float dr = lerp1(sr / wl, ar / wr, lv), dg = lerp1(sg / wl, ag / wg, lv), db = lerp1(sb / wl, ab / wb, lv);
        r = toLin(dr); g = toLin(dg); b = toLin(db);
    } else if (md == 2) {
        float an = slAngle * 0.0174533f, dx = _cosf(an), dy = _sinf(an);
        float sw = (6.0f + 200.0f * sz) * sc;
        float qn = (-(fx - Cx) * dy + (fy - Cy) * dx) / sw + 0.5f;
        int kk = (int)(_floorf(qn));
        float fr = qn - (float)(kk);
        float db = _fminf(fr, 1.0f - fr) * sw;
        int kn = fr < 0.5f ? kk - 1 : kk + 1;
        float reach = lv * 0.3f * hh, mov = sstep(0.0f, 0.3f, _fabs(slSpeed) / 100.0f);
        float tm = tf * slSpeed / 100.0f * 0.03f, dtm = _fabs(slSpeed) / 100.0f * 0.03f;
        float3 c = slideL(p_TexR, p_TexG, p_TexB, kk, fx, fy, dx, dy, reach, rough, tm, dtm, mov, soft, seed, W, H);
        float wo = _saturatef(0.5f + db);
        if (wo < 1.0f) {
            float3 c2 = slideL(p_TexR, p_TexG, p_TexB, kn, fx, fy, dx, dy, reach, rough, tm, dtm, mov, soft, seed, W, H);
            c = make_float3(lerp1(c2.x, c.x, wo), lerp1(c2.y, c.y, wo), lerp1(c2.z, c.z, wo));
        }
        float side = fr < 0.5f ? 1.0f : -1.0f;
        float cut = lgt * _expf(-(db / (1.2f * sc + 0.3f)) * (db / (1.2f * sc + 0.3f))) * lv;
        float m = 1.0f - 0.6f * cut * (side > 0.0f ? 1.0f : 0.3f);
        r = c.x * m; g = c.y * m; b = c.z * m;
    } else if (md == 3) {
        float R = 1.5f + 3.5f * sz;
        float lR = _logf(R);
        float zz = slPhase / 100.0f + tf * slSpeed / 100.0f * 0.02f;
        zz = zz - _floorf(zz);
        float Z = _expf(zz * lR);
        float qx = fx - Cx, qy = fy - Cy;
        float hx = 0.5f * (float)(W), hy = 0.5f * hh;
        float ax = _fabs(qx) / hx, ay = _fabs(qy) / hy;
        float ms = _fmaxf(ax, ay), half = ax > ay ? hx : hy;
        float bw = 0.08f * lv, shade = 0.6f * lgt;
        float m = _fmaxf(ms / Z, 1e-9f);
        int n = clampi((int)(_floorf(-_logf(m) / lR)), 0, 40);
        float sn = _expf((float)(n) * lR) / Z;
        float3 c = levelL(p_TexR, p_TexG, p_TexB, qx, qy, sn, R, bw, tone, shade, W, H);
        float dIn = (ms - Z * _expf(-(float)(n + 1) * lR)) * half;
        float dOut = (Z * _expf(-(float)(n) * lR) - ms) * half;
        if (dIn < 0.5f) {
            float3 c2 = levelL(p_TexR, p_TexG, p_TexB, qx, qy, sn * R, R, bw, tone, shade, W, H);
            float wv = 0.5f - dIn;
            c = make_float3(lerp1(c.x, c2.x, wv), lerp1(c.y, c2.y, wv), lerp1(c.z, c2.z, wv));
        }
        if (dOut < 0.5f && n >= 1) {
            float3 c2 = levelL(p_TexR, p_TexG, p_TexB, qx, qy, sn / R, R, bw, tone, shade, W, H);
            float wv = 0.5f - dOut;
            c = make_float3(lerp1(c.x, c2.x, wv), lerp1(c.y, c2.y, wv), lerp1(c.z, c2.z, wv));
        }
        r = c.x; g = c.y; b = c.z;
    } else {
        float an = slAngle * 0.0174533f, dx = _cosf(an), dy = _sinf(an), nx = -dy, ny = dx;
        float wf = (8.0f + 120.0f * sz) * sc;
        float qn = ((fx - Cx) * nx + (fy - Cy) * ny) / wf;
        float kc = _floorf(qn + 0.5f), s = qn - kc;
        float M = lv * 5.0f, so = soft * 0.03f * wf;
        float3 c = fluteL(p_TexR, p_TexG, p_TexB, fx, fy, s, wf, nx, ny, M, so, W, H);
        float2 li = fluteLightL(s, lgt);
        float L = luma(c.x, c.y, c.z);
        c = make_float3(c.x * li.y + li.x * (0.3f + L), c.y * li.y + li.x * (0.3f + L), c.z * li.y + li.x * (0.3f + L));
        float dj = (0.5f - _fabs(s)) * wf;
        if (dj < 0.5f) {
            float s2 = s > 0.0f ? s - 1.0f : s + 1.0f;
            float3 c2 = fluteL(p_TexR, p_TexG, p_TexB, fx, fy, s2, wf, nx, ny, M, so, W, H);
            float2 l2 = fluteLightL(s2, lgt);
            float L2 = luma(c2.x, c2.y, c2.z);
            c2 = make_float3(c2.x * l2.y + l2.x * (0.3f + L2), c2.y * l2.y + l2.x * (0.3f + L2), c2.z * l2.y + l2.x * (0.3f + L2));
            float wv = 0.5f - dj;
            c = make_float3(lerp1(c.x, c2.x, wv), lerp1(c.y, c2.y, wv), lerp1(c.z, c2.z, wv));
        }
        r = c.x; g = c.y; b = c.z;
        k = li.x;
    }
    float3 o = lightOut(r, g, b, _saturatef(k));
    float a = slAmount / 100.0f;
    return make_float3(lerp1(c0.x, o.x, a), lerp1(c0.y, o.y, a), lerp1(c0.z, o.z, a));
}
