// Develop Texture Plus: eight more ready textures laid over or into the picture, in one transform DCTL, the companion
// of Develop Texture with the same sliders and blends. Each is
// built from the thing it looks like:
//   0 Moire: two fine ring gratings laid one on the other, as two layers of sheer ribbed cloth (watered silk); their
//     beat draws the broad moire bands, and the ribs themselves show only where a pixel can hold them.
//   1 Spots: a cellular field of pigment spots, each its own size, rough edged, pooled darker at its rim, merging where
//     two touch; the field warps slowly.
//   2 Tiles: glazed tiles set in grout (Shape 0 hexagon, 1 triangle, 2 diamond, 3 star and cross), each tile its own
//     glaze tone and a slight tilt, the glaze rounded over each edge and catching a soft light that sways with Speed.
//   3 Loops: three sets of coiled wire seen from the side, each coil a run of loops, the near half of each loop lit and
//     the far half dim; the coils slide slowly along their paths.
//   4 Micro: a rough specimen under a scanning electron microscope: nodules at three scales, tilted surfaces bright
//     (more electrons escape a tilted surface), hollows dark, a faint scan grain.
//   5 Emboss: a sheet of polished metal pressed with a noise relief, mirroring a soft studio light that sways.
//   6 Paint: a noise field painted in short loaded brush strokes, bristle grooves along each, the paint's relief lit.
//   7 Chroma Spiral: a soap film's interference colours, its thickness a noise field swirled by small vortices.
// Blend: 0 Overlay (display values, centred on the texture's median), 1 Multiply (display values, the texture as a
// print, its light parts clear), 2 Screen (the texture's lighter half added in linear), 3 Displace (the picture seen
// through glass pressed with the texture's relief, sampled bilinear). Follow sets how far Overlay and Screen follow the
// picture's own light (0 even over the frame, 100 only where the picture is lit), so the texture lives in the picture.
// Hue 0 keeps each texture's own colour (grey, the film's colours for Chroma Spiral); above 0 it tints them. Amount
// mixes in display terms; Amount 0 is the input exactly. MIT License.

DEFINE_UI_PARAMS(tpAmount,   Texture,   DCTLUI_SLIDER_FLOAT, 100.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(tpKind,     Kind,      DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 7.0, 1.0)
DEFINE_UI_PARAMS(tpBlend,    Blend,     DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 3.0, 1.0)
DEFINE_UI_PARAMS(tpStrength, Strength,  DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(tpSize,     Size,      DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(tpDetail,   Detail,    DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(tpSpeed,    Speed,     DCTLUI_SLIDER_FLOAT, 30.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(tpFollow,   Follow,    DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(tpShape,    Shape,     DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 3.0, 1.0)
DEFINE_UI_PARAMS(tpColour,   Colour,    DCTLUI_SLIDER_FLOAT, 100.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(tpHue,      Hue,       DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(tpSeed,     Seed,      DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)

DEFINE_UI_TOOLTIP(Kind, "0 Moire, 1 Spots, 2 Tiles, 3 Loops, 4 Micro, 5 Emboss, 6 Paint, 7 Chroma Spiral")
DEFINE_UI_TOOLTIP(Blend, "0 Overlay, 1 Multiply, 2 Screen, 3 Displace")
DEFINE_UI_TOOLTIP(Strength, "How strongly the texture works: contrast, depth, light added, or how far the glass bends")
DEFINE_UI_TOOLTIP(Speed, "How fast it moves; 0 holds it")
DEFINE_UI_TOOLTIP(Follow, "How far Overlay and Screen follow the picture's light: 0 even, 100 only where it is lit")
DEFINE_UI_TOOLTIP(Shape, "Tiles only: 0 Hexagon, 1 Triangle, 2 Diamond, 3 Star and cross")
DEFINE_UI_TOOLTIP(Hue, "0 the texture's own colour; above 0 a tint round the colour wheel")

#include "../light/light.h"
#include "../glitch/glitch.h"

__DEVICE__ float3 specT(float t)
{
    float a = 6.2831853f * t;
    return make_float3(0.5f + 0.5f * _cosf(a), 0.5f + 0.5f * _cosf(a - 2.0943951f), 0.5f + 0.5f * _cosf(a - 4.1887902f));
}

__DEVICE__ float3 bilin(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, float fx, float fy, int w, int h)
{
    float x = _clampf(fx, 0.0f, (float)(w - 1)), y = _clampf(fy, 0.0f, (float)(h - 1));
    float x0f = _floorf(x), y0f = _floorf(y);
    int x0 = (int)(x0f), y0 = (int)(y0f);
    int x1 = x0 + 1 < w ? x0 + 1 : w - 1, y1 = y0 + 1 < h ? y0 + 1 : h - 1;
    float ax = x - x0f, ay = y - y0f;
    float3 a = rgbAt(tr, tg, tb, x0, y0, w, h), b = rgbAt(tr, tg, tb, x1, y0, w, h);
    float3 c = rgbAt(tr, tg, tb, x0, y1, w, h), d = rgbAt(tr, tg, tb, x1, y1, w, h);
    return make_float3(lerp1(lerp1(a.x, b.x, ax), lerp1(c.x, d.x, ax), ay), lerp1(lerp1(a.y, b.y, ax), lerp1(c.y, d.y, ax), ay),
                       lerp1(lerp1(a.z, b.z, ax), lerp1(c.z, d.z, ax), ay));
}

__DEVICE__ float gcorner(int ix, int iy, int iz, float dx, float dy, float dz, uint s)
{
    int h = (int)(hash01((uint)(ix + 65536), (uint)(iy + 65536), (uint)(iz + 65536) + s * 7919u) * 16.0f);
    float a = h < 8 ? dx : dy;
    float b = h < 4 ? dy : ((h == 12 || h == 14) ? dx : dz);
    return ((h & 1) == 0 ? a : -a) + ((h & 2) == 0 ? b : -b);
}

__DEVICE__ float gn3(float x, float y, float z, uint s)
{
    float fx = _floorf(x), fy = _floorf(y), fz = _floorf(z);
    int ix = (int)(fx), iy = (int)(fy), iz = (int)(fz);
    float dx = x - fx, dy = y - fy, dz = z - fz;
    float u = fade(dx), v = fade(dy), w = fade(dz);
    float a0 = lerp1(gcorner(ix, iy, iz, dx, dy, dz, s), gcorner(ix + 1, iy, iz, dx - 1.0f, dy, dz, s), u);
    float a1 = lerp1(gcorner(ix, iy + 1, iz, dx, dy - 1.0f, dz, s), gcorner(ix + 1, iy + 1, iz, dx - 1.0f, dy - 1.0f, dz, s), u);
    float b0 = lerp1(gcorner(ix, iy, iz + 1, dx, dy, dz - 1.0f, s), gcorner(ix + 1, iy, iz + 1, dx - 1.0f, dy, dz - 1.0f, s), u);
    float b1 = lerp1(gcorner(ix, iy + 1, iz + 1, dx, dy - 1.0f, dz - 1.0f, s), gcorner(ix + 1, iy + 1, iz + 1, dx - 1.0f, dy - 1.0f, dz - 1.0f, s), u);
    return lerp1(lerp1(a0, a1, v), lerp1(b0, b1, v), w);
}

__DEVICE__ float fbmg(float x, float y, float z, int n, float gain, uint s)
{
    float sum = 0.0f, amp = 1.0f, tot = 0.0f;
    for (int i = 0; i < 6; i++) {
        if (i >= n) break;
        sum += amp * gn3(x, y, z, s + (uint)(i) * 13u);
        tot += amp; amp *= gain;
        float nx = 1.6f * x - 1.2f * y + 17.3f, ny = 1.2f * x + 1.6f * y + 5.1f;
        x = nx; y = ny; z = z * 1.7f + 3.3f;
    }
    return sum / tot;
}

__DEVICE__ float vn1(float x, uint s)
{
    float f = _floorf(x);
    int i = (int)(f);
    return lerp1(rnd3(i, 0, s), rnd3(i + 1, 0, s), fade(x - f));
}

__DEVICE__ float2 cellPt(int ix, int iy, float t, float lo, float wob, uint s)
{
    float sp = 1.0f - 2.0f * lo - 2.0f * wob;
    float ph = 6.2831853f * rnd3(ix, iy, s + 3u), rate = 0.6f + 0.8f * rnd3(ix, iy, s + 4u);
    float px = (float)(ix) + lo + wob + sp * rnd3(ix, iy, s + 1u) + wob * _sinf(t * rate + ph);
    float py = (float)(iy) + lo + wob + sp * rnd3(ix, iy, s + 2u) + wob * _cosf(t * rate * 0.8f + ph * 1.3f);
    return make_float2(px, py);
}

__DEVICE__ float3 domes3(float gx, float gy, float t, uint s)
{
    float cx = _floorf(gx), cy = _floorf(gy);
    int ix = (int)(cx), iy = (int)(cy);
    float k = 0.035f, D = 1.0f, hx = 0.0f, hy = 0.0f;
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            float2 p = cellPt(ix + i, iy + j, t, 0.2f, 0.04f, s);
            float dx = gx - p.x, dy = gy - p.y;
            float rr = 0.55f + 0.20f * rnd3(ix + i, iy + j, s + 5u), r2 = rr * rr;
            float q = _saturatef(1.0f - (dx * dx + dy * dy) / r2);
            float e = _expf(0.5f * rr * q * q / k);
            D += e - 1.0f;
            hx += e * (-2.0f * rr * q * dx / r2); hy += e * (-2.0f * rr * q * dy / r2);
        }
    }
    return make_float3(k * _logf(D), hx / D, hy / D);
}

__DEVICE__ float bandAmp(float f)
{
    return _expf(-4.9348f * f * f) * (1.0f - sstep(0.18f, 0.32f, f));
}

__DEVICE__ float3 lightDir(float t)
{
    float az = -2.3562f + 0.45f * _sinf(0.25f * t), ce = 0.766f;
    return make_float3(ce * _cosf(az), ce * _sinf(az), 0.643f);
}

__DEVICE__ float3 sdBoxG(float qx, float qy, float h)
{
    float dx = _fabs(qx) - h, dy = _fabs(qy) - h;
    float sx = qx < 0.0f ? -1.0f : 1.0f, sy = qy < 0.0f ? -1.0f : 1.0f;
    if (dx > 0.0f && dy > 0.0f) {
        float l = _sqrtf(dx * dx + dy * dy);
        return make_float3(l, sx * dx / l, sy * dy / l);
    }
    if (dx > dy) return make_float3(dx, sx, 0.0f);
    return make_float3(dy, 0.0f, sy);
}

__DEVICE__ float3 starG(float qx, float qy)
{
    float hs = 0.35355f, r = 0.70710678f;
    float3 a = sdBoxG(qx, qy, hs);
    float3 b = sdBoxG((qx + qy) * r, (qy - qx) * r, hs);
    if (a.x < b.x) return a;
    return make_float3(b.x, (b.y - b.z) * r, (b.y + b.z) * r);
}

__DEVICE__ float4 tileField(float a, float b, int shp, uint s)
{
    if (shp == 0) {
        float r3 = 1.7320508f;
        float cax = _floorf(a + 0.5f), cay = _floorf(b / r3 + 0.5f) * r3;
        float cbx = _floorf(a) + 0.5f, cby = (_floorf(b / r3) + 0.5f) * r3;
        float da = (a - cax) * (a - cax) + (b - cay) * (b - cay), db = (a - cbx) * (a - cbx) + (b - cby) * (b - cby);
        float cx = da < db ? cax : cbx, cy = da < db ? cay : cby;
        float qx = a - cx, qy = b - cy;
        float p0 = qx, p1 = 0.5f * qx + 0.8660254f * qy, p2 = -0.5f * qx + 0.8660254f * qy;
        float m = _fabs(p0), gx = p0 < 0.0f ? 1.0f : -1.0f, gy = 0.0f;
        if (_fabs(p1) > m) { m = _fabs(p1); gx = p1 < 0.0f ? 0.5f : -0.5f; gy = p1 < 0.0f ? 0.8660254f : -0.8660254f; }
        if (_fabs(p2) > m) { m = _fabs(p2); gx = p2 < 0.0f ? -0.5f : 0.5f; gy = p2 < 0.0f ? 0.8660254f : -0.8660254f; }
        int ix = (int)(_floorf(2.0f * cx + 0.5f)), iy = (int)(_floorf(2.0f * cy / r3 + 0.5f));
        return make_float4(0.5f - m, gx, gy, rnd3(ix, iy, s));
    }
    float hg = 0.8660254f;
    float s0 = b / hg, s1 = (0.8660254f * a + 0.5f * b) / hg, s2 = (-0.8660254f * a + 0.5f * b) / hg;
    float f0 = s0 - _floorf(s0 + 0.5f), f1 = s1 - _floorf(s1 + 0.5f), f2 = s2 - _floorf(s2 + 0.5f);
    if (shp == 1) {
        float e = _fabs(f0) * hg, gx = 0.0f, gy = f0 < 0.0f ? -1.0f : 1.0f;
        if (_fabs(f1) * hg < e) { e = _fabs(f1) * hg; gx = f1 < 0.0f ? -0.8660254f : 0.8660254f; gy = f1 < 0.0f ? -0.5f : 0.5f; }
        if (_fabs(f2) * hg < e) { e = _fabs(f2) * hg; gx = f2 < 0.0f ? 0.8660254f : -0.8660254f; gy = f2 < 0.0f ? -0.5f : 0.5f; }
        int i0 = (int)(_floorf(s0)), i1 = (int)(_floorf(s1)), i2 = (int)(_floorf(s2));
        return make_float4(e, gx, gy, rnd3(i0 * 997 + i1, i2, s));
    }
    if (shp == 2) {
        float e = _fabs(f1) * hg, gx = f1 < 0.0f ? -0.8660254f : 0.8660254f, gy = f1 < 0.0f ? -0.5f : 0.5f;
        if (_fabs(f2) * hg < e) { e = _fabs(f2) * hg; gx = f2 < 0.0f ? 0.8660254f : -0.8660254f; gy = f2 < 0.0f ? -0.5f : 0.5f; }
        int i1 = (int)(_floorf(s1)), i2 = (int)(_floorf(s2));
        return make_float4(e, gx, gy, rnd3(i1, i2, s));
    }
    float fa = _floorf(a), fb = _floorf(b);
    float best = 9.0f, gx = 0.0f, gy = 0.0f, bx = 0.0f, by = 0.0f;
    for (int j = 0; j <= 1; j++) {
        for (int i = 0; i <= 1; i++) {
            float3 st = starG(a - fa - (float)(i), b - fb - (float)(j));
            if (st.x < best) { best = st.x; gx = st.y; gy = st.z; bx = fa + (float)(i); by = fb + (float)(j); }
        }
    }
    float sg = best < 0.0f ? -1.0f : 1.0f;
    int ix = best < 0.0f ? 2 * (int)(bx) : 2 * (int)(fa) + 1, iy = best < 0.0f ? 2 * (int)(by) : 2 * (int)(fb) + 1;
    return make_float4(_fabs(best), sg * gx, sg * gy, rnd3(ix, iy, s));
}

__DEVICE__ float coil(float x, float y, float A, float B, float R, float w, float aa)
{
    float ab = w + 2.5f * aa;
    if (_fabs(y) > R + ab) return 0.0f;
    float lo = (x - B - ab) / A, hi = (x + B + ab) / A;
    float best = 0.0f;
    float ph = _floorf(lo / 0.2f) * 0.2f;
    float px = A * ph + B * _cosf(ph), py = R * _sinf(ph);
    for (int i = 0; i < 64; i++) {
        if (ph > hi) break;
        float ph2 = ph + 0.2f;
        float qx = A * ph2 + B * _cosf(ph2), qy = R * _sinf(ph2);
        float ex = qx - px, ey = qy - py, l2 = ex * ex + ey * ey;
        float hh = _saturatef(((x - px) * ex + (y - py) * ey) / l2);
        float dx = x - px - hh * ex, dy = y - py - hh * ey, d = _sqrtf(dx * dx + dy * dy);
        if (d < ab) {
            float near = 0.5f + 0.5f * _cosf(ph + 0.2f * hh);
            float wn = w * (0.55f + 0.45f * near), an = aa * (1.0f + 1.5f * (1.0f - near));
            float c = 1.0f - sstep(wn - an, wn + an, d);
            float q = _saturatef(d / (wn + an));
            best = _fmaxf(best, c * (1.0f - 0.35f * q * q) * (0.12f + 0.88f * near * near));
        }
        ph = ph2; px = qx; py = qy;
    }
    return best;
}

__DEVICE__ float glb(float l, float m, float s1, float s2)
{
    float q = (l - m) / (l < m ? s1 : s2);
    return _expf(-0.5f * q * q);
}

__DEVICE__ float3 filmRGB(float d)
{
    float X = 0.0f, Y = 0.0f, Z = 0.0f, Xw = 0.0f, Yw = 0.0f, Zw = 0.0f;
    for (int i = 0; i < 16; i++) {
        float l = 400.0f + 20.0f * (float)(i);
        float xb = 1.056f * glb(l, 599.8f, 37.9f, 31.0f) + 0.362f * glb(l, 442.0f, 16.0f, 26.7f) - 0.065f * glb(l, 501.1f, 20.4f, 26.2f);
        float yb = 0.821f * glb(l, 568.8f, 46.9f, 40.5f) + 0.286f * glb(l, 530.9f, 16.3f, 31.1f);
        float zb = 1.217f * glb(l, 437.0f, 11.8f, 36.0f) + 0.681f * glb(l, 459.0f, 26.0f, 13.8f);
        float s = _sinf(6.2831853f * 1.33f * d / l), R = s * s;
        X += R * xb; Y += R * yb; Z += R * zb; Xw += xb; Yw += yb; Zw += zb;
    }
    float r = 3.2406f * X - 1.5372f * Y - 0.4986f * Z, g = -0.9689f * X + 1.8758f * Y + 0.0415f * Z, b = 0.0557f * X - 0.2040f * Y + 1.0570f * Z;
    float rw = 3.2406f * Xw - 1.5372f * Yw - 0.4986f * Zw, gw = -0.9689f * Xw + 1.8758f * Yw + 0.0415f * Zw, bw = 0.0557f * Xw - 0.2040f * Yw + 1.0570f * Zw;
    return make_float3(_fmaxf(r / rw, 0.0f), _fmaxf(g / gw, 0.0f), _fmaxf(b / bw, 0.0f));
}

__DEVICE__ float4 texAt(int k, float u, float v, float t, float S, float pix, float rp, float det, int shp, uint sd)
{
    float val = 0.0f, aux = 0.0f, sx = 0.0f, sy = 0.0f;
    int oct = 3 + (int)(det * 3.0f + 0.5f);
    float gain = 0.40f + 0.22f * det;
    if (k == 0) {
        float sz = (S - 0.05f) / 0.35f;
        float pp = (4.0f + 5.0f * sz) * pix;
        float a1 = 6.2831853f * rnd3(1, 1, sd + 81u);
        float c1x = 0.889f + 1.1f * _cosf(a1), c1y = 0.5f + 1.1f * _sinf(a1);
        float D = pp * (3.0f + 12.0f * det), a2 = a1 + 1.5707963f + 0.08f * t;
        float c2x = c1x + D * _cosf(a2), c2y = c1y + D * _sinf(a2);
        float wa = pp * (0.3f + 1.4f * det);
        float w1 = wa * fbmg(u * 2.5f, v * 2.5f, 0.0f, 2, 0.5f, sd + 83u), w2 = wa * fbmg(u * 2.5f + 4.1f, v * 2.5f + 8.3f, 0.0f, 2, 0.5f, sd + 84u);
        float d1x = u - c1x, d1y = v - c1y, d2x = u - c2x, d2y = v - c2y;
        float r1 = _sqrtf(d1x * d1x + d1y * d1y), r2 = _sqrtf(d2x * d2x + d2y * d2y);
        float n1x = d1x / r1, n1y = d1y / r1, n2x = d2x / r2, n2y = d2y / r2;
        float fq = rp / pp;
        float A1 = bandAmp(fq);
        float As = bandAmp(fq * _sqrtf((n1x + n2x) * (n1x + n2x) + (n1y + n2y) * (n1y + n2y)));
        float Ad = bandAmp(fq * _sqrtf((n1x - n2x) * (n1x - n2x) + (n1y - n2y) * (n1y - n2y)));
        float p1 = (r1 + w1) / pp, p2 = (r2 + w2) / pp, pd = (r1 - r2 + w1 - w2) / pp;
        float cb = _cosf(6.2831853f * pd);
        val = 0.25f * (1.0f + 0.15f * A1 * (_cosf(6.2831853f * p1) + _cosf(6.2831853f * p2)) + 0.5f * Ad * cb + 0.08f * As * _cosf(6.2831853f * (p1 + p2)));
        aux = 0.5f + 0.5f * Ad * cb;
    } else if (k == 1) {
        float cs = S * 0.45f;
        float gx = u / cs, gy = v / cs;
        float wx = gx + 0.35f * fbmg(gx * 0.45f, gy * 0.45f, t * 0.12f, 2, 0.5f, sd + 1u);
        float wy = gy + 0.35f * fbmg(gx * 0.45f + 5.3f, gy * 0.45f + 2.1f, t * 0.12f, 2, 0.5f, sd + 2u);
        wx += 0.08f * (0.3f + det) * fbmg(gx * 3.1f, gy * 3.1f, t * 0.05f, 2, 0.5f, sd + 3u);
        wy += 0.08f * (0.3f + det) * fbmg(gx * 3.1f + 7.7f, gy * 3.1f + 1.3f, t * 0.05f, 2, 0.5f, sd + 4u);
        float fx = _floorf(wx), fy = _floorf(wy);
        int ix = (int)(fx), iy = (int)(fy);
        float sdf = 9.0f, tone = 0.3f;
        for (int j = -1; j <= 1; j++) {
            for (int i = -1; i <= 1; i++) {
                int cx = ix + i, cy = iy + j;
                float2 p = cellPt(cx, cy, t * 0.2f, 0.22f, 0.05f, sd + 5u);
                float r = 0.17f + 0.22f * rnd3(cx, cy, sd + 6u);
                if (rnd3(cx, cy, sd + 7u) < 0.15f) r *= 0.4f;
                float d = _sqrtf((wx - p.x) * (wx - p.x) + (wy - p.y) * (wy - p.y)) - r;
                float tn = 0.38f + 0.24f * rnd3(cx, cy, sd + 8u);
                float hh = _saturatef(0.5f + 0.5f * (sdf - d) / 0.08f);
                sdf = lerp1(sdf, d, hh) - 0.08f * hh * (1.0f - hh);
                tone = lerp1(tone, tn, hh);
            }
        }
        float e = (1.0f * pix + 0.8f * rp) / cs;
        float cov = 1.0f - sstep(-e, e, sdf);
        float rim = sstep(-0.14f, 0.0f, sdf) * cov;
        float gran = fbmg(u / (S * 0.04f), v / (S * 0.04f), 0.0f, 2, 0.5f, sd + 10u);
        float ground = 0.70f + 0.05f * fbmg(u / (S * 0.15f), v / (S * 0.15f), 0.0f, 2, 0.5f, sd + 9u);
        val = lerp1(ground, tone + 0.07f * gran, cov) - 0.08f * rim;
        aux = tone * 3.0f;
    } else if (k == 2) {
        float ts = S * 0.55f;
        float wu = 0.035f * fbmg(u / ts * 0.3f, v / ts * 0.3f, 0.0f, 2, 0.5f, sd + 26u), wv = 0.035f * fbmg(u / ts * 0.3f + 5.0f, v / ts * 0.3f + 2.0f, 0.0f, 2, 0.5f, sd + 27u);
        float4 tf = tileField(u / ts + 13.7f + wu, v / ts + 5.3f + wv, shp, sd + 21u);
        float e = tf.x, hid = tf.w;
        float gw = 0.5f * (0.020f + 1.6f * pix / ts), bw = 0.11f, aa = 0.8f * rp / ts;
        float m = sstep(-aa, aa, e - gw);
        float xr = _saturatef((e - gw) / bw);
        float dh = 0.018f * 6.0f * xr * (1.0f - xr) / bw;
        float tlx = 0.035f * (rnd3((int)(hid * 65536.0f), 1, sd + 22u) - 0.5f), tly = 0.035f * (rnd3((int)(hid * 65536.0f), 2, sd + 23u) - 0.5f);
        float rs = 0.35f, rd = rp / ts, ra = 0.006f;
        float r0 = gn3(u / ts / rs, v / ts / rs, hid * 50.0f, sd + 24u);
        float ripx = ra * (gn3((u / ts + rd) / rs, v / ts / rs, hid * 50.0f, sd + 24u) - r0) / rd;
        float ripy = ra * (gn3(u / ts / rs, (v / ts + rd) / rs, hid * 50.0f, sd + 24u) - r0) / rd;
        float gxs = (dh * tf.y + tlx + ripx) * m, gys = (dh * tf.z + tly + ripy) * m;
        float3 L = lightDir(t);
        float nn = 1.0f / _sqrtf(1.0f + gxs * gxs + gys * gys);
        float nx = -gxs * nn, ny = -gys * nn, nz = nn;
        float diff = _fmaxf(nx * L.x + ny * L.y + nz * L.z, 0.0f) / L.z;
        float rl = 2.0f * nz * (nx * L.x + ny * L.y + nz * L.z) - L.z;
        float sheen = 0.22f * _powf(_saturatef(rl), 24.0f) + 0.05f * sstep(0.5f, 1.0f, rl);
        float tone = 0.50f + (0.10f + 0.18f * det) * (2.0f * hid - 1.0f);
        tone += 0.07f * (1.0f - sstep(0.0f, 0.10f, e - gw));
        float gr = (0.24f + 0.05f * fbmg(u / (S * 0.05f), v / (S * 0.05f), 0.0f, 2, 0.5f, sd + 25u)) * (0.75f + 0.25f * sstep(0.0f, gw, gw - e));
        val = lerp1(gr, tone * (0.30f + 0.70f * diff) + sheen, m);
        aux = hid;
        float lp = 0.25f * _saturatef(1.0f - (e - gw) / 0.35f) * m;
        sx = lp * tf.y + tlx * m; sy = lp * tf.z + tly * m;
    } else if (k == 3) {
        float best = 0.0f, which = 0.0f;
        float th0 = 6.2831853f * rnd3(3, 7, sd + 91u);
        float w = 1.0f * pix, aa = 0.6f * rp;
        for (int q = 0; q < 3; q++) {
            float th = th0 + 2.0943951f * (float)(q) + 0.35f * rnd3(q, 8, sd + 92u);
            float L = S * (0.34f + 0.18f * (float)(q));
            float R = 0.44f * L, B = 0.95f * R, A = R * (0.22f + 0.30f * (1.0f - det));
            float cth = _cosf(th), sth = _sinf(th);
            float xl = u * cth + v * sth + 3.0f, yl = -u * sth + v * cth + 3.0f;
            int j0 = (int)(_floorf(yl / L));
            for (int jj = 0; jj <= 1; jj++) {
                int j = j0 + jj;
                float pace = 0.4f + 0.6f * rnd3(j, q, sd + 93u), dir = rnd3(j, q, sd + 94u) < 0.5f ? -1.0f : 1.0f;
                float wan = 0.12f * L * fbmg(xl / L * 0.25f, (float)(j) * 1.7f, 0.0f, 2, 0.5f, sd + 95u);
                float yy = yl - (float)(j) * L - wan;
                float xx = xl + A * (dir * 1.5f * pace * t + 40.0f * rnd3(j, q, sd + 96u));
                float c = coil(xx, yy, A, B, R, w, aa) * (1.0f - 0.25f * (float)(q));
                if (c > best) { best = c; which = 0.5f * (float)(q); }
            }
        }
        val = 0.10f + 0.55f * best;
        aux = which;
    } else if (k == 4) {
        float h = 0.0f, hx = 0.0f, hy = 0.0f, amp = 1.0f, c = S * 0.45f, carry = 1.0f;
        for (int i = 0; i < 3; i++) {
            float bu = u / c + 3.7f * (float)(i), bv = v / c + 1.9f * (float)(i);
            float bx = bu + 0.25f * fbmg(bu * 0.7f, bv * 0.7f, 0.0f, 2, 0.5f, sd + 41u + (uint)(i)), by = bv + 0.25f * fbmg(bu * 0.7f + 4.0f, bv * 0.7f + 9.0f, 0.0f, 2, 0.5f, sd + 44u + (uint)(i));
            float3 nn = domes3(bx, by, t * 0.15f, sd + 31u + 17u * (uint)(i));
            float a2 = amp * carry;
            h += a2 * c * nn.x;
            hx += a2 * nn.y; hy += a2 * nn.z;
            carry = carry * (0.25f + 0.75f * sstep(0.0f, 0.09f, nn.x));
            amp *= 0.55f; c *= 0.38f;
        }
        float fr = S * 0.04f, ar = 0.15f * fr * (0.4f + det);
        float g0 = fbmg(u / fr, v / fr, 0.0f, 2, 0.5f, sd + 37u);
        hx += ar * (fbmg((u + rp) / fr, v / fr, 0.0f, 2, 0.5f, sd + 37u) - g0) / rp;
        hy += ar * (fbmg(u / fr, (v + rp) / fr, 0.0f, 2, 0.5f, sd + 37u) - g0) / rp;
        float g2 = hx * hx + hy * hy, sec = _sqrtf(1.0f + g2), nz = 1.0f / sec;
        float nd = (0.25f * hx + 0.75f * hy + 0.61f) * nz;
        float hol = sstep(0.0f, 0.30f * S * 0.45f, h);
        float y0 = 0.16f + 0.30f * _fminf(sec - 1.0f, 1.6f) + 0.30f * nd;
        float grain = 0.035f * gn3(u / (pix * 5.0f), v / (pix * 1.5f), 0.0f, sd + 39u);
        val = y0 * (0.55f + 0.45f * hol) + grain;
        sx = hx; sy = hy;
    } else if (k == 5) {
        float f = 1.6f / S;
        val = 0.5f + fbmg(u * f, v * f, t * 0.04f, 2 + (int)(det * 3.0f + 0.5f), 0.5f, sd + 101u);
    } else if (k == 6) {
        float cs = S * 0.30f;
        float z1 = -1.0f, c1 = 0.0f, k1 = 0.0f, h1 = 0.0f, z2 = -1.0f, c2 = 0.0f, k2 = 0.0f, h2 = 0.0f;
        for (int ly = 0; ly < 3; ly++) {
            uint ls = sd + 111u + 37u * (uint)(ly);
            float gx = u / cs + 0.5f * (float)(ly) + 0.37f, gy = v / cs + 0.31f * (float)(ly) + 0.17f * (float)(ly * ly);
            int ix = (int)(_floorf(gx)), iy = (int)(_floorf(gy));
            for (int j = -1; j <= 1; j++) {
                for (int i = -1; i <= 1; i++) {
                    int cx = ix + i, cy = iy + j;
                    float2 p = cellPt(cx, cy, 0.0f, 0.0f, 0.0f, ls);
                    float ang = 0.6f + 1.1f * _sinf(0.31f * (float)(cx) + 0.53f * (float)(cy) + 6.2831853f * rnd3(0, 0, ls))
                              + 0.6f * _sinf(0.17f * (float)(cy) - 0.41f * (float)(cx)) + 0.5f * (rnd3(cx, cy, ls + 5u) - 0.5f);
                    float ca = _cosf(ang), sa = _sinf(ang);
                    float hl = 0.55f + 0.20f * rnd3(cx, cy, ls + 6u), hw = 0.30f + 0.12f * rnd3(cx, cy, ls + 7u);
                    float dx = gx - p.x, dy = gy - p.y;
                    float ss = (dx * ca + dy * sa) / hl;
                    hw *= 0.85f + 0.3f * vn1(ss * 2.5f + 11.0f * rnd3(cx, cy, ls + 13u), ls + 14u);
                    float qn = (-dx * sa + dy * ca) / hw;
                    float s2 = ss * ss, q2 = qn * qn;
                    float mm = _powf(s2 * s2 * s2 + q2 * q2 * q2, 1.0f / 6.0f);
                    float ee = 1.5f * rp / (cs * hw);
                    float cov = 1.0f - sstep(1.0f - ee, 1.0f + ee, mm);
                    if (cov <= 0.0f) continue;
                    float bo = 37.0f * rnd3(cx, cy, ls + 10u);
                    float br = 0.6f * vn1(qn * 11.0f + bo, ls + 11u) + 0.4f * vn1(qn * 23.0f + bo, ls + 12u);
                    cov *= 1.0f - 0.7f * sstep(0.30f + 0.5f * br, 0.80f + 0.5f * br, ss);
                    float z = rnd3(cx, cy, ls + 8u) + (float)(ly);
                    float col = 0.5f + 0.9f * fbmg(p.x * cs / (S * 1.2f), p.y * cs / (S * 1.2f), 0.0f, 3, 0.5f, sd + 120u) + 0.20f * (rnd3(cx, cy, ls + 9u) - 0.5f);
                    col += 0.03f * (br - 0.5f);
                    float hgt = 0.5f + 0.04f * (br - 0.5f) + 0.05f * (1.0f - sstep(-1.0f, -0.4f, ss));
                    if (z > z1) { z2 = z1; c2 = c1; k2 = k1; h2 = h1; z1 = z; c1 = cov; k1 = col; h1 = hgt; }
                    else if (z > z2) { z2 = z; c2 = cov; k2 = col; h2 = hgt; }
                }
            }
        }
        float base = 0.5f + 0.9f * fbmg(u / (S * 1.2f), v / (S * 1.2f), 0.0f, 3, 0.5f, sd + 120u);
        val = lerp1(lerp1(base, k2, c2), k1, c1);
        aux = lerp1(lerp1(0.5f, h2, c2), h1, c1);
    } else {
        float f = 1.0f / S, vc = 1.6f;
        float x = u * f, y = v * f, gx = x / vc, gy = y / vc;
        int ix = (int)(_floorf(gx)), iy = (int)(_floorf(gy));
        float ox = 0.0f, oy = 0.0f;
        for (int j = -1; j <= 1; j++) {
            for (int i = -1; i <= 1; i++) {
                int cx = ix + i, cy = iy + j;
                float2 p = cellPt(cx, cy, t * 0.1f, 0.15f, 0.03f, sd + 131u);
                float dx = gx - p.x, dy = gy - p.y;
                float wg = _saturatef(1.0f - dx * dx - dy * dy);
                wg = wg * wg;
                float sgn = rnd3(cx, cy, sd + 132u) < 0.5f ? -1.0f : 1.0f;
                float turn = sgn * wg * ((0.6f + 1.4f * rnd3(cx, cy, sd + 133u)) * (0.4f + 0.8f * det) + 0.6f * _sinf(0.15f * t + 6.2831853f * rnd3(cx, cy, sd + 134u)));
                float cr = _cosf(turn), sr = _sinf(turn);
                ox += (dx * cr - dy * sr - dx) * vc; oy += (dx * sr + dy * cr - dy) * vc;
            }
        }
        float n = fbmg(x + ox, y + oy, t * 0.05f, 3, 0.5f, sd + 135u) + 0.06f * det * fbmg(4.0f * (x + ox), 4.0f * (y + oy), t * 0.1f, 2, 0.5f, sd + 136u);
        float dn = _fmaxf(400.0f + (300.0f + 350.0f * det) * n, 90.0f);
        float3 fc = filmRGB(dn);
        float dr = toDisp(_fminf(fc.x, 1.0f)), dg = toDisp(_fminf(fc.y, 1.0f)), db = toDisp(_fminf(fc.z, 1.0f));
        return make_float4(_saturatef(luma(dr, dg, db)), dr, dg, db);
    }
    return make_float4(_saturatef(val), aux, sx, sy);
}

__DEVICE__ float keepOut(float c, float cs, float x)
{
    return c == cs ? x : c + (x - cs);
}

__DEVICE__ float mixOut(float c, float o, float am)
{
    float m = lerp1(c, o, am);
    return (c >= 0.0f && c <= 1.0f && o >= 0.0f && o <= 1.0f) ? _saturatef(m) : m;
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    int W = p_Width, H = p_Height, x = p_X, y = p_Y;
    float3 c0 = rgbAt(p_TexR, p_TexG, p_TexB, x, y, W, H);
    if (tpAmount <= 0.0f) return c0;
    int k = (int)(tpKind + 0.5f), bl = (int)(tpBlend + 0.5f), shp = (int)(tpShape + 0.5f);
    float sc = (float)(H) / 1080.0f, pix = 1.0f / (float)(H);
    float u = ((float)(x) + 0.5f) * pix, v = ((float)(y) + 0.5f) * pix;
    float t = (float)(TIMELINE_FRAME_INDEX) / 24.0f * tpSpeed / 100.0f;
    float S = 0.05f + 0.35f * _powf(tpSize / 100.0f, 1.5f);
    float det = tpDetail / 100.0f, st = tpStrength / 100.0f;
    uint sd = (uint)(tpSeed) * 131u + 7u;
    float pw = 1.0f / 1080.0f;
    float4 tv = texAt(k, u, v, t, S, pw, pix, det, shp, sd);
    float val = tv.x;
    float gx = 0.0f, gy = 0.0f;
    int ana = (k == 2 || k == 4) ? 1 : 0;
    if (ana == 1) { gx = tv.z; gy = tv.w; }
    if (k == 5 || k == 6 || (bl == 3 && ana == 0)) {
        float e = 1.5f * pix;
        float4 ax = texAt(k, u + e, v, t, S, pw, pix, det, shp, sd), ay = texAt(k, u, v + e, t, S, pw, pix, det, shp, sd);
        int yc = (k == 0 || (k == 6 && bl != 3)) ? 1 : 0;
        float c = yc == 1 ? tv.y : tv.x, cx = yc == 1 ? ax.y : ax.x, cy = yc == 1 ? ay.y : ay.x;
        gx = (cx - c) / e * S * 0.25f; gy = (cy - c) / e * S * 0.25f;
    }
    if (k == 5 || k == 6) {
        float dep = k == 5 ? 0.8f : 0.4f;
        float nn = 1.0f / _sqrtf(1.0f + dep * dep * (gx * gx + gy * gy));
        float nx = -gx * dep * nn, ny = -gy * dep * nn, nz = nn;
        float3 L = lightDir(t);
        float ndl = nx * L.x + ny * L.y + nz * L.z;
        float rl = 2.0f * nz * ndl - L.z, ry = 2.0f * nz * ny;
        if (k == 5) {
            float env = 0.30f + 0.34f * sstep(-0.4f, 1.0f, rl) + 0.15f * sstep(0.2f, 1.0f, -ry);
            val = _saturatef(0.85f * env + 0.45f * _powf(_saturatef(rl), 30.0f) + 0.08f * ndl);
        } else {
            val = _saturatef(val * (0.62f + 0.38f * ndl / L.z) + 0.10f * _powf(_saturatef(rl), 20.0f));
        }
    }
    float hue = tpHue / 100.0f, col = tpColour / 100.0f;
    float3 own = make_float3(1.0f, 1.0f, 1.0f);
    if (k == 7) {
        float fy = luma(tv.y, tv.z, tv.w);
        own = make_float3(_fmaxf(lerp1(fy, tv.y, 0.40f), 0.02f), _fmaxf(lerp1(fy, tv.z, 0.40f), 0.02f), _fmaxf(lerp1(fy, tv.w, 0.40f), 0.02f));
    }
    float vary = k == 6 ? 0.25f * (tv.x - 0.5f) : ((k == 1 || k == 3) ? 0.15f * tv.y : 0.0f);
    float3 tint = hue <= 0.0f ? own : specT(hue + vary);
    float tl = luma(tint.x, tint.y, tint.z);
    float3 tc = make_float3(lerp1(1.0f, tint.x / tl, col), lerp1(1.0f, tint.y / tl, col), lerp1(1.0f, tint.z / tl, col));
    float mean = k == 0 ? 0.248f : (k == 1 ? 0.695f : (k == 2 ? 0.492f : (k == 3 ? 0.107f : (k == 4 ? 0.273f : (k == 5 ? 0.535f : (k == 6 ? 0.495f : 0.685f))))));
    float hi = k == 0 ? 0.368f : (k == 1 ? 0.710f : (k == 2 ? 0.671f : (k == 3 ? 0.223f : (k == 4 ? 0.445f : (k == 5 ? 0.684f : (k == 6 ? 0.684f : 0.908f))))));
    float lum = luma(_saturatef(c0.x), _saturatef(c0.y), _saturatef(c0.z));
    float fl = _powf(sstep(0.0f, 0.5f, lum), tpFollow / 50.0f);
    float3 o = c0;
    if (bl == 0) {
        float s2 = st * 1.6f * fl;
        float br = _saturatef(0.5f + s2 * (val * tc.x - mean)), bg = _saturatef(0.5f + s2 * (val * tc.y - mean)), bb = _saturatef(0.5f + s2 * (val * tc.z - mean));
        float ar = _saturatef(c0.x), ag = _saturatef(c0.y), ab = _saturatef(c0.z);
        o = make_float3(keepOut(c0.x, ar, ar < 0.5f ? 2.0f * ar * br : 1.0f - 2.0f * (1.0f - ar) * (1.0f - br)),
                        keepOut(c0.y, ag, ag < 0.5f ? 2.0f * ag * bg : 1.0f - 2.0f * (1.0f - ag) * (1.0f - bg)),
                        keepOut(c0.z, ab, ab < 0.5f ? 2.0f * ab * bb : 1.0f - 2.0f * (1.0f - ab) * (1.0f - bb)));
    } else if (bl == 1) {
        float pk = _fmaxf(tc.x, _fmaxf(tc.y, tc.z));
        float fr = _saturatef(val * tc.x / pk / hi), fg = _saturatef(val * tc.y / pk / hi), fb = _saturatef(val * tc.z / pk / hi);
        o = make_float3(c0.x * lerp1(1.0f, fr, st), c0.y * lerp1(1.0f, fg, st), c0.z * lerp1(1.0f, fb, st));
    } else if (bl == 2) {
        float fls = _powf(_fminf(toLin(lum) / 0.293f, 1.0f), tpFollow / 30.0f);
        float a = 1.5f * st * fls * toLin(sstep(k == 7 ? 0.35f : mean, 1.0f, val));
        float ar = a * tc.x, ag = a * tc.y, ab = a * tc.z;
        float sr = _saturatef(c0.x), sg = _saturatef(c0.y), sb = _saturatef(c0.z);
        float3 lo = lightOut(toLin(sr) + ar, toLin(sg) + ag, toLin(sb) + ab, _fmaxf(ar, _fmaxf(ag, ab)));
        o = make_float3(keepOut(c0.x, sr, lo.x), keepOut(c0.y, sg, lo.y), keepOut(c0.z, sb, lo.z));
    } else {
        float ks = k == 6 ? 0.4f : 1.0f;
        float dxs = gx * ks, dys = gy * ks, gm = _sqrtf(dxs * dxs + dys * dys);
        float amt = st * 160.0f * sc / (1.0f + 2.0f * gm);
        o = bilin(p_TexR, p_TexG, p_TexB, (float)(x) - amt * dxs, (float)(y) - amt * dys, W, H);
    }
    float am = tpAmount / 100.0f;
    return make_float3(mixOut(c0.x, o.x, am), mixOut(c0.y, o.y, am), mixOut(c0.z, o.z, am));
}
