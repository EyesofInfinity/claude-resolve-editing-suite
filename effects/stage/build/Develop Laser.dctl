            ar += k * (E * fc.x + gl + halo); ag += k * (E * fc.y + gl * 0.75f + halo * 0.55f); ab += k * (E * fc.z + gl * 0.4f + halo * 0.18f);
            float lit = k * I * (1.4f / (1.0f + rr * rr * 0.35f) * _expf(-rr / 6.0f) + 0.04f);
            mr += lit; mg += lit * 0.72f; mb += lit * 0.42f;
