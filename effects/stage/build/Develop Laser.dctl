                float ex = px + 0.4f * (dxm * ca - dym * sa) * (1.0f - tb), ey = py + 0.4f * (dxm * sa + dym * ca) * (1.0f - tb);
                float2 ab2 = arcDist(x, y, px, py, ex, ey, chaos * 1.2f, strike * 3.1f + (float)(j) * 7.0f, 40u + (uint)(j) * 5u + sd, 0.0f, 1.0f, far);
                d = _fminf(d, ab2.x * (1.5f + 1.5f * ab2.y));
