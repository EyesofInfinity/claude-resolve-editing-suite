                    float bn = an + (hash01(zs + 300u, (uint)(j), 8u) - 0.5f) * 1.4f;
                    float px = ax + (ex - ax) * tb, py = ay + (ey - ay) * tb;
                    float qx = px + 0.5f * ln * (1.0f - tb) * _cosf(bn), qy = py + 0.5f * ln * (1.0f - tb) * _sinf(bn);
                    float2 a2 = arcDist(x, y, px, py, qx, qy, chaos * 1.3f, strike * 3.1f + (float)(j) * 9.1f, 90u + (uint)(j) * 3u + sd, 0.0f, 1.0f, far);
                    d = _fminf(d, a2.x * (1.6f + 1.5f * a2.y) + w * (0.5f + 1.3f * a2.y * a2.y));
                }
            }
            float dA = _sqrtf((x - ax) * (x - ax) + (y - ay) * (y - ay));
            float e = 2.0f * _expf(-dA / (w * 5.0f * esz)) * flick * k;
            ar += e; ag += e; ab += e;
            float eg = 0.15f * _expf(-dA / (0.018f * esz)) * flick * k;
            ar += eg * hc.x; ag += eg * hc.y; ab += eg * hc.z;
        }
        float core = _expf(-(d / w) * (d / w));
        float glow = _expf(-d / (w * (4.0f + 14.0f * lzGlow / 100.0f)));
        float kk = k * flick;
        ar += kk * (2.5f * core + 0.45f * glow * hc.x); ag += kk * (2.5f * core + 0.45f * glow * hc.y); ab += kk * (2.5f * core + 0.45f * glow * hc.z);
        float lit = 0.4f * kk * _expf(-dt / 0.06f);
        mr += lit * hc.x; mg += lit * hc.y; mb += lit * hc.z;
    } else {
        int per = (int)(lzEvery + 0.5f), life = (int)(lzLife + 0.5f);
        int shot = 0, age = 0;
        if (per > 0) { shot = fr / per; age = fr - shot * per; }
        if (age < life) {
            float S = 0.03f + 0.0012f * lzSize;
            uint ss = (uint)(shot) * 7919u + sd;
            float fa = (float)(age);
            float I = _powf(0.34f, fa);
            float grow = 1.0f + 0.25f * fa;
            float an = (lzAngle + 8.0f * (hash01(ss, 1u, 2u) - 0.5f)) * 0.0174533f;
            float ca = _cosf(an), sa = _sinf(an);
            float px = x - ax, py = y - ay;
            float u0 = (px * ca + py * sa) / S, v0 = (-px * sa + py * ca) / S;
            float rr = _sqrtf(u0 * u0 + v0 * v0);
