                float gw = 1.3f / hh / S;
                gl += _expf(-(gs.x / gw) * (gs.x / gw)) * (0.4f + 0.6f * hash01(ss, (uint)(j), 23u));
            }
            gl *= I * (age < 2 ? 1.0f : 0.0f) * 1.4f;
