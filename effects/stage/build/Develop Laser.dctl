            float dA = _sqrtf((x - ax) * (x - ax) + (y - ay) * (y - ay)), dB = _sqrtf((x - bx) * (x - bx) + (y - by) * (y - by));
            float e = (1.4f * _expf(-dA / (w * 4.0f * esz)) + sstep(0.9f, 1.0f, reach) * 1.8f * _expf(-dB / (w * 5.0f * esz))) * flick * k;
            ar += e; ag += e; ab += e;
        } else {
            float R = 0.08f + 0.0062f * lzSize;
            int nc = (int)(lzCount + 0.5f);
            for (int j = 0; j < 8; j++) {
                if (j >= nc) break;
                float an = (lzAngle + (hash01(zs + 300u, (uint)(j), 5u) - 0.5f) * lzSpread) * 0.0174533f;
                float ln = R * (0.45f + 0.55f * hash01(zs + 300u, (uint)(j), 6u));
                float ex = ax + ln * _cosf(an), ey = ay + ln * _sinf(an);
                float2 a1 = arcDist(x, y, ax, ay, ex, ey, chaos * 1.15f, strike * 3.1f + (float)(j) * 5.3f, 60u + (uint)(j) * 3u + sd, 0.0f, 1.0f, far);
                d = _fminf(d, a1.x * (1.0f + 1.5f * a1.y) + 1.3f * w * a1.y * a1.y);
                dt = _fminf(dt, a1.x);
