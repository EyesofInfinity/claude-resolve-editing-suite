        }
        float3 tc = rgbAt(p_TexR, p_TexG, p_TexB, (int)(sx * s), (int)(sy * s), W, H);
        float tv = 0.92f + 0.12f * rnd3(bi, bj, sd + 3u);
        float bev = 1.0f - 0.18f * sstep(0.25f, 0.6f, f1);
        float3 tile = make_float3(_saturatef(tc.x * tv * bev), _saturatef(tc.y * tv * bev), _saturatef(tc.z * tv * bev));
        float gw = (1.0f + 4.0f * lvl) * sc / s, aw = 0.8f / s;
        float grout = 1.0f - sstep(gw - aw, gw + aw, f2 - f1);
        float3 gc = mix3a(make_float3(0.30f, 0.28f, 0.26f), make_float3(0.75f, 0.72f, 0.68f), arPaper / 100.0f);
        o = mix3a(tile, gc, grout);
    } else if (m == 8) {
        float R = (1.0f + 0.30f * arSize) * sc;
        float ra = R * _sqrtf(rnd3(x, y, sd + (uint)(bf) * 7u + 11u)), aa = 6.2831853f * rnd3(x, y, sd + (uint)(bf) * 7u + 12u);
        o = rgbAt(p_TexR, p_TexG, p_TexB, x + (int)(_round(ra * _cosf(aa))), y + (int)(_round(ra * _sinf(aa))), W, H);
    } else {
        float n = 2.0f + _floorf(lvl * 4.0f + 0.5f);
        int cell = (int)(1.0f + sc);
        float t = bayer8((int)(x / cell), (int)(y / cell));
        float lv = n - 1.0f;
        o = make_float3(_floorf(_saturatef(c0.x) * lv + t) / lv, _floorf(_saturatef(c0.y) * lv + t) / lv, _floorf(_saturatef(c0.z) * lv + t) / lv);
    }
    float a = arAmount / 100.0f;
    return make_float3(_saturatef(lerp1(c0.x, o.x, a)), _saturatef(lerp1(c0.y, o.y, a)), _saturatef(lerp1(c0.z, o.z, a)));
}
