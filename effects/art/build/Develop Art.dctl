        float3 bl = cross5(p_TexR, p_TexG, p_TexB, x, y, W, H, (int)(12.0f * sc + 0.5f));
        float L = luma(t.x, t.y, t.z), Lb = luma(bl.x, bl.y, bl.z);
        float dark = _saturatef((1.0f - L) * (0.7f + 0.6f * lvl));
        float ca = _cosf(an), sa = _sinf(an);
        float u = (fx * ca + fy * sa) / sp + Lb * 6.0f;
        float d = _fabs(fr1(u) - 0.5f), w = 0.7f / sp;
        float ink = 1.0f - sstep(0.5f * _powf(dark, 0.9f) - w, 0.5f * _powf(dark, 0.9f) + w, d);
        ink *= sstep(0.0f, 0.03f, dark);
        float a2 = an + 1.2217f, u2 = (fx * _cosf(a2) + fy * _sinf(a2)) / sp + Lb * 4.0f;
        float d2 = _fabs(fr1(u2) - 0.5f), h2 = 0.5f * _saturatef((dark - 0.6f) / 0.4f);
        ink = _fmaxf(ink, (1.0f - sstep(h2 - w, h2 + w, d2)) * sstep(0.6f, 0.65f, dark));
        float3 sepia = mix3a(make_float3(0.16f, 0.10f, 0.06f), make_float3(c0.x * 0.4f, c0.y * 0.4f, c0.z * 0.4f), col);
        o = mix3a(make_float3(paper0.x, paper0.y * 0.985f, paper0.z * 0.94f), sepia, ink);
    } else if (m == 5) {
        float e = edgeAt(p_TexR, p_TexG, p_TexB, x, y, W, H, (int)(1.5f * sc + 0.5f));
        float jit = (fbm(fx / (40.0f * sc), fy / (40.0f * sc), bt, 2, sd + 5u) - 0.5f) * 0.05f;
        float line = sstep(0.03f + jit, 0.03f + jit + 0.18f * (1.2f - lvl), e);
        float3 t = cross5(p_TexR, p_TexG, p_TexB, x, y, W, H, (int)(3.0f * sc + 0.5f));
        float dark = 1.0f - luma(t.x, t.y, t.z);
        float sp = (3.0f + 0.10f * arSize) * sc;
        float hatch = handLines(fx, fy, an, sp, 0.12f, bt, sc, sd + 41u) * sstep(0.45f, 0.75f, dark) * 0.55f;
        float shade = 0.15f * sstep(0.2f, 0.9f, dark);
        float g = _fmaxf(_fmaxf(line, hatch), shade);
        float3 graph = mix3a(make_float3(0.22f, 0.22f, 0.24f), make_float3(c0.x * 0.5f, c0.y * 0.5f, c0.z * 0.5f), col);
        o = mix3a(paper, graph, g * 0.9f);
    } else if (m == 6) {
        float3 s = cross5(p_TexR, p_TexG, p_TexB, x, y, W, H, (int)(2.5f * sc + 0.5f));
        float3 s2 = cross5(p_TexR, p_TexG, p_TexB, x, y, W, H, (int)(5.0f * sc + 0.5f));
        s = make_float3(0.5f * (s.x + s2.x), 0.5f * (s.y + s2.y), 0.5f * (s.z + s2.z));
        float L = luma(s.x, s.y, s.z);
        float n = 3.0f + _floorf(lvl * 5.0f + 0.5f);
        float Lq = (_floorf(L * n) + 0.6f) / n;
        float k = Lq / _fmaxf(L, 0.02f);
        float3 q = make_float3(s.x * k, s.y * k, s.z * k);
        float Lqq = luma(q.x, q.y, q.z), st = 1.0f + 0.5f * col;
        q = make_float3(_saturatef(Lqq + (q.x - Lqq) * st), _saturatef(Lqq + (q.y - Lqq) * st), _saturatef(Lqq + (q.z - Lqq) * st));
