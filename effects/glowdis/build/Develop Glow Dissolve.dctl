                ag += fall * lerp1(tl.y * 0.6f + 0.4f * (tl.x + tl.y + tl.z) / 3.0f, hc.y * (tl.x + tl.y + tl.z) / 3.0f, rb);
                ab += fall * lerp1(tl.z * 0.6f + 0.4f * (tl.x + tl.y + tl.z) / 3.0f, hc.z * (tl.x + tl.y + tl.z) / 3.0f, rb);
