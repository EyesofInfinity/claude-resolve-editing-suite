__DEVICE__ float boltG(float x, float y, float ax, float ay, float bx, float by, float chaos, float z, uint s)
{
    float dx = bx - ax, dy = by - ay, L = _sqrtf(dx * dx + dy * dy) + 1e-5f;
    float ux = dx / L, uy = dy / L;
    float t = ((x - ax) * ux + (y - ay) * uy) / L;
    if (t < 0.0f || t > 1.0f) return 1e3f;
    float perp = (x - ax) * -uy + (y - ay) * ux;
    float pin = _sinf(3.1415927f * t);
    float off = 0.0f, amp = 0.16f * chaos * L, f = 3.0f;
    for (int o = 0; o < 5; o++) {
        off += amp * (vnoise3(t * f + 37.0f * (float)(o) + 1000.0f, z + 1000.0f, 0.0f, s + (uint)(o)) - 0.5f);
        amp *= 0.5f; f *= 2.3f;
    }
    return _fabs(perp - off * pin);
}

__DEVICE__ float3 ownLightG(int st, float x, float y, float aspect, float p, float sz, float cx, float cy, float ang,
                            float3 hc, uint seed)
{
    float szs = 0.5f + sz;
    if (st == 4) {
        float cs = 0.1f, ar = 0.0f;
        int gx = (int)(_floorf(x / cs)), gy = (int)(_floorf(y / cs));
        for (int cb = 0; cb < 18; cb++) {
            int i = cb % 3 - 1, j = (cb / 3) % 3 - 1;
            uint ux = (uint)(gx + i + 4096), uy = (uint)(gy + j + 4096) + (uint)(cb / 9) * 8192u;
            {
                if (hash01(ux, uy, seed + 11u) < 0.3f) continue;
                float u = 2.0f * hash01(ux, uy, seed + 12u) - 1.0f;
                float ti = 0.5f + 0.4f * (u < 0.0f ? -1.0f : 1.0f) * _powf(_fabs(u), 1.6f);
                float q = p - ti;
                float f = q >= 0.0f ? _expf(-q / 0.03f) : _expf(-(q / 0.006f) * (q / 0.006f));
                if (f < 0.002f) continue;
                float bx = ((float)(gx + i) + 0.1f + 0.8f * hash01(ux, uy, seed + 13u)) * cs;
                float by = ((float)(gy + j) + 0.1f + 0.8f * hash01(ux, uy, seed + 14u)) * cs;
                float dx = x - bx, dy = y - by, d = _sqrtf(dx * dx + dy * dy);
                float win = 1.0f - sstep(0.065f, 0.1f, d);
                if (win <= 0.0f) continue;
                float core = _expf(-(d / (0.008f * szs)) * (d / (0.008f * szs)));
                float halo = _expf(-d / (0.02f * szs)), bloom = _expf(-(d / (0.04f * szs)) * (d / (0.04f * szs)));
                float cross = _expf(-(dy / 0.002f) * (dy / 0.002f)) * _expf(-_fabs(dx) / (0.022f * szs))
                            + _expf(-(dx / 0.002f) * (dx / 0.002f)) * _expf(-_fabs(dy) / (0.022f * szs));
                ar += win * f * (0.6f + 0.4f * hash01(ux, uy, seed + 15u)) * (3.0f * core + 0.8f * halo + 0.35f * bloom + 0.6f * cross);
            }
        }
        return make_float3(ar, ar * 0.97f, ar * 0.9f);
    }
    if (st == 5) {
        float strike = _floorf(p * 7.0f), since = p * 7.0f - strike;
        float flick = 0.55f + 0.45f * _expf(-4.0f * since);
        float w = 0.0008f + 0.0016f * sz, d = 1e3f;
        uint us = (uint)(strike) + 50u;
        for (int k = 0; k < 3; k++) {
            float ax = 0.4f * aspect * hash01(us, (uint)(k), seed + 21u), ay = hash01(us, (uint)(k), seed + 22u);
            float bx = aspect * (0.6f + 0.4f * hash01(us, (uint)(k), seed + 23u)), by = hash01(us, (uint)(k), seed + 24u);
            d = _fminf(d, boltG(x, y, ax, ay, bx, by, 0.8f, strike * 3.1f + (float)(k) * 5.0f, seed + 30u + (uint)(k) * 7u) * (k == 0 ? 1.0f : 1.4f));
        }
        float core = _expf(-(d / w) * (d / w)), glow = _expf(-d / (w * 9.0f));
        return make_float3(flick * (2.5f * core + 0.9f * glow * hc.x), flick * (2.5f * core + 0.9f * glow * hc.y), flick * (2.5f * core + 0.9f * glow * hc.z));
    }
    float ca = _cosf(ang), sa = _sinf(ang), tr = 0.9f * aspect + 0.3f;
    float sx = cx + (p - 0.5f) * tr * ca, sy = cy + (p - 0.5f) * tr * sa;
    float vx = 0.5f * aspect - sx, vy = 0.5f - sy;
    float dx = x - sx, dy = y - sy, d0 = _sqrtf(dx * dx + dy * dy);
    float core = 3.0f * _expf(-(d0 / (0.016f * szs)) * (d0 / (0.016f * szs))) + 0.8f * _expf(-d0 / (0.08f * szs))
               + 0.35f * _expf(-(d0 / (0.3f * szs)) * (d0 / (0.3f * szs)));
    float streak = 0.9f * _expf(-(dy / (0.0035f * szs)) * (dy / (0.0035f * szs))) * _expf(-_fabs(dx) / (0.45f * szs));
    float ar = core + streak * lerp1(1.0f, hc.x, 0.6f), ag = core + streak * lerp1(1.0f, hc.y, 0.6f), ab = core + streak * lerp1(1.0f, hc.z, 0.6f);
    for (int k = 0; k < 5; k++) {
        float m = k == 0 ? 0.35f : (k == 1 ? 0.7f : (k == 2 ? 1.15f : (k == 3 ? 1.45f : 1.9f)));
        float rg = (k == 0 ? 0.03f : (k == 1 ? 0.06f : (k == 2 ? 0.02f : (k == 3 ? 0.1f : 0.045f)))) * szs;
        float gx = x - (sx + vx * m), gy = y - (sy + vy * m), dg = _sqrtf(gx * gx + gy * gy);
        if (dg > rg * 1.4f) continue;
        float q = dg / (rg * aperture(_atan2f(gy, gx), 6.0f, 0.3f, 0.25f));
        float disc = (1.0f - sstep(0.8f, 1.0f, q)) * 0.5f + _expf(-((q - 0.95f) / 0.06f) * ((q - 0.95f) / 0.06f)) * 0.5f;
        float3 c = specL(0.15f + 0.21f * (float)(k));
        ar += 0.3f * disc * (0.3f + c.x); ag += 0.3f * disc * (0.3f + c.y); ab += 0.3f * disc * (0.3f + c.z);
    }
    float hr = 0.32f * szs, ring = _expf(-((d0 - hr) / (0.02f * szs)) * ((d0 - hr) / (0.02f * szs)));
    float3 rc = specL(0.55f + 1.5f * (d0 - hr) / hr);
    ar += 0.1f * ring * rc.x; ag += 0.1f * ring * rc.y; ab += 0.1f * ring * rc.z;
    return make_float3(ar, ag, ab);
}

__DEVICE__ float4 transition(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_FromTexR, __TEXTURE__ p_FromTexG, __TEXTURE__ p_FromTexB, __TEXTURE__ p_FromTexA, __TEXTURE__ p_ToTexR, __TEXTURE__ p_ToTexG, __TEXTURE__ p_ToTexB, __TEXTURE__ p_ToTexA)
{
    float p = _saturatef(TRANSITION_PROGRESS);
    float da = _tex2D(p_FromTexR, p_X, p_Y), dg = _tex2D(p_FromTexG, p_X, p_Y), db = _tex2D(p_FromTexB, p_X, p_Y);
    float ea = _tex2D(p_ToTexR, p_X, p_Y), eg = _tex2D(p_ToTexG, p_X, p_Y), eb = _tex2D(p_ToTexB, p_X, p_Y);
    if (p <= 0.0f) return make_float4(da, dg, db, 1.0f);
    if (p >= 1.0f) return make_float4(ea, eg, eb, 1.0f);
    int W = p_Width, H = p_Height;
    float hh = (float)(H), aspect = (float)(W) / hh;
    float x = ((float)(p_X) + 0.5f) / hh, y = ((float)(p_Y) + 0.5f) / hh;
    int st = (int)(gdStyle + 0.5f);
    uint seed = (uint)(gdSeed) * 131u + 7u;
    float amt = gdLight / 100.0f, sz = gdSize / 100.0f, thr = gdThresh / 100.0f, tw = gdTint / 100.0f;
    float ang = gdAngle * 0.0174533f;
    float3 hc = hueG(gdHue);
    float taper = sstep(0.0f, 0.12f, p) * sstep(0.0f, 0.12f, 1.0f - p);
    float sn = _sinf(3.1415927f * p), ev = sn * sn * taper;
    float bl = 0.015f + 0.3f * gdBlend / 100.0f;
    float swap = sstep(0.5f - bl, 0.5f + bl, p);
    float lr = 0.0f, lg = 0.0f, lb = 0.0f, e = ev * amt;
    float r, g, b;
    if (st == 8) {
        float ca = _cosf(ang), sa = _sinf(ang);
        float ext = 0.5f * (_fabs(ca) * aspect + _fabs(sa));
        float u = ((x - 0.5f * aspect) * ca + (y - 0.5f) * sa) / (2.0f * ext) + 0.5f;
        float bw = 0.02f + 0.12f * sz, front = -0.3f + 1.6f * p;
        float wb = 1.0f - sstep(front - 0.5f * bw, front + 0.5f * bw, u);
        float mr = lerp1(da, ea, wb), mg = lerp1(dg, eg, wb), mb = lerp1(db, eb, wb);
        r = toLin(mr); g = toLin(mg); b = toLin(mb);
        float band = _expf(-((u - front) / bw) * ((u - front) / bw));
        float wide = _expf(-((u - front) / (3.0f * bw)) * ((u - front) / (3.0f * bw)));
        float line = _expf(-((u - front) / (0.08f * bw)) * ((u - front) / (0.08f * bw)));
        float ex = 1.0f + (8.0f * band + 1.2f * wide) * amt;
        r *= ex; g *= ex; b *= ex;
        float lit = band * 2.2f * brightG(luma(mr, mg, mb), thr * 0.6f) + 1.0f * line;
        lr = lit * (r * 0.5f + 0.5f); lg = lit * (g * 0.5f + 0.5f); lb = lit * (b * 0.5f + 0.5f);
        e = amt;
    } else {
        r = toLin(lerp1(da, ea, swap)); g = toLin(lerp1(dg, eg, swap)); b = toLin(lerp1(db, eb, swap));
        if (st == 4 || st == 5 || st == 7) {
            float3 o = ownLightG(st, x, y, aspect, p, sz, gdCX / 100.0f * aspect, gdCY / 100.0f, ang, hc, seed);
            lr = o.x; lg = o.y; lb = o.z;
            if (st == 7) e = _powf(sn, 1.2f) * taper * amt;
        } else {
            float cx = gdCX / 100.0f * (float)(W), cy = gdCY / 100.0f * hh;
            int arms = (int)(gdPoints + 0.5f);
            float rbw = gdRainbow / 100.0f;
            if (swap < 1.0f) {
                float3 o = shotLightG(st, p_FromTexR, p_FromTexG, p_FromTexB, p_X, p_Y, W, H, ev, thr, sz, cx, cy, ang, arms, rbw, p, seed);
                lr += (1.0f - swap) * o.x; lg += (1.0f - swap) * o.y; lb += (1.0f - swap) * o.z;
            }
            if (swap > 0.0f) {
                float3 o = shotLightG(st, p_ToTexR, p_ToTexG, p_ToTexB, p_X, p_Y, W, H, ev, thr, sz, cx, cy, ang, arms, rbw, p, seed);
                lr += swap * o.x; lg += swap * o.y; lb += swap * o.z;
            }
        }
    }
    if (st != 5 && tw > 0.0f) {
        float m = (lr + lg + lb) * 0.55f;
        lr = lerp1(lr, m * hc.x, tw); lg = lerp1(lg, m * hc.y, tw); lb = lerp1(lb, m * hc.z, tw);
    }
    float wash = st == 8 ? 0.0f : gdWash / 100.0f * e;
    if (st == 4) wash *= 0.6f + 0.8f * vnoise3(p * 120.0f + 1000.0f, 3.5f, 0.5f, seed + 40u);
    float wr = lerp1(1.0f, hc.x, tw), wg = lerp1(0.96f, hc.y, tw), wbl = lerp1(0.9f, hc.z, tw);
    float ex = 1.0f + 3.0f * wash, wc = _fminf(wash, 1.0f) * 0.5f;
    r = r * ex * lerp1(1.0f, wr, wc) + lr * e;
    g = g * ex * lerp1(1.0f, wg, wc) + lg * e;
    b = b * ex * lerp1(1.0f, wbl, wc) + lb * e;
    float3 o = lightOut(r, g, b, _saturatef((lr + lg + lb) * e + 3.0f * wash));
    return make_float4(o.x, o.y, o.z, 1.0f);
}
