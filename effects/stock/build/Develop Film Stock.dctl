// Develop Film Stock: a library of film characters. Our own stocks, built from what each kind of film does, named by character, not after any maker's product:
//   0 Daylight Negative: a soft warm negative, gentle toe, cream highlights, greens kept natural.
//   1 Tungsten Night: a tungsten-balanced negative under mixed light: teal shadows, warm practicals.
//   2 Vivid Slide: a saturated reversal film: hard, deep blues and greens, no lifted black.
//   3 Portrait Negative: low contrast and low saturation, pastel highlights, kind to skin.
//   4 Faded Print: a 1970s print whose cyan dye has faded: red and magenta mids, lifted purple blacks, low colour.
//   5 Home Movie: small-gauge reversal: warm, contrasty, a dark round gate.
//   6 Expired: old stock fogged green in the shadows, magenta highlights, thin colour.
//   7 Silver Mono: panchromatic black and white, a little red sensitive.
// Then the trims (Contrast, Saturation, Warmth, Fade), halation, grain sized by the stock, and Wear: a projector's
// flicker, gate weave and dust, moving by TIMELINE_FRAME_INDEX. An OpenFX DCTL effect or a DCTL plugin node. Amount
// mixes with the picture in display terms; Amount 0 is the input exactly. MIT License.

DEFINE_UI_PARAMS(fsAmount,  Film Stock,  DCTLUI_SLIDER_FLOAT, 100.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(fsStock,   Stock,       DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 7.0, 1.0)
DEFINE_UI_PARAMS(fsCon,     Contrast,    DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(fsSat,     Saturation,  DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(fsWarm,    Warmth,      DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(fsFade,    Fade,        DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(fsHal,     Halation,    DCTLUI_SLIDER_FLOAT, 30.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(fsGrain,   Grain,       DCTLUI_SLIDER_FLOAT, 30.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(fsWear,    Wear,        DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(fsSeed,    Seed,        DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)

DEFINE_UI_TOOLTIP(Stock, "0 Daylight Negative, 1 Tungsten Night, 2 Vivid Slide, 3 Portrait Negative, 4 Faded Print, 5 Home Movie, 6 Expired, 7 Silver Mono")
DEFINE_UI_TOOLTIP(Wear, "A projector's flicker, gate weave and dust")

// Develop stock: shared code of Develop Process and Develop Film Stock, on top of light.h (gamma, hash, noise)
// and glitch.h (clamped sampling). Rec.709 gamma 2.4 in and out; colour is mixed in linear, curves run on display
// values. Parametric curves only: no measured stock data, no LUT, nothing taken from any vendor. MIT License.

// Develop light: the shared code of Develop Leak, Develop Burn and Develop Light Dissolve.
// build.py writes it into each effect, so every installed .dctl stands alone. Rec.709 gamma 2.4 in and out;
// light is added in linear. Coordinates are in frame heights (y 0 to 1 top to bottom, x 0 to width/height),
// so a leak keeps its shape at any resolution and aspect. MIT License.

__DEVICE__ float toLin(float x) { return _powf(_fmaxf(x, 0.0f), 2.4f); }
__DEVICE__ float toDisp(float x) { return _powf(_fmaxf(x, 0.0f), 1.0f / 2.4f); }
__DEVICE__ float luma(float r, float g, float b) { return 0.2126f * r + 0.7152f * g + 0.0722f * b; }
__DEVICE__ float lerp1(float a, float b, float t) { return a + (b - a) * t; }
__DEVICE__ float sstep(float a, float b, float x) { float t = _saturatef((x - a) / (b - a)); return t * t * (3.0f - 2.0f * t); }

__DEVICE__ float3 shoulder(float r, float g, float b)
{
    float m = _fmaxf(r, _fmaxf(g, b));
    if (m <= 0.8f) return make_float3(r, g, b);
    float nm = 0.8f + 0.2f * _tanhf((m - 0.8f) / 0.2f);
    float k = nm / m, w = 0.6f * sstep(1.0f, 3.0f, m);
    return make_float3(lerp1(r * k, nm, w), lerp1(g * k, nm, w), lerp1(b * k, nm, w));
}

__DEVICE__ float3 lightOut(float r, float g, float b, float k)
{
    float3 s = shoulder(r, g, b);
    float w = _saturatef(k * 4.0f);
    return make_float3(_saturatef(toDisp(lerp1(r, s.x, w))), _saturatef(toDisp(lerp1(g, s.y, w))), _saturatef(toDisp(lerp1(b, s.z, w))));
}

__DEVICE__ float hash01(uint x, uint y, uint z)
{
    x = x * 1664525u + 1013904223u; y = y * 1664525u + 1013904223u; z = z * 1664525u + 1013904223u;
    x += y * z; y += z * x; z += x * y;
    x ^= x >> 16u; y ^= y >> 16u; z ^= z >> 16u;
    x += y * z; y += z * x; z += x * y;
    return (float)(x >> 8u) * (1.0f / 16777216.0f);
}

__DEVICE__ float fade(float t) { return t * t * t * (t * (t * 6.0f - 15.0f) + 10.0f); }

__DEVICE__ float vnoise3(float x, float y, float z, uint s)
{
    int ix = (int)(x), iy = (int)(y), iz = (int)(z);
    float tx = fade(x - (float)(ix)), ty = fade(y - (float)(iy)), tz = fade(z - (float)(iz));
    uint x0 = (uint)(ix), y0 = (uint)(iy), z0 = (uint)(iz) + s * 7919u;
    float a0 = lerp1(lerp1(hash01(x0, y0, z0), hash01(x0 + 1u, y0, z0), tx), lerp1(hash01(x0, y0 + 1u, z0), hash01(x0 + 1u, y0 + 1u, z0), tx), ty);
    float a1 = lerp1(lerp1(hash01(x0, y0, z0 + 1u), hash01(x0 + 1u, y0, z0 + 1u), tx), lerp1(hash01(x0, y0 + 1u, z0 + 1u), hash01(x0 + 1u, y0 + 1u, z0 + 1u), tx), ty);
    return lerp1(a0, a1, tz);
}

__DEVICE__ float fbm(float x, float y, float z, int n, uint s)
{
    float sum = 0.0f, amp = 0.5f, tot = 0.0f, f = 1.0f;
    for (int i = 0; i < 5; i++) {
        if (i >= n) break;
        sum += amp * vnoise3(x * f + 4096.0f + 37.1f * (float)(i), y * f + 4096.0f + 11.7f * (float)(i), z * f + 4096.0f, s + (uint)(i));
        tot += amp; amp *= 0.5f; f *= 2.03f;
    }
    float v = sum / tot;
    return _saturatef((v - 0.5f) * 1.6f + 0.5f);
}

__DEVICE__ float3 ramp(float pal, float t, float age)
{
    int p = (int)(pal + 0.5f);
    float c0r = 0.30f, c0g = 0.10f, c0b = 0.42f, c1r = 0.62f, c1g = 0.35f, c1b = 0.47f, c2r = 0.86f, c2g = 0.76f, c2b = 0.68f;
    float h0r = 0.73f, h0g = 0.16f, h0b = 0.26f, h1r = 0.89f, h1g = 0.35f, h1b = 0.17f, h2r = 0.94f, h2g = 0.50f, h2b = 0.22f;
    if (p == 1) {
        c0r = 0.45f; c0g = 0.08f; c0b = 0.05f; c1r = 0.85f; c1g = 0.30f; c1b = 0.08f; c2r = 0.98f; c2g = 0.70f; c2b = 0.35f;
        h0r = 0.80f; h0g = 0.20f; h0b = 0.04f; h1r = 0.98f; h1g = 0.55f; h1b = 0.12f; h2r = 1.00f; h2g = 0.85f; h2b = 0.55f;
    }
    if (p == 2) {
        c0r = 0.18f; c0g = 0.10f; c0b = 0.45f; c1r = 0.65f; c1g = 0.25f; c1b = 0.65f; c2r = 0.95f; c2g = 0.70f; c2b = 0.75f;
        h0r = 0.70f; h0g = 0.15f; h0b = 0.50f; h1r = 0.95f; h1g = 0.45f; h1b = 0.45f; h2r = 1.00f; h2g = 0.75f; h2b = 0.55f;
    }
    if (p == 3) {
        c0r = 0.05f; c0g = 0.10f; c0b = 0.35f; c1r = 0.15f; c1g = 0.40f; c1b = 0.75f; c2r = 0.70f; c2g = 0.85f; c2b = 0.98f;
        h0r = 0.10f; h0g = 0.25f; h0b = 0.60f; h1r = 0.35f; h1g = 0.65f; h1b = 0.95f; h2r = 0.85f; h2g = 0.95f; h2b = 1.00f;
    }
    float a = _saturatef(age);
    float r0 = lerp1(c0r, h0r, a), g0 = lerp1(c0g, h0g, a), b0 = lerp1(c0b, h0b, a);
    float r1 = lerp1(c1r, h1r, a), g1 = lerp1(c1g, h1g, a), b1 = lerp1(c1b, h1b, a);
    float r2 = lerp1(c2r, h2r, a), g2 = lerp1(c2g, h2g, a), b2 = lerp1(c2b, h2b, a);
    float u = _saturatef(t);
    float r, g, b;
    if (u < 0.5f) { float k = u * 2.0f; r = lerp1(r0, r1, k); g = lerp1(g0, g1, k); b = lerp1(b0, b1, k); }
    else { float k = u * 2.0f - 1.0f; r = lerp1(r1, r2, k); g = lerp1(g1, g2, k); b = lerp1(b1, b2, k); }
    float hot = sstep(1.0f, 1.4f, t);
    return make_float3(toLin(lerp1(r, 1.0f, hot)), toLin(lerp1(g, 0.96f, hot)), toLin(lerp1(b, 0.90f, hot)));
}

__DEVICE__ float leakField(float x, float y, float aspect, float deg, float w, float sc, float z, uint s)
{
    float a = deg * 0.0174533f, ca = _cosf(a), sa = _sinf(a);
    float ext = 0.5f * (_fabs(ca) * aspect + _fabs(sa));
    float sproj = (x - 0.5f * aspect) * ca + (y - 0.5f) * sa;
    float warp = fbm(x * 1.3f, y * 1.3f, z * 0.35f, 2, s + 40u) - 0.5f;
    float d = _fmaxf(ext - sproj + 0.45f * warp * w * aspect, 0.0f);
    float reach = _fmaxf(w * aspect, 0.02f);
    float e = _expf(-(d / reach) * (d / reach));
    float cloud = fbm(x / sc, y / sc, z, 3, s);
    return _saturatef(e * (0.35f + 1.3f * cloud));
}

__DEVICE__ float burnHeat(float x, float y, float cover, float sc, float z, uint s)
{
    float wx = fbm(x / sc * 0.7f, y / sc * 0.7f, z * 0.6f, 2, s + 90u) - 0.5f;
    float wy = fbm(x / sc * 0.7f + 31.0f, y / sc * 0.7f, z * 0.6f, 2, s + 91u) - 0.5f;
    float h = fbm((x + 0.6f * wx) / sc, (y + 0.6f * wy) / sc, z, 4, s);
    float th = 1.0f - cover;
    return _saturatef((h - th + 0.28f) / 0.62f);
}

__DEVICE__ float dust(int px, int py, int h, float amount, uint z)
{
    float sc = (float)(h) / 1080.0f;
    int cx = (int)((float)(px) / (2.5f * sc)), cy = (int)((float)(py) / (2.5f * sc));
    float r = hash01((uint)(cx), (uint)(cy), z * 13u + 5u);
    float lim = 0.00002f * amount;
    if (r > lim) return 0.0f;
    return hash01((uint)(cx), (uint)(cy), z * 13u + 6u) < 0.6f ? -1.0f : 1.0f;
}

__DEVICE__ float4 burnOver(float r, float g, float b, float x, float y, float aspect, int px, int py, int ph,
                           float cover, float pal, float age, float sc, float show, float grain, float dst,
                           float z, uint fz, uint s)
{
    float k = sstep(0.0f, 0.35f, burnHeat(x, y, cover, sc, z, s));
    uint zi = (uint)(z + 1000.0f);
    float ang = 6.2831853f * ((float)(zi % 1000u) * 0.37f + 0.25f * hash01(zi, s, 71u));
    float ca = _cosf(ang), sa = _sinf(ang), ext = 0.5f * (_fabs(ca) * aspect + _fabs(sa));
    float band = 0.5f + 0.5f * ((x - 0.5f * aspect) * ca + (y - 0.5f) * sa) / ext;
    float cl = fbm(x / (sc * 1.6f), y / (sc * 1.6f), z, 3, s + 200u);
    float t = 0.05f + 0.95f * _saturatef(0.8f * band + 0.95f * (cl - 0.5f) + 0.15f);
    float3 c = ramp(pal, t, age);
    float keep = lerp1(1.0f, show, k);
    float gr = 1.0f + grain * 0.22f * (hash01((uint)(px), (uint)(py), fz * 3u + s) - 0.5f) * k;
    float d = dust(px, py, ph, dst * 100.0f, fz + s) * k;
    float rr = (r * keep + c.x * k) * gr, gg = (g * keep + c.y * k) * gr, bb = (b * keep + c.z * k) * gr;
    if (d < 0.0f) { rr *= 0.15f; gg *= 0.12f; bb *= 0.12f; }
    if (d > 0.0f) { rr = rr + 0.6f; gg = gg + 0.55f; bb = bb + 0.45f; }
    return make_float4(rr, gg, bb, k);
}
// Develop glitch: shared code of the glitch effects, on top of light.h's hash and helpers. MIT License.

__DEVICE__ int clampi(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }

__DEVICE__ float3 rgbAt(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, int x, int y, int w, int h)
{
    int cx = clampi(x, 0, w - 1), cy = clampi(y, 0, h - 1);
    return make_float3(_tex2D(tr, cx, cy), _tex2D(tg, cx, cy), _tex2D(tb, cx, cy));
}

__DEVICE__ float lumaAt(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, int x, int y, int w, int h)
{
    float3 c = rgbAt(tr, tg, tb, x, y, w, h);
    return luma(c.x, c.y, c.z);
}

__DEVICE__ float rnd3(int a, int b, uint c) { return hash01((uint)(a + 65536), (uint)(b + 65536), c); }

__DEVICE__ float bayer8(int cx, int cy)
{
    int bx = cx & 7, by = cy & 7, xr = bx ^ by;
    int v = ((xr & 1) << 5) | ((by & 1) << 4) | ((xr & 2) << 2) | ((by & 2) << 1) | ((xr & 4) >> 1) | ((by & 4) >> 2);
    return ((float)(v) + 0.5f) / 64.0f;
}

__DEVICE__ float3 gritFinish(float3 c, int x, int y, int h, float g, float grit, float dith, uint seed)
{
    if (g <= 0.0f) return c;
    float L = luma(c.x, c.y, c.z);
    float n = hash01((uint)(x + 65536), (uint)(y + 65536), seed) - 0.5f;
    float gr = grit * g * 0.16f * (0.35f + 0.65f * L) * n;
    float r = c.x + gr, gg = c.y + gr, b = c.z + gr;
    float d = dith * g;
    if (d > 0.0f) {
        int cell = (int)(2.0f * (float)(h) / 1080.0f + 0.5f);
        if (cell < 1) cell = 1;
        float t = bayer8((int)(x / cell), (int)(y / cell));
        float lv = 32.0f * (1.0f - d) + 3.0f * d - 1.0f;
        r = _floorf(_saturatef(r) * lv + t) / lv; gg = _floorf(_saturatef(gg) * lv + t) / lv; b = _floorf(_saturatef(b) * lv + t) / lv;
    }
    return make_float3(_saturatef(r), _saturatef(gg), _saturatef(b));
}

__DEVICE__ float3 chromaBleed(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, float3 c, int x, int y, int w, int h, int k)
{
    if (k < 1) return c;
    float3 a = rgbAt(tr, tg, tb, x - k, y, w, h), b = rgbAt(tr, tg, tb, x - (int)(k / 2), y, w, h);
    float3 m = make_float3((a.x + b.x + c.x) / 3.0f, (a.y + b.y + c.y) / 3.0f, (a.z + b.z + c.z) / 3.0f);
    float L = luma(c.x, c.y, c.z), Lm = luma(m.x, m.y, m.z);
    return make_float3(m.x - Lm + L, m.y - Lm + L, m.z - Lm + L);
}

__DEVICE__ float3 lin3(float3 c) { return make_float3(toLin(c.x), toLin(c.y), toLin(c.z)); }
__DEVICE__ float3 disp3(float3 c) { return make_float3(toDisp(c.x), toDisp(c.y), toDisp(c.z)); }
__DEVICE__ float3 sat3(float3 c) { return make_float3(_saturatef(c.x), _saturatef(c.y), _saturatef(c.z)); }
__DEVICE__ float3 mix3(float3 a, float3 b, float t) { return make_float3(lerp1(a.x, b.x, t), lerp1(a.y, b.y, t), lerp1(a.z, b.z, t)); }

__DEVICE__ float sCurve(float v, float a, float p)
{
    if (_fabs(a) < 0.01f) return v;
    float u = _saturatef(v);
    if (a > 0.0f) {
        float lo = 1.0f / (1.0f + _expf(a * p)), hi = 1.0f / (1.0f + _expf(-a * (1.0f - p)));
        return (1.0f / (1.0f + _expf(-a * (u - p))) - lo) / (hi - lo);
    }
    float b = -a;
    float lo = 1.0f / (1.0f + _expf(b * p)), hi = 1.0f / (1.0f + _expf(-b * (1.0f - p)));
    float s = lo + u * (hi - lo);
    return _saturatef(p - _logf(1.0f / s - 1.0f) / b);
}

__DEVICE__ float3 satLin(float3 c, float s)
{
    float L = luma(c.x, c.y, c.z);
    return make_float3(_fmaxf(L + (c.x - L) * s, 0.0f), _fmaxf(L + (c.y - L) * s, 0.0f), _fmaxf(L + (c.z - L) * s, 0.0f));
}

__DEVICE__ float3 toneDisp(float3 v, float a, float p, float3 gam, float3 sh, float3 hi, float lift, float cap)
{
    float r = _powf(_saturatef(v.x), gam.x), g = _powf(_saturatef(v.y), gam.y), b = _powf(_saturatef(v.z), gam.z);
    r = sCurve(r, a, p); g = sCurve(g, a, p); b = sCurve(b, a, p);
    float L = luma(r, g, b), ws = (1.0f - L) * (1.0f - L), wh = L * L;
    r += sh.x * ws + hi.x * wh; g += sh.y * ws + hi.y * wh; b += sh.z * ws + hi.z * wh;
    return make_float3(lift + (cap - lift) * _saturatef(r), lift + (cap - lift) * _saturatef(g), lift + (cap - lift) * _saturatef(b));
}

__DEVICE__ float3 trims(float3 v, float con, float sat, float warm, float fade)
{
    float3 o = v;
    if (con != 0.0f) o = make_float3(sCurve(o.x, con * 0.05f, 0.46f), sCurve(o.y, con * 0.05f, 0.46f), sCurve(o.z, con * 0.05f, 0.46f));
    if (sat != 0.0f || warm != 0.0f) {
        float3 l = lin3(o);
        l = satLin(l, 1.0f + sat / 100.0f);
        float k = _exp2f(0.5f * warm / 100.0f);
        l = make_float3(l.x * k, l.y, l.z / k);
        o = sat3(disp3(l));
    }
    if (fade > 0.0f) {
        float f = fade / 100.0f, lo = 0.12f * f, hi = 1.0f - 0.10f * f;
        o = make_float3(lo + (hi - lo) * o.x, lo + (hi - lo) * o.y, lo + (hi - lo) * o.z);
    }
    return o;
}

__DEVICE__ float3 halation(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, int x, int y, int w, int h, float rad, float amt, float tint)
{
    if (amt <= 0.0f) return make_float3(0.0f, 0.0f, 0.0f);
    float s = 0.0f;
    for (int i = 0; i < 16; i++) {
        float rr = rad * _sqrtf(((float)(i) + 0.5f) / 16.0f), an = 2.3999632f * (float)(i);
        int sx = x + (int)(_round(rr * _cosf(an))), sy = y + (int)(_round(rr * _sinf(an)));
        float L = toLin(lumaAt(tr, tg, tb, sx, sy, w, h));
        s += _fmaxf(L - 0.35f, 0.0f);
    }
    s = s / 16.0f * amt;
    return make_float3(s * 1.0f, s * lerp1(0.32f, 0.9f, tint), s * lerp1(0.10f, 0.85f, tint));
}

__DEVICE__ float3 grainDisp(float3 v, int x, int y, int h, float amt, float cell, uint seed)
{
    if (amt <= 0.0f) return v;
    float sz = _fmaxf(cell * (float)(h) / 1080.0f, 1.0f);
    int cx = (int)((float)(x) / sz), cy = (int)((float)(y) / sz);
    float n = (hash01((uint)(cx + 65536), (uint)(cy + 65536), seed) + hash01((uint)(cx + 65536), (uint)(cy + 65536), seed + 1u)) - 1.0f;
    float nc = hash01((uint)(cx + 65536), (uint)(cy + 65536), seed + 2u) - 0.5f;
    float L = luma(v.x, v.y, v.z), m = 4.0f * L * (1.0f - L) * 0.7f + 0.3f;
    float k = amt * 0.11f * m;
    return make_float3(v.x + k * (n + 0.25f * nc), v.y + k * n, v.z + k * (n - 0.25f * nc));
}

__DEVICE__ float3 stockLook(int k, float3 l, float vig)
{
    float3 one = make_float3(1.0f, 1.0f, 1.0f), zero = make_float3(0.0f, 0.0f, 0.0f);
    if (k == 0) return toneDisp(disp3(satLin(l, 1.0f)), 1.6f, 0.44f, make_float3(0.96f, 1.0f, 1.07f), make_float3(-0.01f, 0.0f, 0.015f),
                                make_float3(0.035f, 0.018f, -0.03f), 0.03f, 0.96f);
    if (k == 1) return toneDisp(disp3(satLin(l, 0.92f)), 2.0f, 0.46f, make_float3(1.08f, 1.0f, 0.9f), make_float3(-0.025f, 0.02f, 0.05f),
                                make_float3(0.04f, 0.012f, -0.02f), 0.015f, 0.98f);
    if (k == 2) return toneDisp(disp3(satLin(l, 1.4f)), 3.4f, 0.47f, make_float3(1.0f, 1.0f, 0.97f), make_float3(0.0f, 0.0f, 0.012f),
                                zero, 0.0f, 1.0f);
    if (k == 3) return toneDisp(disp3(satLin(l, 0.82f)), 0.8f, 0.44f, make_float3(0.99f, 1.0f, 1.01f), zero,
                                make_float3(0.016f, 0.01f, 0.0f), 0.03f, 0.96f);
    if (k == 4) return toneDisp(disp3(satLin(l, 0.72f)), -0.8f, 0.5f, make_float3(0.84f, 1.0f, 1.03f), make_float3(0.03f, 0.0f, 0.025f),
                                make_float3(0.01f, -0.005f, -0.02f), 0.08f, 0.92f);
    if (k == 5) {
        float3 v = toneDisp(disp3(satLin(l, 1.18f)), 3.6f, 0.47f, make_float3(0.95f, 1.0f, 1.1f), make_float3(0.0f, 0.0f, 0.0f),
                            make_float3(0.03f, 0.014f, -0.02f), 0.0f, 0.98f);
        return make_float3(v.x * vig, v.y * vig, v.z * vig);
    }
    if (k == 6) return toneDisp(disp3(satLin(l, 0.7f)), 1.0f, 0.46f, make_float3(1.0f, 0.94f, 1.08f), make_float3(-0.02f, 0.06f, 0.0f),
                                make_float3(0.05f, -0.025f, 0.035f), 0.07f, 0.94f);
    float m = _fmaxf(0.36f * l.x + 0.52f * l.y + 0.12f * l.z, 0.0f);
    float3 v = toneDisp(disp3(make_float3(m, m, m)), 2.4f, 0.45f, one, zero, zero, 0.012f, 0.985f);
    return v;
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    int W = p_Width, H = p_Height, x = p_X, y = p_Y;
    float3 c0 = rgbAt(p_TexR, p_TexG, p_TexB, x, y, W, H);
    if (fsAmount <= 0.0f) return c0;
    int k = (int)(fsStock + 0.5f);
    float sc = (float)(H) / 1080.0f, wear = fsWear / 100.0f;
    int f = TIMELINE_FRAME_INDEX;
    uint sd = (uint)(fsSeed) * 977u + 29u;
    int sx = x, sy = y;
    if (wear > 0.0f) {
        float wx = (rnd3(f, 1, sd) + rnd3(f - 1, 1, sd) + rnd3(f - 2, 1, sd)) / 3.0f - 0.5f;
        float wy = (rnd3(f, 2, sd) + rnd3(f - 1, 2, sd) + rnd3(f - 2, 2, sd)) / 3.0f - 0.5f;
        sx = x + (int)(_round(wx * 6.0f * sc * wear));
        sy = y + (int)(_round(wy * 9.0f * sc * wear));
    }
    float3 c = rgbAt(p_TexR, p_TexG, p_TexB, sx, sy, W, H);
    float aspect = (float)(W) / (float)(H);
    float ux = ((float)(x) + 0.5f) / (float)(H) - 0.5f * aspect, uy = ((float)(y) + 0.5f) / (float)(H) - 0.5f;
    float rr = _sqrtf(ux * ux / (aspect * aspect * 0.25f) + uy * uy / 0.25f);
    float vig = 1.0f - 0.55f * sstep(0.55f, 1.35f, rr);
    float3 v = stockLook(k, lin3(c), vig);
    v = trims(sat3(v), fsCon, fsSat, fsWarm, fsFade);
    float hk = k == 2 ? 0.6f : (k == 7 ? 0.5f : (k == 5 ? 1.3f : 1.0f));
    float3 hl = halation(p_TexR, p_TexG, p_TexB, sx, sy, W, H, 14.0f * sc, fsHal / 100.0f * 0.6f * hk, k == 7 ? 1.0f : 0.0f);
    float3 vl = lin3(v);
    float fl = 1.0f + wear * 0.08f * (rnd3(f, 3, sd) - 0.5f);
    v = sat3(disp3(make_float3((vl.x + hl.x) * fl, (vl.y + hl.y) * fl, (vl.z + hl.z) * fl)));
    float gc = k == 2 ? 1.2f : (k == 5 ? 2.6f : (k == 6 ? 2.0f : 1.6f));
    uint fz = (uint)(f) * 7919u + sd;
    v = grainDisp(v, x, y, H, fsGrain / 100.0f, gc, fz);
    if (wear > 0.0f) {
        float d = dust(x, y, H, wear * 8.0f, (uint)(f) + sd);
        if (d < 0.0f) v = make_float3(v.x * 0.15f, v.y * 0.15f, v.z * 0.15f);
        if (d > 0.0f) v = make_float3(0.92f, 0.9f, 0.86f);
    }
    if (k == 7) { float m = luma(v.x, v.y, v.z); v = make_float3(m, m, m); }
    float a = fsAmount / 100.0f;
    return sat3(mix3(c0, sat3(v), a));
}
