__DEVICE__ float4 dvMain(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE2D__ p_FromTexR, __TEXTURE2D__ p_FromTexG, __TEXTURE2D__ p_FromTexB, __TEXTURE2D__ p_FromTexA, __TEXTURE2D__ p_ToTexR, __TEXTURE2D__ p_ToTexG, __TEXTURE2D__ p_ToTexB, __TEXTURE2D__ p_ToTexA, int dvFrame, float dvProgress, float bdStyle, float bdAmount, float bdSize, float bdAngle, float bdCX, float bdCY, float bdShutter, float bdFrames, float bdSlices, float bdGlow, float bdSeed)
