    float amt = bdAmount / 100.0f, size = bdSize / 100.0f, glow = bdGlow / 100.0f;
    float an = bdAngle * 0.0174533f, dx = _cosf(an), dy = _sinf(an);
    float cx = bdCX / 100.0f * fw - 0.5f, cy = bdCY / 100.0f * fh - 0.5f;
