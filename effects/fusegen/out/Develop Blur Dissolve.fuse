    uint sd = (uint)(bdSeed) * 197u + 23u;
    float jit = jitAt(x, y, (int)(p * bdFrames * 4.0f));
    float3 l = make_float3(0.0f, 0.0f, 0.0f);
    float k = 0.0f;
    if (st == 0) {
        float cs = (0.10f + 0.25f * size) * fh;
        float rise = p * (0.5f + 0.7f * amt) * fh;
        float gx = fx / cs, gy = (fy + rise) / cs;
        int ix = (int)(_floorf(gx)), iy = (int)(_floorf(gy));
        float z1 = -1.0f, z2 = -1.0f;
        float b1x = 0.0f, b1y = 0.0f, b1r = 1.0f, b1a = 0.0f, b1p = 0.0f, b2x = 0.0f, b2y = 0.0f, b2r = 1.0f, b2a = 0.0f, b2p = 0.0f;
        for (int oy = -1; oy <= 1; oy++) {
            for (int ox = -1; ox <= 1; ox++) {
                int ci = ix + ox, cj = iy + oy;
                uint hx = (uint)(ci + 4096), hy = (uint)(cj + 4096);
                if (hash01(hx, hy, sd) > 0.85f) continue;
                float bb = 0.03f + 0.42f * hash01(hx, hy, sd + 1u), dd = 0.70f + 0.24f * hash01(hx, hy, sd + 2u);
                float grow = sstep(bb, bb + 0.10f, p), alive = 1.0f - sstep(dd, dd + 0.025f, p);
                if (grow <= 0.0f || alive <= 0.0f) continue;
                float h3 = hash01(hx, hy, sd + 3u), h4 = hash01(hx, hy, sd + 4u), h5 = hash01(hx, hy, sd + 5u);
                float R = cs * (0.28f + 0.36f * h3) * grow;
                float wob = 0.12f * _sinf(6.2831853f * (p * 1.7f + h4));
                float bx = ((float)(ci) + 0.5f + 0.15f * (2.0f * h4 - 1.0f) + wob) * cs;
                float by = ((float)(cj) + 0.5f + 0.15f * (2.0f * h5 - 1.0f)) * cs - rise;
                float ddx = fx - bx, ddy = fy - by;
                if (ddx * ddx + ddy * ddy > (R + 1.0f) * (R + 1.0f)) continue;
                float z = hash01(hx, hy, sd + 6u);
                if (z > z1) {
                    z2 = z1; b2x = b1x; b2y = b1y; b2r = b1r; b2a = b1a; b2p = b1p;
                    z1 = z; b1x = bx; b1y = by; b1r = R; b1a = alive; b1p = h5 * 9.0f;
                } else if (z > z2) {
                    z2 = z; b2x = bx; b2y = by; b2r = R; b2a = alive; b2p = h5 * 9.0f;
                }
            }
        }
        float bgm = sstep(0.30f, 0.72f, p);
        float3 a0 = linL(p_FromTexR, p_FromTexG, p_FromTexB, fx, fy, W, H), b0 = linL(p_ToTexR, p_ToTexG, p_ToTexB, fx, fy, W, H);
        l = make_float3(lerp1(a0.x, b0.x, bgm), lerp1(a0.y, b0.y, bgm), lerp1(a0.z, b0.z, bgm));
        float lb = luma(l.x, l.y, l.z);
        if (z2 >= 0.0f) {
            float4 c = bubbleAt(p_FromTexR, p_FromTexG, p_FromTexB, p_ToTexR, p_ToTexG, p_ToTexB, fx, fy, b2x, b2y, b2r, b2a, bgm, glow, p, b2p, sd, W, H);
            l = make_float3(lerp1(l.x, c.x, c.w), lerp1(l.y, c.y, c.w), lerp1(l.z, c.z, c.w));
        }
        if (z1 >= 0.0f) {
            float4 c = bubbleAt(p_FromTexR, p_FromTexG, p_FromTexB, p_ToTexR, p_ToTexG, p_ToTexB, fx, fy, b1x, b1y, b1r, b1a, bgm, glow, p, b1p, sd, W, H);
            l = make_float3(lerp1(l.x, c.x, c.w), lerp1(l.y, c.y, c.w), lerp1(l.z, c.z, c.w));
        }
        k = _fmaxf(luma(l.x, l.y, l.z) - lb, 0.0f) * 4.0f;
    } else if (st == 2) {
        float f = p < 0.5f ? sstep(0.0f, 0.5f, p) : sstep(1.0f, 0.5f, p);
        float Rm = (0.30f + 0.25f * size) * fh, Rs = Rm / _fmaxf(f, 0.000001f);
        float th = 3.1415927f * sstep(0.25f, 0.75f, p), ct = _cosf(th), stt = _sinf(th);
        float skr = 1.0f - 0.38f * f * f;
        float mxc = 0.5f * fw - 0.5f, myc = 0.5f * fh - 0.5f;
        float bgm = sstep(0.35f, 0.65f, p);
        float d0 = _sqrtf((fx - mxc) * (fx - mxc) + (fy - myc) * (fy - myc));
        float3 bgc = make_float3(0.0f, 0.0f, 0.0f);
        if (d0 > Rs - 2.0f) {
            float br = (6.0f + 30.0f * f) * sc, dim = lerp1(1.0f, 0.3f, f);
            float3 ba = lensBlur0(p_FromTexR, p_FromTexG, p_FromTexB, fx, fy, br, jit, W, H);
            float3 bb = lensBlur0(p_ToTexR, p_ToTexG, p_ToTexB, fx, fy, br, jit, W, H);
            bgc = make_float3(lerp1(ba.x, bb.x, bgm) * dim, lerp1(ba.y, bb.y, bgm) * dim, lerp1(ba.z, bb.z, bgm) * dim);
        }
        float lx = -0.45f, ly = -0.55f, lz = 0.70f, ll = _sqrtf(lx * lx + ly * ly + lz * lz);
        lx /= ll; ly /= ll; lz /= ll;
        float hx = lx, hy = ly, hz = lz + 1.0f, hl = _sqrtf(hx * hx + hy * hy + hz * hz);
        hx /= hl; hy /= hl; hz /= hl;
        float sr = 0.0f, sg = 0.0f, sb = 0.0f, spec = 0.0f;
        for (int s = 0; s < 4; s++) {
            float ox = s == 0 ? -0.125f : (s == 1 ? 0.375f : (s == 2 ? 0.125f : -0.375f));
            float oy = s == 0 ? -0.375f : (s == 1 ? -0.125f : (s == 2 ? 0.375f : 0.125f));
            float ux = fx + ox - mxc, uy = fy + oy - myc, d = _sqrtf(ux * ux + uy * uy);
            float cov = _saturatef((Rs - d) / 1.2f + 0.5f);
            float3 c = bgc;
            if (cov > 0.0f) {
                float nx = ux / Rs, ny = uy / Rs, nz = _sqrtf(_fmaxf(1.0f - nx * nx - ny * ny, 0.0f));
                float rx = nx * ct + nz * stt, ry = ny, rz = -nx * stt + nz * ct;
                float lxy = _sqrtf(rx * rx + ry * ry), al = _atan2f(lxy, rz);
                float ex = lxy > 0.0f ? rx / lxy : 0.0f, ey = lxy > 0.0f ? ry / lxy : 0.0f;
                float wb = sstep(1.5507963f, 1.5907963f, al);
                float3 ca = wb < 1.0f ? linL(p_FromTexR, p_FromTexG, p_FromTexB, mxc + ex * al * Rs * skr, myc + ey * al * Rs * skr, W, H) : make_float3(0.0f, 0.0f, 0.0f);
                float ab = 3.1415927f - al;
                float3 cb = wb > 0.0f ? linL(p_ToTexR, p_ToTexG, p_ToTexB, mxc - ex * ab * Rs * skr, myc + ey * ab * Rs * skr, W, H) : make_float3(0.0f, 0.0f, 0.0f);
                float lam = _fmaxf(nx * lx + ny * ly + nz * lz, 0.0f);
                float shade = lerp1(1.0f, 0.42f + 0.78f * lam, f);
                float nh = _fmaxf(nx * hx + ny * hy + nz * hz, 0.0f), n2 = nh * nh, n4 = n2 * n2, n8 = n4 * n4, n16 = n8 * n8;
                float n64 = n16 * n16 * n16 * n16, n256 = n64 * n64 * n64 * n64;
                float sp = (1.1f * n256 + 0.04f * n16) * glow * f * f;
                float3 cs2 = make_float3(lerp1(ca.x, cb.x, wb) * shade + sp, lerp1(ca.y, cb.y, wb) * shade + sp, lerp1(ca.z, cb.z, wb) * shade + sp);
                c = make_float3(lerp1(bgc.x, cs2.x, cov), lerp1(bgc.y, cs2.y, cov), lerp1(bgc.z, cs2.z, cov));
                spec += sp * cov;
            }
            sr += c.x; sg += c.y; sb += c.z;
        }
        l = make_float3(sr * 0.25f, sg * 0.25f, sb * 0.25f);
        k = spec * 0.25f;
    } else if (st == 7) {
        float len = (10.0f + 110.0f * amt) * sc * bellSq(p);
        float mx = sstep(0.3f, 0.7f, p), g = 4.0f * sc;
        float3 a = mx < 1.0f ? contourSmear(p_FromTexR, p_FromTexG, p_FromTexB, fx, fy, len, g, jit, dx, dy, W, H) : make_float3(0.0f, 0.0f, 0.0f);
        float3 b = mx > 0.0f ? contourSmear(p_ToTexR, p_ToTexG, p_ToTexB, fx, fy, len, g, jit, dx, dy, W, H) : make_float3(0.0f, 0.0f, 0.0f);
        l = make_float3(lerp1(a.x, b.x, mx), lerp1(a.y, b.y, mx), lerp1(a.z, b.z, mx));
    } else if (st == 8) {
        float S = (120.0f + 420.0f * size) * sc, T = amt * 0.8f * bellSq(p) * S;
        float mx = sstep(0.35f, 0.65f, p);
        float px = fx, py = fy, sr = 0.0f, sg = 0.0f, sb = 0.0f;
        if (T < 0.5f) {
            l = tapMix(p_FromTexR, p_FromTexG, p_FromTexB, p_ToTexR, p_ToTexG, p_ToTexB, make_float4(fx, fy, fx, fy), mx, W, H);
        } else {
            float d0 = 0.75f * T / 12.0f, d1 = 0.25f * T / 16.0f;
            for (int i = 0; i < 28; i++) {
                float2 v = curlVel(px, py, S, p, sd);
                float s = i < 12 ? d0 : (i == 12 ? jit * d1 : d1);
                px -= v.x * s; py -= v.y * s;
                if (i >= 12) {
                    float3 c = tapMix(p_FromTexR, p_FromTexG, p_FromTexB, p_ToTexR, p_ToTexG, p_ToTexB, make_float4(px, py, px, py), mx, W, H);
                    sr += c.x; sg += c.y; sb += c.z;
                }
            }
            l = make_float3(sr / 16.0f, sg / 16.0f, sb / 16.0f);
        }
    } else {
        float4 q0 = movePos(st, p, -0.5f, dp, fx, fy, fw, fh, amt, size, cx, cy, dx, dy, nsl, sd);
        float4 q1 = movePos(st, p, 0.0f, dp, fx, fy, fw, fh, amt, size, cx, cy, dx, dy, nsl, sd);
        float4 q2 = movePos(st, p, 0.5f, dp, fx, fy, fw, fh, amt, size, cx, cy, dx, dy, nsl, sd);
        float la = _sqrtf((q1.x - q0.x) * (q1.x - q0.x) + (q1.y - q0.y) * (q1.y - q0.y)) + _sqrtf((q2.x - q1.x) * (q2.x - q1.x) + (q2.y - q1.y) * (q2.y - q1.y));
        float lb = _sqrtf((q1.z - q0.z) * (q1.z - q0.z) + (q1.w - q0.w) * (q1.w - q0.w)) + _sqrtf((q2.z - q1.z) * (q2.z - q1.z) + (q2.w - q1.w) * (q2.w - q1.w));
        float len = _fmaxf(la, lb);
        int n = len < 0.5f ? 1 : clampi((int)(len / 1.5f) + 2, 2, 64);
        if (n == 1) {
            l = tapMix(p_FromTexR, p_FromTexG, p_FromTexB, p_ToTexR, p_ToTexG, p_ToTexB, q1, mixAt(st, p), W, H);
        } else {
            float sr = 0.0f, sg = 0.0f, sb = 0.0f;
            for (int i = 0; i < 64; i++) {
                if (i >= n) break;
                float j = ((float)(i) + jit) / (float)(n) - 0.5f;
                float4 q = movePos(st, p, j, dp, fx, fy, fw, fh, amt, size, cx, cy, dx, dy, nsl, sd);
                float3 c = tapMix(p_FromTexR, p_FromTexG, p_FromTexB, p_ToTexR, p_ToTexG, p_ToTexB, q, mixAt(st, _saturatef(p + j * dp)), W, H);
                sr += c.x; sg += c.y; sb += c.z;
            }
            l = make_float3(sr / (float)(n), sg / (float)(n), sb / (float)(n));
        }
        if (st == 9) {
            float wk = sstep(0.06f, 0.30f, p) * (1.0f - sstep(0.70f, 0.94f, p));
            float3 s0 = p < 0.5f ? linL(p_FromTexR, p_FromTexG, p_FromTexB, fx, fy, W, H) : linL(p_ToTexR, p_ToTexG, p_ToTexB, fx, fy, W, H);
            l = make_float3(lerp1(s0.x, l.x, wk), lerp1(s0.y, l.y, wk), lerp1(s0.z, l.z, wk));
        }
    }
    float3 o = lightOut(l.x, l.y, l.z, k);
    return make_float4(o.x, o.y, o.z, 1.0f);
}

// fusegen: the kernel entry (Fusion's rows run bottom up; py is the DCTL's top-down row)
__KERNEL__ void DevelopBlurDissolveK0dde4b29(__CONSTANTREF__ DevelopBlurDissolveP0dde4b29 *params, __TEXTURE2D__ p_FromTexR, __TEXTURE2D__ p_FromTexG, __TEXTURE2D__ p_FromTexB, __TEXTURE2D__ p_FromTexA, __TEXTURE2D__ p_ToTexR, __TEXTURE2D__ p_ToTexG, __TEXTURE2D__ p_ToTexB, __TEXTURE2D__ p_ToTexA, __TEXTURE2D_WRITE__ dvDst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->dvSize[0] && y < params->dvSize[1])
    {
        int py = params->dvFlipY != 0 ? params->dvSize[1] - 1 - y : y;
        float4 c = dvMain(params->dvSize[0], params->dvSize[1], x, py, p_FromTexR, p_FromTexG, p_FromTexB, p_FromTexA, p_ToTexR, p_ToTexG, p_ToTexB, p_ToTexA, params->dvFrame, params->dvProgress, params->bdStyle, params->bdAmount, params->bdSize, params->bdAngle, params->bdCX, params->bdCY, params->bdShutter, params->bdFrames, params->bdSlices, params->bdGlow, params->bdSeed);
        _tex2DVec4Write(dvDst, x, y, c);
    }
}
]]

-- the plain source first; the compatibility source only if the plain one does not build
DvSources = { DvMath .. DvMapping .. DvKernelText, DvCompat .. DvMath .. DvMapping .. DvKernelText }
DvWorking = nil

-- the last status of each tool, so a change is reported once
DvLast = {}

-- the compute node's error log (DVIPComputeNode:GetErrorLog, a name in fusionsystem.dll), or a note that it has none
function DvNodeLog(node)
	local log = nil
	if node then
		pcall(function()
			log = node:GetErrorLog()
		end)
	end
	if log == nil or log == "" then
		return "(the node gave no error log; see the Fusion console)"
	end
	return tostring(log)
end

-- report a status: the console, the tool's data and the log file, each once per change
function DvNote(tool, failed, msg)
	local key = DvName
	pcall(function()
		key = tool.Name
	end)
	key = tostring(key)
	local text = msg
	if failed then
		text = "FAILED: " .. msg
	end
	if DvLast[key] == text then
		return
	end
	DvLast[key] = text
	print(DvName .. " [" .. key .. "] " .. text)
	pcall(function()
		tool:SetData("DevelopFuse.Status", text)
	end)
	pcall(function()
		local dir = os.getenv("TEMP") or os.getenv("TMP") or "."
		local f = io.open(dir .. "/DevelopFuse.log", "a")
		if f then
			local line = (text:gsub("[\r\n]+", " | "))
			f:write(os.date("%Y-%m-%d %H:%M:%S") .. "\t" .. key .. "\t" .. DvName .. "\t" .. line .. "\n")
			f:close()
		end
	end)
end

-- a Lua error's message with its traceback when the debug library is there
function DvTrace(e)
	if debug and debug.traceback then
		return debug.traceback(tostring(e), 2)
	end
	return tostring(e)
end

-- the visible error: a solid magenta frame the size of ref (nil when there is no picture to size it by)
function DvFailImage(ref)
	local bad = nil
	if ref then
		pcall(function()
			bad = Image({IMG_Like = ref})
			bad:Fill(Pixel({R = 1.0, G = 0.0, B = 1.0, A = 1.0}))
		end)
	end
	return bad
end

function Create()
	InProgress = self:AddInput("Progress", "Progress", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 1.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 1.0,
		INPS_StatusText = "The transition from Outgoing (0) to Incoming (1): the DCTL's TRANSITION_PROGRESS",
		})
	InBdStyle = self:AddInput("Style", "bdStyle", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 9.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 9.0,
		INPS_StatusText = "0 Bubble, 1 Shake, 2 Sphere, 3 Crash Zoom, 4 Cross Zoom, 5 Directional, 6 Spin, 7 Vector, 8 Curl, 9 Kaleida",
		})
	InBdAmount = self:AddInput("Amount", "bdAmount", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 60.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "How far: the shake, the zoom, the roll, the smear, the swirl, the turn",
		})
	InBdSize = self:AddInput("Size", "bdSize", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "Bubble and ball size, the shake's pace, the swirl's scale",
		})
	InBdAngle = self:AddInput("Angle", "bdAngle", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 360.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 360.0,
		INPS_StatusText = "Directional and Cross Zoom: the way the picture moves, 0 right, 90 down",
		})
	InBdCX = self:AddInput("Center X", "bdCX", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InBdCY = self:AddInput("Center Y", "bdCY", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InBdShutter = self:AddInput("Shutter", "bdShutter", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 180.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 360.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 360.0,
		INPS_StatusText = "The camera's shutter angle: 180 is a film camera's, 0 no motion blur",
		})
	InBdFrames = self:AddInput("Frames", "bdFrames", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 24.0,
		INP_MinScale = 6.0,
		INP_MaxScale = 60.0,
		INP_MinAllowed = 6.0,
		INP_MaxAllowed = 60.0,
		INPS_StatusText = "How many frames the dissolve is laid, so the blur matches the move in each frame",
		})
	InBdSlices = self:AddInput("Slices", "bdSlices", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 6.0,
		INP_MinScale = 3.0,
		INP_MaxScale = 12.0,
		INP_MinAllowed = 3.0,
		INP_MaxAllowed = 12.0,
		})
	InBdGlow = self:AddInput("Glow", "bdGlow", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "Bubble: the film's colours and glint. Sphere: the ball's shine",
		})
	InBdSeed = self:AddInput("Seed", "bdSeed", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InFrameOffset = self:AddInput("Frame Offset", "FrameOffset", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Integer = true,
		INP_Default = 0,
		INP_MinScale = 0,
		INP_MaxScale = 1000,
		INPS_StatusText = "Added to the comp frame to make the DCTL's frame value (Resolve's TIMELINE_FRAME_INDEX)",
		})
	InHoldFrame = self:AddInput("Hold Frame", "HoldFrame", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 0,
		INPS_StatusText = "The frame value is Frame Offset alone, so a moving effect holds still",
		})
	InFlipY = self:AddInput("Rows Top Down", "FlipY", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 1,
		IC_Visible = false,
		})
	InOutgoing = self:AddInput("Outgoing", "Outgoing", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
		})
	InIncoming = self:AddInput("Incoming", "Incoming", {
		LINKID_DataType = "Image",
		LINK_Main = 2,
		INP_Required = false,
		})
	OutImage = self:AddOutput("Output", "Output", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
		})
end

-- one channel of img as its own texture, rows top-down (DvSplitSource); returns the plane, or nil and why
function DvPlane(req, img, ch, flip)
	local plane = Image({IMG_Like = img})
	local node = DVIPComputeNode(req, DvSplitName, DvSplitSource, DvSplitParamsName, DvSplitParams)
	if not node then
		return nil, "the split kernel's compute node was not created (DVIPComputeNode gave nil)"
	end
	local p = node:GetParamBlock(DvSplitParams)
	p.ch = ch
	p.flipY = flip
	p.size[0] = img.DataWindow:Width()
	p.size[1] = img.DataWindow:Height()
	node:SetParamBlock(p)
	node:AddInput("src", img)
	node:AddOutput("dst", plane)
	if node:RunSession(req) then
		return plane
	end
	return nil, "the split kernel did not run: " .. DvNodeLog(node)
end

-- the kernel over every pixel with source k; returns true when it ran, or false and why
function DvRun(req, k, src, inc, planes, out, frame, flip, progress)
	local node = DVIPComputeNode(req, DvKernelName, DvSources[k], DvParamsName, DvParams)
	if not node then
		return false, "source " .. k .. ": the compute node was not created (DVIPComputeNode gave nil)"
	end
	local p = node:GetParamBlock(DvParams)
	p.bdStyle = InBdStyle:GetValue(req).Value
	p.bdAmount = InBdAmount:GetValue(req).Value
	p.bdSize = InBdSize:GetValue(req).Value
	p.bdAngle = InBdAngle:GetValue(req).Value
	p.bdCX = InBdCX:GetValue(req).Value
	p.bdCY = InBdCY:GetValue(req).Value
	p.bdShutter = InBdShutter:GetValue(req).Value
	p.bdFrames = InBdFrames:GetValue(req).Value
	p.bdSlices = InBdSlices:GetValue(req).Value
	p.bdGlow = InBdGlow:GetValue(req).Value
	p.bdSeed = InBdSeed:GetValue(req).Value
	p.dvProgress = progress
	p.dvFrame = frame
	p.dvFlipY = flip
	p.dvSize[0] = src.DataWindow:Width()
	p.dvSize[1] = src.DataWindow:Height()
	node:SetParamBlock(p)
	node:AddInput("p_FromTexR", planes.p_FromTexR)
	node:AddInput("p_FromTexG", planes.p_FromTexG)
	node:AddInput("p_FromTexB", planes.p_FromTexB)
	node:AddInput("p_FromTexA", planes.p_FromTexA)
	node:AddInput("p_ToTexR", planes.p_ToTexR)
	node:AddInput("p_ToTexG", planes.p_ToTexG)
	node:AddInput("p_ToTexB", planes.p_ToTexB)
	node:AddInput("p_ToTexA", planes.p_ToTexA)
	node:AddOutput("dvDst", out)
	if node:RunSession(req) then
		return true
	end
	return false, "source " .. k .. ": RunSession failed: " .. DvNodeLog(node)
end

function DvProcess(req)
	local src = InOutgoing:GetValue(req)
	if not src then
		return nil, "no Outgoing image", true, nil
	end
	if req:IsPreCalc() then
		return Image({IMG_Like = src, IMG_NoData = true}), nil, false, src
	end
	local inc = InIncoming:GetValue(req)
	if not inc then
		return src, "Incoming is not connected, so Outgoing passes through", false, src
	end
	local progress = InProgress:GetValue(req).Value
	local out = Image({IMG_Like = src})
	local flip = math.floor(InFlipY:GetValue(req).Value + 0.5)
	local frame = math.floor(InFrameOffset:GetValue(req).Value + 0.5)
	if InHoldFrame:GetValue(req).Value < 0.5 then
		frame = frame + math.floor(req.Time + 0.5)
	end
	local planes = {}
	local why = nil
	planes.p_FromTexR, why = DvPlane(req, src, 0, flip)
	if not planes.p_FromTexR then
		return nil, "p_FromTexR: " .. tostring(why), true, src
	end
	planes.p_FromTexG, why = DvPlane(req, src, 1, flip)
	if not planes.p_FromTexG then
		return nil, "p_FromTexG: " .. tostring(why), true, src
	end
	planes.p_FromTexB, why = DvPlane(req, src, 2, flip)
	if not planes.p_FromTexB then
		return nil, "p_FromTexB: " .. tostring(why), true, src
	end
	planes.p_FromTexA = src -- the DCTL never reads this plane
	planes.p_ToTexR, why = DvPlane(req, inc, 0, flip)
	if not planes.p_ToTexR then
		return nil, "p_ToTexR: " .. tostring(why), true, src
	end
	planes.p_ToTexG, why = DvPlane(req, inc, 1, flip)
	if not planes.p_ToTexG then
		return nil, "p_ToTexG: " .. tostring(why), true, src
	end
	planes.p_ToTexB, why = DvPlane(req, inc, 2, flip)
	if not planes.p_ToTexB then
		return nil, "p_ToTexB: " .. tostring(why), true, src
	end
	planes.p_ToTexA = inc -- the DCTL never reads this plane
	local order = {}
	if DvWorking then
		order[1] = DvWorking
	end
	for k = 1, #DvSources do
		if k ~= DvWorking then
			order[#order + 1] = k
		end
	end
	local errs = {}
	for i = 1, #order do
		local ok, err = DvRun(req, order[i], src, inc, planes, out, frame, flip, progress)
		if ok then
			DvWorking = order[i]
			return out, "ok, the kernel runs from source " .. order[i], false, src
		end
		errs[#errs + 1] = tostring(err)
	end
	return nil, "the kernel ran from no source: " .. table.concat(errs, " || "), true, src
end

-- every failure is reported and shows as magenta; the input never passes through quietly
function Process(req)
	local res, msg, failed, ref = nil, nil, true, nil
	local called, err = xpcall(function()
		res, msg, failed, ref = DvProcess(req)
	end, DvTrace)
	if not called then
		res, msg, failed = nil, "Lua error in Process: " .. tostring(err), true
		if not ref then
			pcall(function()
				ref = InOutgoing:GetValue(req)
			end)
		end
	end
	if msg then
		DvNote(self, failed, msg)
	end
	if failed then
		res = DvFailImage(ref)
	end
	OutImage:Set(req, res)
end
