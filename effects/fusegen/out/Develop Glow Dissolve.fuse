            float bx = aspect * (0.6f + 0.4f * hash01(us, (uint)(k), seed + 23u)), by = hash01(us, (uint)(k), seed + 24u);
            d = _fminf(d, boltG(x, y, ax, ay, bx, by, 0.8f, strike * 3.1f + (float)(k) * 5.0f, seed + 30u + (uint)(k) * 7u) * (k == 0 ? 1.0f : 1.4f));
