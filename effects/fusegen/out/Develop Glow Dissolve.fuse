        ar += 0.3f * disc * (0.3f + c.x); ag += 0.3f * disc * (0.3f + c.y); ab += 0.3f * disc * (0.3f + c.z);
    }
    float hr = 0.32f * szs, ring = _expf(-((d0 - hr) / (0.02f * szs)) * ((d0 - hr) / (0.02f * szs)));
    float3 rc = specL(0.55f + 1.5f * (d0 - hr) / hr);
    ar += 0.1f * ring * rc.x; ag += 0.1f * ring * rc.y; ab += 0.1f * ring * rc.z;
    return make_float3(ar, ag, ab);
}

__DEVICE__ float4 dvMain(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE2D__ p_FromTexR, __TEXTURE2D__ p_FromTexG, __TEXTURE2D__ p_FromTexB, __TEXTURE2D__ p_FromTexA, __TEXTURE2D__ p_ToTexR, __TEXTURE2D__ p_ToTexG, __TEXTURE2D__ p_ToTexB, __TEXTURE2D__ p_ToTexA, int dvFrame, float dvProgress, float gdStyle, float gdLight, float gdSize, float gdThresh, float gdWash, float gdBlend, float gdCX, float gdCY, float gdAngle, float gdPoints, float gdRainbow, float gdHue, float gdTint, float gdSeed)
{
    float p = _saturatef(dvProgress);
    float da = dvTex2D(p_FromTexR, p_X, p_Y), dg = dvTex2D(p_FromTexG, p_X, p_Y), db = dvTex2D(p_FromTexB, p_X, p_Y);
    float ea = dvTex2D(p_ToTexR, p_X, p_Y), eg = dvTex2D(p_ToTexG, p_X, p_Y), eb = dvTex2D(p_ToTexB, p_X, p_Y);
    if (p <= 0.0f) return make_float4(da, dg, db, 1.0f);
    if (p >= 1.0f) return make_float4(ea, eg, eb, 1.0f);
    int W = p_Width, H = p_Height;
    float hh = (float)(H), aspect = (float)(W) / hh;
    float x = ((float)(p_X) + 0.5f) / hh, y = ((float)(p_Y) + 0.5f) / hh;
    int st = (int)(gdStyle + 0.5f);
    uint seed = (uint)(gdSeed) * 131u + 7u;
    float amt = gdLight / 100.0f, sz = gdSize / 100.0f, thr = gdThresh / 100.0f, tw = gdTint / 100.0f;
    float ang = gdAngle * 0.0174533f;
    float3 hc = hueG(gdHue);
    float taper = sstep(0.0f, 0.12f, p) * sstep(0.0f, 0.12f, 1.0f - p);
    float sn = _sinf(3.1415927f * p), ev = sn * sn * taper;
    float bl = 0.015f + 0.3f * gdBlend / 100.0f;
    float swap = sstep(0.5f - bl, 0.5f + bl, p);
    float lr = 0.0f, lg = 0.0f, lb = 0.0f, e = ev * amt;
    float r, g, b;
    if (st == 8) {
        float ca = _cosf(ang), sa = _sinf(ang);
        float ext = 0.5f * (_fabs(ca) * aspect + _fabs(sa));
        float u = ((x - 0.5f * aspect) * ca + (y - 0.5f) * sa) / (2.0f * ext) + 0.5f;
        float bw = 0.02f + 0.12f * sz, front = -0.3f + 1.6f * p;
        float wb = 1.0f - sstep(front - 0.5f * bw, front + 0.5f * bw, u);
        float mr = lerp1(da, ea, wb), mg = lerp1(dg, eg, wb), mb = lerp1(db, eb, wb);
        r = toLin(mr); g = toLin(mg); b = toLin(mb);
        float band = _expf(-((u - front) / bw) * ((u - front) / bw));
        float wide = _expf(-((u - front) / (3.0f * bw)) * ((u - front) / (3.0f * bw)));
        float line = _expf(-((u - front) / (0.08f * bw)) * ((u - front) / (0.08f * bw)));
        float ex = 1.0f + (8.0f * band + 1.2f * wide) * amt;
        r *= ex; g *= ex; b *= ex;
        float lit = band * 2.2f * brightG(luma(mr, mg, mb), thr * 0.6f) + 1.0f * line;
        lr = lit * (r * 0.5f + 0.5f); lg = lit * (g * 0.5f + 0.5f); lb = lit * (b * 0.5f + 0.5f);
        e = amt;
    } else {
        r = toLin(lerp1(da, ea, swap)); g = toLin(lerp1(dg, eg, swap)); b = toLin(lerp1(db, eb, swap));
        if (st == 4 || st == 5 || st == 7) {
            float3 o = ownLightG(st, x, y, aspect, p, sz, gdCX / 100.0f * aspect, gdCY / 100.0f, ang, hc, seed);
            lr = o.x; lg = o.y; lb = o.z;
            if (st == 7) e = _powf(sn, 1.2f) * taper * amt;
        } else {
            float cx = gdCX / 100.0f * (float)(W), cy = gdCY / 100.0f * hh;
            int arms = (int)(gdPoints + 0.5f);
            float rbw = gdRainbow / 100.0f;
            if (swap < 1.0f) {
                float3 o = shotLightG(st, p_FromTexR, p_FromTexG, p_FromTexB, p_X, p_Y, W, H, ev, thr, sz, cx, cy, ang, arms, rbw, p, seed);
                lr += (1.0f - swap) * o.x; lg += (1.0f - swap) * o.y; lb += (1.0f - swap) * o.z;
            }
            if (swap > 0.0f) {
                float3 o = shotLightG(st, p_ToTexR, p_ToTexG, p_ToTexB, p_X, p_Y, W, H, ev, thr, sz, cx, cy, ang, arms, rbw, p, seed);
                lr += swap * o.x; lg += swap * o.y; lb += swap * o.z;
            }
        }
    }
    if (st != 5 && tw > 0.0f) {
        float m = (lr + lg + lb) * 0.55f;
        lr = lerp1(lr, m * hc.x, tw); lg = lerp1(lg, m * hc.y, tw); lb = lerp1(lb, m * hc.z, tw);
    }
    float wash = st == 8 ? 0.0f : gdWash / 100.0f * e;
    if (st == 4) wash *= 0.6f + 0.8f * vnoise3(p * 120.0f + 1000.0f, 3.5f, 0.5f, seed + 40u);
    float wr = lerp1(1.0f, hc.x, tw), wg = lerp1(0.96f, hc.y, tw), wbl = lerp1(0.9f, hc.z, tw);
    float ex = 1.0f + 3.0f * wash, wc = _fminf(wash, 1.0f) * 0.5f;
    r = r * ex * lerp1(1.0f, wr, wc) + lr * e;
    g = g * ex * lerp1(1.0f, wg, wc) + lg * e;
    b = b * ex * lerp1(1.0f, wbl, wc) + lb * e;
    float3 o = lightOut(r, g, b, _saturatef((lr + lg + lb) * e + 3.0f * wash));
    return make_float4(o.x, o.y, o.z, 1.0f);
}

// fusegen: the kernel entry (Fusion's rows run bottom up; py is the DCTL's top-down row)
__KERNEL__ void DevelopGlowDissolveK169d775c(__CONSTANTREF__ DevelopGlowDissolveP169d775c *params, __TEXTURE2D__ p_FromTexR, __TEXTURE2D__ p_FromTexG, __TEXTURE2D__ p_FromTexB, __TEXTURE2D__ p_FromTexA, __TEXTURE2D__ p_ToTexR, __TEXTURE2D__ p_ToTexG, __TEXTURE2D__ p_ToTexB, __TEXTURE2D__ p_ToTexA, __TEXTURE2D_WRITE__ dvDst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->dvSize[0] && y < params->dvSize[1])
    {
        int py = params->dvFlipY != 0 ? params->dvSize[1] - 1 - y : y;
        float4 c = dvMain(params->dvSize[0], params->dvSize[1], x, py, p_FromTexR, p_FromTexG, p_FromTexB, p_FromTexA, p_ToTexR, p_ToTexG, p_ToTexB, p_ToTexA, params->dvFrame, params->dvProgress, params->gdStyle, params->gdLight, params->gdSize, params->gdThresh, params->gdWash, params->gdBlend, params->gdCX, params->gdCY, params->gdAngle, params->gdPoints, params->gdRainbow, params->gdHue, params->gdTint, params->gdSeed);
        _tex2DVec4Write(dvDst, x, y, c);
    }
}
]]

-- the plain source first; the compatibility source only if the plain one does not build
DvSources = { DvMath .. DvMapping .. DvKernelText, DvCompat .. DvMath .. DvMapping .. DvKernelText }
DvWorking = nil

-- the last status of each tool, so a change is reported once
DvLast = {}

-- the compute node's error log (DVIPComputeNode:GetErrorLog, a name in fusionsystem.dll), or a note that it has none
function DvNodeLog(node)
	local log = nil
	if node then
		pcall(function()
			log = node:GetErrorLog()
		end)
	end
	if log == nil or log == "" then
		return "(the node gave no error log; see the Fusion console)"
	end
	return tostring(log)
end

-- report a status: the console, the tool's data and the log file, each once per change
function DvNote(tool, failed, msg)
	local key = DvName
	pcall(function()
		key = tool.Name
	end)
	key = tostring(key)
	local text = msg
	if failed then
		text = "FAILED: " .. msg
	end
	if DvLast[key] == text then
		return
	end
	DvLast[key] = text
	print(DvName .. " [" .. key .. "] " .. text)
	pcall(function()
		tool:SetData("DevelopFuse.Status", text)
	end)
	pcall(function()
		local dir = os.getenv("TEMP") or os.getenv("TMP") or "."
		local f = io.open(dir .. "/DevelopFuse.log", "a")
		if f then
			local line = (text:gsub("[\r\n]+", " | "))
			f:write(os.date("%Y-%m-%d %H:%M:%S") .. "\t" .. key .. "\t" .. DvName .. "\t" .. line .. "\n")
			f:close()
		end
	end)
end

-- a Lua error's message with its traceback when the debug library is there
function DvTrace(e)
	if debug and debug.traceback then
		return debug.traceback(tostring(e), 2)
	end
	return tostring(e)
end

-- the visible error: a solid magenta frame the size of ref (nil when there is no picture to size it by)
function DvFailImage(ref)
	local bad = nil
	if ref then
		pcall(function()
			bad = Image({IMG_Like = ref})
			bad:Fill(Pixel({R = 1.0, G = 0.0, B = 1.0, A = 1.0}))
		end)
	end
	return bad
end

function Create()
	InProgress = self:AddInput("Progress", "Progress", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 1.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 1.0,
		INPS_StatusText = "The transition from Outgoing (0) to Incoming (1): the DCTL's TRANSITION_PROGRESS",
		})
	InGdStyle = self:AddInput("Style", "gdStyle", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 8.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 8.0,
		INPS_StatusText = "0 Glow, 1 Rays, 2 Edge Rays, 3 Glint, 4 Flashbulbs, 5 Zap, 6 Orbs, 7 Lens Flare, 8 Light Wipe",
		})
	InGdLight = self:AddInput("Light", "gdLight", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 70.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InGdSize = self:AddInput("Size", "gdSize", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 1.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 1.0,
		INP_MaxAllowed = 100.0,
		})
	InGdThresh = self:AddInput("Threshold", "gdThresh", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 60.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InGdWash = self:AddInput("Wash", "gdWash", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "How far the whole frame lifts toward the light at the peak, hiding the cut",
		})
	InGdBlend = self:AddInput("Blend", "gdBlend", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 10.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "0 cuts clean under the peak; higher blends the two shots across it",
		})
	InGdCX = self:AddInput("Center X", "gdCX", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = -50.0,
		INP_MaxScale = 150.0,
		INP_MinAllowed = -50.0,
		INP_MaxAllowed = 150.0,
		})
	InGdCY = self:AddInput("Center Y", "gdCY", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 30.0,
		INP_MinScale = -50.0,
		INP_MaxScale = 150.0,
		INP_MinAllowed = -50.0,
		INP_MaxAllowed = 150.0,
		})
	InGdAngle = self:AddInput("Angle", "gdAngle", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 15.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 360.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 360.0,
		})
	InGdPoints = self:AddInput("Points", "gdPoints", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 6.0,
		INP_MinScale = 4.0,
		INP_MaxScale = 8.0,
		INP_MinAllowed = 4.0,
		INP_MaxAllowed = 8.0,
		})
	InGdRainbow = self:AddInput("Rainbow", "gdRainbow", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
