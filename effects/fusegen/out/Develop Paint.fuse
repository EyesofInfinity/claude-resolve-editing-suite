DvMapping = [[
// fusegen mapping (effects/fusegen/README.md section 2): a DCTL reads one channel with _tex2D(plane, x, y);
// here each plane is a texture holding that channel, read at whole-pixel coordinates by the default sampler
#define dvTex2D(dv_t, dv_x, dv_y) (_tex2DVec4((dv_t), (dv_x), (dv_y)).x)
]]

DvCompat = [[
// fusegen compatibility, used only when the plain source does not build: Resolve's DCTL names for the vector
// constructors, over Fusion's own
#ifndef make_float2
#define make_float2(a, b) to_float2((a), (b))
#endif
#ifndef make_float3
#define make_float3(a, b, c) to_float3((a), (b), (c))
#endif
#ifndef make_float4
#define make_float4(a, b, c, d) to_float4((a), (b), (c), (d))
#endif
]]

DvKernelText = [[
// Develop Paint: paint strokes, watercolour, an edge-following tile mosaic and spray paint in one transform DCTL.
// Five modes:
//   0 Oil Paint: two layers of brush strokes laid along the picture's edges and the flow of its light, a broad layer
//     first, then smaller strokes where the picture has detail; each stroke one colour taken under it, with bristle
//     streaks, a dry end and impasto ridges lit from the top left; strokes stop short of a hard edge as a painter cuts in.
//   1 Cartoon Paint: the same strokes in flat colour cut to few steps of light, saturated, inked on the picture's edges.
//   2 Watercolour: the picture softened into washes laid in layers with wobbling borders, the darker wash pooling
//     pigment at its edge, the picture's darkest small marks laid over, pigment settling into the paper's tooth,
//     highlights left as bare paper.
//   3 Tile Mosaic: square tiles laid square to the frame, turned to run along the picture's edges and cut where its
//     colour changes, grout tracing the forms; each tile one colour from its own side of an edge, bevelled.
//   4 Spray Paint: the picture airbrushed and pulled toward few stencil tones, then round droplets of three sizes, each
//     carrying the paint from where it was aimed, so every border is oversprayed; a fine mist over all.
// Size sets the stroke, wash, tile or overspray size. Detail: how far small strokes go into fine detail, how strongly
// washes settle into steps, how hard tiles cut at edges, how many spray tones. Flow: how far strokes and tiles turn to
// follow the picture's edges; where it is flat, strokes run at Angle with a slow wander, tiles square to the frame.
// Texture: bristles and impasto, paper and granulation, grout and tile surface, mist. Boil repaints Oil, Cartoon and Spray a few times a second by
// dvFrame, as a painted animation boils; 0 holds them still. An OpenFX DCTL effect or a DCTL plugin node.
// Amount mixes with the picture in display terms; Amount 0 is the input exactly. MIT License.

// fusegen ui: ptAmount
// fusegen ui: ptMode
// fusegen ui: ptSize
// fusegen ui: ptDetail
// fusegen ui: ptAngle
// fusegen ui: ptFlow
// fusegen ui: ptColour
// fusegen ui: ptTexture
// fusegen ui: ptBoil
// fusegen ui: ptSeed

// fusegen tip: Mode
// fusegen tip: Size
// fusegen tip: Detail
// fusegen tip: Angle
// fusegen tip: Flow
// fusegen tip: Boil

// Develop paint: the code of Develop Paint, on top of light.h, glitch.h and lens.h. Every value comes in as an
// argument. Distances are in pixels; sc is the frame height over 1080. MIT License.

// Develop lens: shared code of Develop Bokeh and Develop Lens, on top of light.h and glitch.h. Bilinear sampling
// with mirrored edges, linear light (Rec.709 gamma 2.4). MIT License.

// Develop light: the shared code of Develop Leak, Develop Burn and Develop Light Dissolve.
// build.py writes it into each effect, so every installed .dctl stands alone. Rec.709 gamma 2.4 in and out;
// light is added in linear. Coordinates are in frame heights (y 0 to 1 top to bottom, x 0 to width/height),
// so a leak keeps its shape at any resolution and aspect. MIT License.

__DEVICE__ float toLin(float x) { return _powf(_fmaxf(x, 0.0f), 2.4f); }
__DEVICE__ float toDisp(float x) { return _powf(_fmaxf(x, 0.0f), 1.0f / 2.4f); }
__DEVICE__ float luma(float r, float g, float b) { return 0.2126f * r + 0.7152f * g + 0.0722f * b; }
__DEVICE__ float lerp1(float a, float b, float t) { return a + (b - a) * t; }
__DEVICE__ float sstep(float a, float b, float x) { float t = _saturatef((x - a) / (b - a)); return t * t * (3.0f - 2.0f * t); }

__DEVICE__ float3 shoulder(float r, float g, float b)
{
    float m = _fmaxf(r, _fmaxf(g, b));
    if (m <= 0.8f) return make_float3(r, g, b);
    float nm = 0.8f + 0.2f * _tanhf((m - 0.8f) / 0.2f);
    float k = nm / m, w = 0.6f * sstep(1.0f, 3.0f, m);
    return make_float3(lerp1(r * k, nm, w), lerp1(g * k, nm, w), lerp1(b * k, nm, w));
}

__DEVICE__ float3 lightOut(float r, float g, float b, float k)
{
    float3 s = shoulder(r, g, b);
    float w = _saturatef(k * 4.0f);
    return make_float3(_saturatef(toDisp(lerp1(r, s.x, w))), _saturatef(toDisp(lerp1(g, s.y, w))), _saturatef(toDisp(lerp1(b, s.z, w))));
}

__DEVICE__ float hash01(uint x, uint y, uint z)
{
    x = x * 1664525u + 1013904223u; y = y * 1664525u + 1013904223u; z = z * 1664525u + 1013904223u;
    x += y * z; y += z * x; z += x * y;
    x ^= x >> 16u; y ^= y >> 16u; z ^= z >> 16u;
    x += y * z; y += z * x; z += x * y;
    return (float)(x >> 8u) * (1.0f / 16777216.0f);
}

__DEVICE__ float fade(float t) { return t * t * t * (t * (t * 6.0f - 15.0f) + 10.0f); }

__DEVICE__ float vnoise3(float x, float y, float z, uint s)
{
    int ix = (int)(x), iy = (int)(y), iz = (int)(z);
    float tx = fade(x - (float)(ix)), ty = fade(y - (float)(iy)), tz = fade(z - (float)(iz));
    uint x0 = (uint)(ix), y0 = (uint)(iy), z0 = (uint)(iz) + s * 7919u;
    float a0 = lerp1(lerp1(hash01(x0, y0, z0), hash01(x0 + 1u, y0, z0), tx), lerp1(hash01(x0, y0 + 1u, z0), hash01(x0 + 1u, y0 + 1u, z0), tx), ty);
    float a1 = lerp1(lerp1(hash01(x0, y0, z0 + 1u), hash01(x0 + 1u, y0, z0 + 1u), tx), lerp1(hash01(x0, y0 + 1u, z0 + 1u), hash01(x0 + 1u, y0 + 1u, z0 + 1u), tx), ty);
    return lerp1(a0, a1, tz);
}

__DEVICE__ float fbm(float x, float y, float z, int n, uint s)
{
    float sum = 0.0f, amp = 0.5f, tot = 0.0f, f = 1.0f;
    for (int i = 0; i < 5; i++) {
        if (i >= n) break;
        sum += amp * vnoise3(x * f + 4096.0f + 37.1f * (float)(i), y * f + 4096.0f + 11.7f * (float)(i), z * f + 4096.0f, s + (uint)(i));
        tot += amp; amp *= 0.5f; f *= 2.03f;
    }
    float v = sum / tot;
    return _saturatef((v - 0.5f) * 1.6f + 0.5f);
}

__DEVICE__ float3 ramp(float pal, float t, float age)
{
    int p = (int)(pal + 0.5f);
    float c0r = 0.30f, c0g = 0.10f, c0b = 0.42f, c1r = 0.62f, c1g = 0.35f, c1b = 0.47f, c2r = 0.86f, c2g = 0.76f, c2b = 0.68f;
    float h0r = 0.73f, h0g = 0.16f, h0b = 0.26f, h1r = 0.89f, h1g = 0.35f, h1b = 0.17f, h2r = 0.94f, h2g = 0.50f, h2b = 0.22f;
    if (p == 1) {
        c0r = 0.45f; c0g = 0.08f; c0b = 0.05f; c1r = 0.85f; c1g = 0.30f; c1b = 0.08f; c2r = 0.98f; c2g = 0.70f; c2b = 0.35f;
        h0r = 0.80f; h0g = 0.20f; h0b = 0.04f; h1r = 0.98f; h1g = 0.55f; h1b = 0.12f; h2r = 1.00f; h2g = 0.85f; h2b = 0.55f;
    }
    if (p == 2) {
        c0r = 0.18f; c0g = 0.10f; c0b = 0.45f; c1r = 0.65f; c1g = 0.25f; c1b = 0.65f; c2r = 0.95f; c2g = 0.70f; c2b = 0.75f;
        h0r = 0.70f; h0g = 0.15f; h0b = 0.50f; h1r = 0.95f; h1g = 0.45f; h1b = 0.45f; h2r = 1.00f; h2g = 0.75f; h2b = 0.55f;
    }
    if (p == 3) {
        c0r = 0.05f; c0g = 0.10f; c0b = 0.35f; c1r = 0.15f; c1g = 0.40f; c1b = 0.75f; c2r = 0.70f; c2g = 0.85f; c2b = 0.98f;
        h0r = 0.10f; h0g = 0.25f; h0b = 0.60f; h1r = 0.35f; h1g = 0.65f; h1b = 0.95f; h2r = 0.85f; h2g = 0.95f; h2b = 1.00f;
    }
    float a = _saturatef(age);
    float r0 = lerp1(c0r, h0r, a), g0 = lerp1(c0g, h0g, a), b0 = lerp1(c0b, h0b, a);
    float r1 = lerp1(c1r, h1r, a), g1 = lerp1(c1g, h1g, a), b1 = lerp1(c1b, h1b, a);
    float r2 = lerp1(c2r, h2r, a), g2 = lerp1(c2g, h2g, a), b2 = lerp1(c2b, h2b, a);
    float u = _saturatef(t);
    float r, g, b;
    if (u < 0.5f) { float k = u * 2.0f; r = lerp1(r0, r1, k); g = lerp1(g0, g1, k); b = lerp1(b0, b1, k); }
    else { float k = u * 2.0f - 1.0f; r = lerp1(r1, r2, k); g = lerp1(g1, g2, k); b = lerp1(b1, b2, k); }
    float hot = sstep(1.0f, 1.4f, t);
    return make_float3(toLin(lerp1(r, 1.0f, hot)), toLin(lerp1(g, 0.96f, hot)), toLin(lerp1(b, 0.90f, hot)));
}

__DEVICE__ float leakField(float x, float y, float aspect, float deg, float w, float sc, float z, uint s)
{
    float a = deg * 0.0174533f, ca = _cosf(a), sa = _sinf(a);
    float ext = 0.5f * (_fabs(ca) * aspect + _fabs(sa));
    float sproj = (x - 0.5f * aspect) * ca + (y - 0.5f) * sa;
    float warp = fbm(x * 1.3f, y * 1.3f, z * 0.35f, 2, s + 40u) - 0.5f;
    float d = _fmaxf(ext - sproj + 0.45f * warp * w * aspect, 0.0f);
    float reach = _fmaxf(w * aspect, 0.02f);
    float e = _expf(-(d / reach) * (d / reach));
    float cloud = fbm(x / sc, y / sc, z, 3, s);
    return _saturatef(e * (0.35f + 1.3f * cloud));
}

__DEVICE__ float burnHeat(float x, float y, float cover, float sc, float z, uint s)
{
    float wx = fbm(x / sc * 0.7f, y / sc * 0.7f, z * 0.6f, 2, s + 90u) - 0.5f;
    float wy = fbm(x / sc * 0.7f + 31.0f, y / sc * 0.7f, z * 0.6f, 2, s + 91u) - 0.5f;
    float h = fbm((x + 0.6f * wx) / sc, (y + 0.6f * wy) / sc, z, 4, s);
    float th = 1.0f - cover;
    return _saturatef((h - th + 0.28f) / 0.62f);
}

__DEVICE__ float dust(int px, int py, int h, float amount, uint z)
{
    float sc = (float)(h) / 1080.0f;
    int cx = (int)((float)(px) / (2.5f * sc)), cy = (int)((float)(py) / (2.5f * sc));
    float r = hash01((uint)(cx), (uint)(cy), z * 13u + 5u);
    float lim = 0.00002f * amount;
    if (r > lim) return 0.0f;
    return hash01((uint)(cx), (uint)(cy), z * 13u + 6u) < 0.6f ? -1.0f : 1.0f;
}

__DEVICE__ float4 burnOver(float r, float g, float b, float x, float y, float aspect, int px, int py, int ph,
                           float cover, float pal, float age, float sc, float show, float grain, float dst,
                           float z, uint fz, uint s)
{
    float k = sstep(0.0f, 0.35f, burnHeat(x, y, cover, sc, z, s));
    uint zi = (uint)(z + 1000.0f);
    float ang = 6.2831853f * ((float)(zi % 1000u) * 0.37f + 0.25f * hash01(zi, s, 71u));
    float ca = _cosf(ang), sa = _sinf(ang), ext = 0.5f * (_fabs(ca) * aspect + _fabs(sa));
    float band = 0.5f + 0.5f * ((x - 0.5f * aspect) * ca + (y - 0.5f) * sa) / ext;
    float cl = fbm(x / (sc * 1.6f), y / (sc * 1.6f), z, 3, s + 200u);
    float t = 0.05f + 0.95f * _saturatef(0.8f * band + 0.95f * (cl - 0.5f) + 0.15f);
    float3 c = ramp(pal, t, age);
    float keep = lerp1(1.0f, show, k);
    float gr = 1.0f + grain * 0.22f * (hash01((uint)(px), (uint)(py), fz * 3u + s) - 0.5f) * k;
    float d = dust(px, py, ph, dst * 100.0f, fz + s) * k;
    float rr = (r * keep + c.x * k) * gr, gg = (g * keep + c.y * k) * gr, bb = (b * keep + c.z * k) * gr;
    if (d < 0.0f) { rr *= 0.15f; gg *= 0.12f; bb *= 0.12f; }
    if (d > 0.0f) { rr = rr + 0.6f; gg = gg + 0.55f; bb = bb + 0.45f; }
    return make_float4(rr, gg, bb, k);
}
// Develop glitch: shared code of the glitch effects, on top of light.h's hash and helpers. MIT License.

__DEVICE__ int clampi(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }

__DEVICE__ float3 rgbAt(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h)
{
    int cx = clampi(x, 0, w - 1), cy = clampi(y, 0, h - 1);
    return make_float3(dvTex2D(tr, cx, cy), dvTex2D(tg, cx, cy), dvTex2D(tb, cx, cy));
}

__DEVICE__ float lumaAt(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h)
{
    float3 c = rgbAt(tr, tg, tb, x, y, w, h);
    return luma(c.x, c.y, c.z);
}

__DEVICE__ float rnd3(int a, int b, uint c) { return hash01((uint)(a + 65536), (uint)(b + 65536), c); }

__DEVICE__ float bayer8(int cx, int cy)
{
    int bx = cx & 7, by = cy & 7, xr = bx ^ by;
    int v = ((xr & 1) << 5) | ((by & 1) << 4) | ((xr & 2) << 2) | ((by & 2) << 1) | ((xr & 4) >> 1) | ((by & 4) >> 2);
    return ((float)(v) + 0.5f) / 64.0f;
}

__DEVICE__ float3 gritFinish(float3 c, int x, int y, int h, float g, float grit, float dith, uint seed)
{
    if (g <= 0.0f) return c;
    float L = luma(c.x, c.y, c.z);
    float n = hash01((uint)(x + 65536), (uint)(y + 65536), seed) - 0.5f;
    float gr = grit * g * 0.16f * (0.35f + 0.65f * L) * n;
    float r = c.x + gr, gg = c.y + gr, b = c.z + gr;
    float d = dith * g;
    if (d > 0.0f) {
        int cell = (int)(2.0f * (float)(h) / 1080.0f + 0.5f);
        if (cell < 1) cell = 1;
        float t = bayer8((int)(x / cell), (int)(y / cell));
        float lv = 32.0f * (1.0f - d) + 3.0f * d - 1.0f;
        r = _floorf(_saturatef(r) * lv + t) / lv; gg = _floorf(_saturatef(gg) * lv + t) / lv; b = _floorf(_saturatef(b) * lv + t) / lv;
    }
    return make_float3(_saturatef(r), _saturatef(gg), _saturatef(b));
}

__DEVICE__ float3 chromaBleed(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, float3 c, int x, int y, int w, int h, int k)
{
    if (k < 1) return c;
    float3 a = rgbAt(tr, tg, tb, x - k, y, w, h), b = rgbAt(tr, tg, tb, x - (int)(k / 2), y, w, h);
    float3 m = make_float3((a.x + b.x + c.x) / 3.0f, (a.y + b.y + c.y) / 3.0f, (a.z + b.z + c.z) / 3.0f);
    float L = luma(c.x, c.y, c.z), Lm = luma(m.x, m.y, m.z);
    return make_float3(m.x - Lm + L, m.y - Lm + L, m.z - Lm + L);
}

__DEVICE__ int mirL(int i, int n)
{
    int q = 2 * n, m = i % q;
    if (m < 0) m += q;
    if (m >= n) m = q - 1 - m;
    return clampi(m, 0, n - 1);
}

__DEVICE__ float3 bilL(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, float fx, float fy, int w, int h)
{
    float bx = _floorf(fx), by = _floorf(fy);
    float ax = fx - bx, ay = fy - by;
    int x0 = (int)(bx), y0 = (int)(by);
    int xa = mirL(x0, w), xb = mirL(x0 + 1, w), ya = mirL(y0, h), yb = mirL(y0 + 1, h);
    float3 c00 = make_float3(dvTex2D(tr, xa, ya), dvTex2D(tg, xa, ya), dvTex2D(tb, xa, ya));
    if (ax == 0.0f && ay == 0.0f) return c00;
    float3 c10 = make_float3(dvTex2D(tr, xb, ya), dvTex2D(tg, xb, ya), dvTex2D(tb, xb, ya));
    float3 c01 = make_float3(dvTex2D(tr, xa, yb), dvTex2D(tg, xa, yb), dvTex2D(tb, xa, yb));
    float3 c11 = make_float3(dvTex2D(tr, xb, yb), dvTex2D(tg, xb, yb), dvTex2D(tb, xb, yb));
    return make_float3(lerp1(lerp1(c00.x, c10.x, ax), lerp1(c01.x, c11.x, ax), ay),
                       lerp1(lerp1(c00.y, c10.y, ax), lerp1(c01.y, c11.y, ax), ay),
                       lerp1(lerp1(c00.z, c10.z, ax), lerp1(c01.z, c11.z, ax), ay));
}

__DEVICE__ float3 linL(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, float fx, float fy, int w, int h)
{
    float3 c = bilL(tr, tg, tb, fx, fy, w, h);
    return make_float3(toLin(c.x), toLin(c.y), toLin(c.z));
}

__DEVICE__ float aperture(float a, float n, float rot, float rnd)
{
    if (n < 3.0f) return 1.0f;
    float seg = 6.2831853f / n;
    float t = a - rot;
    float m = t - seg * _floorf(t / seg) - 0.5f * seg;
    float poly = _cosf(0.5f * seg) / _cosf(m);
    return lerp1(poly, 1.0f, rnd);
}

__DEVICE__ float3 specL(float t)
{
    float a = 6.2831853f * t;
    float r = 0.5f + 0.5f * _cosf(a), g = 0.5f + 0.5f * _cosf(a - 2.0943951f), b = 0.5f + 0.5f * _cosf(a - 4.1887902f);
    return make_float3(r * r * r, g * g * g, b * b * b);
}

__DEVICE__ float fr1(float v) { return v - _floorf(v); }
__DEVICE__ float3 mix3(float3 a, float3 b, float t) { return make_float3(lerp1(a.x, b.x, t), lerp1(a.y, b.y, t), lerp1(a.z, b.z, t)); }

__DEVICE__ float3 cross5(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, int r0)
{
    int r = r0 < 1 ? 1 : r0;
    float3 a = rgbAt(tr, tg, tb, x, y, w, h), b = rgbAt(tr, tg, tb, x - r, y, w, h), c = rgbAt(tr, tg, tb, x + r, y, w, h);
    float3 d = rgbAt(tr, tg, tb, x, y - r, w, h), e = rgbAt(tr, tg, tb, x, y + r, w, h);
    return make_float3((a.x + b.x + c.x + d.x + e.x) / 5.0f, (a.y + b.y + c.y + d.y + e.y) / 5.0f, (a.z + b.z + c.z + d.z + e.z) / 5.0f);
}

__DEVICE__ float3 tent9(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, int r0)
{
    int r = r0 < 1 ? 1 : r0;
    float3 s = make_float3(0.0f, 0.0f, 0.0f);
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            float3 c = rgbAt(tr, tg, tb, x + i * r, y + j * r, w, h);
            float wt = (i == 0 ? 2.0f : 1.0f) * (j == 0 ? 2.0f : 1.0f);
            s = make_float3(s.x + wt * c.x, s.y + wt * c.y, s.z + wt * c.z);
        }
    }
    return make_float3(s.x / 16.0f, s.y / 16.0f, s.z / 16.0f);
}

__DEVICE__ float3 likeMean(float3 a, float3 b, float3 c, float3 d, float3 e)
{
    float wb = 1.0f - sstep(0.06f, 0.30f, _fmaxf(_fabs(b.x - a.x), _fmaxf(_fabs(b.y - a.y), _fabs(b.z - a.z))));
    float wc = 1.0f - sstep(0.06f, 0.30f, _fmaxf(_fabs(c.x - a.x), _fmaxf(_fabs(c.y - a.y), _fabs(c.z - a.z))));
    float wd = 1.0f - sstep(0.06f, 0.30f, _fmaxf(_fabs(d.x - a.x), _fmaxf(_fabs(d.y - a.y), _fabs(d.z - a.z))));
    float we = 1.0f - sstep(0.06f, 0.30f, _fmaxf(_fabs(e.x - a.x), _fmaxf(_fabs(e.y - a.y), _fabs(e.z - a.z))));
    float t = 1.0f + wb + wc + wd + we;
    return make_float3((a.x + wb * b.x + wc * c.x + wd * d.x + we * e.x) / t, (a.y + wb * b.y + wc * c.y + wd * d.y + we * e.y) / t,
                       (a.z + wb * b.z + wc * c.z + wd * d.z + we * e.z) / t);
}

__DEVICE__ float edgeAt(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, int r0)
{
    int r = r0 < 1 ? 1 : r0;
    float a = lumaAt(tr, tg, tb, x - r, y - r, w, h), b = lumaAt(tr, tg, tb, x, y - r, w, h), c = lumaAt(tr, tg, tb, x + r, y - r, w, h);
    float d = lumaAt(tr, tg, tb, x - r, y, w, h), f = lumaAt(tr, tg, tb, x + r, y, w, h);
    float g = lumaAt(tr, tg, tb, x - r, y + r, w, h), k = lumaAt(tr, tg, tb, x, y + r, w, h), m = lumaAt(tr, tg, tb, x + r, y + r, w, h);
    float gx = (c + 2.0f * f + m) - (a + 2.0f * d + g), gy = (g + 2.0f * k + m) - (a + 2.0f * b + c);
    return _sqrtf(gx * gx + gy * gy) / 4.0f;
}

__DEVICE__ float3 satur(float3 c, float k)
{
    float L = luma(c.x, c.y, c.z);
    return make_float3(_saturatef(L + (c.x - L) * k), _saturatef(L + (c.y - L) * k), _saturatef(L + (c.z - L) * k));
}

__DEVICE__ float3 toneCut(float3 c, float n, float k)
{
    float L = luma(c.x, c.y, c.z);
    float t = L * (n - 1.0f), fl = _floorf(t);
    float Lt = lerp1(L, _saturatef((fl + sstep(0.35f, 0.65f, t - fl)) / (n - 1.0f)), k);
    float kq = Lt / _fmaxf(L, 0.02f);
    float3 o = make_float3(_saturatef(c.x * kq), _saturatef(c.y * kq), _saturatef(c.z * kq));
    return mix3(o, make_float3(Lt, Lt, Lt), 0.6f * sstep(1.5f, 3.0f, kq));
}

__DEVICE__ float2 runDir(float gx, float gy, float a0, float fw, float sym)
{
    float g2 = gx * gx + gy * gy;
    float ge = _atan2f(gy, gx) + 1.5707963f;
    float wgt = fw * sstep(0.0015f, 0.0080f, g2);
    float mx = lerp1(_cosf(sym * a0), _cosf(sym * ge), wgt), my = lerp1(_sinf(sym * a0), _sinf(sym * ge), wgt);
    float th = _atan2f(my, mx) / sym;
    return make_float2(_cosf(th), _sinf(th));
}

__DEVICE__ float3 strokeAt(float px, float py, float cx, float cy, float tx, float ty, float lh, float wh, float bend, float sc, float dry, uint s)
{
    float dx = px - cx, dy = py - cy;
    float u = (dx * tx + dy * ty) / lh;
    float v = (-dx * ty + dy * tx - bend * u * u) / wh;
    if (_fabs(u) > 1.15f || _fabs(v) > 1.3f) return make_float3(0.0f, 0.0f, 0.5f);
    float tp = 1.0f - 0.35f * sstep(0.1f, 1.0f, u);
    float vv = v / tp;
    float uu = u * u;
    float d = uu * uu + vv * vv;
    float b = 0.65f * vnoise3(v * wh / (1.1f * sc) + 4096.0f, u * lh / (40.0f * sc) + 4096.0f, 0.0f, s)
            + 0.35f * vnoise3(v * wh / (3.0f * sc) + 4196.0f, u * lh / (90.0f * sc) + 4096.0f, 0.0f, s + 17u);
    float de = d - 0.45f * (b - 0.5f) * sstep(0.2f, 1.0f, _fabs(vv));
    float aa = _fminf(1.3f / wh, 0.5f);
    float a = 1.0f - sstep(1.0f - aa, 1.0f + aa, de);
    a *= 1.0f - dry * sstep(0.1f, 1.0f, u) * (1.0f - sstep(0.35f, 0.60f, b));
    float hgt = (1.0f - sstep(0.2f, 1.15f, de)) * (0.7f + 0.3f * b);
    return make_float3(a, hgt, b);
}

__DEVICE__ float4 paintLayer(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, float3 base, float3 un, float fx, float fy, int w, int h,
                             float s, int per, float lw, float gate, float a0, float fw, float vib, float tex, float flat, float sc, uint sd)
{
    int ix = (int)(_floorf(fx / s)), iy = (int)(_floorf(fy / s));
    float z1 = -1.0f, z2 = -1.0f, z3 = -1.0f, a1 = 0.0f, a2 = 0.0f, a3 = 0.0f;
    float3 c1 = base, c2 = base, c3 = base;
    int r = (int)(0.35f * s + 0.5f);
    if (r < 1) r = 1;
    float lx = -0.62f, ly = -0.62f;
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            for (int k = 0; k < 2; k++) {
                if (k >= per) break;
                int ci = ix + i, cj = iy + j;
                uint ks = sd + (uint)(k) * 101u;
                float cx = ((float)(ci) + 0.5f + (rnd3(ci, cj, ks + 1u) - 0.5f) * 0.5f) * s;
                float cy = ((float)(cj) + 0.5f + (rnd3(ci, cj, ks + 2u) - 0.5f) * 0.5f) * s;
                int qx = (int)(_floorf(cx)), qy = (int)(_floorf(cy));
                float3 ca = rgbAt(tr, tg, tb, qx, qy, w, h), cl = rgbAt(tr, tg, tb, qx - r, qy, w, h), cr = rgbAt(tr, tg, tb, qx + r, qy, w, h);
                float3 cu = rgbAt(tr, tg, tb, qx, qy - r, w, h), cd = rgbAt(tr, tg, tb, qx, qy + r, w, h);
                float gx = (luma(cr.x, cr.y, cr.z) - luma(cl.x, cl.y, cl.z)) * 0.5f, gy = (luma(cd.x, cd.y, cd.z) - luma(cu.x, cu.y, cu.z)) * 0.5f;
                float ch = _fmaxf(_fmaxf(_fabs(cr.x - cl.x), _fabs(cr.y - cl.y)), _fmaxf(_fabs(cr.z - cl.z), _fmaxf(_fabs(cd.x - cu.x), _fmaxf(_fabs(cd.y - cu.y), _fabs(cd.z - cu.z)))));
                float gk = gate > 0.0f ? sstep(0.7f * gate, 1.3f * gate, 0.5f * ch) : 1.0f;
                if (gk <= 0.0f) continue;
                float wa = a0 + 2.0f * (vnoise3(cx / (4.0f * s) + 4096.0f, cy / (4.0f * s) + 4096.0f, 0.0f, sd + 3u) - 0.5f)
                         + 0.5f * (rnd3(ci, cj, ks + 10u) - 0.5f);
                float2 t = runDir(gx, gy, wa, fw, 2.0f);
                float lh = s * lw * (0.6f + 0.45f * rnd3(ci, cj, ks + 4u)), wh = s * 0.38f * (0.75f + 0.5f * rnd3(ci, cj, ks + 5u));
                float bend = (rnd3(ci, cj, ks + 11u) - 0.5f) * 1.2f * wh;
                uint ss = ks + (uint)((ci & 1023) * 1024 + (cj & 1023)) * 3u;
                float3 st = strokeAt(fx, fy, cx, cy, t.x, t.y, lh, wh, bend, sc, 0.7f * tex * (1.0f - flat), ss);
                if (st.x <= 0.002f) continue;
                float3 pc = make_float3((ca.x + cl.x + cr.x + cu.x + cd.x) / 5.0f, (ca.y + cl.y + cr.y + cu.y + cd.y) / 5.0f, (ca.z + cl.z + cr.z + cu.z + cd.z) / 5.0f);
                float dc = _sqrtf((pc.x - un.x) * (pc.x - un.x) + (pc.y - un.y) * (pc.y - un.y) + (pc.z - un.z) * (pc.z - un.z));
                float a = gk * st.x * (1.0f - 0.95f * sstep(0.10f, 0.22f, dc));
                float jv = 1.0f + 0.07f * (rnd3(ci, cj, ks + 6u) - 0.5f);
                pc = make_float3(pc.x * jv * (1.0f + 0.03f * (rnd3(ci, cj, ks + 7u) - 0.5f)), pc.y * jv, pc.z * jv * (1.0f + 0.03f * (rnd3(ci, cj, ks + 8u) - 0.5f)));
                pc = satur(pc, 1.0f + 0.6f * vib + 0.4f * flat);
                if (flat > 0.0f) pc = toneCut(pc, 5.0f, 1.0f);
                float dr = 0.7f * tex * (1.0f - flat);
                float3 sx = strokeAt(fx + 1.0f, fy, cx, cy, t.x, t.y, lh, wh, bend, sc, dr, ss);
                float3 sy = strokeAt(fx, fy + 1.0f, cx, cy, t.x, t.y, lh, wh, bend, sc, dr, ss);
                float sl = ((sx.y - st.y) * lx + (sy.y - st.y) * ly) * wh;
                float sh = (1.0f - flat) * tex * (0.16f * _clampf(sl, -1.5f, 1.5f) + 0.12f * (st.z - 0.5f));
                pc = make_float3(_saturatef(pc.x * (1.0f - sh)), _saturatef(pc.y * (1.0f - sh)), _saturatef(pc.z * (1.0f - sh)));
                float zz = rnd3(ci, cj, ks + 9u);
                if (zz > z1) { z3 = z2; a3 = a2; c3 = c2; z2 = z1; a2 = a1; c2 = c1; z1 = zz; a1 = a; c1 = pc; }
                else if (zz > z2) { z3 = z2; a3 = a2; c3 = c2; z2 = zz; a2 = a; c2 = pc; }
                else if (zz > z3) { z3 = zz; a3 = a; c3 = pc; }
            }
        }
    }
    float3 o = mix3(mix3(mix3(base, c3, a3), c2, a2), c1, a1);
    return make_float4(o.x, o.y, o.z, 1.0f - (1.0f - a1) * (1.0f - a2) * (1.0f - a3));
}

__DEVICE__ float3 watercolour(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, float fx, float fy, int w, int h, float R,
                              float det, float vib, float tex, float sc, uint sd)
{
    float wx = (fbm(fx / (70.0f * sc), fy / (70.0f * sc), 0.0f, 2, sd + 21u) - 0.5f) * 0.8f * R;
    float wy = (fbm(fx / (70.0f * sc), fy / (70.0f * sc), 0.0f, 2, sd + 22u) - 0.5f) * 0.8f * R;
    float qx = fx + wx, qy = fy + wy, hr = 0.5f * R;
    float3 sum = make_float3(0.0f, 0.0f, 0.0f);
    float gx = 0.0f, gy = 0.0f;
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            float3 c = bilL(tr, tg, tb, qx + (float)(i) * hr, qy + (float)(j) * hr, w, h);
            float wt = (i == 0 ? 2.0f : 1.0f) * (j == 0 ? 2.0f : 1.0f);
            sum = make_float3(sum.x + wt * c.x, sum.y + wt * c.y, sum.z + wt * c.z);
            float L = luma(c.x, c.y, c.z);
            gx += (float)(i) * L * (j == 0 ? 2.0f : 1.0f);
            gy += (float)(j) * L * (i == 0 ? 2.0f : 1.0f);
        }
    }
    float3 wc = make_float3(sum.x / 16.0f, sum.y / 16.0f, sum.z / 16.0f);
    float con = 0.25f * _sqrtf(gx * gx + gy * gy);
    float gpx = _fmaxf(con / R, 0.00001f);
    float L = luma(wc.x, wc.y, wc.z);
    float n = 3.0f + _floorf(det * 5.0f + 0.5f);
    float t = L * n, f = fr1(t), fl = _floorf(t);
    float ks = sstep(0.04f, 0.14f, con);
    float qv = (fl + 0.5f - 0.5f * (1.0f - sstep(0.0f, 0.3f, f)) + 0.5f * (1.0f - sstep(0.0f, 0.3f, 1.0f - f))) / n;
    float Lw = lerp1(L, _fminf(qv, 1.0f), 0.3f + 0.4f * det);
    float kk = Lw / _fmaxf(L, 0.01f);
    float3 c = make_float3(_saturatef(wc.x * kk), _saturatef(wc.y * kk), _saturatef(wc.z * kk));
    float3 cq = cross5(tr, tg, tb, (int)(fx), (int)(fy), w, h, (int)(2.0f * sc + 0.5f));
    float dk = luma(cq.x, cq.y, cq.z) - L;
    float dt = -sstep(0.05f, 0.18f, -dk) * (0.10f + 0.35f * det) * _fabs(dk) * 2.0f;
    c = make_float3(_saturatef(c.x * (1.0f + dt)), _saturatef(c.y * (1.0f + dt)), _saturatef(c.z * (1.0f + dt)));
    c = satur(c, 1.15f + 0.5f * vib);
    c = make_float3(1.0f - 0.82f * (1.0f - c.x), 1.0f - 0.82f * (1.0f - c.y), 1.0f - 0.82f * (1.0f - c.z));
    c = mix3(c, make_float3(1.0f, 1.0f, 1.0f), sstep(0.80f, 0.94f, L));
    float rim = 0.8f * ks * _fmaxf(_expf(-((1.0f - f) / (n * gpx)) / (3.0f * sc)), _expf(-(f / (n * gpx)) / (0.7f * sc)));
    float p1 = fbm(fx / (1.5f * sc), fy / (1.5f * sc), 0.0f, 3, sd + 31u);
    float p2 = fbm(fx / (6.0f * sc), fy / (6.0f * sc), 0.0f, 2, sd + 32u);
    float pp = 0.55f * p1 + 0.45f * p2;
    float tu = fbm(fx / (35.0f * sc), fy / (35.0f * sc), 0.0f, 3, sd + 41u) - 0.5f;
    float pig = 1.0f - luma(c.x, c.y, c.z);
    float d = 1.0f + 1.7f * rim + tex * (1.5f * (0.5f - pp) * sstep(0.0f, 0.4f, pig) + 0.6f * tu);
    d = _clampf(d, 0.2f, 3.0f);
    c = make_float3(_saturatef(c.x - (c.x - c.x * c.x) * (d - 1.0f)), _saturatef(c.y - (c.y - c.y * c.y) * (d - 1.0f)), _saturatef(c.z - (c.z - c.z * c.z) * (d - 1.0f)));
    float pr = fbm((fx - 1.0f) / (6.0f * sc), (fy - 1.0f) / (6.0f * sc), 0.0f, 2, sd + 32u);
    float rl = 1.0f + tex * 0.12f * (pr - p2);
    return make_float3(_saturatef(c.x * 0.975f * rl), _saturatef(c.y * 0.962f * rl), _saturatef(c.z * 0.930f * rl));
}

__DEVICE__ float3 tileMosaic(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, float s,
                             float det, float fw, float tex, float sc, uint sd)
{
    float fx = (float)(x), fy = (float)(y);
    int ix = (int)(_floorf(fx / s)), iy = (int)(_floorf(fy / s));
    int pr = (int)(sc + 0.5f);
    if (pr < 1) pr = 1;
    float3 pa = rgbAt(tr, tg, tb, x, y, w, h), pl = rgbAt(tr, tg, tb, x - pr, y, w, h), pg = rgbAt(tr, tg, tb, x + pr, y, w, h);
    float3 pu = rgbAt(tr, tg, tb, x, y - pr, w, h), pd = rgbAt(tr, tg, tb, x, y + pr, w, h);
    float3 cp = likeMean(pa, pl, pg, pu, pd);
    float ec = 0.5f * _fmaxf(_fmaxf(_fmaxf(_fabs(pg.x - pl.x), _fabs(pg.y - pl.y)), _fabs(pg.z - pl.z)),
                             _fmaxf(_fmaxf(_fabs(pd.x - pu.x), _fabs(pd.y - pu.y)), _fabs(pd.z - pu.z)));
    float3 ql = rgbAt(tr, tg, tb, x - 3 * pr, y, w, h), qg = rgbAt(tr, tg, tb, x + 3 * pr, y, w, h);
    float3 qu = rgbAt(tr, tg, tb, x, y - 3 * pr, w, h), qd = rgbAt(tr, tg, tb, x, y + 3 * pr, w, h);
    ec = _fminf(ec, 0.5f * _fmaxf(_fmaxf(_fmaxf(_fabs(qg.x - ql.x), _fabs(qg.y - ql.y)), _fabs(qg.z - ql.z)),
                                  _fmaxf(_fmaxf(_fabs(qd.x - qu.x), _fabs(qd.y - qu.y)), _fabs(qd.z - qu.z))));
    float f1 = 99.0f, f2 = 99.0f;
    float3 tc = cp;
    int bi = 0, bj = 0;
    int r = (int)(0.3f * s + 0.5f);
    float kc = 0.5f + 2.5f * det;
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            int ci = ix + i, cj = iy + j;
            float cx = ((float)(ci) + 0.5f + (rnd3(ci, cj, sd + 1u) - 0.5f) * 0.12f) * s;
            float cy = ((float)(cj) + 0.5f + (rnd3(ci, cj, sd + 2u) - 0.5f) * 0.12f) * s;
            int qx = (int)(_floorf(cx)), qy = (int)(_floorf(cy));
            float3 ca = rgbAt(tr, tg, tb, qx, qy, w, h), cl = rgbAt(tr, tg, tb, qx - r, qy, w, h), cr = rgbAt(tr, tg, tb, qx + r, qy, w, h);
            float3 cu = rgbAt(tr, tg, tb, qx, qy - r, w, h), cd = rgbAt(tr, tg, tb, qx, qy + r, w, h);
            float gx = (luma(cr.x, cr.y, cr.z) - luma(cl.x, cl.y, cl.z)) * 0.5f, gy = (luma(cd.x, cd.y, cd.z) - luma(cu.x, cu.y, cu.z)) * 0.5f;
            float2 t = runDir(gx, gy, 0.0f, fw, 4.0f);
            float dx = fx - cx, dy = fy - cy;
            float u = (dx * t.x + dy * t.y) / s, v = (-dx * t.y + dy * t.x) / s;
            float dl = _fmaxf(_fabs(u), _fabs(v));
            float3 pc = likeMean(ca, cl, cr, cu, cd);
            float dc = _sqrtf((pc.x - cp.x) * (pc.x - cp.x) + (pc.y - cp.y) * (pc.y - cp.y) + (pc.z - cp.z) * (pc.z - cp.z));
            float dd = dl + kc * sstep(0.06f, 0.36f, dc) * dc;
            if (dd < f1) { f2 = f1; f1 = dd; tc = pc; bi = ci; bj = cj; }
            else if (dd < f2) { f2 = dd; }
        }
    }
    float tv = 0.97f + 0.09f * rnd3(bi, bj, sd + 3u);
    float gap = f2 - f1;
    float bev = 0.90f + 0.10f * sstep(0.0f, 0.10f, gap);
    float sf = 1.0f + tex * 0.07f * (vnoise3(fx / (2.0f * sc) + 4096.0f, fy / (2.0f * sc) + 4096.0f, 0.0f, sd + 4u) - 0.5f);
    float k = tv * bev * sf;
    float3 tile = make_float3(_saturatef(tc.x * k), _saturatef(tc.y * k), _saturatef(tc.z * k));
    float gw = (0.6f + 2.0f * tex) * sc / s, aw = 0.7f / s;
    float grout = 1.0f - sstep(gw - aw, gw + aw, gap);
    grout = _fmaxf(grout, sstep(0.12f, 0.25f, ec) * (0.5f + 0.5f * det));
    float gn = 0.04f * (rnd3(x, y, sd + 5u) - 0.5f);
    float3 gc = make_float3(0.34f + gn, 0.32f + gn, 0.30f + gn);
    return mix3(tile, gc, grout);
}

__DEVICE__ float3 sprayPaint(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, float fx, float fy, int w, int h, float R,
                             float det, float vib, float tex, float sc, uint sd)
{
    float n = 3.0f + _floorf(det * 3.0f + 0.5f);
    float hs = 0.5f * R;
    int jx = (int)(fx + (rnd3((int)(fx), (int)(fy), sd + 71u) - 0.5f) * hs), jy = (int)(fy + (rnd3((int)(fx), (int)(fy), sd + 72u) - 0.5f) * hs);
    float3 c = toneCut(tent9(tr, tg, tb, jx, jy, w, h, (int)(hs + 0.5f)), n, 0.75f);
    for (int k = 0; k < 3; k++) {
        float cs = (k == 0 ? 2.5f : (k == 1 ? 5.0f : 10.0f)) * sc;
        float occ = k == 0 ? 0.7f : (k == 1 ? 0.45f : 0.2f);
        int ci = (int)(_floorf(fx / cs)), cj = (int)(_floorf(fy / cs));
        uint ks = sd + (uint)(k) * 37u + 50u;
        float rr = (0.2f + 0.22f * rnd3(ci, cj, ks + 1u)) * cs;
        float px = ((float)(ci) + 0.5f + (rnd3(ci, cj, ks + 2u) - 0.5f) * 0.12f) * cs, py = ((float)(cj) + 0.5f + (rnd3(ci, cj, ks + 3u) - 0.5f) * 0.12f) * cs;
        float dd = _sqrtf((fx - px) * (fx - px) + (fy - py) * (fy - py));
        float on = (1.0f - sstep(rr - 0.6f, rr + 0.6f, dd)) * (rnd3(ci, cj, ks + 4u) < occ ? 1.0f : 0.0f);
        if (on > 0.0f) {
            float ra = 2.5f * R * _sqrtf(rnd3(ci, cj, ks + 5u)), aa = 6.2831853f * rnd3(ci, cj, ks + 6u);
            float3 dc = bilL(tr, tg, tb, px + ra * _cosf(aa), py + ra * _sinf(aa), w, h);
            c = mix3(c, toneCut(dc, n, 0.75f), 0.9f * on);
        }
    }
    c = satur(c, 1.0f + 0.6f * vib);
    float mist = rnd3((int)(fx), (int)(fy), sd + 61u) - 0.5f;
    float g = 1.0f + tex * 0.08f * mist;
    return make_float3(_saturatef(c.x * g), _saturatef(c.y * g), _saturatef(c.z * g));
}

__DEVICE__ float3 dvMain(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE2D__ p_TexR, __TEXTURE2D__ p_TexG, __TEXTURE2D__ p_TexB, int dvFrame, float dvProgress, float ptAmount, float ptMode, float ptSize, float ptDetail, float ptAngle, float ptFlow, float ptColour, float ptTexture, float ptBoil, float ptSeed)
{
    int W = p_Width, H = p_Height, x = p_X, y = p_Y;
    float3 c0 = rgbAt(p_TexR, p_TexG, p_TexB, x, y, W, H);
    if (ptAmount <= 0.0f) return c0;
    int m = (int)(ptMode + 0.5f);
    float sc = (float)(H) / 1080.0f, fx = (float)(x), fy = (float)(y);
    float an = ptAngle * 0.0174533f, det = ptDetail / 100.0f, col = ptColour / 100.0f, tex = ptTexture / 100.0f;
    float flow = ptFlow / 100.0f;
    int every = ptBoil <= 0.0f ? 0 : 2 + (int)((100.0f - ptBoil) / 100.0f * 12.0f);
    int bf = every == 0 ? 0 : (int)(dvFrame / every);
    uint sd = (uint)(ptSeed) * 523u + 7u;
    uint sb = sd + (uint)(bf % 4096) * 977u;
    float3 o = c0;
    if (m <= 1) {
        float s1 = (5.0f + 0.22f * ptSize) * sc;
        float s2 = 0.5f * s1;
        float fl = m == 1 ? 1.0f : 0.0f;
        float3 un = tent9(p_TexR, p_TexG, p_TexB, x, y, W, H, (int)(0.15f * s1 + 0.5f));
        float gate = lerp1(0.15f, 0.02f, det);
        float4 a = paintLayer(p_TexR, p_TexG, p_TexB, un, un, fx, fy, W, H, s1, 2, 1.0f, 0.0f, an, flow, col, tex, fl, sc, sb);
        float4 b = paintLayer(p_TexR, p_TexG, p_TexB, make_float3(a.x, a.y, a.z), un, fx, fy, W, H, s2, 1, 0.9f, gate, an, flow, col, tex, fl, sc, sb + 5000u);
        o = make_float3(b.x, b.y, b.z);
        float cv = (fbm(fx / (1.4f * sc), fy / (1.4f * sc), 0.0f, 2, sd + 60u) - 0.5f) * 0.10f * tex * (1.0f - 0.7f * a.w);
        o = make_float3(o.x * (1.0f + cv), o.y * (1.0f + cv), o.z * (1.0f + cv));
        if (m == 1) {
            float e = _fminf(edgeAt(p_TexR, p_TexG, p_TexB, x, y, W, H, (int)(1.5f * sc + 0.5f)), edgeAt(p_TexR, p_TexG, p_TexB, x, y, W, H, (int)(4.0f * sc + 0.5f)));
            float ink = sstep(0.20f - 0.06f * det, 0.30f - 0.08f * det, e);
            o = mix3(o, make_float3(0.05f, 0.04f, 0.06f), ink * 0.92f);
        }
    } else if (m == 2) {
        o = watercolour(p_TexR, p_TexG, p_TexB, fx, fy, W, H, (3.0f + 0.12f * ptSize) * sc, det, col, tex, sc, sd);
    } else if (m == 3) {
        o = tileMosaic(p_TexR, p_TexG, p_TexB, x, y, W, H, (7.0f + 0.26f * ptSize) * sc, det, flow, tex, sc, sd);
    } else {
        o = sprayPaint(p_TexR, p_TexG, p_TexB, fx, fy, W, H, (2.0f + 0.12f * ptSize) * sc, det, col, tex, sc, sb);
    }
    float am = ptAmount / 100.0f;
    return make_float3(_saturatef(lerp1(c0.x, o.x, am)), _saturatef(lerp1(c0.y, o.y, am)), _saturatef(lerp1(c0.z, o.z, am)));
}

// fusegen: the kernel entry (Fusion's rows run bottom up; py is the DCTL's top-down row)
__KERNEL__ void DevelopPaintKd179ded2(__CONSTANTREF__ DevelopPaintPd179ded2 *params, __TEXTURE2D__ p_TexR, __TEXTURE2D__ p_TexG, __TEXTURE2D__ p_TexB, __TEXTURE2D__ dvSrc, __TEXTURE2D_WRITE__ dvDst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->dvSize[0] && y < params->dvSize[1])
    {
        int py = params->dvFlipY != 0 ? params->dvSize[1] - 1 - y : y;
        float3 c = dvMain(params->dvSize[0], params->dvSize[1], x, py, p_TexR, p_TexG, p_TexB, params->dvFrame, params->dvProgress, params->ptAmount, params->ptMode, params->ptSize, params->ptDetail, params->ptAngle, params->ptFlow, params->ptColour, params->ptTexture, params->ptBoil, params->ptSeed);
        float4 s = _tex2DVec4(dvSrc, x, y);
        _tex2DVec4Write(dvDst, x, y, to_float4(c.x, c.y, c.z, s.w));
    }
}
]]

-- the plain source first; the compatibility source only if the plain one does not build
DvSources = { DvMath .. DvMapping .. DvKernelText, DvCompat .. DvMath .. DvMapping .. DvKernelText }
DvWorking = nil

-- the last status of each tool, so a change is reported once
DvLast = {}

-- the compute node's error log (DVIPComputeNode:GetErrorLog, a name in fusionsystem.dll), or a note that it has none
function DvNodeLog(node)
	local log = nil
	if node then
		pcall(function()
			log = node:GetErrorLog()
		end)
	end
	if log == nil or log == "" then
		return "(the node gave no error log; see the Fusion console)"
	end
	return tostring(log)
end

-- report a status: the console, the tool's data and the log file, each once per change
function DvNote(tool, failed, msg)
	local key = DvName
	pcall(function()
		key = tool.Name
	end)
	key = tostring(key)
	local text = msg
	if failed then
		text = "FAILED: " .. msg
	end
	if DvLast[key] == text then
		return
	end
	DvLast[key] = text
	print(DvName .. " [" .. key .. "] " .. text)
	pcall(function()
		tool:SetData("DevelopFuse.Status", text)
	end)
	pcall(function()
		local dir = os.getenv("TEMP") or os.getenv("TMP") or "."
		local f = io.open(dir .. "/DevelopFuse.log", "a")
		if f then
			local line = (text:gsub("[\r\n]+", " | "))
			f:write(os.date("%Y-%m-%d %H:%M:%S") .. "\t" .. key .. "\t" .. DvName .. "\t" .. line .. "\n")
			f:close()
		end
	end)
end

-- a Lua error's message with its traceback when the debug library is there
function DvTrace(e)
	if debug and debug.traceback then
		return debug.traceback(tostring(e), 2)
	end
	return tostring(e)
end

-- the visible error: a solid magenta frame the size of ref (nil when there is no picture to size it by)
function DvFailImage(ref)
	local bad = nil
	if ref then
		pcall(function()
			bad = Image({IMG_Like = ref})
			bad:Fill(Pixel({R = 1.0, G = 0.0, B = 1.0, A = 1.0}))
		end)
	end
	return bad
end

function Create()
	InPtAmount = self:AddInput("Paint", "ptAmount", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 100.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InPtMode = self:AddInput("Mode", "ptMode", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 4.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 4.0,
		INPS_StatusText = "0 Oil Paint, 1 Cartoon Paint, 2 Watercolour, 3 Tile Mosaic, 4 Spray Paint",
		})
	InPtSize = self:AddInput("Size", "ptSize", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "Stroke, wash, tile or overspray size",
		})
	InPtDetail = self:AddInput("Detail", "ptDetail", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "Small strokes into detail; wash steps; how hard tiles cut at edges; spray tones",
		})
	InPtAngle = self:AddInput("Angle", "ptAngle", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 60.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 180.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 180.0,
		INPS_StatusText = "Oil and Cartoon: the strokes' run where the picture is flat",
		})
	InPtFlow = self:AddInput("Flow", "ptFlow", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 80.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "How far strokes and tiles turn to follow the picture's edges",
		})
	InPtColour = self:AddInput("Colour", "ptColour", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 40.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InPtTexture = self:AddInput("Texture", "ptTexture", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InPtBoil = self:AddInput("Boil", "ptBoil", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 25.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "Oil, Cartoon, Spray: how often the painting is redone; 0 holds it",
		})
	InPtSeed = self:AddInput("Seed", "ptSeed", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InFrameOffset = self:AddInput("Frame Offset", "FrameOffset", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Integer = true,
		INP_Default = 0,
		INP_MinScale = 0,
		INP_MaxScale = 1000,
		INPS_StatusText = "Added to the comp frame to make the DCTL's frame value (Resolve's TIMELINE_FRAME_INDEX)",
		})
	InHoldFrame = self:AddInput("Hold Frame", "HoldFrame", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 0,
		INPS_StatusText = "The frame value is Frame Offset alone, so a moving effect holds still",
		})
	InFlipY = self:AddInput("Rows Top Down", "FlipY", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 1,
		IC_Visible = false,
		})
	InInput = self:AddInput("Input", "Input", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
		})
	OutImage = self:AddOutput("Output", "Output", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
		})
end

-- one channel of img as its own texture, rows top-down (DvSplitSource); returns the plane, or nil and why
function DvPlane(req, img, ch, flip)
	local plane = Image({IMG_Like = img})
	local node = DVIPComputeNode(req, DvSplitName, DvSplitSource, DvSplitParamsName, DvSplitParams)
	if not node then
		return nil, "the split kernel's compute node was not created (DVIPComputeNode gave nil)"
	end
	local p = node:GetParamBlock(DvSplitParams)
	p.ch = ch
	p.flipY = flip
	p.size[0] = img.DataWindow:Width()
	p.size[1] = img.DataWindow:Height()
	node:SetParamBlock(p)
	node:AddInput("src", img)
	node:AddOutput("dst", plane)
	if node:RunSession(req) then
		return plane
	end
	return nil, "the split kernel did not run: " .. DvNodeLog(node)
end

-- the kernel over every pixel with source k; returns true when it ran, or false and why
function DvRun(req, k, src, inc, planes, out, frame, flip, progress)
	local node = DVIPComputeNode(req, DvKernelName, DvSources[k], DvParamsName, DvParams)
	if not node then
		return false, "source " .. k .. ": the compute node was not created (DVIPComputeNode gave nil)"
	end
	local p = node:GetParamBlock(DvParams)
	p.ptAmount = InPtAmount:GetValue(req).Value
	p.ptMode = InPtMode:GetValue(req).Value
	p.ptSize = InPtSize:GetValue(req).Value
	p.ptDetail = InPtDetail:GetValue(req).Value
	p.ptAngle = InPtAngle:GetValue(req).Value
	p.ptFlow = InPtFlow:GetValue(req).Value
	p.ptColour = InPtColour:GetValue(req).Value
	p.ptTexture = InPtTexture:GetValue(req).Value
	p.ptBoil = InPtBoil:GetValue(req).Value
	p.ptSeed = InPtSeed:GetValue(req).Value
	p.dvProgress = progress
	p.dvFrame = frame
	p.dvFlipY = flip
	p.dvSize[0] = src.DataWindow:Width()
	p.dvSize[1] = src.DataWindow:Height()
	node:SetParamBlock(p)
	node:AddInput("p_TexR", planes.p_TexR)
	node:AddInput("p_TexG", planes.p_TexG)
	node:AddInput("p_TexB", planes.p_TexB)
	node:AddInput("dvSrc", src)
	node:AddOutput("dvDst", out)
	if node:RunSession(req) then
		return true
	end
	return false, "source " .. k .. ": RunSession failed: " .. DvNodeLog(node)
end

function DvProcess(req)
	local src = InInput:GetValue(req)
	if not src then
		return nil, "no input image", true, nil
	end
	if req:IsPreCalc() then
		return Image({IMG_Like = src, IMG_NoData = true}), nil, false, src
	end
	local inc = nil
	local progress = 0.0
	local out = Image({IMG_Like = src})
	local flip = math.floor(InFlipY:GetValue(req).Value + 0.5)
	local frame = math.floor(InFrameOffset:GetValue(req).Value + 0.5)
	if InHoldFrame:GetValue(req).Value < 0.5 then
		frame = frame + math.floor(req.Time + 0.5)
	end
	local planes = {}
	local why = nil
	planes.p_TexR, why = DvPlane(req, src, 0, flip)
	if not planes.p_TexR then
		return nil, "p_TexR: " .. tostring(why), true, src
	end
	planes.p_TexG, why = DvPlane(req, src, 1, flip)
	if not planes.p_TexG then
		return nil, "p_TexG: " .. tostring(why), true, src
	end
	planes.p_TexB, why = DvPlane(req, src, 2, flip)
	if not planes.p_TexB then
		return nil, "p_TexB: " .. tostring(why), true, src
	end
	local order = {}
	if DvWorking then
		order[1] = DvWorking
	end
	for k = 1, #DvSources do
		if k ~= DvWorking then
			order[#order + 1] = k
		end
	end
	local errs = {}
	for i = 1, #order do
		local ok, err = DvRun(req, order[i], src, inc, planes, out, frame, flip, progress)
		if ok then
			DvWorking = order[i]
			return out, "ok, the kernel runs from source " .. order[i], false, src
		end
		errs[#errs + 1] = tostring(err)
	end
	return nil, "the kernel ran from no source: " .. table.concat(errs, " || "), true, src
end

-- every failure is reported and shows as magenta; the input never passes through quietly
function Process(req)
	local res, msg, failed, ref = nil, nil, true, nil
	local called, err = xpcall(function()
		res, msg, failed, ref = DvProcess(req)
	end, DvTrace)
	if not called then
		res, msg, failed = nil, "Lua error in Process: " .. tostring(err), true
		if not ref then
			pcall(function()
				ref = InInput:GetValue(req)
			end)
		end
	end
	if msg then
		DvNote(self, failed, msg)
	end
	if failed then
		res = DvFailImage(ref)
	end
	OutImage:Set(req, res)
end
