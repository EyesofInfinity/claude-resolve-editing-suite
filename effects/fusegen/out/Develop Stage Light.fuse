		INP_MaxScale = 45.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 45.0,
		})
	InSlSpeed = self:AddInput("Speed", "slSpeed", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 20.0,
		INP_MinScale = 0.0,
