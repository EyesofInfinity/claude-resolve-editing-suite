--[[ Develop Stage Light as a Fusion Fuse: the transform DCTL effects/stage/build/Develop Stage Light.dctl run on the GPU through DVIPComputeNode,
every pixel calling the DCTL's own main function with the DCTL's own controls. Written by
effects/fusegen/fusegen.py; regenerate it, never edit it. The picture is read and written in the values
the DCTL sees in Resolve (Rec.709 gamma 2.4 display values in Develop), with no conversion.
Frame Offset adds to the comp frame for the DCTL's frame value; Hold Frame uses Frame Offset alone.
If the kernel cannot run, the output is solid magenta and the reason is in the Fusion console, in the
tool's data DevelopFuse.Status and in %TEMP%\DevelopFuse.log. MIT License. ]]

FuRegisterClass("DevelopStageLight", CT_Tool, {
	REGS_Category = "Fuses\\Develop",
	REGS_OpIconString = "DSL",
	REGS_OpDescription = "Develop Stage Light (Develop DCTL in a Fuse)",
	REG_NoObjMatCtrls = true,
	REG_NoMotionBlurCtrls = true,
	})

DvName = "Develop Stage Light"
DvKind = "transform"
DvDctl = "stage/build/Develop Stage Light.dctl"

-- the DCTL slider steps, for the record and the inverse mapping (Fusion sliders have no step)
DvSteps = { slAmount = 1.0, slMode = 1.0, slX = 1.0, slY = 1.0, slSize = 1.0, slAspect = 1.0, slAngle = 1.0, slSoft = 1.0, slLight = 0.1, slAmb = 0.1, slGel = 1.0, slSat = 1.0, slHue = 1.0, slSpread = 1.0, slBeams = 1.0, slRigY = 1.0, slRig = 1.0, slFan = 1.0, slHaze = 1.0, slDepth = 1.0, slLand = 1.0, slSweep = 1.0, slSpeed = 1.0, slSeed = 1.0 }

-- this Fuse's own C names for its kernels and parameter structs (never shared with another Fuse)
DvKernelName = "DevelopStageLightK4aec36d6"
DvParamsName = "DevelopStageLightP4aec36d6"
DvSplitName = "DevelopStageLightS4aec36d6"
DvSplitParamsName = "DevelopStageLightSP4aec36d6"

DvParams = [[
	float slAmount;
	float slMode;
	float slX;
	float slY;
	float slSize;
	float slAspect;
	float slAngle;
	float slSoft;
	float slLight;
	float slAmb;
	float slGel;
	float slSat;
	float slHue;
	float slSpread;
	float slBeams;
	float slRigY;
	float slRig;
	float slFan;
	float slHaze;
	float slDepth;
	float slLand;
	float slSweep;
	float slSpeed;
	float slSeed;
	float dvProgress;
	int dvFrame;
	int dvFlipY;
	int dvSize[2];
]]

DvSplitParams = [[
	int ch;
	int flipY;
	int size[2];
]]

DvSplitSource = [[
// one channel of an image as its own texture (the channel in every component), rows turned top-down when
// flipY is set, so a DCTL's _tex2D(plane, x, y) reads what Resolve hands it
__KERNEL__ void DevelopStageLightS4aec36d6(__CONSTANTREF__ DevelopStageLightSP4aec36d6 *params, __TEXTURE2D__ src, __TEXTURE2D_WRITE__ dst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->size[0] && y < params->size[1])
    {
        int sy = params->flipY != 0 ? params->size[1] - 1 - y : y;
        float4 c = _tex2DVec4(src, x, sy);
        float v = params->ch == 0 ? c.x : (params->ch == 1 ? c.y : (params->ch == 2 ? c.z : c.w));
        _tex2DVec4Write(dst, x, y, to_float4(v, v, v, v));
    }
}
]]

