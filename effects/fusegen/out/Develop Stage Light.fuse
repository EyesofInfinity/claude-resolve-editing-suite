		INP_Default = 55.0,
		INP_MinScale = -50.0,
		INP_MaxScale = 150.0,
		INP_MinAllowed = -50.0,
		INP_MaxAllowed = 150.0,
		})
	InSlSize = self:AddInput("Size", "slSize", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 40.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "Spotlight: the pool's size; Stage: each cone's width",
		})
	InSlAspect = self:AddInput("Aspect", "slAspect", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 60.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InSlAngle = self:AddInput("Angle", "slAngle", {
