__DEVICE__ float lumaTexGl(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y)
{
    return luma(_saturatef(dvTex2D(tr, x, y)), _saturatef(dvTex2D(tg, x, y)), _saturatef(dvTex2D(tb, x, y)));
}

__DEVICE__ int greenAnyGl(__TEXTURE2D__ tg, float fx, float fy, float g, int w, int h)
{
    int x0 = (int)(_floorf(fx)), y0 = (int)(_floorf(fy));
    if (x0 < -1 || y0 < -1 || x0 >= w || y0 >= h) return 2;
    int xa = clampi(x0, 0, w - 1), xb = clampi(x0 + 1, 0, w - 1), ya = clampi(y0, 0, h - 1), yb = clampi(y0 + 1, 0, h - 1);
    if (dvTex2D(tg, xa, ya) > g || dvTex2D(tg, xb, ya) > g) return 1;
    return (dvTex2D(tg, xa, yb) > g || dvTex2D(tg, xb, yb) > g) ? 1 : 0;
}

__DEVICE__ float ringDarkGl(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, float rad, float a0, float lim, int w, int h)
{
    float ring = 0.0f;
    for (int i = 0; i < 8; i++) {
        float a = 0.7853982f * (float)(i) + a0;
        int sx = mirL(x + (int)(_round(rad * _cosf(a))), w), sy = mirL(y + (int)(_round(rad * _sinf(a))), h);
        float q = lumaTexGl(tr, tg, tb, sx, sy);
        float bq = sstep(0.45f * lim, 0.9f * lim, q);
        ring += bq;
        if (ring >= 3.5f) return 0.0f;
    }
    return sstep(0.5f, 0.95f, 1.0f - ring / 8.0f);
