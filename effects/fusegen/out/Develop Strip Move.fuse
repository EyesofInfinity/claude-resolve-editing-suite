            float4 h = cardM(X, Y, hw, th, pop, f);
            if (h.w <= 0.0f) continue;
            if (h.z < z1) { z2 = z1; c2 = c1; u2 = u1; v2 = v1; x2 = x1; y2 = y1; t2 = t1; z1 = h.z; c1 = h.w; u1 = h.x; v1 = h.y; x1 = ccx; y1 = ccy; t1 = th; }
            else if (h.z < z2) { z2 = h.z; c2 = h.w; u2 = h.x; v2 = h.y; x2 = ccx; y2 = ccy; t2 = th; }
        }
        float bg = 0.0015f;
        float ar = 0.0f, ag = 0.0f, ab = 0.0f, br = 0.0f, bgg = 0.0f, bb = 0.0f;
        for (int layer = 0; layer < 2; layer++) {
            float cv = layer == 0 ? c1 : c2;
            if (cv <= 0.0f) continue;
            float u = layer == 0 ? u1 : u2, v = layer == 0 ? v1 : v2, ccx = layer == 0 ? x1 : x2, ccy = layer == 0 ? y1 : y2;
            float th = layer == 0 ? t1 : t2, ct = _cosf(th);
            float ua = ct >= 0.0f ? u : -u;
            float sx = vert == 1 ? ccx + ua * hw : ccx + v * hw, sy = vert == 1 ? ccy + v * hw : ccy + ua * hw;
            sx = _clampf(sx, -1.0f, (float)(W)); sy = _clampf(sy, -1.0f, (float)(H));
            float3 c = ct >= 0.0f ? linL(p_FromTexR, p_FromTexG, p_FromTexB, sx, sy, W, H) : linL(p_ToTexR, p_ToTexG, p_ToTexB, sx, sy, W, H);
            float at = _fabs(th), sh = 0.35f + 0.65f * _fabs(ct);
            float gl = lgt * 0.9f * (_expf(-((at - 0.55f) / 0.2f) * ((at - 0.55f) / 0.2f)) + _expf(-((at - 2.59f) / 0.2f) * ((at - 2.59f) / 0.2f)));
            float L = luma(c.x, c.y, c.z);
            float cr = c.x * sh + gl * (0.4f * c.x + 0.3f * L + 0.02f), cg = c.y * sh + gl * (0.4f * c.y + 0.3f * L + 0.02f), cb = c.z * sh + gl * (0.4f * c.z + 0.3f * L + 0.02f);
            if (layer == 0) { ar = cr; ag = cg; ab = cb; } else { br = cr; bgg = cg; bb = cb; }
            k = _fmaxf(k, gl * cv);
        }
        float wov = sstep(0.5f, 3.0f, z2 - z1);
        float rest = _fmaxf(1.0f - c1 - c2, 0.0f), nc = _fmaxf(c1 + c2, 1.0f);
        float o2r = c2 * br + (1.0f - c2) * bg, o2g = c2 * bgg + (1.0f - c2) * bg, o2b = c2 * bb + (1.0f - c2) * bg;
        lr = lerp1((c1 * ar + c2 * br) / nc + rest * bg, c1 * ar + (1.0f - c1) * o2r, wov);
        lg = lerp1((c1 * ag + c2 * bgg) / nc + rest * bg, c1 * ag + (1.0f - c1) * o2g, wov);
        lb = lerp1((c1 * ab + c2 * bb) / nc + rest * bg, c1 * ab + (1.0f - c1) * o2b, wov);
    } else if (st == 1 || st == 2 || st == 10) {
        float sw = Ln / (float)(cnt);
        float qn = (r + 0.5f * Ln) / sw;
        int kk = (int)(_floorf(qn));
        float fr = qn - (float)(kk);
        float db = _fminf(fr, 1.0f - fr) * sw;
        int kn = fr < 0.5f ? kk - 1 : kk + 1;
        float4 c = stripM(st, kk, p_FromTexR, p_FromTexG, p_FromTexB, p_ToTexR, p_ToTexG, p_ToTexB, s, r, Cx, Cy, dx, dy, Ld, Ln, sw, cnt, p, stg, amt, blur, lgt, seed, jt, W, H);
        if (st == 1) {
            if (db < 1.0f) {
                float4 c2 = stripM(st, kn, p_FromTexR, p_FromTexG, p_FromTexB, p_ToTexR, p_ToTexG, p_ToTexB, s, r, Cx, Cy, dx, dy, Ld, Ln, sw, cnt, p, stg, amt, blur, lgt, seed, jt, W, H);
                c = make_float4(c.x + c2.x, c.y + c2.y, c.z + c2.z, c.w + c2.w);
            }
            float bg = 0.0015f * _fmaxf(1.0f - c.w, 0.0f);
            lr = c.x + bg; lg = c.y + bg; lb = c.z + bg;
        } else {
            float wo = _saturatef(0.5f + db);
            if (wo < 1.0f) {
                float4 c2 = stripM(st, kn, p_FromTexR, p_FromTexG, p_FromTexB, p_ToTexR, p_ToTexG, p_ToTexB, s, r, Cx, Cy, dx, dy, Ld, Ln, sw, cnt, p, stg, amt, blur, lgt, seed, jt, W, H);
                c = make_float4(lerp1(c2.x, c.x, wo), lerp1(c2.y, c.y, wo), lerp1(c2.z, c.z, wo), lerp1(c2.w, c.w, wo));
            }
            lr = c.x; lg = c.y; lb = c.z;
            k = c.w;
        }
    } else if (st == 3 || st == 4) {
        float Dt = (0.15f + 1.35f * amt) * (float)(W);
        float len = blur * 0.45f * (float)(W) * bellP;
        float hs = p < 0.5f ? 1.0f : -1.0f, u = p < 0.5f ? 2.0f * p : 2.0f - 2.0f * p;
        float o = hs * Dt * u * u * u;
        float3 c = make_float3(0.0f, 0.0f, 0.0f);
        if (st == 3) {
            float qx = fx - dx * o, qy = fy - dy * o;
            if (p < 0.5f) c = prismM(p_FromTexR, p_FromTexG, p_FromTexB, qx, qy, dx, dy, len, 0.9f, jt, W, H);
            else c = prismM(p_ToTexR, p_ToTexG, p_ToTexB, qx, qy, dx, dy, len, 0.9f, jt, W, H);
        } else {
            float rn = r / (0.5f * Ln);
            float bow = 1.0f + amt * 1.6f * (0.45f - rn * rn + 0.15f * _sinf(3.0f * rn + 6.0f * p));
            float st2 = 1.0f + amt * 0.9f * bellP;
            float ss = s / st2 - o * bow;
            float qx = Cx + ss * dx - r * dy, qy = Cy + ss * dy + r * dx;
            float lb2 = len * bow / st2;
            if (p < 0.5f) c = lineM(p_FromTexR, p_FromTexG, p_FromTexB, qx, qy, dx, dy, lb2, jt, W, H);
            else c = lineM(p_ToTexR, p_ToTexG, p_ToTexB, qx, qy, dx, dy, lb2, jt, W, H);
        }
        float L = luma(c.x, c.y, c.z), ex = 1.0f + lgt * 1.4f * bellP * sstep(0.3f, 0.9f, L);
        lr = c.x * ex; lg = c.y * ex; lb = c.z * ex;
        k = (ex - 1.0f);
    } else if (st == 5 || st == 6) {
        float x = fx / hh, y = fy / hh;
        float u = s / Ld + 0.5f;
        float scl = 0.15f + 0.6f * sz;
        float mB = 0.0f, band = 0.0f, veil = 0.0f, wisp = 0.0f;
        if (st == 5) {
            float ax = x - 0.5f * p * dx, ay = y - 0.5f * p * dy;
            float w1 = fbm(ax / scl, ay / scl, p * 0.9f, 2, seed + 5u) - 0.5f;
            float w2 = fbm(ax / scl + 7.3f, ay / scl, p * 0.9f, 2, seed + 6u) - 0.5f;
            float n = fbm(ax / scl + 0.9f * w1, ay / scl + 0.9f * w2, p * 1.2f, 4, seed);
            float hb = 0.03f + 0.18f * soft, wa = 0.3f * amt;
            float f = -0.35f - wa - 2.0f * hb + (1.7f + 2.0f * wa + 4.0f * hb) * p;
            float v = u + wa * (2.0f * n - 1.0f);
            mB = 1.0f - sstep(f - hb, f + hb, v);
            band = _expf(-((v - f) / (1.4f * hb)) * ((v - f) / (1.4f * hb)));
            wisp = fbm(ax * 3.0f / scl + 1.5f * w1, ay * 3.0f / scl + 1.5f * w2, p * 2.0f, 4, seed + 9u);
            veil = band * (0.25f + 0.75f * wisp * wisp) * (0.5f + 0.6f * amt);
        } else {
            float w1 = fbm(x / scl, y / scl, p * 0.4f, 3, seed + 7u) - 0.5f;
            float w2 = fbm(x / scl + 5.1f, y / scl + 2.7f, p * 0.4f, 3, seed + 8u) - 0.5f;
            float n = fbm(x / scl + 2.0f * w1, y / scl + 2.0f * w2, p * 0.6f, 4, seed + 4u);
            float v = lerp1(u, n, 0.15f + 0.85f * amt);
            float hb = 0.008f + 0.12f * soft;
            float f = -2.0f * hb + (1.0f + 4.0f * hb) * p;
            mB = 1.0f - sstep(f - hb, f + hb, v);
            band = _expf(-((v - f) / (1.2f * hb)) * ((v - f) / (1.2f * hb)));
        }
        if (st == 5) {
            float br = band * 14.0f * sc * (0.3f + 0.7f * sz);
            float3 a = discM(p_FromTexR, p_FromTexG, p_FromTexB, fx, fy, br, jt, W, H);
            float3 b = discM(p_ToTexR, p_ToTexG, p_ToTexB, fx, fy, br, jt, W, H);
            float mr = lerp1(a.x, b.x, mB), mg = lerp1(a.y, b.y, mB), mb = lerp1(a.z, b.z, mB);
            float sr = mr, sg = mg, sb = mb;
            float Ls = luma(sr, sg, sb);
            float gr = 0.6f * sr + 0.4f * Ls, gg2 = 0.6f * sg + 0.4f * Ls, gb = 0.6f * sb + 0.4f * Ls;
            float lift = 1.3f + 1.2f * lgt;
            float vv = _saturatef(veil);
            lr = lerp1(mr, gr * lift + 0.004f * lgt, vv); lg = lerp1(mg, gg2 * lift + 0.004f * lgt, vv); lb = lerp1(mb, gb * lift + 0.004f * lgt, vv);
            k = vv * lgt;
        } else {
            float3 a = linL(p_FromTexR, p_FromTexG, p_FromTexB, fx, fy, W, H);
            float3 b = linL(p_ToTexR, p_ToTexG, p_ToTexB, fx, fy, W, H);
            float mr = lerp1(a.x, b.x, mB), mg = lerp1(a.y, b.y, mB), mb = lerp1(a.z, b.z, mB);
            float ex = 1.0f + 5.0f * lgt * band * band;
            float ln = lgt * 0.05f * band * band * band;
            lr = mr * ex + ln; lg = mg * ex + 0.8f * ln; lb = mb * ex + 0.55f * ln;
            k = lgt * band;
        }
    } else if (st == 7) {
        float cs = hh * 1.6f / (float)(cnt);
        float4 vc = vorM(fx, fy, cs, seed);
        float e = vc.z;
        float o1 = cellOpenM(vc.x, vc.y, Cx, Cy, dx, dy, Ld, p, stg, seed, cs);
        float g2x = _floorf(vc.w / 4096.0f), g2y = vc.w - g2x * 4096.0f;
        g2x -= 2048.0f; g2y -= 2048.0f;
        uint ux2 = (uint)((int)(g2x) + 4096), uy2 = (uint)((int)(g2y) + 4096);
        float s2x = (g2x + 0.1f + 0.8f * hash01(ux2, uy2, seed + 1u)) * cs, s2y = (g2y + 0.1f + 0.8f * hash01(ux2, uy2, seed + 2u)) * cs;
        float o2 = cellOpenM(s2x, s2y, Cx, Cy, dx, dy, Ld, p, stg, seed, cs);
        float d1 = _sqrtf((fx - vc.x) * (fx - vc.x) + (fy - vc.y) * (fy - vc.y));
        float rr = d1 / (d1 + _fmaxf(e, 0.0f) + 1e-4f);
        float bw = 1.0f / (d1 + _fmaxf(e, 0.0f) + 1.0f) + 0.12f * soft;
        float rho = o1 * (1.0f + 3.0f * bw) - bw;
        float m1 = 1.0f - sstep(rho - bw, rho + bw, rr);
        float rho2 = o2 * (1.0f + 3.0f * bw) - bw;
        float m2 = 1.0f - sstep(rho2 - bw, rho2 + bw, 1.0f);
        float wo = _saturatef(0.5f + e);
        float mB = lerp1(m2, m1, wo);
        float3 a = linL(p_FromTexR, p_FromTexG, p_FromTexB, fx, fy, W, H);
        float3 b = linL(p_ToTexR, p_ToTexG, p_ToTexB, fx, fy, W, H);
        float mr = lerp1(a.x, b.x, mB), mg = lerp1(a.y, b.y, mB), mb = lerp1(a.z, b.z, mB);
        float lit = -((fx - vc.x) * 0.7071f + (fy - vc.y) * 0.7071f) / (d1 + 1e-3f);
        float op = _sinf(3.1415927f * o1);
        float rim = _expf(-((rr - rho) / (2.5f * bw)) * ((rr - rho) / (2.5f * bw))) * op * op * (lit > 0.0f ? 1.0f : 0.6f);
        float ex = 1.0f + lgt * 1.6f * rim * lit;
        float seam = 1.0f - lgt * 0.75f * bellP * (1.0f - sstep(0.5f * sc, 2.5f * sc, _fabs(e)));
        lr = mr * ex * seam; lg = mg * ex * seam; lb = mb * ex * seam;
        k = _fmaxf(ex - 1.0f, 0.0f);
    } else if (st == 8) {
        float cs = hh * 1.6f / (float)(cnt);
        float gx = _floorf(fx / cs), gy = _floorf(fy / cs);
        float spread = 0.6f * stg, D = 0.92f - spread;
        float best = -1e9f, cov = 0.0f, bx = 0.0f, by = 0.0f, bR = 1.0f, bt = 1.0f;
        for (int qi = 0; qi < 9; qi++) {
            int i = qi % 3 - 1, j = qi / 3 - 1;
            uint ux = (uint)((int)(gx) + i + 4096), uy = (uint)((int)(gy) + j + 4096);
            float sx = (gx + (float)(i) + 0.25f + 0.5f * hash01(ux, uy, seed + 21u)) * cs;
            float sy = (gy + (float)(j) + 0.25f + 0.5f * hash01(ux, uy, seed + 22u)) * cs;
            float pos = _saturatef(((sx - Cx) * dx + (sy - Cy) * dy) / Ld + 0.5f);
            float tau = spread * (0.7f * pos + 0.3f * hash01(ux, uy, seed + 23u));
            float t = _saturatef((p - tau) / D);
            if (t <= 0.0f) continue;
            float R = 1.15f * cs * t * (2.0f - t) * lerp1(0.8f + 0.2f * hash01(ux, uy, seed + 24u), 1.0f, fade(t));
            float d = _sqrtf((fx - sx) * (fx - sx) + (fy - sy) * (fy - sy));
            cov = _fmaxf(cov, _saturatef(R - d + 0.5f));
            float hgt = R * R - d * d;
            if (hgt > best) { best = hgt; bx = sx; by = sy; bR = R; bt = t; }
        }
        float3 a = linL(p_FromTexR, p_FromTexG, p_FromTexB, fx, fy, W, H);
        if (cov <= 0.0f) { lr = a.x; lg = a.y; lb = a.z; }
        else {
            float nx = (fx - bx) / bR, ny = (fy - by) / bR;
            float n2 = _fminf(nx * nx + ny * ny, 1.0f), nz = _sqrtf(1.0f - n2);
            float gk = 1.0f - fade(bt);
            float g = amt * 0.55f * gk;
            float3 cb = make_float3(0.0f, 0.0f, 0.0f);
            {
                float kr = 1.0f - g * 1.04f * nz, kg = 1.0f - g * nz, kb = 1.0f - g * 0.96f * nz;
                float3 sr = linL(p_ToTexR, p_ToTexG, p_ToTexB, bx + (fx - bx) * kr, by + (fy - by) * kr, W, H);
                float3 sg = linL(p_ToTexR, p_ToTexG, p_ToTexB, bx + (fx - bx) * kg, by + (fy - by) * kg, W, H);
                float3 sb = linL(p_ToTexR, p_ToTexG, p_ToTexB, bx + (fx - bx) * kb, by + (fy - by) * kb, W, H);
                cb = make_float3(sr.x, sg.y, sb.z);
            }
            float fr = (1.0f - nz) * (1.0f - nz) * (1.0f - nz) * gk;
            float hx = nx + 0.38f, hy = ny + 0.42f;
            float wx = (hx * 0.8f + hy * 0.6f) / 0.10f, wy = (-hx * 0.6f + hy * 0.8f) / 0.06f;
            float win = 1.0f - sstep(0.7f, 1.0f, wx * wx + wy * wy);
            float spec = lgt * gk * (1.6f * win + 0.05f * _expf(-(hx * hx + hy * hy) / 0.05f));
            float rr = lerp1(cb.x * (1.0f - 0.4f * fr), a.x, 0.45f * fr) + spec;
            float gg = lerp1(cb.y * (1.0f - 0.4f * fr), a.y, 0.45f * fr) + spec;
            float bb = lerp1(cb.z * (1.0f - 0.4f * fr), a.z, 0.45f * fr) + spec;
            lr = lerp1(a.x, rr, cov); lg = lerp1(a.y, gg, cov); lb = lerp1(a.z, bb, cov);
            k = spec * cov;
        }
    } else if (st == 9) {
        float bw = (0.03f + 0.17f * sz) * hh;
        float e = sstep(0.0f, 1.0f, p);
        float F = -0.5f * Ld - bw - 2.0f + (Ld + 2.0f * bw + 4.0f) * e;
        float q = (s - F) / bw;
        if (_fabs(q) >= 1.0f) {
            float3 c = s < F ? linL(p_ToTexR, p_ToTexG, p_ToTexB, fx, fy, W, H) : linL(p_FromTexR, p_FromTexG, p_FromTexB, fx, fy, W, H);
            lr = c.x; lg = c.y; lb = c.z;
        } else {
            float h = (1.0f - q * q) * (1.0f - q * q);
            float M = 0.9f * amt;
            float rr = 0.0f, gg = 0.0f, bb = 0.0f;
            float dh = -4.0f * q * (1.0f - q * q) / bw;
            for (int c3 = 0; c3 < 3; c3++) {
                float Mi = M * (c3 == 0 ? 1.05f : (c3 == 1 ? 1.0f : 0.95f));
                float sS = F + (s - F) * (1.0f - Mi * h);
                float fp = _fminf(_fabs(1.0f - Mi * h - Mi * (s - F) * dh), 12.0f);
                int nt = fp > 1.0f ? 4 : 1;
                float v = 0.0f;
                for (int t4 = 0; t4 < 4; t4++) {
                    if (t4 >= nt) break;
                    float so = nt == 1 ? 0.0f : (((float)(t4) + 0.5f) / 4.0f - 0.5f) * fp;
                    float sT = sS + so;
                    float qx = fx + (sT - s) * dx, qy = fy + (sT - s) * dy;
                    float wB = _saturatef(F - sT + 0.5f);
                    float3 ca = linL(p_FromTexR, p_FromTexG, p_FromTexB, qx, qy, W, H);
                    float3 cb = linL(p_ToTexR, p_ToTexG, p_ToTexB, qx, qy, W, H);
                    float vA = c3 == 0 ? ca.x : (c3 == 1 ? ca.y : ca.z), vB = c3 == 0 ? cb.x : (c3 == 1 ? cb.y : cb.z);
                    v += lerp1(vA, vB, wB);
                }
                v /= (float)(nt);
                if (c3 == 0) rr = v; else if (c3 == 1) gg = v; else bb = v;
            }
            float aq = _fabs(q);
            float edge = 1.0f - 0.5f * _expf(-((aq - 0.86f) / 0.06f) * ((aq - 0.86f) / 0.06f)) * (1.0f - sstep(0.9f, 1.0f, aq));
            float L = luma(rr, gg, bb);
            float spec = lgt * (1.1f * _expf(-((q + 0.5f) / 0.09f) * ((q + 0.5f) / 0.09f)) + 0.25f * _expf(-((q - 0.62f) / 0.07f) * ((q - 0.62f) / 0.07f)));
            float ww = spec * (0.25f + 0.5f * L);
            lr = rr * edge + ww; lg = gg * edge + ww; lb = bb * edge + ww;
            k = spec;
        }
    }
    float3 o = lightOut(lr, lg, lb, _saturatef(k));
    return make_float4(o.x, o.y, o.z, 1.0f);
}

// fusegen: the kernel entry (Fusion's rows run bottom up; py is the DCTL's top-down row)
__KERNEL__ void DevelopStripMoveKe750d16d(__CONSTANTREF__ DevelopStripMovePe750d16d *params, __TEXTURE2D__ p_FromTexR, __TEXTURE2D__ p_FromTexG, __TEXTURE2D__ p_FromTexB, __TEXTURE2D__ p_FromTexA, __TEXTURE2D__ p_ToTexR, __TEXTURE2D__ p_ToTexG, __TEXTURE2D__ p_ToTexB, __TEXTURE2D__ p_ToTexA, __TEXTURE2D_WRITE__ dvDst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->dvSize[0] && y < params->dvSize[1])
    {
        int py = params->dvFlipY != 0 ? params->dvSize[1] - 1 - y : y;
        float4 c = dvMain(params->dvSize[0], params->dvSize[1], x, py, p_FromTexR, p_FromTexG, p_FromTexB, p_FromTexA, p_ToTexR, p_ToTexG, p_ToTexB, p_ToTexA, params->dvFrame, params->dvProgress, params->smStyle, params->smAngle, params->smCount, params->smAmount, params->smSize, params->smBlur, params->smSoft, params->smLight, params->smStagger, params->smSeed);
        _tex2DVec4Write(dvDst, x, y, c);
    }
}
]]

-- the plain source first; the compatibility source only if the plain one does not build
DvSources = { DvMath .. DvMapping .. DvKernelText, DvCompat .. DvMath .. DvMapping .. DvKernelText }
DvWorking = nil

-- the last status of each tool, so a change is reported once
DvLast = {}

-- the compute node's error log (DVIPComputeNode:GetErrorLog, a name in fusionsystem.dll), or a note that it has none
function DvNodeLog(node)
	local log = nil
	if node then
		pcall(function()
			log = node:GetErrorLog()
		end)
	end
	if log == nil or log == "" then
		return "(the node gave no error log; see the Fusion console)"
	end
	return tostring(log)
end

-- report a status: the console, the tool's data and the log file, each once per change
function DvNote(tool, failed, msg)
	local key = DvName
	pcall(function()
		key = tool.Name
	end)
	key = tostring(key)
	local text = msg
	if failed then
		text = "FAILED: " .. msg
	end
	if DvLast[key] == text then
		return
	end
	DvLast[key] = text
	print(DvName .. " [" .. key .. "] " .. text)
	pcall(function()
		tool:SetData("DevelopFuse.Status", text)
	end)
	pcall(function()
		local dir = os.getenv("TEMP") or os.getenv("TMP") or "."
		local f = io.open(dir .. "/DevelopFuse.log", "a")
		if f then
			local line = (text:gsub("[\r\n]+", " | "))
			f:write(os.date("%Y-%m-%d %H:%M:%S") .. "\t" .. key .. "\t" .. DvName .. "\t" .. line .. "\n")
			f:close()
		end
	end)
end

-- a Lua error's message with its traceback when the debug library is there
function DvTrace(e)
	if debug and debug.traceback then
		return debug.traceback(tostring(e), 2)
	end
	return tostring(e)
end

-- the visible error: a solid magenta frame the size of ref (nil when there is no picture to size it by)
function DvFailImage(ref)
	local bad = nil
	if ref then
		pcall(function()
			bad = Image({IMG_Like = ref})
			bad:Fill(Pixel({R = 1.0, G = 0.0, B = 1.0, A = 1.0}))
		end)
	end
	return bad
end

