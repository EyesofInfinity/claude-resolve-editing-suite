    float br1 = bF10 * DCTB[px * 8 + 0] + bF11 * DCTB[px * 8 + 1] + bF12 * DCTB[px * 8 + 2] + bF13 * DCTB[px * 8 + 3] + bF14 * DCTB[px * 8 + 4] + bF15 * DCTB[px * 8 + 5] + bF16 * DCTB[px * 8 + 6] + bF17 * DCTB[px * 8 + 7];
    float br2 = bF20 * DCTB[px * 8 + 0] + bF21 * DCTB[px * 8 + 1] + bF22 * DCTB[px * 8 + 2] + bF23 * DCTB[px * 8 + 3] + bF24 * DCTB[px * 8 + 4] + bF25 * DCTB[px * 8 + 5] + bF26 * DCTB[px * 8 + 6] + bF27 * DCTB[px * 8 + 7];
    float br3 = bF30 * DCTB[px * 8 + 0] + bF31 * DCTB[px * 8 + 1] + bF32 * DCTB[px * 8 + 2] + bF33 * DCTB[px * 8 + 3] + bF34 * DCTB[px * 8 + 4] + bF35 * DCTB[px * 8 + 5] + bF36 * DCTB[px * 8 + 6] + bF37 * DCTB[px * 8 + 7];
    float br4 = bF40 * DCTB[px * 8 + 0] + bF41 * DCTB[px * 8 + 1] + bF42 * DCTB[px * 8 + 2] + bF43 * DCTB[px * 8 + 3] + bF44 * DCTB[px * 8 + 4] + bF45 * DCTB[px * 8 + 5] + bF46 * DCTB[px * 8 + 6] + bF47 * DCTB[px * 8 + 7];
    float br5 = bF50 * DCTB[px * 8 + 0] + bF51 * DCTB[px * 8 + 1] + bF52 * DCTB[px * 8 + 2] + bF53 * DCTB[px * 8 + 3] + bF54 * DCTB[px * 8 + 4] + bF55 * DCTB[px * 8 + 5] + bF56 * DCTB[px * 8 + 6] + bF57 * DCTB[px * 8 + 7];
    float br6 = bF60 * DCTB[px * 8 + 0] + bF61 * DCTB[px * 8 + 1] + bF62 * DCTB[px * 8 + 2] + bF63 * DCTB[px * 8 + 3] + bF64 * DCTB[px * 8 + 4] + bF65 * DCTB[px * 8 + 5] + bF66 * DCTB[px * 8 + 6] + bF67 * DCTB[px * 8 + 7];
    float br7 = bF70 * DCTB[px * 8 + 0] + bF71 * DCTB[px * 8 + 1] + bF72 * DCTB[px * 8 + 2] + bF73 * DCTB[px * 8 + 3] + bF74 * DCTB[px * 8 + 4] + bF75 * DCTB[px * 8 + 5] + bF76 * DCTB[px * 8 + 6] + bF77 * DCTB[px * 8 + 7];
    float bout = br0 * DCTB[py * 8 + 0] + br1 * DCTB[py * 8 + 1] + br2 * DCTB[py * 8 + 2] + br3 * DCTB[py * 8 + 3] + br4 * DCTB[py * 8 + 4] + br5 * DCTB[py * 8 + 5] + br6 * DCTB[py * 8 + 6] + br7 * DCTB[py * 8 + 7];
    float rr0 = rF00 * DCTB[px * 8 + 0] + rF01 * DCTB[px * 8 + 1] + rF02 * DCTB[px * 8 + 2] + rF03 * DCTB[px * 8 + 3] + rF04 * DCTB[px * 8 + 4] + rF05 * DCTB[px * 8 + 5] + rF06 * DCTB[px * 8 + 6] + rF07 * DCTB[px * 8 + 7];
    float rr1 = rF10 * DCTB[px * 8 + 0] + rF11 * DCTB[px * 8 + 1] + rF12 * DCTB[px * 8 + 2] + rF13 * DCTB[px * 8 + 3] + rF14 * DCTB[px * 8 + 4] + rF15 * DCTB[px * 8 + 5] + rF16 * DCTB[px * 8 + 6] + rF17 * DCTB[px * 8 + 7];
    float rr2 = rF20 * DCTB[px * 8 + 0] + rF21 * DCTB[px * 8 + 1] + rF22 * DCTB[px * 8 + 2] + rF23 * DCTB[px * 8 + 3] + rF24 * DCTB[px * 8 + 4] + rF25 * DCTB[px * 8 + 5] + rF26 * DCTB[px * 8 + 6] + rF27 * DCTB[px * 8 + 7];
    float rr3 = rF30 * DCTB[px * 8 + 0] + rF31 * DCTB[px * 8 + 1] + rF32 * DCTB[px * 8 + 2] + rF33 * DCTB[px * 8 + 3] + rF34 * DCTB[px * 8 + 4] + rF35 * DCTB[px * 8 + 5] + rF36 * DCTB[px * 8 + 6] + rF37 * DCTB[px * 8 + 7];
    float rr4 = rF40 * DCTB[px * 8 + 0] + rF41 * DCTB[px * 8 + 1] + rF42 * DCTB[px * 8 + 2] + rF43 * DCTB[px * 8 + 3] + rF44 * DCTB[px * 8 + 4] + rF45 * DCTB[px * 8 + 5] + rF46 * DCTB[px * 8 + 6] + rF47 * DCTB[px * 8 + 7];
    float rr5 = rF50 * DCTB[px * 8 + 0] + rF51 * DCTB[px * 8 + 1] + rF52 * DCTB[px * 8 + 2] + rF53 * DCTB[px * 8 + 3] + rF54 * DCTB[px * 8 + 4] + rF55 * DCTB[px * 8 + 5] + rF56 * DCTB[px * 8 + 6] + rF57 * DCTB[px * 8 + 7];
    float rr6 = rF60 * DCTB[px * 8 + 0] + rF61 * DCTB[px * 8 + 1] + rF62 * DCTB[px * 8 + 2] + rF63 * DCTB[px * 8 + 3] + rF64 * DCTB[px * 8 + 4] + rF65 * DCTB[px * 8 + 5] + rF66 * DCTB[px * 8 + 6] + rF67 * DCTB[px * 8 + 7];
    float rr7 = rF70 * DCTB[px * 8 + 0] + rF71 * DCTB[px * 8 + 1] + rF72 * DCTB[px * 8 + 2] + rF73 * DCTB[px * 8 + 3] + rF74 * DCTB[px * 8 + 4] + rF75 * DCTB[px * 8 + 5] + rF76 * DCTB[px * 8 + 6] + rF77 * DCTB[px * 8 + 7];
    float rout = rr0 * DCTB[py * 8 + 0] + rr1 * DCTB[py * 8 + 1] + rr2 * DCTB[py * 8 + 2] + rr3 * DCTB[py * 8 + 3] + rr4 * DCTB[py * 8 + 4] + rr5 * DCTB[py * 8 + 5] + rr6 * DCTB[py * 8 + 6] + rr7 * DCTB[py * 8 + 7];
    return make_float2(bout, rout);
}

// ---- 0 JPEG Damage ---------------------------------------------------------------------------------------------
__DEVICE__ float3 scJpeg(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, float sc,
                         float str, float size, float rate, float col, int f, uint sd)
{
    float bs = _fmaxf(1.0f, _floorf(sc * (1.0f + 2.0f * size) + 0.5f));
    float Q = 2.0f + 93.0f * _powf(1.0f - str, 1.5f);
    float S = Q < 50.0f ? 5000.0f / Q : 200.0f - 2.0f * Q;
    float qs = S / 100.0f, qc = qs * _powf(2.0f, 4.0f * col - 2.0f);
    float B = 8.0f * bs, M = 16.0f * bs;
    int mx = (int)((float)(x) / M), my = (int)((float)(y) / M);
    int ncol = (int)((float)(w) / M) + 1, nrow = (int)((float)(h) / M) + 1;
    float dY = 0.0f, dB = 0.0f, dR = 0.0f, garb = 0.0f;
    int shift = 0;
    uint gs = sd * 5u + 1u;
    for (int e = 0; e < 4; e++) {
        uint fe = (uint)(f) * 4u + (uint)(e);
        if (hash01(fe, sd, 3u) >= rate * 0.55f) continue;
        int er = (int)(hash01(fe, sd, 4u) * (float)(nrow)), ec = (int)(hash01(fe, sd, 5u) * (float)(ncol));
        int span = hash01(fe, sd, 13u) < 0.25f ? nrow : 1 + (int)(hash01(fe, sd, 6u) * (1.0f + 3.0f * str));
        if (my < er || my >= er + span || (my == er && mx < ec)) continue;
        dY += (hash01(fe, sd, 7u) - 0.5f) * 80.0f;
        dB += (hash01(fe, sd, 8u) - 0.5f) * 90.0f;
        dR += (hash01(fe, sd, 9u) - 0.5f) * 90.0f;
        int k = 1 + (int)(hash01(fe, sd, 10u) * 5.0f);
        shift += hash01(fe, sd, 11u) < 0.5f ? k : -k;
        int run = (my - er) * ncol + mx - ec;
        if (run < 1 + (int)(hash01(fe, sd, 12u) * 3.0f)) { garb = 1.0f; gs = fe * 7u + 3u; }
    }
    int sx = mx + shift;
    sx = sx - (int)(_floorf((float)(sx) / (float)(ncol))) * ncol;
    float lx = (float)(x) - (float)(mx) * M, ly = (float)(y) - (float)(my) * M;
    int bx = (int)(lx / B), by = (int)(ly / B);
    int px = (int)((lx - (float)(bx) * B) / bs), py = (int)((ly - (float)(by) * B) / bs);
    float ox = (float)(sx) * M, oy = (float)(my) * M;
    float Y = jpegY(tr, tg, tb, ox + (float)(bx) * B, oy + (float)(by) * B, bs, w, h, px, py, qs, garb, gs) + dY;
    float2 C = jpegC(tr, tg, tb, ox, oy, bs, w, h, (int)(lx / (2.0f * bs)), (int)(ly / (2.0f * bs)), qc, garb, gs);
    float cb = C.x + dB, cr = C.y + dR;
    return make_float3(_saturatef((Y + 1.402f * cr) / 255.0f), _saturatef((Y - 0.344136f * cb - 0.714136f * cr) / 255.0f),
                       _saturatef((Y + 1.772f * cb) / 255.0f));
}

// ---- 1 Digital Damage ------------------------------------------------------------------------------------------
__DEVICE__ float3 scDigital(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, float sc,
                            float str, float size, float rate, float col, int f, uint sd)
{
    float3 c = rgbAt(tr, tg, tb, x, y, w, h);
    if (rate <= 0.0f) return c;
    float M = 16.0f * sc * _powf(2.0f, (size - 0.5f) * 2.0f);
    int mx = (int)((float)(x) / M), my = (int)((float)(y) / M);
    int ncol = (int)((float)(w) / M) + 1, nrow = (int)((float)(h) / M) + 1;
    int G = 24 + (int)((1.0f - rate) * 72.0f);
    int slots = 1 + (int)(rate * 2.99f);
    for (int k = 0; k < 3; k++) {
        if (k >= slots) break;
        int ph = (int)(hash01((uint)(k) + 1u, sd, 11u) * (float)(G));
        int fp = f + ph;
        int gi = fp / G, t = fp - gi * G;
        uint gk = (uint)(gi) * 3u + (uint)(k) + 17u;
        int ts = (int)(hash01(gk, sd, 12u) * 0.45f * (float)(G));
        if (t < ts) continue;
        float age = (float)(t - ts);
        int m0 = (int)(hash01(gk, sd, 13u) * (float)(ncol * nrow));
        float len = (float)(ncol) * (0.25f + 3.0f * str) * (0.3f + 0.7f * hash01(gk, sd, 14u)) * (1.0f + age * (0.05f + 0.1f * str));
        int m = my * ncol + mx;
        if (m < m0 || (float)(m - m0) >= len) continue;
        int r0 = m0 / ncol, c0 = m0 - r0 * ncol;
        int gl = 2 + (int)(hash01(gk, sd, 21u) * 12.0f);
        int run = m - m0;
        int gid = run / gl;
        uint gu = (uint)(gid) + 1u;
        float hm = hash01(gu, gk, 15u);
        float drift = (hash01(gk, sd, 16u) - 0.5f) * 2.0f * age * sc * 1.5f;
        float dc = (hash01((uint)(m) + 1u, gk, 17u) - 0.5f) * 0.08f;
        float cell = 4.0f * sc;
        float fx = (_floorf((float)(x) / cell) + 0.5f) * cell - 0.5f, fy = (_floorf((float)(y) / cell) + 0.5f) * cell - 0.5f;
        float3 o;
        if (hm < 0.55f) {
            int rg = mx >= c0 ? r0 : r0 + 1;
            float ys = _fmaxf((float)(rg) * M - 1.0f, 0.0f);
            o = bilL(tr, tg, tb, fx + drift, ys, w, h);
            float st = (rnd3((int)(fx / cell), rg, gk) - 0.5f) * 0.05f;
            o = make_float3(o.x + st, o.y + st, o.z + st);
        } else {
            float mvx = (hash01(gu, gk, 18u) - 0.5f) * 2.0f * M * (1.0f + 0.3f * age);
            float mvy = (hash01(gu, gk, 19u) - 0.5f) * 1.2f * M * (1.0f + 0.15f * age);
            o = bilL(tr, tg, tb, fx + mvx, fy + mvy, w, h);
            if (hm > 1.0f - 0.35f * col) {
                float Yv = 0.299f * o.x + 0.587f * o.y + 0.114f * o.z;
                float zero = hash01(gu, gk, 20u) < 0.3f ? 0.0f : 1.0f;
                Yv *= zero;
                o = make_float3(Yv - 0.701f, Yv + 0.529f, Yv - 0.886f);
            }
        }
        return make_float3(_saturatef(o.x + dc), _saturatef(o.y + dc), _saturatef(o.z + dc));
    }
    return c;
}

// ---- 2 TV Damage -----------------------------------------------------------------------------------------------
__DEVICE__ float3 scTV(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, float sc,
                       float str, float size, float rate, float col, int f, uint sd)
{
    float Wf = (float)(w), Hf = (float)(h), ft = (float)(f);
    float s = _saturatef(str * (0.35f + 1.2f * fbm(ft * 0.035f, 3.7f, 0.0f, 2, sd + 1u)));
    int sp = f / 60, ts = f - sp * 60;
    float Ht = Hf * 1.08f, voff = 0.0f;
    if (hash01((uint)(sp) + 1u, sd, 21u) < rate * 0.7f) {
        float st = hash01((uint)(sp) + 1u, sd, 22u) * 20.0f, dur = 10.0f + 26.0f * hash01((uint)(sp) + 1u, sd, 23u);
        float nr = 1.0f + _floorf(hash01((uint)(sp) + 1u, sd, 24u) * 1.99f);
        voff = sstep(0.0f, dur, (float)(ts) - st) * nr * Ht;
    }
    float yr = _fmod((float)(y) + Ht - voff + Ht * 4.0f, Ht);
    float n = (rnd3(x, y, (uint)(f) * 3u + sd) - 0.5f) * (0.06f + 0.6f * s * s);
    if (yr >= Hf) {
        float rel = (yr - Hf) / (Ht - Hf);
        float dash = rel > 0.55f && rel < 0.62f && rnd3((int)((float)(x) / (7.0f * sc)), (int)(rel * 40.0f), 31u) < 0.5f ? 0.55f : 0.0f;
        float v = 0.02f + dash + 0.5f * n;
        return make_float3(v, v, v);
    }
    int sq = f / 45, tq = f - sq * 45;
    float hold = 0.0f;
    if (hash01((uint)(sq) + 1u, sd, 25u) < rate * 0.5f) {
        float amp = (hash01((uint)(sq) + 1u, sd, 26u) - 0.5f) * 6.0f;
        hold = amp * sstep(0.0f, 8.0f, (float)(tq)) * sstep(45.0f, 30.0f, (float)(tq));
    }
    float Lt = Wf * 1.18f;
    float line = (rnd3((int)(yr), f, sd + 2u) - 0.5f) * 2.0f * s * 2.5f * sc;
    float flag = (fbm(ft * 0.3f, 1.1f, 0.0f, 2, sd + 3u) - 0.5f) * 0.08f * Wf * _expf(-yr / (0.04f * Hf)) * (0.3f + s);
    float xr = _fmod((float)(x) + hold * Lt * (yr / Hf) + line + flag + Lt * 8.0f, Lt);
    if (xr >= Wf) {
        float v = 0.015f + 0.4f * n;
        return make_float3(v, v, v);
    }
    float bw = (0.6f + 2.2f * s) * sc;
    float3 a = bilL(tr, tg, tb, xr - bw, yr, w, h), b = bilL(tr, tg, tb, xr, yr, w, h), d = bilL(tr, tg, tb, xr + bw, yr, w, h);
    float gd = (0.008f + 0.05f * size) * Wf;
    float3 g = bilL(tr, tg, tb, xr - gd, yr, w, h), g2 = bilL(tr, tg, tb, xr - 1.7f * gd, yr, w, h);
    float ga = 0.12f + 0.3f * s, g2a = 0.06f + 0.12f * s;
    float r = (0.25f * a.x + 0.5f * b.x + 0.25f * d.x + ga * g.x - g2a * g2.x) / (1.0f + ga - g2a);
    float gg = (0.25f * a.y + 0.5f * b.y + 0.25f * d.y + ga * g.y - g2a * g2.y) / (1.0f + ga - g2a);
    float bb = (0.25f * a.z + 0.5f * b.z + 0.25f * d.z + ga * g.z - g2a * g2.z) / (1.0f + ga - g2a);
    float Y = luma(r, gg, bb), U = bb - Y, V = r - Y;
    float phi = col * 1.6f * (fbm(ft * 0.02f, 9.1f, 0.0f, 2, sd + 5u) - 0.5f);
    float cp = _cosf(phi), sn = _sinf(phi);
    float kill = 1.0f - (0.4f + 0.6f * col) * sstep(0.45f, 0.75f, s + 0.2f * (hash01((uint)(f) + 1u, sd, 27u) - 0.5f));
    float U2 = (U * cp - V * sn) * kill, V2 = (U * sn + V * cp) * kill;
    float Y2 = 0.42f + (Y - 0.42f) * (1.0f - 0.5f * s);
    float ncx = (float)(x) / (2.2f * sc);
    int nc = (int)(ncx);
    float nt = ncx - (float)(nc);
    float sn2 = (lerp1(rnd3(nc, y, (uint)(f) * 5u + sd), rnd3(nc + 1, y, (uint)(f) * 5u + sd), nt) - 0.5f) * (0.08f + 0.9f * s * s);
    float conf = s * s * col * (1.0f - kill * 0.5f);
    int qx = (int)((float)(x) / (4.0f * sc)), qy = (int)((float)(y) / (2.0f * sc));
    float cu = (rnd3(qx, qy, (uint)(f) * 7u + sd) - 0.5f) * 0.5f * conf, cv = (rnd3(qx, qy, (uint)(f) * 7u + sd + 1u) - 0.5f) * 0.5f * conf;
    float hum = 1.0f - 0.16f * str * (0.5f + 0.5f * _sinf(6.2831853f * (yr / Hf + ft * 0.011f)));
    float Yo = (Y2 + sn2 + 0.4f * n) * hum;
    float R = Yo + V2 + cv, Bc = Yo + U2 + cu;
    float Gc = (Yo - 0.2126f * R - 0.0722f * Bc) / 0.7152f;
    return make_float3(_saturatef(R), _saturatef(Gc), _saturatef(Bc));
}

// ---- 3 Night Vision --------------------------------------------------------------------------------------------
__DEVICE__ float nvIn(float3 c)
{
    return 0.45f * toLin(_saturatef(c.x)) + 0.47f * toLin(_saturatef(c.y)) + 0.08f * toLin(_saturatef(c.z));
}

__DEVICE__ float3 scNight(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, float sc,
                          float str, float size, float rate, float col, float shape, int f, uint sd)
{
    float fx = (float)(x), fy = (float)(y), Wf = (float)(w), Hf = (float)(h);
    float gain = _powf(2.0f, 1.0f + 5.0f * str) * (1.0f + 0.04f * (hash01((uint)(f) + 1u, sd, 41u) - 0.5f));
    float r1 = 0.9f * sc;
    float L = 0.4f * nvIn(bilL(tr, tg, tb, fx, fy, w, h));
    L += 0.15f * (nvIn(bilL(tr, tg, tb, fx - r1, fy, w, h)) + nvIn(bilL(tr, tg, tb, fx + r1, fy, w, h)) +
                  nvIn(bilL(tr, tg, tb, fx, fy - r1, w, h)) + nvIn(bilL(tr, tg, tb, fx, fy + r1, w, h)));
    float R = (6.0f + 30.0f * size) * sc, halo = 0.0f;
    for (int i = 0; i < 16; i++) {
        float an = 6.2831853f * ((float)(i) + 0.5f) / 16.0f;
        float rr = (i & 1) == 0 ? R : 0.55f * R;
        float e = gain * nvIn(bilL(tr, tg, tb, fx + rr * _cosf(an), fy + rr * _sinf(an), w, h));
        halo += sstep(1.5f, 6.0f, e);
    }
    halo /= 16.0f;
    float e0 = gain * L;
    float v = toDisp(1.0f - _expf(-e0) + 0.45f * halo * (1.0f - 0.5f * sstep(1.0f, 4.0f, e0)));
    uint fz = (uint)(f) * 11u + sd;
    float cellf = 1.3f * sc;
    int qx = (int)(fx / cellf), qy = (int)(fy / cellf);
    float nz = rnd3(qx, qy, fz) - 0.5f;
    float spark = rnd3(qx, qy, fz + 1u);
    float dk = 1.0f - _saturatef(v);
    v += rate * (nz * (0.08f + 0.3f * dk) + (spark > 1.0f - 0.006f * dk ? 0.6f * rnd3(qx, qy, fz + 2u) : 0.0f));
    float hs = 5.0f * sc, hx = hs, hy = hs * 1.7320508f;
    float ax = _fmod(fx + 0.5f, hx) - 0.5f * hx, ay = _fmod(fy + 0.5f, hy) - 0.5f * hy;
    float bx = _fmod(fx + 0.5f + 0.5f * hx, hx) - 0.5f * hx, by = _fmod(fy + 0.5f + 0.5f * hy, hy) - 0.5f * hy;
    float hd = _fminf(_sqrtf(ax * ax + ay * ay), _sqrtf(bx * bx + by * by));
    float wall = 1.0f - 0.06f * sstep(0.36f * hs, 0.5f * hs, hd);
    float blem = 1.0f;
    for (int i = 0; i < 7; i++) {
        float bpx = hash01((uint)(i) + 1u, sd, 42u) * Wf, bpy = hash01((uint)(i) + 1u, sd, 43u) * Hf;
        float br = (1.5f + 4.0f * hash01((uint)(i) + 1u, sd, 44u)) * sc;
        float dd = _sqrtf((fx - bpx) * (fx - bpx) + (fy - bpy) * (fy - bpy));
        blem *= 1.0f - 0.75f * sstep(br + 1.0f, br - 1.0f, dd);
    }
    v = _fmaxf(v, 0.0f) * wall * blem;
    float u = fx + 0.5f - 0.5f * Wf, q = fy + 0.5f - 0.5f * Hf, mask;
    int shp = (int)(shape + 0.5f);
    if (shp == 0) {
        float rr = _sqrtf(u * u + q * q) / (0.5f * _sqrtf(Wf * Wf + Hf * Hf));
        mask = 1.0f - 0.55f * rr * rr * rr;
    } else {
        float Rc = (shp == 1 ? 0.47f : 0.44f) * Hf, off = shp == 1 ? 0.0f : 0.29f * Hf, edge = 0.012f * Hf;
        float d1 = _sqrtf((u - off) * (u - off) + q * q), d2 = _sqrtf((u + off) * (u + off) + q * q);
        float dm = _fminf(d1, d2);
        mask = sstep(Rc + edge, Rc - edge, dm) * (1.0f - 0.4f * _powf(_saturatef(dm / Rc), 4.0f));
    }
    v *= mask;
    float vl = toLin(_saturatef(v) * 0.97f);
    float tr0 = lerp1(0.07f, 0.80f, col), tg0 = lerp1(1.0f, 0.90f, col), tb0 = lerp1(0.05f, 1.0f, col);
    float wh = 0.45f * _saturatef(v) * _saturatef(v) * _saturatef(v);
    return make_float3(toDisp(vl * lerp1(tr0, 1.0f, wh)), toDisp(vl * lerp1(tg0, 1.0f, wh)), toDisp(vl * lerp1(tb0, 1.0f, wh)));
}

// ---- 4 X-Ray ---------------------------------------------------------------------------------------------------
__DEVICE__ float xIn(float3 c)
{
    return 0.2126f * _saturatef(c.x) + 0.7152f * _saturatef(c.y) + 0.0722f * _saturatef(c.z);
}

__DEVICE__ float3 scXray(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, float sc,
                         float str, float size, float rate, float col, float shape, int f, uint sd)
{
    float fx = (float)(x), fy = (float)(y);
    float L = xIn(bilL(tr, tg, tb, fx, fy, w, h));
    float ra = (1.5f + 7.0f * size) * sc, Lb = 0.0f, Lw = 0.0f;
    for (int i = 0; i < 12; i++) {
        float an = 6.2831853f * ((float)(i) + 0.25f) / 12.0f;
        float rr = (i & 1) == 0 ? ra : 2.4f * ra;
        float wt = (i & 1) == 0 ? 1.0f : 0.6f;
        Lb += wt * xIn(bilL(tr, tg, tb, fx + rr * _cosf(an), fy + rr * _sinf(an), w, h));
        Lw += wt;
    }
    Lb = (Lb + L) / (Lw + 1.0f);
    int pos = shape > 0.5f ? 1 : 0;
    float d = pos == 1 ? L : 1.0f - L, db = pos == 1 ? Lb : 1.0f - Lb;
    d = d + (0.3f + 1.0f * str) * (d - db);
    float t = _saturatef(0.5f + (d - 0.5f) * (0.75f + 0.8f * str));
    t = lerp1(t, t * t * (3.0f - 2.0f * t), 0.35f);
    float z = rate > 0.0f ? _floorf((float)(f) * (0.25f + 0.75f * rate)) : 0.0f;
    float mot = vnoise3(fx / (2.2f * sc) + 4096.0f, fy / (2.2f * sc) + 4096.0f, z + 4096.0f, sd + 51u) - 0.5f;
    t = _saturatef(t + mot * 0.07f * (0.3f + t));
    float glow = sstep(0.55f, 1.0f, db) * 0.22f;
    float tl = toLin(t) + glow * toLin(t + 0.2f) * 0.5f;
    float br = lerp1(0.93f, 0.55f, col), bg = lerp1(0.96f, 0.80f, col);
    return make_float3(toDisp(0.0015f + tl * br), toDisp(0.0022f + tl * bg), toDisp(0.0045f + tl));
}

// ---- 5 LED Sign ------------------------------------------------------------------------------------------------
__DEVICE__ float3 ledCell(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, float cx, float cy, float P, int w, int h,
                          int i, int j, float lv, float col, uint sd)
{
    float q = 0.25f * P;
    float3 a = bilL(tr, tg, tb, cx - q, cy - q, w, h), b = bilL(tr, tg, tb, cx + q, cy - q, w, h);
    float3 c = bilL(tr, tg, tb, cx - q, cy + q, w, h), d = bilL(tr, tg, tb, cx + q, cy + q, w, h);
    float r = 0.25f * (_saturatef(a.x) + _saturatef(b.x) + _saturatef(c.x) + _saturatef(d.x));
    float g = 0.25f * (_saturatef(a.y) + _saturatef(b.y) + _saturatef(c.y) + _saturatef(d.y));
    float bl = 0.25f * (_saturatef(a.z) + _saturatef(b.z) + _saturatef(c.z) + _saturatef(d.z));
    float Y = luma(r, g, bl);
    r = _saturatef(Y + (r - Y) * col * 2.0f); g = _saturatef(Y + (g - Y) * col * 2.0f); bl = _saturatef(Y + (bl - Y) * col * 2.0f);
    float t = bayer8(i, j) - 0.5f;
    r = softRound(r * lv + t, 8.0f) / lv; g = softRound(g * lv + t, 8.0f) / lv; bl = softRound(bl * lv + t, 8.0f) / lv;
    float dead = hash01((uint)(i + 70000), (uint)(j + 70000), sd + 61u) < 0.0015f ? 0.0f : 1.0f;
    return make_float3(toLin(_saturatef(r)) * dead, toLin(_saturatef(g)) * dead, toLin(_saturatef(bl)) * dead);
}

__DEVICE__ float3 scLed(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, float sc,
                        float str, float size, float rate, float col, float dith, float shape, int f, uint sd)
{
    float Wf = (float)(w), Hf = (float)(h), fx = (float)(x), fy = (float)(y);
    float P = (6.0f + 34.0f * size) * sc;
    float u = (fx + 0.5f - 0.5f * Wf) / P, v = (fy + 0.5f - 0.5f * Hf) / P;
    int ci = (int)(_floorf(u)), cj = (int)(_floorf(v));
    float lv = lerp1(48.0f, 3.0f, dith);
    int shp = (int)(shape + 0.5f);
    float band = 1.0f;
    if (rate > 0.0f) {
        float ph = 0.5f + 0.5f * _cosf(6.2831853f * (fy / Hf * 2.5f - (float)(f) * 0.06f * rate));
        band = 1.0f - 0.55f * rate * ph * ph * ph * ph;
    }
    float lr = 0.0008f, lg = 0.0008f, lb = 0.0008f;
    float gr = 0.0f, gg = 0.0f, gb = 0.0f;
    float gw = 0.28f * P, gk = 0.3f * str;
    for (int dj = -1; dj <= 1; dj++) {
        for (int di = -1; di <= 1; di++) {
            int i = ci + di, j = cj + dj;
            float cxp = ((float)(i) + 0.5f) * P + 0.5f * Wf - 0.5f, cyp = ((float)(j) + 0.5f) * P + 0.5f * Hf - 0.5f;
            float3 e = ledCell(tr, tg, tb, cxp, cyp, P, w, h, i, j, lv, col, sd);
            for (int k = 0; k < 3; k++) {
                if (shp != 1 && k > 0) break;
                float ox = 0.0f, oy = 0.0f, rad = 0.36f * P;
                float er = e.x, eg = e.y, eb = e.z;
                if (shp == 2) {
                    float Ye = 0.2126f * er + 0.7152f * eg + 0.0722f * eb;
                    er = Ye * 1.0f; eg = Ye * 0.36f; eb = Ye * 0.025f;
                }
                if (shp == 1) {
                    rad = 0.19f * P;
                    ox = k == 0 ? 0.0f : (k == 1 ? -0.21f * P : 0.21f * P);
                    oy = k == 0 ? -0.2f * P : 0.14f * P;
                    float lum = k == 0 ? er : (k == 1 ? eg : eb);
                    er = k == 0 ? lum * 1.0f : (k == 1 ? lum * 0.06f : lum * 0.03f);
                    eg = k == 0 ? lum * 0.05f : (k == 1 ? lum * 1.0f : lum * 0.22f);
                    eb = k == 0 ? lum * 0.01f : (k == 1 ? lum * 0.28f : lum * 1.0f);
                    float lift = 2.4f;
                    er *= lift; eg *= lift; eb *= lift;
                }
                float dx = fx - (cxp + ox), dy = fy - (cyp + oy);
                float dd = _sqrtf(dx * dx + dy * dy);
                float cov = sstep(rad + 0.75f, rad - 0.75f, dd);
                float dome = 1.15f - 0.4f * (dd / rad) * (dd / rad);
                float shine = 0.006f * sstep(0.3f * rad, 0.05f * rad, _sqrtf((dx + 0.3f * rad) * (dx + 0.3f * rad) + (dy + 0.35f * rad) * (dy + 0.35f * rad)));
                lr = lerp1(lr, 0.0025f + er * dome * band + shine, cov);
                lg = lerp1(lg, 0.0025f + eg * dome * band + shine, cov);
                lb = lerp1(lb, 0.0025f + eb * dome * band + shine, cov);
                float gl = gk * _expf(-(dd / gw) * (dd / gw)) * sstep(1.4f * P, 1.0f * P, dd) * band;
                gr += gl * er; gg += gl * eg; gb += gl * eb;
            }
        }
    }
    return lightOut(lr + gr, lg + gg, lb + gb, 1.0f);
}

// ---- 6 Misalignment --------------------------------------------------------------------------------------------
__DEVICE__ float3 scMisalign(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, float sc,
                             float str, float size, float rate, float col, int f, uint sd)
{
    float fx = (float)(x), fy = (float)(y), Wf = (float)(w), Hf = (float)(h), ft = (float)(f);
    float u = (fx + 0.5f - 0.5f * Wf) / Hf, v = (fy + 0.5f - 0.5f * Hf) / Hf, r2 = u * u + v * v;
    float wob = 1.0f + rate * (0.18f * _sinf(ft * 0.21f) + 0.08f * _sinf(ft * 0.83f + 1.0f) + 0.05f * (hash01((uint)(f) + 1u, sd, 71u) - 0.5f));
    float A = str * sc * wob;
    float a1 = 6.2831853f * hash01(1u, sd, 72u), a2 = a1 + 2.4f + 1.2f * hash01(2u, sd, 72u);
    float sr = 4.0f * A, dr = 26.0f * A;
    float ka = 0.7f + 0.6f * hash01(3u, sd, 72u), kb = -(0.7f + 0.6f * hash01(4u, sd, 72u));
    float tw = 0.5f * (hash01(5u, sd, 72u) - 0.5f);
    float rx = sr * _cosf(a1) + dr * (ka * u * r2 * 2.0f - tw * v), ry = sr * _sinf(a1) + dr * (ka * v * r2 * 2.0f + tw * u);
    float bx = sr * _cosf(a2) + dr * (kb * u * r2 * 2.0f + tw * v), by = sr * _sinf(a2) + dr * (kb * v * r2 * 2.0f - tw * u);
    float gx = 0.25f * dr * u * r2, gy = 0.25f * dr * v * r2;
    float fr = (0.4f + 1.6f * size) * sc, fb = (0.8f + 3.0f * size) * sc;
    float R = 0.0f, G = 0.0f, B = 0.0f;
    for (int i = 0; i < 5; i++) {
        float ox = i == 1 ? 1.0f : (i == 2 ? -1.0f : 0.0f), oy = i == 3 ? 1.0f : (i == 4 ? -1.0f : 0.0f);
        float wt = i == 0 ? 0.4f : 0.15f;
        R += wt * toLin(_saturatef(bilL(tr, tg, tb, fx + rx + ox * fr, fy + ry + oy * fr, w, h).x));
        G += wt * toLin(_saturatef(bilL(tr, tg, tb, fx + gx + ox * 0.3f * sc, fy + gy + oy * 0.3f * sc, w, h).y));
        B += wt * toLin(_saturatef(bilL(tr, tg, tb, fx + bx + ox * fb, fy + by + oy * fb, w, h).z));
    }
    float p1 = col * sstep(0.52f, 0.78f, fbm(u * 1.4f + 3.0f, v * 1.4f + 3.0f, 0.0f, 3, sd + 73u)) * (0.3f + 2.2f * r2);
    float p2 = col * sstep(0.52f, 0.78f, fbm(u * 1.4f + 9.0f, v * 1.4f + 1.0f, 0.0f, 3, sd + 74u)) * (0.3f + 2.2f * r2);
    p1 = _saturatef(p1) * 0.5f; p2 = _saturatef(p2) * 0.5f;
    float R2 = R * (1.0f - p1) + B * p2, G2 = G + R * p1 * 0.8f, B2 = B * (1.0f - p2) + G * p2 * 0.3f;
    return make_float3(toDisp(R2), toDisp(G2), toDisp(B2));
}

// ---- 7 Video Glitch --------------------------------------------------------------------------------------------
__DEVICE__ float3 scVGlitch(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, float sc,
                            float str, float size, float rate, float col, int f, uint sd)
{
    float Wf = (float)(w), Hf = (float)(h), fx = (float)(x), fy = (float)(y);
    float e = 0.0f;
    for (int k = 0; k < 2; k++) {
        int fk = f + k * 7;
        int win = fk / 16, tw = fk - win * 16;
        uint wk = (uint)(win) * 2u + (uint)(k) + 1u;
        if (hash01(wk, sd, 81u) >= 0.1f + 0.85f * rate) continue;
        int st = (int)(hash01(wk, sd, 82u) * 8.0f), ln = 2 + (int)(hash01(wk, sd, 83u) * 9.0f);
        if (tw >= st && tw < st + ln) e = _fmaxf(e, 0.5f + 0.5f * hash01((uint)(f) + 1u, sd, 84u + (uint)(k)));
    }
    e *= str;
    uint fz = (uint)(f) * 13u + sd;
    float sx = fx, sy = fy;
    float swap = 0.0f, rgbyuv = 0.0f, dark = 1.0f;
    if (e > 0.0f) {
        float bh = (3.0f + 60.0f * size) * sc;
        int band = (int)(fy / bh);
        float bt = (float)(band) * bh;
        float hb = rnd3(band, f, sd + 85u);
        if (hb < 0.55f * e) {
            float kind = rnd3(band, f, sd + 86u);
            if (kind < 0.3f) {
                sy = _fmaxf(bt - 1.0f, 0.0f);
            } else if (kind < 0.7f) {
                float dx = (rnd3(band, f, sd + 87u) - 0.5f) * 2.0f * Wf * (0.05f + 0.35f * e);
                float xs = _fmod(fx - dx + Wf * 4.0f, Wf);
                float seam = _fmod(dx + Wf * 4.0f, Wf);
                dark = 1.0f - 0.9f * sstep(4.0f * sc, 1.0f * sc, _fabs(fx - seam));
                sx = xs;
            } else {
                int odd = y & 1;
                sx = fx + (odd == 1 ? (rnd3(band, f, sd + 88u) - 0.5f) * 40.0f * sc * (0.3f + e) : 0.0f);
            }
            float cs = rnd3(band, f, sd + 89u);
            if (cs < 0.5f * col) swap = 1.0f;
            else if (cs < 0.75f * col) rgbyuv = 1.0f;
        }
    }
    float3 c = bilL(tr, tg, tb, sx, sy, w, h);
    float r = _saturatef(c.x), g = _saturatef(c.y), b = _saturatef(c.z);
    if (swap > 0.0f) {
        float Y = 0.299f * r + 0.587f * g + 0.114f * b, U = 0.564f * (b - Y), V = 0.713f * (r - Y);
        r = Y + 1.402f * U; g = Y - 0.344f * V - 0.714f * U; b = Y + 1.772f * V;
    }
    if (rgbyuv > 0.0f) {
        float Y = 0.299f * r + 0.587f * g + 0.114f * b, U = 0.564f * (b - Y) + 0.5f, V = 0.713f * (r - Y) + 0.5f;
        r = V; g = Y; b = U;
    }
    r *= dark; g *= dark; b *= dark;
    float dens = str * 0.0006f + e * 0.006f;
    for (int k = 0; k < 4; k++) {
        float hs = rnd3(x - k, y, fz);
        if (hs < dens && (float)(k) < 1.0f + rnd3(x - k, y, fz + 1u) * 4.0f) {
            float kc = rnd3(x - k, y, fz + 2u);
            r = kc < 0.4f ? 1.0f : (kc < 0.6f ? 0.0f : rnd3(x - k, y, fz + 3u));
            g = kc < 0.4f ? 1.0f : (kc < 0.6f ? 0.0f : rnd3(x - k, y, fz + 4u));
            b = kc < 0.4f ? 1.0f : (kc < 0.6f ? 0.0f : rnd3(x - k, y, fz + 5u));
            break;
        }
    }
    return make_float3(_saturatef(r), _saturatef(g), _saturatef(b));
}

__DEVICE__ float3 dvMain(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE2D__ p_TexR, __TEXTURE2D__ p_TexG, __TEXTURE2D__ p_TexB, int dvFrame, float dvProgress, float scAmount, float scMode, float scStrength, float scSize, float scRate, float scColour, float scShape, float scDither, float scSeed)
{
    int W = p_Width, H = p_Height, x = p_X, y = p_Y;
    float3 c0 = rgbAt(p_TexR, p_TexG, p_TexB, x, y, W, H);
    if (scAmount <= 0.0f) return c0;
    int m = (int)(scMode + 0.5f), f = dvFrame;
    float sc = (float)(H) / 1080.0f, amt = scAmount / 100.0f;
    float str = scStrength / 100.0f, size = scSize / 100.0f, rate = scRate / 100.0f, col = scColour / 100.0f;
    float dith = scDither / 100.0f;
    uint sd = (uint)(scSeed) * 977u + 7u;
    float3 o = c0;
    float grit = 0.3f;
    if (m == 0) { o = scJpeg(p_TexR, p_TexG, p_TexB, x, y, W, H, sc, str, size, rate, col, f, sd); grit = 0.15f; }
    else if (m == 1) { o = scDigital(p_TexR, p_TexG, p_TexB, x, y, W, H, sc, str, size, rate, col, f, sd); grit = 0.25f; }
    else if (m == 2) { o = scTV(p_TexR, p_TexG, p_TexB, x, y, W, H, sc, str, size, rate, col, f, sd); grit = 0.45f; }
    else if (m == 3) { o = scNight(p_TexR, p_TexG, p_TexB, x, y, W, H, sc, str, size, rate, _saturatef(2.0f * col - 1.0f), scShape, f, sd); grit = 0.4f; }
    else if (m == 4) { o = scXray(p_TexR, p_TexG, p_TexB, x, y, W, H, sc, str, size, rate, col, scShape, f, sd); grit = 0.3f; }
    else if (m == 5) { o = scLed(p_TexR, p_TexG, p_TexB, x, y, W, H, sc, str, size, rate, col, dith, scShape, f, sd); }
    else if (m == 6) { o = scMisalign(p_TexR, p_TexG, p_TexB, x, y, W, H, sc, str, size, rate, col, f, sd); grit = 0.35f; }
    else { o = scVGlitch(p_TexR, p_TexG, p_TexB, x, y, W, H, sc, str, size, rate, col, f, sd); grit = 0.4f; }
    o = make_float3(lerp1(c0.x, o.x, amt), lerp1(c0.y, o.y, amt), lerp1(c0.z, o.z, amt));
    if (m == 5) return make_float3(_saturatef(o.x), _saturatef(o.y), _saturatef(o.z));
    return gritFinish(o, x, y, H, amt, grit, dith, (uint)(f) * 17u + sd);
}

// fusegen: the kernel entry (Fusion's rows run bottom up; py is the DCTL's top-down row)
__KERNEL__ void DevelopScreenK3969eca8(__CONSTANTREF__ DevelopScreenP3969eca8 *params, __TEXTURE2D__ p_TexR, __TEXTURE2D__ p_TexG, __TEXTURE2D__ p_TexB, __TEXTURE2D__ dvSrc, __TEXTURE2D_WRITE__ dvDst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->dvSize[0] && y < params->dvSize[1])
    {
        int py = params->dvFlipY != 0 ? params->dvSize[1] - 1 - y : y;
        float3 c = dvMain(params->dvSize[0], params->dvSize[1], x, py, p_TexR, p_TexG, p_TexB, params->dvFrame, params->dvProgress, params->scAmount, params->scMode, params->scStrength, params->scSize, params->scRate, params->scColour, params->scShape, params->scDither, params->scSeed);
        float4 s = _tex2DVec4(dvSrc, x, y);
        _tex2DVec4Write(dvDst, x, y, to_float4(c.x, c.y, c.z, s.w));
    }
}
]]

-- the plain source first; the compatibility source only if the plain one does not build
DvSources = { DvMath .. DvMapping .. DvKernelText, DvCompat .. DvMath .. DvMapping .. DvKernelText }
DvWorking = nil

-- the last status of each tool, so a change is reported once
DvLast = {}

-- the compute node's error log (DVIPComputeNode:GetErrorLog, a name in fusionsystem.dll), or a note that it has none
function DvNodeLog(node)
	local log = nil
	if node then
		pcall(function()
			log = node:GetErrorLog()
		end)
	end
	if log == nil or log == "" then
		return "(the node gave no error log; see the Fusion console)"
	end
	return tostring(log)
end

-- report a status: the console, the tool's data and the log file, each once per change
function DvNote(tool, failed, msg)
	local key = DvName
	pcall(function()
		key = tool.Name
	end)
	key = tostring(key)
	local text = msg
	if failed then
		text = "FAILED: " .. msg
	end
	if DvLast[key] == text then
		return
	end
	DvLast[key] = text
	print(DvName .. " [" .. key .. "] " .. text)
	pcall(function()
		tool:SetData("DevelopFuse.Status", text)
	end)
	pcall(function()
		local dir = os.getenv("TEMP") or os.getenv("TMP") or "."
		local f = io.open(dir .. "/DevelopFuse.log", "a")
		if f then
			local line = (text:gsub("[\r\n]+", " | "))
			f:write(os.date("%Y-%m-%d %H:%M:%S") .. "\t" .. key .. "\t" .. DvName .. "\t" .. line .. "\n")
			f:close()
		end
	end)
end

-- a Lua error's message with its traceback when the debug library is there
function DvTrace(e)
	if debug and debug.traceback then
		return debug.traceback(tostring(e), 2)
	end
	return tostring(e)
end

-- the visible error: a solid magenta frame the size of ref (nil when there is no picture to size it by)
function DvFailImage(ref)
	local bad = nil
	if ref then
		pcall(function()
			bad = Image({IMG_Like = ref})
			bad:Fill(Pixel({R = 1.0, G = 0.0, B = 1.0, A = 1.0}))
		end)
	end
	return bad
end

function Create()
	InScAmount = self:AddInput("Screen", "scAmount", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 100.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InScMode = self:AddInput("Mode", "scMode", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 7.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 7.0,
		INPS_StatusText = "0 JPEG Damage, 1 Digital Damage, 2 TV Damage, 3 Night Vision, 4 X-Ray, 5 LED Sign, 6 Misalignment, 7 Video Glitch",
		})
	InScStrength = self:AddInput("Strength", "scStrength", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 60.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "How bad: JPEG quality, damage spread, signal loss, tube gain, film contrast, LED glow, convergence error, link errors",
		})
	InScSize = self:AddInput("Size", "scSize", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "JPEG sample size, macroblock size, ghost delay, halo size, X-ray edge radius, LED pitch, beam focus, glitch band height",
		})
	InScRate = self:AddInput("Rate", "scRate", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "How often: bit errors, packet loss, hold slips, scintillation, mottle speed, LED scan bands, beam wobble, link drops",
		})
	InScColour = self:AddInput("Colour", "scColour", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "JPEG colour crush, green blocks, hue drift, phosphor (over 50 toward white), X-ray blue, LED saturation, purity, colour-space bands",
		})
	InScShape = self:AddInput("Shape", "scShape", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 2.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 2.0,
		INPS_StatusText = "Night Vision: 0 full frame, 1 one eyepiece, 2 two; X-Ray: 0 negative, 1 bright as dense; LED Sign: 0 full colour, 1 RGB lamp clusters, 2 amber",
		})
	InScDither = self:AddInput("Dither", "scDither", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "The picture crushed to few levels through a Bayer dither; LED Sign: brightness levels dithered across the emitters",
		})
	InScSeed = self:AddInput("Seed", "scSeed", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InFrameOffset = self:AddInput("Frame Offset", "FrameOffset", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Integer = true,
		INP_Default = 0,
		INP_MinScale = 0,
		INP_MaxScale = 1000,
		INPS_StatusText = "Added to the comp frame to make the DCTL's frame value (Resolve's TIMELINE_FRAME_INDEX)",
		})
	InHoldFrame = self:AddInput("Hold Frame", "HoldFrame", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 0,
		INPS_StatusText = "The frame value is Frame Offset alone, so a moving effect holds still",
		})
	InFlipY = self:AddInput("Rows Top Down", "FlipY", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 1,
		IC_Visible = false,
		})
	InInput = self:AddInput("Input", "Input", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
		})
	OutImage = self:AddOutput("Output", "Output", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
		})
end

-- one channel of img as its own texture, rows top-down (DvSplitSource); returns the plane, or nil and why
function DvPlane(req, img, ch, flip)
	local plane = Image({IMG_Like = img})
	local node = DVIPComputeNode(req, DvSplitName, DvSplitSource, DvSplitParamsName, DvSplitParams)
	if not node then
		return nil, "the split kernel's compute node was not created (DVIPComputeNode gave nil)"
	end
	local p = node:GetParamBlock(DvSplitParams)
	p.ch = ch
	p.flipY = flip
	p.size[0] = img.DataWindow:Width()
	p.size[1] = img.DataWindow:Height()
	node:SetParamBlock(p)
	node:AddInput("src", img)
	node:AddOutput("dst", plane)
	if node:RunSession(req) then
		return plane
	end
	return nil, "the split kernel did not run: " .. DvNodeLog(node)
end

-- the kernel over every pixel with source k; returns true when it ran, or false and why
function DvRun(req, k, src, inc, planes, out, frame, flip, progress)
	local node = DVIPComputeNode(req, DvKernelName, DvSources[k], DvParamsName, DvParams)
	if not node then
		return false, "source " .. k .. ": the compute node was not created (DVIPComputeNode gave nil)"
	end
	local p = node:GetParamBlock(DvParams)
	p.scAmount = InScAmount:GetValue(req).Value
	p.scMode = InScMode:GetValue(req).Value
	p.scStrength = InScStrength:GetValue(req).Value
	p.scSize = InScSize:GetValue(req).Value
	p.scRate = InScRate:GetValue(req).Value
	p.scColour = InScColour:GetValue(req).Value
	p.scShape = InScShape:GetValue(req).Value
	p.scDither = InScDither:GetValue(req).Value
	p.scSeed = InScSeed:GetValue(req).Value
	p.dvProgress = progress
	p.dvFrame = frame
	p.dvFlipY = flip
	p.dvSize[0] = src.DataWindow:Width()
	p.dvSize[1] = src.DataWindow:Height()
	node:SetParamBlock(p)
	node:AddInput("p_TexR", planes.p_TexR)
	node:AddInput("p_TexG", planes.p_TexG)
	node:AddInput("p_TexB", planes.p_TexB)
	node:AddInput("dvSrc", src)
	node:AddOutput("dvDst", out)
	if node:RunSession(req) then
		return true
	end
	return false, "source " .. k .. ": RunSession failed: " .. DvNodeLog(node)
end

function DvProcess(req)
	local src = InInput:GetValue(req)
	if not src then
		return nil, "no input image", true, nil
	end
	if req:IsPreCalc() then
		return Image({IMG_Like = src, IMG_NoData = true}), nil, false, src
	end
	local inc = nil
	local progress = 0.0
	local out = Image({IMG_Like = src})
	local flip = math.floor(InFlipY:GetValue(req).Value + 0.5)
	local frame = math.floor(InFrameOffset:GetValue(req).Value + 0.5)
	if InHoldFrame:GetValue(req).Value < 0.5 then
		frame = frame + math.floor(req.Time + 0.5)
	end
	local planes = {}
	local why = nil
	planes.p_TexR, why = DvPlane(req, src, 0, flip)
	if not planes.p_TexR then
		return nil, "p_TexR: " .. tostring(why), true, src
	end
	planes.p_TexG, why = DvPlane(req, src, 1, flip)
	if not planes.p_TexG then
		return nil, "p_TexG: " .. tostring(why), true, src
	end
	planes.p_TexB, why = DvPlane(req, src, 2, flip)
	if not planes.p_TexB then
		return nil, "p_TexB: " .. tostring(why), true, src
	end
	local order = {}
	if DvWorking then
		order[1] = DvWorking
	end
	for k = 1, #DvSources do
		if k ~= DvWorking then
			order[#order + 1] = k
		end
	end
	local errs = {}
	for i = 1, #order do
		local ok, err = DvRun(req, order[i], src, inc, planes, out, frame, flip, progress)
		if ok then
			DvWorking = order[i]
			return out, "ok, the kernel runs from source " .. order[i], false, src
		end
		errs[#errs + 1] = tostring(err)
	end
	return nil, "the kernel ran from no source: " .. table.concat(errs, " || "), true, src
end

-- every failure is reported and shows as magenta; the input never passes through quietly
function Process(req)
	local res, msg, failed, ref = nil, nil, true, nil
	local called, err = xpcall(function()
		res, msg, failed, ref = DvProcess(req)
	end, DvTrace)
	if not called then
		res, msg, failed = nil, "Lua error in Process: " .. tostring(err), true
		if not ref then
			pcall(function()
				ref = InInput:GetValue(req)
			end)
		end
	end
	if msg then
		DvNote(self, failed, msg)
	end
	if failed then
		res = DvFailImage(ref)
	end
	OutImage:Set(req, res)
end
