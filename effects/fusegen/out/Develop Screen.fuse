--[[ Develop Screen as a Fusion Fuse: the transform DCTL effects/screens/build/Develop Screen.dctl run on the GPU through DVIPComputeNode,
every pixel calling the DCTL's own main function with the DCTL's own controls. Written by
effects/fusegen/fusegen.py; regenerate it, never edit it. The picture is read and written in the values
the DCTL sees in Resolve (Rec.709 gamma 2.4 display values in Develop), with no conversion.
Frame Offset adds to the comp frame for the DCTL's frame value; Hold Frame uses Frame Offset alone.
If the kernel cannot run, the output is solid magenta and the reason is in the Fusion console, in the
tool's data DevelopFuse.Status and in %TEMP%\DevelopFuse.log. MIT License. ]]

FuRegisterClass("DevelopScreen", CT_Tool, {
	REGS_Category = "Fuses\\Develop",
	REGS_OpIconString = "DS",
	REGS_OpDescription = "Develop Screen (Develop DCTL in a Fuse)",
	REG_NoObjMatCtrls = true,
	REG_NoMotionBlurCtrls = true,
	})

DvName = "Develop Screen"
DvKind = "transform"
DvDctl = "screens/build/Develop Screen.dctl"

-- the DCTL slider steps, for the record and the inverse mapping (Fusion sliders have no step)
DvSteps = { scAmount = 1.0, scMode = 1.0, scStrength = 1.0, scSize = 1.0, scRate = 1.0, scColour = 1.0, scShape = 1.0, scDither = 1.0, scSeed = 1.0 }

-- this Fuse's own C names for its kernels and parameter structs (never shared with another Fuse)
DvKernelName = "DevelopScreenK3969eca8"
DvParamsName = "DevelopScreenP3969eca8"
DvSplitName = "DevelopScreenS3969eca8"
DvSplitParamsName = "DevelopScreenSP3969eca8"

DvParams = [[
	float scAmount;
	float scMode;
	float scStrength;
	float scSize;
	float scRate;
	float scColour;
	float scShape;
	float scDither;
	float scSeed;
	float dvProgress;
	int dvFrame;
	int dvFlipY;
	int dvSize[2];
]]

DvSplitParams = [[
	int ch;
	int flipY;
	int size[2];
]]

DvSplitSource = [[
// one channel of an image as its own texture (the channel in every component), rows turned top-down when
// flipY is set, so a DCTL's _tex2D(plane, x, y) reads what Resolve hands it
__KERNEL__ void DevelopScreenS3969eca8(__CONSTANTREF__ DevelopScreenSP3969eca8 *params, __TEXTURE2D__ src, __TEXTURE2D_WRITE__ dst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->size[0] && y < params->size[1])
    {
        int sy = params->flipY != 0 ? params->size[1] - 1 - y : y;
        float4 c = _tex2DVec4(src, x, sy);
        float v = params->ch == 0 ? c.x : (params->ch == 1 ? c.y : (params->ch == 2 ? c.z : c.w));
        _tex2DVec4Write(dst, x, y, to_float4(v, v, v, v));
    }
}
]]

