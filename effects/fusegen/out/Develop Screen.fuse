__DEVICE__ float softRound(float v, float k)
{
    float n = _floorf(v + 0.5f), t = v - n;
    return n + 0.5f * _copysignf(_powf(_fabs(2.0f * t), k), t);
}

__DEVICE__ float qz(float F, float q, float garb, uint gs, int k)
{
