    return make_float4(_saturatef(val), aux, sx, sy);
}

__DEVICE__ float3 dvMain(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE2D__ p_TexR, __TEXTURE2D__ p_TexG, __TEXTURE2D__ p_TexB, int dvFrame, float dvProgress, float txAmount, float txKind, float txBlend, float txStrength, float txSize, float txDetail, float txSpeed, float txColour, float txHue, float txSeed)
{
    int W = p_Width, H = p_Height, x = p_X, y = p_Y;
    float3 c0 = rgbAt(p_TexR, p_TexG, p_TexB, x, y, W, H);
    if (txAmount <= 0.0f) return c0;
    int k = (int)(txKind + 0.5f), bl = (int)(txBlend + 0.5f);
    float sc = (float)(H) / 1080.0f, pix = 1.0f / (float)(H);
    float u = ((float)(x) + 0.5f) * pix, v = ((float)(y) + 0.5f) * pix;
    float t = (float)(dvFrame) / 24.0f * txSpeed / 100.0f;
    float S = 0.05f + 0.35f * _powf(txSize / 100.0f, 1.5f);
    float det = txDetail / 100.0f, st = txStrength / 100.0f;
    uint sd = (uint)(txSeed) * 131u + 7u;
    float pw = 1.0f / 1080.0f;
    float4 tv = texAt(k, u, v, t, S, pw, det, sd);
    float val = tv.x;
    float gx = tv.z, gy = tv.w;
    if (k == 3 || (bl == 3 && k != 4)) {
        float e = 1.5f * pix;
        float vx = texAt(k, u + e, v, t, S, pw, det, sd).x, vy = texAt(k, u, v + e, t, S, pw, det, sd).x;
        gx = (vx - val) / e * S * 0.25f; gy = (vy - val) / e * S * 0.25f;
    }
    if (k == 3 || k == 4) {
        float nz = 1.0f / _sqrtf(1.0f + gx * gx + gy * gy);
        float lx = -0.54f, ly = -0.54f, lz = 0.643f;
        float sh = (-gx * lx - gy * ly + lz) * nz / lz;
        val = k == 3 ? _saturatef(0.25f + 0.45f * val + 0.40f * (sh - 0.85f)) : _saturatef(val + 0.55f * (sh - 0.88f));
    }
    float hue = txHue / 100.0f, col = txColour / 100.0f;
    float3 own = make_float3(1.0f, 1.0f, 1.0f);
    if (k == 2) own = make_float3(0.45f, 1.0f, 0.55f);
    if (k == 5) own = make_float3(lerp1(0.62f, 1.0f, tv.y), lerp1(0.32f, 0.38f, tv.y), lerp1(1.0f, 0.78f, tv.y));
    float3 tint = hue <= 0.0f ? own : specT(hue + (k == 5 ? 0.15f * tv.y : 0.0f));
    float tl = luma(tint.x, tint.y, tint.z);
    float3 tc = make_float3(lerp1(1.0f, tint.x / tl, col), lerp1(1.0f, tint.y / tl, col), lerp1(1.0f, tint.z / tl, col));
    float mean = k == 0 ? 0.41f : (k == 1 ? 0.10f : (k == 2 ? 0.01f : (k == 3 ? 0.48f : (k == 4 ? 0.59f : (k == 5 ? 0.07f : 0.665f)))));
    float3 o = c0;
    if (bl == 0) {
        float s2 = st * 1.6f;
        float br = _saturatef(0.5f + s2 * (val * tc.x - mean)), bg = _saturatef(0.5f + s2 * (val * tc.y - mean)), bb = _saturatef(0.5f + s2 * (val * tc.z - mean));
        float ar = _saturatef(c0.x), ag = _saturatef(c0.y), ab = _saturatef(c0.z);
        o = make_float3(ar < 0.5f ? 2.0f * ar * br : 1.0f - 2.0f * (1.0f - ar) * (1.0f - br),
                        ag < 0.5f ? 2.0f * ag * bg : 1.0f - 2.0f * (1.0f - ag) * (1.0f - bg),
                        ab < 0.5f ? 2.0f * ab * bb : 1.0f - 2.0f * (1.0f - ab) * (1.0f - bb));
    } else if (bl == 1) {
        float pk = _fmaxf(tc.x, _fmaxf(tc.y, tc.z)), hi = _fminf(mean * 1.7f, 0.95f);
        float fr = _saturatef(val * tc.x / pk / hi), fg = _saturatef(val * tc.y / pk / hi), fb = _saturatef(val * tc.z / pk / hi);
        o = make_float3(c0.x * lerp1(1.0f, fr, st), c0.y * lerp1(1.0f, fg, st), c0.z * lerp1(1.0f, fb, st));
    } else if (bl == 2) {
        float a = 1.5f * st * toLin(sstep(mean, 1.0f, val));
        float ar = a * tc.x, ag = a * tc.y, ab = a * tc.z;
        o = lightOut(toLin(c0.x) + ar, toLin(c0.y) + ag, toLin(c0.z) + ab, _fmaxf(ar, _fmaxf(ag, ab)));
    } else {
        float ks = k == 6 ? 0.07f : 1.0f;
        float dxs = gx * ks, dys = gy * ks, gm = _sqrtf(dxs * dxs + dys * dys);
        float amt = st * 160.0f * sc / (1.0f + 2.0f * gm);
        o = bilin(p_TexR, p_TexG, p_TexB, (float)(x) - amt * dxs, (float)(y) - amt * dys, W, H);
    }
    float am = txAmount / 100.0f;
    return make_float3(_saturatef(lerp1(c0.x, o.x, am)), _saturatef(lerp1(c0.y, o.y, am)), _saturatef(lerp1(c0.z, o.z, am)));
}

// fusegen: the kernel entry (Fusion's rows run bottom up; py is the DCTL's top-down row)
__KERNEL__ void DevelopTextureK14291155(__CONSTANTREF__ DevelopTextureP14291155 *params, __TEXTURE2D__ p_TexR, __TEXTURE2D__ p_TexG, __TEXTURE2D__ p_TexB, __TEXTURE2D__ dvSrc, __TEXTURE2D_WRITE__ dvDst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->dvSize[0] && y < params->dvSize[1])
    {
        int py = params->dvFlipY != 0 ? params->dvSize[1] - 1 - y : y;
        float3 c = dvMain(params->dvSize[0], params->dvSize[1], x, py, p_TexR, p_TexG, p_TexB, params->dvFrame, params->dvProgress, params->txAmount, params->txKind, params->txBlend, params->txStrength, params->txSize, params->txDetail, params->txSpeed, params->txColour, params->txHue, params->txSeed);
        float4 s = _tex2DVec4(dvSrc, x, y);
        _tex2DVec4Write(dvDst, x, y, to_float4(c.x, c.y, c.z, s.w));
    }
}
]]

-- the plain source first; the compatibility source only if the plain one does not build
DvSources = { DvMath .. DvMapping .. DvKernelText, DvCompat .. DvMath .. DvMapping .. DvKernelText }
DvWorking = nil

-- the last status of each tool, so a change is reported once
DvLast = {}

-- the compute node's error log (DVIPComputeNode:GetErrorLog, a name in fusionsystem.dll), or a note that it has none
function DvNodeLog(node)
	local log = nil
	if node then
		pcall(function()
			log = node:GetErrorLog()
		end)
	end
	if log == nil or log == "" then
		return "(the node gave no error log; see the Fusion console)"
	end
	return tostring(log)
end

-- report a status: the console, the tool's data and the log file, each once per change
function DvNote(tool, failed, msg)
	local key = DvName
	pcall(function()
		key = tool.Name
	end)
	key = tostring(key)
	local text = msg
	if failed then
		text = "FAILED: " .. msg
	end
	if DvLast[key] == text then
		return
	end
	DvLast[key] = text
	print(DvName .. " [" .. key .. "] " .. text)
	pcall(function()
		tool:SetData("DevelopFuse.Status", text)
	end)
	pcall(function()
		local dir = os.getenv("TEMP") or os.getenv("TMP") or "."
		local f = io.open(dir .. "/DevelopFuse.log", "a")
		if f then
			local line = (text:gsub("[\r\n]+", " | "))
			f:write(os.date("%Y-%m-%d %H:%M:%S") .. "\t" .. key .. "\t" .. DvName .. "\t" .. line .. "\n")
			f:close()
		end
	end)
end

-- a Lua error's message with its traceback when the debug library is there
function DvTrace(e)
	if debug and debug.traceback then
		return debug.traceback(tostring(e), 2)
	end
	return tostring(e)
end

-- the visible error: a solid magenta frame the size of ref (nil when there is no picture to size it by)
function DvFailImage(ref)
	local bad = nil
	if ref then
		pcall(function()
			bad = Image({IMG_Like = ref})
			bad:Fill(Pixel({R = 1.0, G = 0.0, B = 1.0, A = 1.0}))
		end)
	end
	return bad
end

function Create()
	InTxAmount = self:AddInput("Texture", "txAmount", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 100.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InTxKind = self:AddInput("Kind", "txKind", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 6.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 6.0,
		INPS_StatusText = "0 Cells, 1 Flux, 2 Neurons, 3 Ridges, 4 Folded, 5 Plasma, 6 Weave",
		})
	InTxBlend = self:AddInput("Blend", "txBlend", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 3.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 3.0,
		INPS_StatusText = "0 Overlay, 1 Multiply, 2 Screen, 3 Displace",
		})
	InTxStrength = self:AddInput("Strength", "txStrength", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "How strongly the texture works: contrast, depth, light added, or how far the glass bends",
		})
	InTxSize = self:AddInput("Size", "txSize", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InTxDetail = self:AddInput("Detail", "txDetail", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InTxSpeed = self:AddInput("Speed", "txSpeed", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 30.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "How fast it moves; 0 holds it",
		})
	InTxColour = self:AddInput("Colour", "txColour", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 100.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InTxHue = self:AddInput("Hue", "txHue", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "0 the texture's own colour; above 0 a tint round the colour wheel",
		})
	InTxSeed = self:AddInput("Seed", "txSeed", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InFrameOffset = self:AddInput("Frame Offset", "FrameOffset", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Integer = true,
		INP_Default = 0,
		INP_MinScale = 0,
		INP_MaxScale = 1000,
		INPS_StatusText = "Added to the comp frame to make the DCTL's frame value (Resolve's TIMELINE_FRAME_INDEX)",
		})
	InHoldFrame = self:AddInput("Hold Frame", "HoldFrame", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 0,
		INPS_StatusText = "The frame value is Frame Offset alone, so a moving effect holds still",
		})
	InFlipY = self:AddInput("Rows Top Down", "FlipY", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 1,
		IC_Visible = false,
		})
	InInput = self:AddInput("Input", "Input", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
		})
	OutImage = self:AddOutput("Output", "Output", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
		})
end

-- one channel of img as its own texture, rows top-down (DvSplitSource); returns the plane, or nil and why
function DvPlane(req, img, ch, flip)
	local plane = Image({IMG_Like = img})
	local node = DVIPComputeNode(req, DvSplitName, DvSplitSource, DvSplitParamsName, DvSplitParams)
	if not node then
		return nil, "the split kernel's compute node was not created (DVIPComputeNode gave nil)"
	end
	local p = node:GetParamBlock(DvSplitParams)
	p.ch = ch
	p.flipY = flip
	p.size[0] = img.DataWindow:Width()
	p.size[1] = img.DataWindow:Height()
	node:SetParamBlock(p)
	node:AddInput("src", img)
	node:AddOutput("dst", plane)
	if node:RunSession(req) then
		return plane
	end
	return nil, "the split kernel did not run: " .. DvNodeLog(node)
end

-- the kernel over every pixel with source k; returns true when it ran, or false and why
function DvRun(req, k, src, inc, planes, out, frame, flip, progress)
	local node = DVIPComputeNode(req, DvKernelName, DvSources[k], DvParamsName, DvParams)
	if not node then
		return false, "source " .. k .. ": the compute node was not created (DVIPComputeNode gave nil)"
	end
	local p = node:GetParamBlock(DvParams)
	p.txAmount = InTxAmount:GetValue(req).Value
	p.txKind = InTxKind:GetValue(req).Value
	p.txBlend = InTxBlend:GetValue(req).Value
	p.txStrength = InTxStrength:GetValue(req).Value
	p.txSize = InTxSize:GetValue(req).Value
	p.txDetail = InTxDetail:GetValue(req).Value
	p.txSpeed = InTxSpeed:GetValue(req).Value
	p.txColour = InTxColour:GetValue(req).Value
	p.txHue = InTxHue:GetValue(req).Value
	p.txSeed = InTxSeed:GetValue(req).Value
	p.dvProgress = progress
	p.dvFrame = frame
	p.dvFlipY = flip
	p.dvSize[0] = src.DataWindow:Width()
	p.dvSize[1] = src.DataWindow:Height()
	node:SetParamBlock(p)
	node:AddInput("p_TexR", planes.p_TexR)
	node:AddInput("p_TexG", planes.p_TexG)
	node:AddInput("p_TexB", planes.p_TexB)
	node:AddInput("dvSrc", src)
	node:AddOutput("dvDst", out)
	if node:RunSession(req) then
		return true
	end
	return false, "source " .. k .. ": RunSession failed: " .. DvNodeLog(node)
end

function DvProcess(req)
	local src = InInput:GetValue(req)
	if not src then
		return nil, "no input image", true, nil
	end
	if req:IsPreCalc() then
		return Image({IMG_Like = src, IMG_NoData = true}), nil, false, src
	end
	local inc = nil
	local progress = 0.0
	local out = Image({IMG_Like = src})
	local flip = math.floor(InFlipY:GetValue(req).Value + 0.5)
	local frame = math.floor(InFrameOffset:GetValue(req).Value + 0.5)
	if InHoldFrame:GetValue(req).Value < 0.5 then
		frame = frame + math.floor(req.Time + 0.5)
	end
	local planes = {}
	local why = nil
	planes.p_TexR, why = DvPlane(req, src, 0, flip)
	if not planes.p_TexR then
		return nil, "p_TexR: " .. tostring(why), true, src
	end
	planes.p_TexG, why = DvPlane(req, src, 1, flip)
	if not planes.p_TexG then
		return nil, "p_TexG: " .. tostring(why), true, src
	end
	planes.p_TexB, why = DvPlane(req, src, 2, flip)
	if not planes.p_TexB then
		return nil, "p_TexB: " .. tostring(why), true, src
	end
	local order = {}
	if DvWorking then
		order[1] = DvWorking
	end
	for k = 1, #DvSources do
		if k ~= DvWorking then
			order[#order + 1] = k
		end
	end
	local errs = {}
	for i = 1, #order do
		local ok, err = DvRun(req, order[i], src, inc, planes, out, frame, flip, progress)
		if ok then
			DvWorking = order[i]
			return out, "ok, the kernel runs from source " .. order[i], false, src
		end
		errs[#errs + 1] = tostring(err)
	end
	return nil, "the kernel ran from no source: " .. table.concat(errs, " || "), true, src
end

-- every failure is reported and shows as magenta; the input never passes through quietly
function Process(req)
	local res, msg, failed, ref = nil, nil, true, nil
	local called, err = xpcall(function()
		res, msg, failed, ref = DvProcess(req)
	end, DvTrace)
	if not called then
		res, msg, failed = nil, "Lua error in Process: " .. tostring(err), true
		if not ref then
			pcall(function()
				ref = InInput:GetValue(req)
			end)
		end
	end
	if msg then
		DvNote(self, failed, msg)
	end
	if failed then
		res = DvFailImage(ref)
	end
	OutImage:Set(req, res)
end
