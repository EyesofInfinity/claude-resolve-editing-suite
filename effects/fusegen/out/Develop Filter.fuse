        int sx = x + (int)(_round(rr * _cosf(an))), sy = y + (int)(_round(rr * _sinf(an)));
        float L = toLin(lumaAt(tr, tg, tb, sx, sy, w, h));
        s += _fmaxf(L - 0.35f, 0.0f);
