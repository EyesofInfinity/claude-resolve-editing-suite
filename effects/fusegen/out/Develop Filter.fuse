		INP_MaxScale = 3.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 3.0,
		INPS_StatusText = "0 neutral, 1 tobacco, 2 blue, 3 sunset",
		})
	InFiSunAz = self:AddInput("Sun Azimuth", "fiSunAz", {
