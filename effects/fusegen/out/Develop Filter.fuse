__DEVICE__ float3 grainDisp(float3 v, int x, int y, int h, float amt, float cell, uint seed)
{
    if (amt <= 0.0f) return v;
    float sz = _fmaxf(cell * (float)(h) / 1080.0f, 1.0f);
    int cx = (int)((float)(x) / sz), cy = (int)((float)(y) / sz);
