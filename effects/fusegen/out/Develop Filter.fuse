        float f = fade / 100.0f, lo = 0.12f * f, hi = 1.0f - 0.10f * f;
        o = make_float3(lo + (hi - lo) * o.x, lo + (hi - lo) * o.y, lo + (hi - lo) * o.z);
    }
    return o;
}

__DEVICE__ float3 halation(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h, float rad, float amt, float tint)
{
    if (amt <= 0.0f) return make_float3(0.0f, 0.0f, 0.0f);
    float s = 0.0f;
    for (int i = 0; i < 16; i++) {
