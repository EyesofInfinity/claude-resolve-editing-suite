		INP_MinAllowed = -180.0,
		INP_MaxAllowed = 180.0,
		INPS_StatusText = "Polarizer: the sun round the horizon from where the camera looks, 90 to the right, 180 behind",
		})
	InFiSunEl = self:AddInput("Sun Height", "fiSunEl", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 30.0,
		INP_MinScale = 0.0,
