		INP_MaxScale = 200.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 200.0,
		INPS_StatusText = "The filter's thickness: 100 one filter, 200 two stacked, 0 clear glass",
		})
	InFiFilm = self:AddInput("Film", "fiFilm", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 2.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 2.0,
		INPS_StatusText = "0 the filter's own (B&W for 8-17), 1 colour, 2 black and white",
		})
	InFiPos = self:AddInput("Grad Line", "fiPos", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
