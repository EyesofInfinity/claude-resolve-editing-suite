    r += sh.x * ws + hi.x * wh; g += sh.y * ws + hi.y * wh; b += sh.z * ws + hi.z * wh;
    return make_float3(lift + (cap - lift) * _saturatef(r), lift + (cap - lift) * _saturatef(g), lift + (cap - lift) * _saturatef(b));
