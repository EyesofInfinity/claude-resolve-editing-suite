    0.08805513f, 0.001753439f, 0.001187226f, -0.005067161f, -0.0001009022f, -6.831933e-05f, -0.001155939f, -2.301819e-05f, -1.558525e-05f, 0.01928088f, 0.0003839397f, 0.0002599595f,
    0.07808048f, 0.0006949224f, 0.001038151f, -0.005616029f, -4.99831e-05f, -7.46702e-05f, -0.0008841103f, -7.868651e-06f, -1.175505e-05f, 0.01864746f, 0.0001659639f, 0.0002479349f,
    0.0668448f, 0.0002009861f, 0.0008820783f, -0.005495634f, -1.652404e-05f, -7.251992e-05f, -0.0006705879f, -2.016295e-06f, -8.84902e-06f, 0.01772823f, 5.33045e-05f, 0.0002339403f,
    0.05704668f, -8.402541e-06f, 0.0007497302f, -0.005079092f, 7.481117e-07f, -6.675147e-05f, -0.0005234766f, 7.710411e-08f, -6.879738e-06f, 0.01699195f, -2.502785e-06f, 0.000223315f,
    0.04723736f, -8.670011e-05f, 0.0006194593f, -0.00438261f, 8.043904e-06f, -5.747248e-05f, -0.0004112669f, 7.548452e-07f, -5.393255e-06f, 0.01583785f, -2.906902e-05f, 0.0002076938f,
    0.03706043f, -0.0001015073f, 0.0004854334f, -0.003471298f, 9.507769e-06f, -4.546855e-05f, -0.0003185368f, 8.724616e-07f, -4.172331e-06f, 0.01386401f, -3.797305e-05f, 0.0001815967f,
    0.02823325f, -9.098427e-05f, 0.0003695795f, -0.002590782f, 8.349037e-06f, -3.391391e-05f, -0.000249409f, 8.037437e-07f, -3.264819e-06f, 0.01154552f, -3.720652e-05f, 0.0001511334f,
    0.02140183f, -7.450955e-05f, 0.0002800607f, -0.001861916f, 6.482179e-06f, -2.436471e-05f, -0.0002018631f, 7.027778e-07f, -2.641546e-06f, 0.009286967f, -3.233218e-05f, 0.0001215277f,
    0.01576239f, -5.706012e-05f, 0.0002062269f, -0.001247583f, 4.51627e-06f, -1.632272e-05f, -0.0001642f, 5.944065e-07f, -2.148307e-06f, 0.007021272f, -2.541712e-05f, 9.186267e-05f,
    0.01140927f, -4.214791e-05f, 0.0001492586f, -0.0007738799f, 2.858853e-06f, -1.012407e-05f, -0.0001350639f, 4.989507e-07f, -1.766936e-06f, 0.005066527f, -1.871667e-05f, 6.628142e-05f,
    0.00801742f, -2.993608e-05f, 0.0001048803f, -0.0004204107f, 1.569763e-06f, -5.499623e-06f, -0.0001104002f, 4.122208e-07f, -1.444205e-06f, 0.003480593f, -1.299611e-05f, 4.553154e-05f,
    0.005267212f, -1.977905e-05f, 6.890138e-05f, -0.0001690228f, 6.347022e-07f, -2.211019e-06f, -8.598194e-05f, 3.228732e-07f, -1.124746e-06f, 0.0022191f, -8.333005e-06f, 2.902846e-05f,
    0.003353081f, -1.262938e-05f, 4.386162e-05f, -1.843732e-05f, 6.944419e-08f, -2.411785e-07f, -6.592698e-05f, 2.483141e-07f, -8.623904e-07f, 0.001377022f, -5.186555e-06f, 1.801282e-05f,
    0.002004081f, -7.560574e-06f, 2.621516e-05f, 5.857348e-05f, -2.209737e-07f, 7.661932e-07f, -4.813859e-05f, 1.816071e-07f, -6.296956e-07f, 0.0008138368f, -3.070272e-06f, 1.064571e-05f,
    0.001154175f, -4.357991e-06f, 1.509758e-05f, 8.647778e-05f, -3.265269e-07f, 1.131202e-06f, -3.434395e-05f, 1.296775e-07f, -4.492476e-07f, 0.0004739123f, -1.789421e-06f, 6.199168e-06f,
    0.0006896653f, -2.605274e-06f, 9.021378e-06f, 9.379757e-05f, -3.543289e-07f, 1.226948e-06f, -2.58091e-05f, 9.749625e-08f, -3.376038e-07f, 0.0002947383f, -1.113401e-06f, 3.855414e-06f,
    0.0003959636f, -1.496158e-06f, 5.179516e-06f, 8.696554e-05f, -3.286015e-07f, 1.137578e-06f, -1.897421e-05f, 7.169453e-08f, -2.481976e-07f, 0.0001824498f, -6.893913e-07f, 2.386588e-06f,
    0.000218497f, -8.257057e-07f, 2.858111e-06f, 7.390092e-05f, -2.792735e-07f, 9.666818e-07f, -1.372262e-05f, 5.185812e-08f, -1.795026e-07f, 0.0001132682f, -4.280435e-07f, 1.481637e-06f,
    0.0001141377f, -4.313599e-07f, 1.49301e-06f, 5.881038e-05f, -2.222616e-07f, 7.692854e-07f, -9.704602e-06f, 3.667653e-08f, -1.269437e-07f, 7.017514e-05f, -2.652124e-07f, 9.179453e-07f};
__CONSTANT__ float FRAYL[3] = {0.213266f, 0.432994f, 1.000000f};

__DEVICE__ float sigm(float v) { return 1.0f / (1.0f + _expf(-v)); }

__DEVICE__ float lpD(float lam, float l50, float w, float tmin, float tmax) { return -_logf(tmin + (tmax - tmin) * sigm((lam - l50) / w)); }

__DEVICE__ float miredD(float lam, float mired) { return 14.388f * mired * (1.0f / lam - 1.0f / (mired > 0.0f ? 720.0f : 380.0f)); }

__DEVICE__ float filterD(int f, float lam)
{
    float g = 0.0f;
    if (f == 0) return miredD(lam, 112.0f);
    if (f == 1) return miredD(lam, 131.0f);
    if (f == 2) return miredD(lam, -131.0f);
    if (f == 3) return miredD(lam, -112.0f);
    if (f == 4) return miredD(lam, 18.0f);
    if (f == 5) return miredD(lam, 52.0f);
    if (f == 6) return miredD(lam, -18.0f);
    if (f == 7) return miredD(lam, -45.0f);
    if (f == 8) return 0.0f;
    if (f == 9) return lpD(lam, 475.0f, 8.0f, 0.02f, 0.92f);
    if (f == 10) return lpD(lam, 482.0f, 9.0f, 0.03f, 0.85f) - _logf(0.30f + 0.70f * (1.0f - sigm((lam - 596.0f) / 20.0f)));
    if (f == 11) return lpD(lam, 522.0f, 7.0f, 0.005f, 0.92f);
    if (f == 12) return lpD(lam, 556.0f, 7.0f, 0.003f, 0.92f);
    if (f == 13) return lpD(lam, 585.0f, 7.0f, 0.002f, 0.90f);
    if (f == 14) return lpD(lam, 598.0f, 6.0f, 0.001f, 0.90f);
    if (f == 15) return lpD(lam, 618.0f, 6.0f, 0.001f, 0.88f);
    if (f == 16) return -_logf(0.002f + 0.50f * (1.0f - sigm((lam - 490.0f) / 9.0f)) * sigm((lam - 396.0f) / 6.0f));
    if (f == 17) return -_logf(0.002f + 0.65f * sigm((lam - 497.0f) / 9.0f) * (1.0f - sigm((lam - 588.0f) / 9.0f)));
    if (f == 18) return miredD(lam, 159.0f);
    if (f == 19) return miredD(lam, 81.0f);
    if (f == 20) return miredD(lam, -137.0f);
    if (f == 21) { g = (lam - 535.0f) / 55.0f; return 0.69f * (1.0f - _expf(-g * g)); }
    if (f == 22) { g = (lam - 540.0f) / 40.0f; return 0.69f * _expf(-g * g); }
    if (f == 23) { g = (lam - 520.0f) / 35.0f; return miredD(lam, 55.0f) + 0.18f * _expf(-g * g); }
    if (f == 24) return -_logf(0.004f + 0.30f * (1.0f - sigm((lam - 475.0f) / 12.0f)) * sigm((lam - 402.0f) / 8.0f) + 0.75f * sigm((lam - 688.0f) / 10.0f));
    if (f == 25) return lpD(lam, 605.0f, 7.0f, 0.003f, 0.88f);
    if (f == 26) return -_logf(0.06f + 0.64f * (1.0f - sigm((lam - 545.0f) / 22.0f)));
    if (f == 27) return -_logf(0.45f + 0.40f * (1.0f - sigm((lam - 585.0f) / 30.0f)));
    return 0.0f;
}

__DEVICE__ float gradShape(int c, float lam)
{
    if (c == 1) return 0.55f + 1.10f * (1.0f - sigm((lam - 565.0f) / 40.0f));
    if (c == 2) return 0.35f + 1.30f * sigm((lam - 520.0f) / 30.0f);
    if (c == 3) { float g = (lam - 545.0f) / 35.0f; return 0.45f + 1.20f * (1.0f - sigm((lam - 585.0f) / 22.0f)) + 0.25f * _expf(-g * g); }
    return 1.0f;
}

__DEVICE__ float3 specRow(int f, int gc, float s, float dg, int row)
{
    float a = 0.0f, b = 0.0f, c = 0.0f;
    for (int i = 0; i < 65; i++) {
        float lam = 390.0f + 5.0f * (float)(i);
        float d = f >= 0 ? s * filterD(f, lam) : dg * gradShape(gc, lam);
        float T = _expf(-d);
        a += T * FSPEC[i * 12 + row * 3]; b += T * FSPEC[i * 12 + row * 3 + 1]; c += T * FSPEC[i * 12 + row * 3 + 2];
    }
    return make_float3(a, b, c);
}

__DEVICE__ float dot3(float3 a, float3 b) { return a.x * b.x + a.y * b.y + a.z * b.z; }

__DEVICE__ float3 polar(float3 l, float3 dir, float3 sd, float kr, float below, float glare, float st, float lcr)
{
    float c = dot3(dir, sd), c2 = c * c;
    float P = 0.75f * (1.0f - c2) / (1.0f + c2);
    float rr = FRAYL[0], rg = FRAYL[1], rb = FRAYL[2];
    float r = _fmaxf(l.x, 0.0f), g = _fmaxf(l.y, 0.0f), b = _fmaxf(l.z, 0.0f);
    float aa = 3.0f, ab = rr + rg + rb, bb = rr * rr + rg * rg + rb * rb;
    float pa = r + g + b, pb = rr * r + rg * g + rb * b;
    float det = aa * bb - ab * ab;
    float w = (bb * pa - ab * pb) / det, s = _fmaxf((aa * pb - ab * pa) / det, 0.0f);
    float er = r - w - s * rr, eg = g - w - s * rg, eb = b - w - s * rb;
    float L = _fmaxf(luma(r, g, b), 1e-5f);
    float fit = 1.0f - sstep(0.12f, 0.40f, _sqrtf(er * er + eg * eg + eb * eb) / L);
    float cut = P * kr * st * fit * (1.0f - 0.5f * below);
    cut *= sstep(0.01f, 0.06f, L);
    float q = _saturatef(s * luma(rr, rg, rb) / L);
    float3 o = make_float3(r - cut * (0.65f * q * r + 0.35f * s * rr), g - cut * (0.65f * q * g + 0.35f * s * rg), b - cut * (0.65f * q * b + 0.35f * s * rb));
    float mx = _fmaxf(o.x, _fmaxf(o.y, o.z)), mn = _fminf(o.x, _fminf(o.y, o.z));
    float sky = s * rb / (mx + 1e-4f) * fit;
    float gw = sstep(0.15f, 0.5f, lcr) * (1.0f - sstep(0.3f, 0.7f, sky));
    float gc = 0.6f * glare * kr * st * gw * mn;
    return make_float3(_fmaxf(o.x - gc, 0.0f), _fmaxf(o.y - gc, 0.0f), _fmaxf(o.z - gc, 0.0f));
}

__DEVICE__ float3 dvMain(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE2D__ p_TexR, __TEXTURE2D__ p_TexG, __TEXTURE2D__ p_TexB, int dvFrame, float dvProgress, float fiAmount, float fiFilter, float fiStrength, float fiFilm, float fiPos, float fiAngle, float fiSoft, float fiStops, float fiGradCol, float fiSunAz, float fiSunEl, float fiFov, float fiHorizon, float fiTurn, float fiGlare)
{
    int W = p_Width, H = p_Height, x = p_X, y = p_Y;
    float3 c0 = rgbAt(p_TexR, p_TexG, p_TexB, x, y, W, H);
    if (fiAmount <= 0.0f) return c0;
    int f = (int)(fiFilter + 0.5f), film = (int)(fiFilm + 0.5f);
    float st = fiStrength / 100.0f;
    int mono = film == 2 || (film == 0 && f >= 8 && f <= 17) ? 1 : 0;
    float3 l = make_float3(toLin(c0.x), toLin(c0.y), toLin(c0.z));
    float expo = 1.0f;
    int sf = f, gc = 0;
    float dg = 0.0f;
    if (f == 28) {
        float fx = ((float)(x) + 0.5f - 0.5f * (float)(W)), fy = ((float)(y) + 0.5f - (float)(H) * fiHorizon / 100.0f);
        float ha = 0.5f * fiFov * 0.0174533f;
        float fp = 0.5f * (float)(W) * _cosf(ha) / _sinf(ha);
        float dn = _sqrtf(fx * fx + fy * fy + fp * fp);
        float3 dir = make_float3(fx / dn, -fy / dn, fp / dn);
        float az = fiSunAz * 0.0174533f, el = fiSunEl * 0.0174533f;
        float3 sd = make_float3(_sinf(az) * _cosf(el), _sinf(el), _cosf(az) * _cosf(el));
        float tr = fiTurn * 0.0174533f;
        float kr = 1.0f - 2.0f * _sinf(tr) * _sinf(tr);
        float below = sstep(0.0f, 0.12f, -dir.y);
        float rad = 14.0f * (float)(H) / 1080.0f, nr = 0.0f, ng = 0.0f, nb = 0.0f;
        for (int i = 0; i < 12; i++) {
            float rr = rad * _sqrtf(((float)(i) + 0.5f) / 12.0f), an = 2.3999632f * (float)(i);
            float3 q = rgbAt(p_TexR, p_TexG, p_TexB, x + (int)(_round(rr * _cosf(an))), y + (int)(_round(rr * _sinf(an))), W, H);
            nr += toLin(_saturatef(q.x)); ng += toLin(_saturatef(q.y)); nb += toLin(_saturatef(q.z));
        }
        float nmx = _fmaxf(nr, _fmaxf(ng, nb)) + 1e-5f, nmn = _fminf(nr, _fminf(ng, nb));
        float lcr = (nmx - nmn) / nmx * (1.0f - sstep(-0.06f, 0.06f, (nb - _fmaxf(nr, ng)) / nmx));
        l = polar(l, dir, sd, kr, below, fiGlare / 100.0f, st, lcr);
        sf = 8;
    }
    if (f == 29 || f == 30) {
        float an = fiAngle * 0.0174533f;
        float px = ((float)(x) + 0.5f - 0.5f * (float)(W)) / (float)(H), py = ((float)(y) + 0.5f) / (float)(H) - fiPos / 100.0f;
        float d = -(py * _cosf(an) - px * _sinf(an));
        float hw = 0.01f + 0.40f * fiSoft / 100.0f;
        float gw = sstep(-hw, hw, d);
        if (f == 30) gw = sstep(-hw * 0.5f, 0.0f, d) * (1.0f - 0.7f * sstep(0.0f, 0.55f, d));
        dg = fiStops * st * gw * 0.6931472f;
        expo = _exp2f(-fiStops * st * gw);
        sf = -1; gc = (int)(fiGradCol + 0.5f);
    }
    float3 o;
    if (mono == 1) {
        float3 fw = specRow(sf, gc, st, dg, 3);
        float tot = fw.x + fw.y + fw.z;
        float Y = dot3(fw, l) / _fmaxf(tot, 1e-6f) * expo;
        float dv = sCurve(toDisp(Y), 1.4f, 0.45f);
        o = make_float3(dv, dv, dv);
    } else {
        float3 m0 = specRow(sf, gc, st, dg, 0), m1 = specRow(sf, gc, st, dg, 1), m2 = specRow(sf, gc, st, dg, 2);
        float Yw = 0.2126f * (m0.x + m0.y + m0.z) + 0.7152f * (m1.x + m1.y + m1.z) + 0.0722f * (m2.x + m2.y + m2.z);
        float mxw = _fmaxf(m0.x + m0.y + m0.z, _fmaxf(m1.x + m1.y + m1.z, m2.x + m2.y + m2.z));
        float gain = _fminf(_fminf(1.0f / _fmaxf(Yw, 1e-6f), 6.0f), 2.0f / _fmaxf(mxw, 1e-6f)) * expo;
        float r = dot3(m0, l) * gain, g = dot3(m1, l) * gain, b = dot3(m2, l) * gain;
        r = _fmaxf(r, 0.0f); g = _fmaxf(g, 0.0f); b = _fmaxf(b, 0.0f);
        float mx = _fmaxf(r, _fmaxf(g, b));
        float kk = mx > 0.9f ? (0.9f + 0.1f * _tanhf((mx - 0.9f) / 0.1f)) / mx : 1.0f;
        float wk = sstep(1.0f, 1.1f, mx);
        kk = lerp1(1.0f, kk, wk);
        o = make_float3(toDisp(r * kk), toDisp(g * kk), toDisp(b * kk));
    }
    float am = fiAmount / 100.0f;
    return make_float3(_saturatef(lerp1(c0.x, o.x, am)), _saturatef(lerp1(c0.y, o.y, am)), _saturatef(lerp1(c0.z, o.z, am)));
}

// fusegen: the kernel entry (Fusion's rows run bottom up; py is the DCTL's top-down row)
__KERNEL__ void DevelopFilterK571e3168(__CONSTANTREF__ DevelopFilterP571e3168 *params, __TEXTURE2D__ p_TexR, __TEXTURE2D__ p_TexG, __TEXTURE2D__ p_TexB, __TEXTURE2D__ dvSrc, __TEXTURE2D_WRITE__ dvDst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->dvSize[0] && y < params->dvSize[1])
    {
        int py = params->dvFlipY != 0 ? params->dvSize[1] - 1 - y : y;
        float3 c = dvMain(params->dvSize[0], params->dvSize[1], x, py, p_TexR, p_TexG, p_TexB, params->dvFrame, params->dvProgress, params->fiAmount, params->fiFilter, params->fiStrength, params->fiFilm, params->fiPos, params->fiAngle, params->fiSoft, params->fiStops, params->fiGradCol, params->fiSunAz, params->fiSunEl, params->fiFov, params->fiHorizon, params->fiTurn, params->fiGlare);
        float4 s = _tex2DVec4(dvSrc, x, y);
        _tex2DVec4Write(dvDst, x, y, to_float4(c.x, c.y, c.z, s.w));
    }
}
]]

-- the plain source first; the compatibility source only if the plain one does not build
DvSources = { DvMath .. DvMapping .. DvKernelText, DvCompat .. DvMath .. DvMapping .. DvKernelText }
DvWorking = nil

-- the last status of each tool, so a change is reported once
DvLast = {}

-- the compute node's error log (DVIPComputeNode:GetErrorLog, a name in fusionsystem.dll), or a note that it has none
function DvNodeLog(node)
	local log = nil
	if node then
		pcall(function()
			log = node:GetErrorLog()
		end)
	end
	if log == nil or log == "" then
		return "(the node gave no error log; see the Fusion console)"
	end
	return tostring(log)
end

-- report a status: the console, the tool's data and the log file, each once per change
function DvNote(tool, failed, msg)
	local key = DvName
	pcall(function()
		key = tool.Name
	end)
	key = tostring(key)
	local text = msg
	if failed then
		text = "FAILED: " .. msg
	end
	if DvLast[key] == text then
		return
	end
	DvLast[key] = text
	print(DvName .. " [" .. key .. "] " .. text)
	pcall(function()
		tool:SetData("DevelopFuse.Status", text)
	end)
	pcall(function()
		local dir = os.getenv("TEMP") or os.getenv("TMP") or "."
		local f = io.open(dir .. "/DevelopFuse.log", "a")
		if f then
			local line = (text:gsub("[\r\n]+", " | "))
			f:write(os.date("%Y-%m-%d %H:%M:%S") .. "\t" .. key .. "\t" .. DvName .. "\t" .. line .. "\n")
			f:close()
		end
	end)
end

-- a Lua error's message with its traceback when the debug library is there
function DvTrace(e)
	if debug and debug.traceback then
		return debug.traceback(tostring(e), 2)
	end
	return tostring(e)
end

-- the visible error: a solid magenta frame the size of ref (nil when there is no picture to size it by)
function DvFailImage(ref)
	local bad = nil
	if ref then
		pcall(function()
			bad = Image({IMG_Like = ref})
			bad:Fill(Pixel({R = 1.0, G = 0.0, B = 1.0, A = 1.0}))
		end)
	end
	return bad
end

function Create()
	InFiAmount = self:AddInput("Filter Mix", "fiAmount", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 100.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InFiFilter = self:AddInput("Filter", "fiFilter", {
