		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 7.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 7.0,
		INPS_StatusText = "0 Moire, 1 Spots, 2 Tiles, 3 Loops, 4 Micro, 5 Emboss, 6 Paint, 7 Chroma Spiral",
		})
	InTpBlend = self:AddInput("Blend", "tpBlend", {
