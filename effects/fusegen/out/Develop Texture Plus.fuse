        float rim = sstep(-0.14f, 0.0f, sdf) * cov;
        float gran = fbmg(u / (S * 0.04f), v / (S * 0.04f), 0.0f, 2, 0.5f, sd + 10u);
        float ground = 0.70f + 0.05f * fbmg(u / (S * 0.15f), v / (S * 0.15f), 0.0f, 2, 0.5f, sd + 9u);
        val = lerp1(ground, tone + 0.07f * gran, cov) - 0.08f * rim;
        aux = tone * 3.0f;
    } else if (k == 2) {
        float ts = S * 0.55f;
        float wu = 0.035f * fbmg(u / ts * 0.3f, v / ts * 0.3f, 0.0f, 2, 0.5f, sd + 26u), wv = 0.035f * fbmg(u / ts * 0.3f + 5.0f, v / ts * 0.3f + 2.0f, 0.0f, 2, 0.5f, sd + 27u);
        float4 tf = tileField(u / ts + 13.7f + wu, v / ts + 5.3f + wv, shp, sd + 21u);
        float e = tf.x, hid = tf.w;
        float gw = 0.5f * (0.020f + 1.6f * pix / ts), bw = 0.11f, aa = 0.8f * rp / ts;
        float m = sstep(-aa, aa, e - gw);
        float xr = _saturatef((e - gw) / bw);
        float dh = 0.018f * 6.0f * xr * (1.0f - xr) / bw;
        float tlx = 0.035f * (rnd3((int)(hid * 65536.0f), 1, sd + 22u) - 0.5f), tly = 0.035f * (rnd3((int)(hid * 65536.0f), 2, sd + 23u) - 0.5f);
        float rs = 0.35f, rd = rp / ts, ra = 0.006f;
        float r0 = gn3(u / ts / rs, v / ts / rs, hid * 50.0f, sd + 24u);
        float ripx = ra * (gn3((u / ts + rd) / rs, v / ts / rs, hid * 50.0f, sd + 24u) - r0) / rd;
        float ripy = ra * (gn3(u / ts / rs, (v / ts + rd) / rs, hid * 50.0f, sd + 24u) - r0) / rd;
        float gxs = (dh * tf.y + tlx + ripx) * m, gys = (dh * tf.z + tly + ripy) * m;
        float3 L = lightDir(t);
        float nn = 1.0f / _sqrtf(1.0f + gxs * gxs + gys * gys);
        float nx = -gxs * nn, ny = -gys * nn, nz = nn;
        float diff = _fmaxf(nx * L.x + ny * L.y + nz * L.z, 0.0f) / L.z;
        float rl = 2.0f * nz * (nx * L.x + ny * L.y + nz * L.z) - L.z;
        float sheen = 0.22f * _powf(_saturatef(rl), 24.0f) + 0.05f * sstep(0.5f, 1.0f, rl);
        float tone = 0.50f + (0.10f + 0.18f * det) * (2.0f * hid - 1.0f);
        tone += 0.07f * (1.0f - sstep(0.0f, 0.10f, e - gw));
        float gr = (0.24f + 0.05f * fbmg(u / (S * 0.05f), v / (S * 0.05f), 0.0f, 2, 0.5f, sd + 25u)) * (0.75f + 0.25f * sstep(0.0f, gw, gw - e));
        val = lerp1(gr, tone * (0.30f + 0.70f * diff) + sheen, m);
        aux = hid;
        float lp = 0.25f * _saturatef(1.0f - (e - gw) / 0.35f) * m;
        sx = lp * tf.y + tlx * m; sy = lp * tf.z + tly * m;
    } else if (k == 3) {
        float best = 0.0f, which = 0.0f;
        float th0 = 6.2831853f * rnd3(3, 7, sd + 91u);
        float w = 1.0f * pix, aa = 0.6f * rp;
        for (int q = 0; q < 3; q++) {
            float th = th0 + 2.0943951f * (float)(q) + 0.35f * rnd3(q, 8, sd + 92u);
            float L = S * (0.34f + 0.18f * (float)(q));
            float R = 0.44f * L, B = 0.95f * R, A = R * (0.22f + 0.30f * (1.0f - det));
            float cth = _cosf(th), sth = _sinf(th);
            float xl = u * cth + v * sth + 3.0f, yl = -u * sth + v * cth + 3.0f;
            int j0 = (int)(_floorf(yl / L));
            for (int jj = 0; jj <= 1; jj++) {
                int j = j0 + jj;
                float pace = 0.4f + 0.6f * rnd3(j, q, sd + 93u), dir = rnd3(j, q, sd + 94u) < 0.5f ? -1.0f : 1.0f;
                float wan = 0.12f * L * fbmg(xl / L * 0.25f, (float)(j) * 1.7f, 0.0f, 2, 0.5f, sd + 95u);
                float yy = yl - (float)(j) * L - wan;
                float xx = xl + A * (dir * 1.5f * pace * t + 40.0f * rnd3(j, q, sd + 96u));
                float c = coil(xx, yy, A, B, R, w, aa) * (1.0f - 0.25f * (float)(q));
                if (c > best) { best = c; which = 0.5f * (float)(q); }
            }
        }
        val = 0.10f + 0.55f * best;
        aux = which;
    } else if (k == 4) {
        float h = 0.0f, hx = 0.0f, hy = 0.0f, amp = 1.0f, c = S * 0.45f, carry = 1.0f;
        for (int i = 0; i < 3; i++) {
            float bu = u / c + 3.7f * (float)(i), bv = v / c + 1.9f * (float)(i);
            float bx = bu + 0.25f * fbmg(bu * 0.7f, bv * 0.7f, 0.0f, 2, 0.5f, sd + 41u + (uint)(i)), by = bv + 0.25f * fbmg(bu * 0.7f + 4.0f, bv * 0.7f + 9.0f, 0.0f, 2, 0.5f, sd + 44u + (uint)(i));
            float3 nn = domes3(bx, by, t * 0.15f, sd + 31u + 17u * (uint)(i));
            float a2 = amp * carry;
            h += a2 * c * nn.x;
            hx += a2 * nn.y; hy += a2 * nn.z;
            carry = carry * (0.25f + 0.75f * sstep(0.0f, 0.09f, nn.x));
            amp *= 0.55f; c *= 0.38f;
        }
        float fr = S * 0.04f, ar = 0.15f * fr * (0.4f + det);
        float g0 = fbmg(u / fr, v / fr, 0.0f, 2, 0.5f, sd + 37u);
        hx += ar * (fbmg((u + rp) / fr, v / fr, 0.0f, 2, 0.5f, sd + 37u) - g0) / rp;
        hy += ar * (fbmg(u / fr, (v + rp) / fr, 0.0f, 2, 0.5f, sd + 37u) - g0) / rp;
        float g2 = hx * hx + hy * hy, sec = _sqrtf(1.0f + g2), nz = 1.0f / sec;
        float nd = (0.25f * hx + 0.75f * hy + 0.61f) * nz;
        float hol = sstep(0.0f, 0.30f * S * 0.45f, h);
        float y0 = 0.16f + 0.30f * _fminf(sec - 1.0f, 1.6f) + 0.30f * nd;
        float grain = 0.035f * gn3(u / (pix * 5.0f), v / (pix * 1.5f), 0.0f, sd + 39u);
        val = y0 * (0.55f + 0.45f * hol) + grain;
        sx = hx; sy = hy;
    } else if (k == 5) {
        float f = 1.6f / S;
        val = 0.5f + fbmg(u * f, v * f, t * 0.04f, 2 + (int)(det * 3.0f + 0.5f), 0.5f, sd + 101u);
    } else if (k == 6) {
        float cs = S * 0.30f;
        float z1 = -1.0f, c1 = 0.0f, k1 = 0.0f, h1 = 0.0f, z2 = -1.0f, c2 = 0.0f, k2 = 0.0f, h2 = 0.0f;
        for (int ly = 0; ly < 3; ly++) {
            uint ls = sd + 111u + 37u * (uint)(ly);
            float gx = u / cs + 0.5f * (float)(ly) + 0.37f, gy = v / cs + 0.31f * (float)(ly) + 0.17f * (float)(ly * ly);
            int ix = (int)(_floorf(gx)), iy = (int)(_floorf(gy));
            for (int j = -1; j <= 1; j++) {
                for (int i = -1; i <= 1; i++) {
                    int cx = ix + i, cy = iy + j;
                    float2 p = cellPt(cx, cy, 0.0f, 0.0f, 0.0f, ls);
                    float ang = 0.6f + 1.1f * _sinf(0.31f * (float)(cx) + 0.53f * (float)(cy) + 6.2831853f * rnd3(0, 0, ls))
                              + 0.6f * _sinf(0.17f * (float)(cy) - 0.41f * (float)(cx)) + 0.5f * (rnd3(cx, cy, ls + 5u) - 0.5f);
                    float ca = _cosf(ang), sa = _sinf(ang);
                    float hl = 0.55f + 0.20f * rnd3(cx, cy, ls + 6u), hw = 0.30f + 0.12f * rnd3(cx, cy, ls + 7u);
                    float dx = gx - p.x, dy = gy - p.y;
                    float ss = (dx * ca + dy * sa) / hl;
                    hw *= 0.85f + 0.3f * vn1(ss * 2.5f + 11.0f * rnd3(cx, cy, ls + 13u), ls + 14u);
                    float qn = (-dx * sa + dy * ca) / hw;
                    float s2 = ss * ss, q2 = qn * qn;
                    float mm = _powf(s2 * s2 * s2 + q2 * q2 * q2, 1.0f / 6.0f);
                    float ee = 1.5f * rp / (cs * hw);
                    float cov = 1.0f - sstep(1.0f - ee, 1.0f + ee, mm);
                    if (cov <= 0.0f) continue;
                    float bo = 37.0f * rnd3(cx, cy, ls + 10u);
                    float br = 0.6f * vn1(qn * 11.0f + bo, ls + 11u) + 0.4f * vn1(qn * 23.0f + bo, ls + 12u);
                    cov *= 1.0f - 0.7f * sstep(0.30f + 0.5f * br, 0.80f + 0.5f * br, ss);
                    float z = rnd3(cx, cy, ls + 8u) + (float)(ly);
                    float col = 0.5f + 0.9f * fbmg(p.x * cs / (S * 1.2f), p.y * cs / (S * 1.2f), 0.0f, 3, 0.5f, sd + 120u) + 0.20f * (rnd3(cx, cy, ls + 9u) - 0.5f);
                    col += 0.03f * (br - 0.5f);
                    float hgt = 0.5f + 0.04f * (br - 0.5f) + 0.05f * (1.0f - sstep(-1.0f, -0.4f, ss));
                    if (z > z1) { z2 = z1; c2 = c1; k2 = k1; h2 = h1; z1 = z; c1 = cov; k1 = col; h1 = hgt; }
                    else if (z > z2) { z2 = z; c2 = cov; k2 = col; h2 = hgt; }
                }
            }
        }
        float base = 0.5f + 0.9f * fbmg(u / (S * 1.2f), v / (S * 1.2f), 0.0f, 3, 0.5f, sd + 120u);
        val = lerp1(lerp1(base, k2, c2), k1, c1);
        aux = lerp1(lerp1(0.5f, h2, c2), h1, c1);
    } else {
        float f = 1.0f / S, vc = 1.6f;
        float x = u * f, y = v * f, gx = x / vc, gy = y / vc;
        int ix = (int)(_floorf(gx)), iy = (int)(_floorf(gy));
        float ox = 0.0f, oy = 0.0f;
        for (int j = -1; j <= 1; j++) {
            for (int i = -1; i <= 1; i++) {
                int cx = ix + i, cy = iy + j;
                float2 p = cellPt(cx, cy, t * 0.1f, 0.15f, 0.03f, sd + 131u);
                float dx = gx - p.x, dy = gy - p.y;
                float wg = _saturatef(1.0f - dx * dx - dy * dy);
                wg = wg * wg;
                float sgn = rnd3(cx, cy, sd + 132u) < 0.5f ? -1.0f : 1.0f;
                float turn = sgn * wg * ((0.6f + 1.4f * rnd3(cx, cy, sd + 133u)) * (0.4f + 0.8f * det) + 0.6f * _sinf(0.15f * t + 6.2831853f * rnd3(cx, cy, sd + 134u)));
                float cr = _cosf(turn), sr = _sinf(turn);
                ox += (dx * cr - dy * sr - dx) * vc; oy += (dx * sr + dy * cr - dy) * vc;
            }
        }
        float n = fbmg(x + ox, y + oy, t * 0.05f, 3, 0.5f, sd + 135u) + 0.06f * det * fbmg(4.0f * (x + ox), 4.0f * (y + oy), t * 0.1f, 2, 0.5f, sd + 136u);
        float dn = _fmaxf(400.0f + (300.0f + 350.0f * det) * n, 90.0f);
        float3 fc = filmRGB(dn);
        float dr = toDisp(_fminf(fc.x, 1.0f)), dg = toDisp(_fminf(fc.y, 1.0f)), db = toDisp(_fminf(fc.z, 1.0f));
        return make_float4(_saturatef(luma(dr, dg, db)), dr, dg, db);
    }
    return make_float4(_saturatef(val), aux, sx, sy);
}

__DEVICE__ float keepOut(float c, float cs, float x)
{
    return c == cs ? x : c + (x - cs);
}

__DEVICE__ float mixOut(float c, float o, float am)
{
    float m = lerp1(c, o, am);
    return (c >= 0.0f && c <= 1.0f && o >= 0.0f && o <= 1.0f) ? _saturatef(m) : m;
}

__DEVICE__ float3 dvMain(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE2D__ p_TexR, __TEXTURE2D__ p_TexG, __TEXTURE2D__ p_TexB, int dvFrame, float dvProgress, float tpAmount, float tpKind, float tpBlend, float tpStrength, float tpSize, float tpDetail, float tpSpeed, float tpFollow, float tpShape, float tpColour, float tpHue, float tpSeed)
{
    int W = p_Width, H = p_Height, x = p_X, y = p_Y;
    float3 c0 = rgbAt(p_TexR, p_TexG, p_TexB, x, y, W, H);
    if (tpAmount <= 0.0f) return c0;
    int k = (int)(tpKind + 0.5f), bl = (int)(tpBlend + 0.5f), shp = (int)(tpShape + 0.5f);
    float sc = (float)(H) / 1080.0f, pix = 1.0f / (float)(H);
    float u = ((float)(x) + 0.5f) * pix, v = ((float)(y) + 0.5f) * pix;
    float t = (float)(dvFrame) / 24.0f * tpSpeed / 100.0f;
    float S = 0.05f + 0.35f * _powf(tpSize / 100.0f, 1.5f);
    float det = tpDetail / 100.0f, st = tpStrength / 100.0f;
    uint sd = (uint)(tpSeed) * 131u + 7u;
    float pw = 1.0f / 1080.0f;
    float4 tv = texAt(k, u, v, t, S, pw, pix, det, shp, sd);
    float val = tv.x;
    float gx = 0.0f, gy = 0.0f;
    int ana = (k == 2 || k == 4) ? 1 : 0;
    if (ana == 1) { gx = tv.z; gy = tv.w; }
    if (k == 5 || k == 6 || (bl == 3 && ana == 0)) {
        float e = 1.5f * pix;
        float4 ax = texAt(k, u + e, v, t, S, pw, pix, det, shp, sd), ay = texAt(k, u, v + e, t, S, pw, pix, det, shp, sd);
        int yc = (k == 0 || (k == 6 && bl != 3)) ? 1 : 0;
        float c = yc == 1 ? tv.y : tv.x, cx = yc == 1 ? ax.y : ax.x, cy = yc == 1 ? ay.y : ay.x;
        gx = (cx - c) / e * S * 0.25f; gy = (cy - c) / e * S * 0.25f;
    }
    if (k == 5 || k == 6) {
        float dep = k == 5 ? 0.8f : 0.4f;
        float nn = 1.0f / _sqrtf(1.0f + dep * dep * (gx * gx + gy * gy));
        float nx = -gx * dep * nn, ny = -gy * dep * nn, nz = nn;
        float3 L = lightDir(t);
        float ndl = nx * L.x + ny * L.y + nz * L.z;
        float rl = 2.0f * nz * ndl - L.z, ry = 2.0f * nz * ny;
        if (k == 5) {
            float env = 0.30f + 0.34f * sstep(-0.4f, 1.0f, rl) + 0.15f * sstep(0.2f, 1.0f, -ry);
            val = _saturatef(0.85f * env + 0.45f * _powf(_saturatef(rl), 30.0f) + 0.08f * ndl);
        } else {
            val = _saturatef(val * (0.62f + 0.38f * ndl / L.z) + 0.10f * _powf(_saturatef(rl), 20.0f));
        }
    }
    float hue = tpHue / 100.0f, col = tpColour / 100.0f;
    float3 own = make_float3(1.0f, 1.0f, 1.0f);
    if (k == 7) {
        float fy = luma(tv.y, tv.z, tv.w);
        own = make_float3(_fmaxf(lerp1(fy, tv.y, 0.40f), 0.02f), _fmaxf(lerp1(fy, tv.z, 0.40f), 0.02f), _fmaxf(lerp1(fy, tv.w, 0.40f), 0.02f));
    }
    float vary = k == 6 ? 0.25f * (tv.x - 0.5f) : ((k == 1 || k == 3) ? 0.15f * tv.y : 0.0f);
    float3 tint = hue <= 0.0f ? own : specT(hue + vary);
    float tl = luma(tint.x, tint.y, tint.z);
    float3 tc = make_float3(lerp1(1.0f, tint.x / tl, col), lerp1(1.0f, tint.y / tl, col), lerp1(1.0f, tint.z / tl, col));
    float mean = k == 0 ? 0.248f : (k == 1 ? 0.695f : (k == 2 ? 0.492f : (k == 3 ? 0.107f : (k == 4 ? 0.273f : (k == 5 ? 0.535f : (k == 6 ? 0.495f : 0.685f))))));
    float hi = k == 0 ? 0.368f : (k == 1 ? 0.710f : (k == 2 ? 0.671f : (k == 3 ? 0.223f : (k == 4 ? 0.445f : (k == 5 ? 0.684f : (k == 6 ? 0.684f : 0.908f))))));
    float lum = luma(_saturatef(c0.x), _saturatef(c0.y), _saturatef(c0.z));
    float fl = _powf(sstep(0.0f, 0.5f, lum), tpFollow / 50.0f);
    float3 o = c0;
    if (bl == 0) {
        float s2 = st * 1.6f * fl;
        float br = _saturatef(0.5f + s2 * (val * tc.x - mean)), bg = _saturatef(0.5f + s2 * (val * tc.y - mean)), bb = _saturatef(0.5f + s2 * (val * tc.z - mean));
        float ar = _saturatef(c0.x), ag = _saturatef(c0.y), ab = _saturatef(c0.z);
        o = make_float3(keepOut(c0.x, ar, ar < 0.5f ? 2.0f * ar * br : 1.0f - 2.0f * (1.0f - ar) * (1.0f - br)),
                        keepOut(c0.y, ag, ag < 0.5f ? 2.0f * ag * bg : 1.0f - 2.0f * (1.0f - ag) * (1.0f - bg)),
                        keepOut(c0.z, ab, ab < 0.5f ? 2.0f * ab * bb : 1.0f - 2.0f * (1.0f - ab) * (1.0f - bb)));
    } else if (bl == 1) {
        float pk = _fmaxf(tc.x, _fmaxf(tc.y, tc.z));
        float fr = _saturatef(val * tc.x / pk / hi), fg = _saturatef(val * tc.y / pk / hi), fb = _saturatef(val * tc.z / pk / hi);
        o = make_float3(c0.x * lerp1(1.0f, fr, st), c0.y * lerp1(1.0f, fg, st), c0.z * lerp1(1.0f, fb, st));
    } else if (bl == 2) {
        float fls = _powf(_fminf(toLin(lum) / 0.293f, 1.0f), tpFollow / 30.0f);
        float a = 1.5f * st * fls * toLin(sstep(k == 7 ? 0.35f : mean, 1.0f, val));
        float ar = a * tc.x, ag = a * tc.y, ab = a * tc.z;
        float sr = _saturatef(c0.x), sg = _saturatef(c0.y), sb = _saturatef(c0.z);
        float3 lo = lightOut(toLin(sr) + ar, toLin(sg) + ag, toLin(sb) + ab, _fmaxf(ar, _fmaxf(ag, ab)));
        o = make_float3(keepOut(c0.x, sr, lo.x), keepOut(c0.y, sg, lo.y), keepOut(c0.z, sb, lo.z));
    } else {
        float ks = k == 6 ? 0.4f : 1.0f;
        float dxs = gx * ks, dys = gy * ks, gm = _sqrtf(dxs * dxs + dys * dys);
        float amt = st * 160.0f * sc / (1.0f + 2.0f * gm);
        o = bilin(p_TexR, p_TexG, p_TexB, (float)(x) - amt * dxs, (float)(y) - amt * dys, W, H);
    }
    float am = tpAmount / 100.0f;
    return make_float3(mixOut(c0.x, o.x, am), mixOut(c0.y, o.y, am), mixOut(c0.z, o.z, am));
}

// fusegen: the kernel entry (Fusion's rows run bottom up; py is the DCTL's top-down row)
__KERNEL__ void DevelopTexturePlusKb2da800a(__CONSTANTREF__ DevelopTexturePlusPb2da800a *params, __TEXTURE2D__ p_TexR, __TEXTURE2D__ p_TexG, __TEXTURE2D__ p_TexB, __TEXTURE2D__ dvSrc, __TEXTURE2D_WRITE__ dvDst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->dvSize[0] && y < params->dvSize[1])
    {
        int py = params->dvFlipY != 0 ? params->dvSize[1] - 1 - y : y;
        float3 c = dvMain(params->dvSize[0], params->dvSize[1], x, py, p_TexR, p_TexG, p_TexB, params->dvFrame, params->dvProgress, params->tpAmount, params->tpKind, params->tpBlend, params->tpStrength, params->tpSize, params->tpDetail, params->tpSpeed, params->tpFollow, params->tpShape, params->tpColour, params->tpHue, params->tpSeed);
        float4 s = _tex2DVec4(dvSrc, x, y);
        _tex2DVec4Write(dvDst, x, y, to_float4(c.x, c.y, c.z, s.w));
    }
}
]]

-- the plain source first; the compatibility source only if the plain one does not build
DvSources = { DvMath .. DvMapping .. DvKernelText, DvCompat .. DvMath .. DvMapping .. DvKernelText }
DvWorking = nil

-- the last status of each tool, so a change is reported once
DvLast = {}

-- the compute node's error log (DVIPComputeNode:GetErrorLog, a name in fusionsystem.dll), or a note that it has none
function DvNodeLog(node)
	local log = nil
	if node then
		pcall(function()
			log = node:GetErrorLog()
		end)
	end
	if log == nil or log == "" then
		return "(the node gave no error log; see the Fusion console)"
	end
	return tostring(log)
end

-- report a status: the console, the tool's data and the log file, each once per change
function DvNote(tool, failed, msg)
	local key = DvName
	pcall(function()
		key = tool.Name
	end)
	key = tostring(key)
	local text = msg
	if failed then
		text = "FAILED: " .. msg
	end
	if DvLast[key] == text then
		return
	end
	DvLast[key] = text
	print(DvName .. " [" .. key .. "] " .. text)
	pcall(function()
		tool:SetData("DevelopFuse.Status", text)
	end)
	pcall(function()
		local dir = os.getenv("TEMP") or os.getenv("TMP") or "."
		local f = io.open(dir .. "/DevelopFuse.log", "a")
		if f then
			local line = (text:gsub("[\r\n]+", " | "))
			f:write(os.date("%Y-%m-%d %H:%M:%S") .. "\t" .. key .. "\t" .. DvName .. "\t" .. line .. "\n")
			f:close()
		end
	end)
end

-- a Lua error's message with its traceback when the debug library is there
function DvTrace(e)
	if debug and debug.traceback then
		return debug.traceback(tostring(e), 2)
	end
	return tostring(e)
end

-- the visible error: a solid magenta frame the size of ref (nil when there is no picture to size it by)
function DvFailImage(ref)
	local bad = nil
	if ref then
		pcall(function()
			bad = Image({IMG_Like = ref})
			bad:Fill(Pixel({R = 1.0, G = 0.0, B = 1.0, A = 1.0}))
		end)
	end
	return bad
end

function Create()
	InTpAmount = self:AddInput("Texture", "tpAmount", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 100.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
