--[[ Develop Laser as a Fusion Fuse: the transform DCTL effects/stage/build/Develop Laser.dctl run on the GPU through DVIPComputeNode,
every pixel calling the DCTL's own main function with the DCTL's own controls. Written by
effects/fusegen/fusegen.py; regenerate it, never edit it. The picture is read and written in the values
the DCTL sees in Resolve (Rec.709 gamma 2.4 display values in Develop), with no conversion.
Frame Offset adds to the comp frame for the DCTL's frame value; Hold Frame uses Frame Offset alone.
If the kernel cannot run, the output is solid magenta and the reason is in the Fusion console, in the
tool's data DevelopFuse.Status and in %TEMP%\DevelopFuse.log. MIT License. ]]

FuRegisterClass("DevelopLaser", CT_Tool, {
	REGS_Category = "Fuses\\Develop",
	REGS_OpIconString = "DL",
	REGS_OpDescription = "Develop Laser (Develop DCTL in a Fuse)",
	REG_NoObjMatCtrls = true,
	REG_NoMotionBlurCtrls = true,
	})

DvName = "Develop Laser"
DvKind = "transform"
DvDctl = "stage/build/Develop Laser.dctl"

-- the DCTL slider steps, for the record and the inverse mapping (Fusion sliders have no step)
DvSteps = { lzAmount = 1.0, lzMode = 1.0, lzX0 = 1.0, lzY0 = 1.0, lzX1 = 1.0, lzY1 = 1.0, lzWidth = 1.0, lzGlow = 1.0, lzHaze = 1.0, lzHue = 1.0, lzFlick = 1.0, lzLength = 1.0, lzRate = 1.0, lzChaos = 1.0, lzBranch = 1.0, lzCount = 1.0, lzAngle = 1.0, lzSpread = 1.0, lzSize = 1.0, lzEvery = 1.0, lzLife = 1.0, lzPoints = 1.0, lzSeed = 1.0 }

-- this Fuse's own C names for its kernels and parameter structs (never shared with another Fuse)
DvKernelName = "DevelopLaserK663f4ffa"
DvParamsName = "DevelopLaserP663f4ffa"
DvSplitName = "DevelopLaserS663f4ffa"
DvSplitParamsName = "DevelopLaserSP663f4ffa"

DvParams = [[
	float lzAmount;
	float lzMode;
	float lzX0;
	float lzY0;
	float lzX1;
	float lzY1;
	float lzWidth;
	float lzGlow;
	float lzHaze;
	float lzHue;
	float lzFlick;
	float lzLength;
	float lzRate;
	float lzChaos;
	float lzBranch;
	float lzCount;
	float lzAngle;
	float lzSpread;
	float lzSize;
	float lzEvery;
	float lzLife;
	float lzPoints;
	float lzSeed;
	float dvProgress;
	int dvFrame;
	int dvFlipY;
	int dvSize[2];
]]

DvSplitParams = [[
	int ch;
	int flipY;
	int size[2];
]]

DvSplitSource = [[
// one channel of an image as its own texture (the channel in every component), rows turned top-down when
// flipY is set, so a DCTL's _tex2D(plane, x, y) reads what Resolve hands it
__KERNEL__ void DevelopLaserS663f4ffa(__CONSTANTREF__ DevelopLaserSP663f4ffa *params, __TEXTURE2D__ src, __TEXTURE2D_WRITE__ dst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->size[0] && y < params->size[1])
    {
        int sy = params->flipY != 0 ? params->size[1] - 1 - y : y;
        float4 c = _tex2DVec4(src, x, sy);
        float v = params->ch == 0 ? c.x : (params->ch == 1 ? c.y : (params->ch == 2 ? c.z : c.w));
        _tex2DVec4Write(dst, x, y, to_float4(v, v, v, v));
    }
}
]]

