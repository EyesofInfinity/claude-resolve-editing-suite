DvMapping = [[
// fusegen mapping (effects/fusegen/README.md section 2): a DCTL reads one channel with _tex2D(plane, x, y);
// here each plane is a texture holding that channel, read at whole-pixel coordinates by the default sampler
#define dvTex2D(dv_t, dv_x, dv_y) (_tex2DVec4((dv_t), (dv_x), (dv_y)).x)
]]

DvCompat = [[
// fusegen compatibility, used only when the plain source does not build: Resolve's DCTL names for the vector
// constructors, over Fusion's own
#ifndef make_float2
#define make_float2(a, b) to_float2((a), (b))
#endif
#ifndef make_float3
#define make_float3(a, b, c) to_float3((a), (b), (c))
#endif
#ifndef make_float4
#define make_float4(a, b, c, d) to_float4((a), (b), (c), (d))
#endif
]]

DvKernelText = [[
// Develop Film Dissolve: film and television hand-overs in one Transition DCTL. Lay it on a cut from Edit page >
// OpenFX > Transition > ResolveFX Color > DCTL and pick
// this file. Style:
//   0 Film Dissolve: the optical printer's dissolve. The printer exposes the outgoing shot onto the dupe fading out,
//     winds back, and exposes the incoming fading in, so the two add as exposure on the negative and the print's curve
//     (its toe and its shoulder) makes the picture. A highlight given dvHalf its light drops a little on the shoulder,
//     where a video dissolve takes it halfway to grey; the blacks stay down in the toe. Highlight Hold sets the curve
//     (0 is a dissolve in linear light). Grain rises in the dissolve, as an optical's dupe generation shows.
//   1 Film Roll: the projector loses its loop and the film slips through the gate. The frames roll by with the black
//     frame line between them, streaked by the strip's speed while the shutter is open, weaving in the gate and
//     flickering, until the incoming shot's frame settles in the gate. Frames: how many frame lines roll by.
//   2 TV Roll: the set loses sync as the channel changes. The vertical hold goes: the picture rolls with its black
//     blanking bar, faster and faster; the horizontal hold goes with it, the lines slipping sideways into diagonal bands
//     with the blanking edge running through them and the top of the picture bending; colour drops out and snow
//     comes up over the change; then the incoming station rolls in and locks.
// dvProgress runs it; it starts exactly on the outgoing shot and ends exactly on the incoming. MIT License.

// fusegen ui: fdStyle
// fusegen ui: fdHold
// fusegen ui: fdFrames
// fusegen ui: fdDir
// fusegen ui: fdBar
// fusegen ui: fdBlur
// fusegen ui: fdWeave
// fusegen ui: fdFlicker
// fusegen ui: fdGrain
// fusegen ui: fdTear
// fusegen ui: fdSnow
// fusegen ui: fdSeed

// fusegen tip: Style
// fusegen tip: Highlight Hold
// fusegen tip: Frames
// fusegen tip: Direction
// fusegen tip: Frame Line
// fusegen tip: Sync Tear

// Develop lens: shared code of Develop Bokeh and Develop Lens, on top of light.h and glitch.h. Bilinear sampling
// with mirrored edges, linear light (Rec.709 gamma 2.4). MIT License.

// Develop light: the shared code of Develop Leak, Develop Burn and Develop Light Dissolve.
// build.py writes it into each effect, so every installed .dctl stands alone. Rec.709 gamma 2.4 in and out;
// light is added in linear. Coordinates are in frame heights (y 0 to 1 top to bottom, x 0 to width/height),
// so a leak keeps its shape at any resolution and aspect. MIT License.

__DEVICE__ float toLin(float x) { return _powf(_fmaxf(x, 0.0f), 2.4f); }
__DEVICE__ float toDisp(float x) { return _powf(_fmaxf(x, 0.0f), 1.0f / 2.4f); }
__DEVICE__ float luma(float r, float g, float b) { return 0.2126f * r + 0.7152f * g + 0.0722f * b; }
__DEVICE__ float lerp1(float a, float b, float t) { return a + (b - a) * t; }
__DEVICE__ float sstep(float a, float b, float x) { float t = _saturatef((x - a) / (b - a)); return t * t * (3.0f - 2.0f * t); }

__DEVICE__ float3 shoulder(float r, float g, float b)
{
    float m = _fmaxf(r, _fmaxf(g, b));
    if (m <= 0.8f) return make_float3(r, g, b);
    float nm = 0.8f + 0.2f * _tanhf((m - 0.8f) / 0.2f);
    float k = nm / m, w = 0.6f * sstep(1.0f, 3.0f, m);
    return make_float3(lerp1(r * k, nm, w), lerp1(g * k, nm, w), lerp1(b * k, nm, w));
}

__DEVICE__ float3 lightOut(float r, float g, float b, float k)
{
    float3 s = shoulder(r, g, b);
    float w = _saturatef(k * 4.0f);
    return make_float3(_saturatef(toDisp(lerp1(r, s.x, w))), _saturatef(toDisp(lerp1(g, s.y, w))), _saturatef(toDisp(lerp1(b, s.z, w))));
}

__DEVICE__ float hash01(uint x, uint y, uint z)
{
    x = x * 1664525u + 1013904223u; y = y * 1664525u + 1013904223u; z = z * 1664525u + 1013904223u;
    x += y * z; y += z * x; z += x * y;
    x ^= x >> 16u; y ^= y >> 16u; z ^= z >> 16u;
    x += y * z; y += z * x; z += x * y;
    return (float)(x >> 8u) * (1.0f / 16777216.0f);
}

__DEVICE__ float fade(float t) { return t * t * t * (t * (t * 6.0f - 15.0f) + 10.0f); }

__DEVICE__ float vnoise3(float x, float y, float z, uint s)
{
    int ix = (int)(x), iy = (int)(y), iz = (int)(z);
    float tx = fade(x - (float)(ix)), ty = fade(y - (float)(iy)), tz = fade(z - (float)(iz));
    uint x0 = (uint)(ix), y0 = (uint)(iy), z0 = (uint)(iz) + s * 7919u;
    float a0 = lerp1(lerp1(hash01(x0, y0, z0), hash01(x0 + 1u, y0, z0), tx), lerp1(hash01(x0, y0 + 1u, z0), hash01(x0 + 1u, y0 + 1u, z0), tx), ty);
    float a1 = lerp1(lerp1(hash01(x0, y0, z0 + 1u), hash01(x0 + 1u, y0, z0 + 1u), tx), lerp1(hash01(x0, y0 + 1u, z0 + 1u), hash01(x0 + 1u, y0 + 1u, z0 + 1u), tx), ty);
    return lerp1(a0, a1, tz);
}

__DEVICE__ float fbm(float x, float y, float z, int n, uint s)
{
    float sum = 0.0f, amp = 0.5f, tot = 0.0f, f = 1.0f;
    for (int i = 0; i < 5; i++) {
        if (i >= n) break;
        sum += amp * vnoise3(x * f + 4096.0f + 37.1f * (float)(i), y * f + 4096.0f + 11.7f * (float)(i), z * f + 4096.0f, s + (uint)(i));
        tot += amp; amp *= 0.5f; f *= 2.03f;
    }
    float v = sum / tot;
    return _saturatef((v - 0.5f) * 1.6f + 0.5f);
}

__DEVICE__ float3 ramp(float pal, float t, float age)
{
    int p = (int)(pal + 0.5f);
    float c0r = 0.30f, c0g = 0.10f, c0b = 0.42f, c1r = 0.62f, c1g = 0.35f, c1b = 0.47f, c2r = 0.86f, c2g = 0.76f, c2b = 0.68f;
    float h0r = 0.73f, h0g = 0.16f, h0b = 0.26f, h1r = 0.89f, h1g = 0.35f, h1b = 0.17f, h2r = 0.94f, h2g = 0.50f, h2b = 0.22f;
    if (p == 1) {
        c0r = 0.45f; c0g = 0.08f; c0b = 0.05f; c1r = 0.85f; c1g = 0.30f; c1b = 0.08f; c2r = 0.98f; c2g = 0.70f; c2b = 0.35f;
        h0r = 0.80f; h0g = 0.20f; h0b = 0.04f; h1r = 0.98f; h1g = 0.55f; h1b = 0.12f; h2r = 1.00f; h2g = 0.85f; h2b = 0.55f;
    }
    if (p == 2) {
        c0r = 0.18f; c0g = 0.10f; c0b = 0.45f; c1r = 0.65f; c1g = 0.25f; c1b = 0.65f; c2r = 0.95f; c2g = 0.70f; c2b = 0.75f;
        h0r = 0.70f; h0g = 0.15f; h0b = 0.50f; h1r = 0.95f; h1g = 0.45f; h1b = 0.45f; h2r = 1.00f; h2g = 0.75f; h2b = 0.55f;
    }
    if (p == 3) {
        c0r = 0.05f; c0g = 0.10f; c0b = 0.35f; c1r = 0.15f; c1g = 0.40f; c1b = 0.75f; c2r = 0.70f; c2g = 0.85f; c2b = 0.98f;
        h0r = 0.10f; h0g = 0.25f; h0b = 0.60f; h1r = 0.35f; h1g = 0.65f; h1b = 0.95f; h2r = 0.85f; h2g = 0.95f; h2b = 1.00f;
    }
    float a = _saturatef(age);
    float r0 = lerp1(c0r, h0r, a), g0 = lerp1(c0g, h0g, a), b0 = lerp1(c0b, h0b, a);
    float r1 = lerp1(c1r, h1r, a), g1 = lerp1(c1g, h1g, a), b1 = lerp1(c1b, h1b, a);
    float r2 = lerp1(c2r, h2r, a), g2 = lerp1(c2g, h2g, a), b2 = lerp1(c2b, h2b, a);
    float u = _saturatef(t);
    float r, g, b;
    if (u < 0.5f) { float k = u * 2.0f; r = lerp1(r0, r1, k); g = lerp1(g0, g1, k); b = lerp1(b0, b1, k); }
    else { float k = u * 2.0f - 1.0f; r = lerp1(r1, r2, k); g = lerp1(g1, g2, k); b = lerp1(b1, b2, k); }
    float hot = sstep(1.0f, 1.4f, t);
    return make_float3(toLin(lerp1(r, 1.0f, hot)), toLin(lerp1(g, 0.96f, hot)), toLin(lerp1(b, 0.90f, hot)));
}

__DEVICE__ float leakField(float x, float y, float aspect, float deg, float w, float sc, float z, uint s)
{
    float a = deg * 0.0174533f, ca = _cosf(a), sa = _sinf(a);
    float ext = 0.5f * (_fabs(ca) * aspect + _fabs(sa));
    float sproj = (x - 0.5f * aspect) * ca + (y - 0.5f) * sa;
    float warp = fbm(x * 1.3f, y * 1.3f, z * 0.35f, 2, s + 40u) - 0.5f;
    float d = _fmaxf(ext - sproj + 0.45f * warp * w * aspect, 0.0f);
    float reach = _fmaxf(w * aspect, 0.02f);
    float e = _expf(-(d / reach) * (d / reach));
    float cloud = fbm(x / sc, y / sc, z, 3, s);
    return _saturatef(e * (0.35f + 1.3f * cloud));
}

__DEVICE__ float burnHeat(float x, float y, float cover, float sc, float z, uint s)
{
    float wx = fbm(x / sc * 0.7f, y / sc * 0.7f, z * 0.6f, 2, s + 90u) - 0.5f;
    float wy = fbm(x / sc * 0.7f + 31.0f, y / sc * 0.7f, z * 0.6f, 2, s + 91u) - 0.5f;
    float h = fbm((x + 0.6f * wx) / sc, (y + 0.6f * wy) / sc, z, 4, s);
    float th = 1.0f - cover;
    return _saturatef((h - th + 0.28f) / 0.62f);
}

__DEVICE__ float dust(int px, int py, int h, float amount, uint z)
{
    float sc = (float)(h) / 1080.0f;
    int cx = (int)((float)(px) / (2.5f * sc)), cy = (int)((float)(py) / (2.5f * sc));
    float r = hash01((uint)(cx), (uint)(cy), z * 13u + 5u);
    float lim = 0.00002f * amount;
    if (r > lim) return 0.0f;
    return hash01((uint)(cx), (uint)(cy), z * 13u + 6u) < 0.6f ? -1.0f : 1.0f;
}

__DEVICE__ float4 burnOver(float r, float g, float b, float x, float y, float aspect, int px, int py, int ph,
                           float cover, float pal, float age, float sc, float show, float grain, float dst,
                           float z, uint fz, uint s)
{
    float k = sstep(0.0f, 0.35f, burnHeat(x, y, cover, sc, z, s));
    uint zi = (uint)(z + 1000.0f);
    float ang = 6.2831853f * ((float)(zi % 1000u) * 0.37f + 0.25f * hash01(zi, s, 71u));
    float ca = _cosf(ang), sa = _sinf(ang), ext = 0.5f * (_fabs(ca) * aspect + _fabs(sa));
    float band = 0.5f + 0.5f * ((x - 0.5f * aspect) * ca + (y - 0.5f) * sa) / ext;
    float cl = fbm(x / (sc * 1.6f), y / (sc * 1.6f), z, 3, s + 200u);
    float t = 0.05f + 0.95f * _saturatef(0.8f * band + 0.95f * (cl - 0.5f) + 0.15f);
    float3 c = ramp(pal, t, age);
    float keep = lerp1(1.0f, show, k);
    float gr = 1.0f + grain * 0.22f * (hash01((uint)(px), (uint)(py), fz * 3u + s) - 0.5f) * k;
    float d = dust(px, py, ph, dst * 100.0f, fz + s) * k;
    float rr = (r * keep + c.x * k) * gr, gg = (g * keep + c.y * k) * gr, bb = (b * keep + c.z * k) * gr;
    if (d < 0.0f) { rr *= 0.15f; gg *= 0.12f; bb *= 0.12f; }
    if (d > 0.0f) { rr = rr + 0.6f; gg = gg + 0.55f; bb = bb + 0.45f; }
    return make_float4(rr, gg, bb, k);
}
// Develop glitch: shared code of the glitch effects, on top of light.h's hash and helpers. MIT License.

__DEVICE__ int clampi(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }

__DEVICE__ float3 rgbAt(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h)
{
    int cx = clampi(x, 0, w - 1), cy = clampi(y, 0, h - 1);
    return make_float3(dvTex2D(tr, cx, cy), dvTex2D(tg, cx, cy), dvTex2D(tb, cx, cy));
}

__DEVICE__ float lumaAt(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, int x, int y, int w, int h)
{
    float3 c = rgbAt(tr, tg, tb, x, y, w, h);
    return luma(c.x, c.y, c.z);
}

__DEVICE__ float rnd3(int a, int b, uint c) { return hash01((uint)(a + 65536), (uint)(b + 65536), c); }

__DEVICE__ float bayer8(int cx, int cy)
{
    int bx = cx & 7, by = cy & 7, xr = bx ^ by;
    int v = ((xr & 1) << 5) | ((by & 1) << 4) | ((xr & 2) << 2) | ((by & 2) << 1) | ((xr & 4) >> 1) | ((by & 4) >> 2);
    return ((float)(v) + 0.5f) / 64.0f;
}

__DEVICE__ float3 gritFinish(float3 c, int x, int y, int h, float g, float grit, float dith, uint seed)
{
    if (g <= 0.0f) return c;
    float L = luma(c.x, c.y, c.z);
    float n = hash01((uint)(x + 65536), (uint)(y + 65536), seed) - 0.5f;
    float gr = grit * g * 0.16f * (0.35f + 0.65f * L) * n;
    float r = c.x + gr, gg = c.y + gr, b = c.z + gr;
    float d = dith * g;
    if (d > 0.0f) {
        int cell = (int)(2.0f * (float)(h) / 1080.0f + 0.5f);
        if (cell < 1) cell = 1;
        float t = bayer8((int)(x / cell), (int)(y / cell));
        float lv = 32.0f * (1.0f - d) + 3.0f * d - 1.0f;
        r = _floorf(_saturatef(r) * lv + t) / lv; gg = _floorf(_saturatef(gg) * lv + t) / lv; b = _floorf(_saturatef(b) * lv + t) / lv;
    }
    return make_float3(_saturatef(r), _saturatef(gg), _saturatef(b));
}

__DEVICE__ float3 chromaBleed(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, float3 c, int x, int y, int w, int h, int k)
{
    if (k < 1) return c;
    float3 a = rgbAt(tr, tg, tb, x - k, y, w, h), b = rgbAt(tr, tg, tb, x - (int)(k / 2), y, w, h);
    float3 m = make_float3((a.x + b.x + c.x) / 3.0f, (a.y + b.y + c.y) / 3.0f, (a.z + b.z + c.z) / 3.0f);
    float L = luma(c.x, c.y, c.z), Lm = luma(m.x, m.y, m.z);
    return make_float3(m.x - Lm + L, m.y - Lm + L, m.z - Lm + L);
}

__DEVICE__ int mirL(int i, int n)
{
    int q = 2 * n, m = i % q;
    if (m < 0) m += q;
    if (m >= n) m = q - 1 - m;
    return clampi(m, 0, n - 1);
}

__DEVICE__ float3 bilL(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, float fx, float fy, int w, int h)
{
    float bx = _floorf(fx), by = _floorf(fy);
    float ax = fx - bx, ay = fy - by;
    int x0 = (int)(bx), y0 = (int)(by);
    int xa = mirL(x0, w), xb = mirL(x0 + 1, w), ya = mirL(y0, h), yb = mirL(y0 + 1, h);
    float3 c00 = make_float3(dvTex2D(tr, xa, ya), dvTex2D(tg, xa, ya), dvTex2D(tb, xa, ya));
    if (ax == 0.0f && ay == 0.0f) return c00;
    float3 c10 = make_float3(dvTex2D(tr, xb, ya), dvTex2D(tg, xb, ya), dvTex2D(tb, xb, ya));
    float3 c01 = make_float3(dvTex2D(tr, xa, yb), dvTex2D(tg, xa, yb), dvTex2D(tb, xa, yb));
    float3 c11 = make_float3(dvTex2D(tr, xb, yb), dvTex2D(tg, xb, yb), dvTex2D(tb, xb, yb));
    return make_float3(lerp1(lerp1(c00.x, c10.x, ax), lerp1(c01.x, c11.x, ax), ay),
                       lerp1(lerp1(c00.y, c10.y, ax), lerp1(c01.y, c11.y, ax), ay),
                       lerp1(lerp1(c00.z, c10.z, ax), lerp1(c01.z, c11.z, ax), ay));
}

__DEVICE__ float3 linL(__TEXTURE2D__ tr, __TEXTURE2D__ tg, __TEXTURE2D__ tb, float fx, float fy, int w, int h)
{
    float3 c = bilL(tr, tg, tb, fx, fy, w, h);
    return make_float3(toLin(c.x), toLin(c.y), toLin(c.z));
}

__DEVICE__ float aperture(float a, float n, float rot, float rnd)
{
    if (n < 3.0f) return 1.0f;
    float seg = 6.2831853f / n;
    float t = a - rot;
    float m = t - seg * _floorf(t / seg) - 0.5f * seg;
    float poly = _cosf(0.5f * seg) / _cosf(m);
    return lerp1(poly, 1.0f, rnd);
}

__DEVICE__ float3 specL(float t)
{
    float a = 6.2831853f * t;
    float r = 0.5f + 0.5f * _cosf(a), g = 0.5f + 0.5f * _cosf(a - 2.0943951f), b = 0.5f + 0.5f * _cosf(a - 4.1887902f);
    return make_float3(r * r * r, g * g * g, b * b * b);
}

__DEVICE__ float printF(float E, float k, float tau)
{
    float u = k < 0.001f ? E : (1.0f - _expf(-k * E)) / (1.0f - _expf(-k));
    return tau <= 0.0f ? u : u * u / (u + tau) * (1.0f + tau);
}

__DEVICE__ float exposureF(float v, float k, float tau)
{
    float y = _saturatef(v), u = y;
    if (tau > 0.0f) {
        float a = y / (1.0f + tau);
        u = 0.5f * (a + _sqrtf(a * a + 4.0f * a * tau));
    }
    if (k < 0.001f) return u;
    return -_logf(_fmaxf(1.0f - u * (1.0f - _expf(-k)), 1e-7f)) / k;
}

__DEVICE__ float3 grainF(float3 c, int x, int y, float sc, float amt, float tz, uint seed)
{
    if (amt <= 0.0f) return c;
    float cs = 1.4f * sc;
    float n = vnoise3((float)(x) / cs + 4096.0f, (float)(y) / cs + 4096.0f, tz + 4096.0f, seed) - 0.5f;
    float m = vnoise3((float)(x) / cs + 5096.0f, (float)(y) / cs + 4096.0f, tz + 4096.0f, seed + 9u) - 0.5f;
    float L = luma(_saturatef(c.x), _saturatef(c.y), _saturatef(c.z));
    float k = amt * 0.16f * (0.25f + 3.0f * L * (1.0f - L));
    return make_float3(_saturatef(c.x + k * (n + 0.25f * m)), _saturatef(c.y + k * n), _saturatef(c.z + k * (n - 0.25f * m)));
}

__DEVICE__ float barF(float z, float pitch, float hh, float e)
{
    float k = _floorf(z / pitch), yy = z - k * pitch;
    float sd = yy >= hh ? _fminf(yy - hh, pitch - yy) : -_fminf(hh - yy, yy);
    return sstep(-e, e, sd);
}

__DEVICE__ float3 stripF(__TEXTURE2D__ ar, __TEXTURE2D__ ag, __TEXTURE2D__ ab, __TEXTURE2D__ br, __TEXTURE2D__ bg, __TEXTURE2D__ bb,
                         float fx, float z, float pitch, int n, int down, int W, int H, float e)
{
    float hh = (float)(H);
    float k = _floorf(z / pitch), yy = z - k * pitch;
    int ki = (int)(k);
    int isB = down == 1 ? (ki <= -n ? 1 : 0) : (ki >= n ? 1 : 0);
    float fy = _fminf(yy, hh - 1.0f);
    float3 c = isB == 1 ? linL(br, bg, bb, fx, fy, W, H) : linL(ar, ag, ab, fx, fy, W, H);
    float bar = barF(z, pitch, hh, e);
    return make_float3(c.x * (1.0f - bar), c.y * (1.0f - bar), c.z * (1.0f - bar));
}

__DEVICE__ float slipF(float yy, float hh, float W, float tear, float jit)
{
    float skew = tear * tear * 3.0f * W * (yy / hh);
    float bend = tear * 0.07f * W * _expf(-yy / (0.05f * hh));
    return skew + bend + jit;
}

__DEVICE__ float4 dvMain(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE2D__ p_FromTexR, __TEXTURE2D__ p_FromTexG, __TEXTURE2D__ p_FromTexB, __TEXTURE2D__ p_FromTexA, __TEXTURE2D__ p_ToTexR, __TEXTURE2D__ p_ToTexG, __TEXTURE2D__ p_ToTexB, __TEXTURE2D__ p_ToTexA, int dvFrame, float dvProgress, float fdStyle, float fdHold, float fdFrames, float fdDir, float fdBar, float fdBlur, float fdWeave, float fdFlicker, float fdGrain, float fdTear, float fdSnow, float fdSeed)
{
    float p = _saturatef(dvProgress);
    float da = dvTex2D(p_FromTexR, p_X, p_Y), dg = dvTex2D(p_FromTexG, p_X, p_Y), db = dvTex2D(p_FromTexB, p_X, p_Y);
    float ea = dvTex2D(p_ToTexR, p_X, p_Y), eg = dvTex2D(p_ToTexG, p_X, p_Y), eb = dvTex2D(p_ToTexB, p_X, p_Y);
    if (p <= 0.0f) return make_float4(da, dg, db, 1.0f);
    if (p >= 1.0f) return make_float4(ea, eg, eb, 1.0f);
    int W = p_Width, H = p_Height, x = p_X, y = p_Y;
    float hh = (float)(H), ww = (float)(W), sc = hh / 1080.0f;
    int st = (int)(fdStyle + 0.5f);
    uint seed = (uint)(fdSeed) * 131u + 17u;
    int n = (int)(fdFrames + 0.5f);
    int down = fdDir > 0.5f ? 1 : 0;
    float taper = sstep(0.0f, 0.12f, p) * sstep(0.0f, 0.12f, 1.0f - p);
    float sn = _sinf(3.1415927f * p), env = sn * sn * taper;
    float grain = fdGrain / 100.0f;
    float tz = p * 150.0f;
    float3 o;

    if (st == 0) {
        float hold = fdHold / 100.0f;
        float k = 7.0f * hold, tau = 0.03f * hold;
        float p3 = p * p * p, q3 = (1.0f - p) * (1.0f - p) * (1.0f - p);
        float t = p3 / (p3 + q3);
        float r = printF((1.0f - t) * exposureF(toLin(da), k, tau) + t * exposureF(toLin(ea), k, tau), k, tau);
        float g = printF((1.0f - t) * exposureF(toLin(dg), k, tau) + t * exposureF(toLin(eg), k, tau), k, tau);
        float b = printF((1.0f - t) * exposureF(toLin(db), k, tau) + t * exposureF(toLin(eb), k, tau), k, tau);
        o = make_float3(_saturatef(toDisp(r)), _saturatef(toDisp(g)), _saturatef(toDisp(b)));
        o = grainF(o, x, y, sc, grain * sstep(0.0f, 0.15f, p) * sstep(0.0f, 0.15f, 1.0f - p), tz, seed);
        return make_float4(o.x, o.y, o.z, 1.0f);
    }

    float fx = (float)(x), fy = (float)(y);
    if (st == 1) {
        float pitch = hh * (1.0f + 0.16f * fdBar / 100.0f);
        float s = fade(p), v = 30.0f * p * p * (1.0f - p) * (1.0f - p);
        float run = (float)(n) * pitch;
        float z0 = down == 1 ? fy - s * run : fy + s * run;
        float streak = fdBlur / 100.0f * v * run / 24.0f * 0.5f;
        float wv = fdWeave / 100.0f * env;
        float ox = wv * 0.012f * ww * (vnoise3(p * 18.0f + 100.0f, 3.5f, 0.5f, seed + 1u) - 0.5f) * 2.0f;
        float oy = wv * 0.02f * hh * (vnoise3(p * 23.0f + 200.0f, 7.5f, 0.5f, seed + 2u) - 0.5f) * 2.0f;
        float e = _fmaxf(1.2f * sc, 0.75f);
        float r = 0.0f, g = 0.0f, b = 0.0f;
        int nt = (int)(_fminf(streak / (1.5f * sc), 31.0f)) + 1;
        float jt = hash01((uint)(x) + 4096u, (uint)(y) + 4096u, seed + 3u);
        for (int i = 0; i < 32; i++) {
            if (i >= nt) break;
            float dz = nt == 1 ? 0.0f : streak * (((float)(i) + jt) / (float)(nt) - 0.5f);
            float3 c = stripF(p_FromTexR, p_FromTexG, p_FromTexB, p_ToTexR, p_ToTexG, p_ToTexB, fx + ox, z0 + oy + dz, pitch, n, down, W, H, e);
            r += c.x; g += c.y; b += c.z;
        }
        r /= (float)(nt); g /= (float)(nt); b /= (float)(nt);
        float fl = fdFlicker / 100.0f * env;
        float ex = 1.0f + fl * 0.7f * (vnoise3(p * 60.0f + 300.0f, 1.5f, 0.5f, seed + 4u) - 0.5f) * 2.0f - 0.15f * fl;
        o = make_float3(_saturatef(toDisp(r * ex)), _saturatef(toDisp(g * ex)), _saturatef(toDisp(b * ex)));
        o = grainF(o, x, y, sc, grain * env, tz, seed + 5u);
        return make_float4(o.x, o.y, o.z, 1.0f);
    }

    float pitch = hh * (1.0f + 0.16f * fdBar / 100.0f);
    int isB = p >= 0.5f ? 1 : 0;
    float ra = sstep(0.0f, 0.5f, p), rb = sstep(0.0f, 0.5f, 1.0f - p);
    float roll = isB == 1 ? -(float)(n) * rb * rb * rb : (float)(n) * ra * ra * ra;
    if (down == 1) roll = -roll;
    float z = fy + roll * pitch;
    float kf = _floorf(z / pitch), yy = z - kf * pitch;
    float bar = barF(z, pitch, hh, _fmaxf(1.5f * sc, 0.75f));
    float hold = sstep(0.1f, 0.5f, p) * sstep(0.1f, 0.5f, 1.0f - p);
    float tear = fdTear / 100.0f * hold * taper;
    int line = (int)(_floorf(yy));
    float jit = tear * 6.0f * sc * (vnoise3((float)(line) * 0.7f + 4096.0f, tz * 2.0f + 4096.0f, 0.5f, seed + 6u) - 0.5f) * 2.0f;
    float span = ww * 1.17f;
    float xs = fx - slipF(yy, hh, ww, tear, jit);
    xs = xs - span * _floorf(xs / span);
    float hb = sstep(ww - 1.5f * sc, ww + 1.5f * sc, xs) * (1.0f - sstep(span - 1.5f * sc, span, xs));
    float yr = _fminf(yy, hh - 1.0f), xr = _fminf(xs, ww - 1.0f);
    float3 c = isB == 1 ? bilL(p_ToTexR, p_ToTexG, p_ToTexB, xr, yr, W, H) : bilL(p_FromTexR, p_FromTexG, p_FromTexB, xr, yr, W, H);
    float L = luma(c.x, c.y, c.z), ck = 0.85f * env;
    c = make_float3(lerp1(c.x, L, ck), lerp1(c.y, L, ck), lerp1(c.z, L, ck));
    float vis = (1.0f - bar) * (1.0f - hb);
    c = make_float3(c.x * vis, c.y * vis, c.z * vis);
    float sw = fdSnow / 100.0f * sstep(0.18f, 0.5f, p) * sstep(0.18f, 0.5f, 1.0f - p);
    if (sw > 0.0f) {
        float nz = vnoise3(fx / (2.5f * sc) + 4096.0f, fy + 4096.0f + 0.5f, tz * 3.0f + 4096.0f, seed + 7u);
        float nz2 = vnoise3(fx / (1.2f * sc) + 6096.0f, fy + 4096.0f + 0.5f, tz * 3.0f + 4096.0f, seed + 8u);
        float sv = _saturatef(0.45f + 2.6f * (0.65f * nz + 0.35f * nz2 - 0.5f));
        float k = 0.85f * sw;
        float cm = 0.5f * (1.0f - k);
        c = make_float3(lerp1(c.x * (1.0f - cm) + 0.05f * cm, sv, k), lerp1(c.y * (1.0f - cm) + 0.05f * cm, sv, k), lerp1(c.z * (1.0f - cm) + 0.05f * cm, sv, k));
    }
    float pl = _fmaxf(3.0f * sc, 2.0f);
    float scan = 1.0f - 0.28f * env * (0.5f + 0.5f * _cosf(6.2831853f * (fy + 0.5f) / pl));
    o = make_float3(_saturatef(c.x * scan), _saturatef(c.y * scan), _saturatef(c.z * scan));
    float wcut = sstep(0.47f, 0.53f, p);
    if (wcut > 0.0f && wcut < 1.0f) {
        float3 c2 = isB == 1 ? bilL(p_FromTexR, p_FromTexG, p_FromTexB, xr, yr, W, H) : bilL(p_ToTexR, p_ToTexG, p_ToTexB, xr, yr, W, H);
        float L2 = luma(c2.x, c2.y, c2.z);
        c2 = make_float3(lerp1(c2.x, L2, ck) * vis * scan, lerp1(c2.y, L2, ck) * vis * scan, lerp1(c2.z, L2, ck) * vis * scan);
        float wm = isB == 1 ? 1.0f - wcut : wcut;
        o = make_float3(lerp1(o.x, _saturatef(c2.x), wm * (1.0f - 0.85f * sw)), lerp1(o.y, _saturatef(c2.y), wm * (1.0f - 0.85f * sw)), lerp1(o.z, _saturatef(c2.z), wm * (1.0f - 0.85f * sw)));
    }
    return make_float4(o.x, o.y, o.z, 1.0f);
}

// fusegen: the kernel entry (Fusion's rows run bottom up; py is the DCTL's top-down row)
__KERNEL__ void DevelopFilmDissolveK63aeb787(__CONSTANTREF__ DevelopFilmDissolveP63aeb787 *params, __TEXTURE2D__ p_FromTexR, __TEXTURE2D__ p_FromTexG, __TEXTURE2D__ p_FromTexB, __TEXTURE2D__ p_FromTexA, __TEXTURE2D__ p_ToTexR, __TEXTURE2D__ p_ToTexG, __TEXTURE2D__ p_ToTexB, __TEXTURE2D__ p_ToTexA, __TEXTURE2D_WRITE__ dvDst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->dvSize[0] && y < params->dvSize[1])
    {
        int py = params->dvFlipY != 0 ? params->dvSize[1] - 1 - y : y;
        float4 c = dvMain(params->dvSize[0], params->dvSize[1], x, py, p_FromTexR, p_FromTexG, p_FromTexB, p_FromTexA, p_ToTexR, p_ToTexG, p_ToTexB, p_ToTexA, params->dvFrame, params->dvProgress, params->fdStyle, params->fdHold, params->fdFrames, params->fdDir, params->fdBar, params->fdBlur, params->fdWeave, params->fdFlicker, params->fdGrain, params->fdTear, params->fdSnow, params->fdSeed);
        _tex2DVec4Write(dvDst, x, y, c);
    }
}
]]

-- the plain source first; the compatibility source only if the plain one does not build
DvSources = { DvMath .. DvMapping .. DvKernelText, DvCompat .. DvMath .. DvMapping .. DvKernelText }
DvWorking = nil

-- the last status of each tool, so a change is reported once
DvLast = {}

-- the compute node's error log (DVIPComputeNode:GetErrorLog, a name in fusionsystem.dll), or a note that it has none
function DvNodeLog(node)
	local log = nil
	if node then
		pcall(function()
			log = node:GetErrorLog()
		end)
	end
	if log == nil or log == "" then
		return "(the node gave no error log; see the Fusion console)"
	end
	return tostring(log)
end

-- report a status: the console, the tool's data and the log file, each once per change
function DvNote(tool, failed, msg)
	local key = DvName
	pcall(function()
		key = tool.Name
	end)
	key = tostring(key)
	local text = msg
	if failed then
		text = "FAILED: " .. msg
	end
	if DvLast[key] == text then
		return
	end
	DvLast[key] = text
	print(DvName .. " [" .. key .. "] " .. text)
	pcall(function()
		tool:SetData("DevelopFuse.Status", text)
	end)
	pcall(function()
		local dir = os.getenv("TEMP") or os.getenv("TMP") or "."
		local f = io.open(dir .. "/DevelopFuse.log", "a")
		if f then
			local line = (text:gsub("[\r\n]+", " | "))
			f:write(os.date("%Y-%m-%d %H:%M:%S") .. "\t" .. key .. "\t" .. DvName .. "\t" .. line .. "\n")
			f:close()
		end
	end)
end

-- a Lua error's message with its traceback when the debug library is there
function DvTrace(e)
	if debug and debug.traceback then
		return debug.traceback(tostring(e), 2)
	end
	return tostring(e)
end

-- the visible error: a solid magenta frame the size of ref (nil when there is no picture to size it by)
function DvFailImage(ref)
	local bad = nil
	if ref then
		pcall(function()
			bad = Image({IMG_Like = ref})
			bad:Fill(Pixel({R = 1.0, G = 0.0, B = 1.0, A = 1.0}))
		end)
	end
	return bad
end

function Create()
	InProgress = self:AddInput("Progress", "Progress", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 1.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 1.0,
		INPS_StatusText = "The transition from Outgoing (0) to Incoming (1): the DCTL's TRANSITION_PROGRESS",
		})
	InFdStyle = self:AddInput("Style", "fdStyle", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 2.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 2.0,
		INPS_StatusText = "0 Film Dissolve, 1 Film Roll, 2 TV Roll",
		})
	InFdHold = self:AddInput("Highlight Hold", "fdHold", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 70.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "Film Dissolve: how far the brights hold through the dissolve; 0 is a dissolve in linear light",
		})
	InFdFrames = self:AddInput("Frames", "fdFrames", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 1.0,
		INP_MinScale = 1.0,
		INP_MaxScale = 4.0,
		INP_MinAllowed = 1.0,
		INP_MaxAllowed = 4.0,
		INPS_StatusText = "Film Roll: frame lines that roll by; TV Roll: how many times the picture rolls each side of the change",
		})
	InFdDir = self:AddInput("Direction", "fdDir", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 1.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 1.0,
		INPS_StatusText = "0 the picture rolls up, 1 down",
		})
	InFdBar = self:AddInput("Frame Line", "fdBar", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "The black bar between frames (film) or the blanking bar (TV)",
		})
	InFdBlur = self:AddInput("Motion Blur", "fdBlur", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 60.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InFdWeave = self:AddInput("Weave", "fdWeave", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 40.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InFdFlicker = self:AddInput("Flicker", "fdFlicker", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 40.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InFdGrain = self:AddInput("Grain", "fdGrain", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 30.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InFdTear = self:AddInput("Sync Tear", "fdTear", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		INPS_StatusText = "TV Roll: how far the lines slip sideways when the horizontal hold goes",
		})
	InFdSnow = self:AddInput("Snow", "fdSnow", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 50.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InFdSeed = self:AddInput("Seed", "fdSeed", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InFrameOffset = self:AddInput("Frame Offset", "FrameOffset", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Integer = true,
		INP_Default = 0,
		INP_MinScale = 0,
		INP_MaxScale = 1000,
		INPS_StatusText = "Added to the comp frame to make the DCTL's frame value (Resolve's TIMELINE_FRAME_INDEX)",
		})
	InHoldFrame = self:AddInput("Hold Frame", "HoldFrame", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 0,
		INPS_StatusText = "The frame value is Frame Offset alone, so a moving effect holds still",
		})
	InFlipY = self:AddInput("Rows Top Down", "FlipY", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 1,
		IC_Visible = false,
		})
	InOutgoing = self:AddInput("Outgoing", "Outgoing", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
		})
	InIncoming = self:AddInput("Incoming", "Incoming", {
		LINKID_DataType = "Image",
		LINK_Main = 2,
		INP_Required = false,
		})
	OutImage = self:AddOutput("Output", "Output", {
		LINKID_DataType = "Image",
		LINK_Main = 1,
		})
end

-- one channel of img as its own texture, rows top-down (DvSplitSource); returns the plane, or nil and why
function DvPlane(req, img, ch, flip)
	local plane = Image({IMG_Like = img})
	local node = DVIPComputeNode(req, DvSplitName, DvSplitSource, DvSplitParamsName, DvSplitParams)
	if not node then
		return nil, "the split kernel's compute node was not created (DVIPComputeNode gave nil)"
	end
	local p = node:GetParamBlock(DvSplitParams)
	p.ch = ch
	p.flipY = flip
	p.size[0] = img.DataWindow:Width()
	p.size[1] = img.DataWindow:Height()
	node:SetParamBlock(p)
	node:AddInput("src", img)
	node:AddOutput("dst", plane)
	if node:RunSession(req) then
		return plane
	end
	return nil, "the split kernel did not run: " .. DvNodeLog(node)
end

-- the kernel over every pixel with source k; returns true when it ran, or false and why
function DvRun(req, k, src, inc, planes, out, frame, flip, progress)
	local node = DVIPComputeNode(req, DvKernelName, DvSources[k], DvParamsName, DvParams)
	if not node then
		return false, "source " .. k .. ": the compute node was not created (DVIPComputeNode gave nil)"
	end
	local p = node:GetParamBlock(DvParams)
	p.fdStyle = InFdStyle:GetValue(req).Value
	p.fdHold = InFdHold:GetValue(req).Value
	p.fdFrames = InFdFrames:GetValue(req).Value
	p.fdDir = InFdDir:GetValue(req).Value
	p.fdBar = InFdBar:GetValue(req).Value
	p.fdBlur = InFdBlur:GetValue(req).Value
	p.fdWeave = InFdWeave:GetValue(req).Value
	p.fdFlicker = InFdFlicker:GetValue(req).Value
	p.fdGrain = InFdGrain:GetValue(req).Value
	p.fdTear = InFdTear:GetValue(req).Value
	p.fdSnow = InFdSnow:GetValue(req).Value
	p.fdSeed = InFdSeed:GetValue(req).Value
	p.dvProgress = progress
	p.dvFrame = frame
	p.dvFlipY = flip
	p.dvSize[0] = src.DataWindow:Width()
	p.dvSize[1] = src.DataWindow:Height()
	node:SetParamBlock(p)
	node:AddInput("p_FromTexR", planes.p_FromTexR)
	node:AddInput("p_FromTexG", planes.p_FromTexG)
	node:AddInput("p_FromTexB", planes.p_FromTexB)
	node:AddInput("p_FromTexA", planes.p_FromTexA)
	node:AddInput("p_ToTexR", planes.p_ToTexR)
	node:AddInput("p_ToTexG", planes.p_ToTexG)
	node:AddInput("p_ToTexB", planes.p_ToTexB)
	node:AddInput("p_ToTexA", planes.p_ToTexA)
	node:AddOutput("dvDst", out)
	if node:RunSession(req) then
		return true
	end
	return false, "source " .. k .. ": RunSession failed: " .. DvNodeLog(node)
end

function DvProcess(req)
	local src = InOutgoing:GetValue(req)
	if not src then
		return nil, "no Outgoing image", true, nil
	end
	if req:IsPreCalc() then
		return Image({IMG_Like = src, IMG_NoData = true}), nil, false, src
	end
	local inc = InIncoming:GetValue(req)
	if not inc then
		return src, "Incoming is not connected, so Outgoing passes through", false, src
	end
	local progress = InProgress:GetValue(req).Value
	local out = Image({IMG_Like = src})
	local flip = math.floor(InFlipY:GetValue(req).Value + 0.5)
	local frame = math.floor(InFrameOffset:GetValue(req).Value + 0.5)
	if InHoldFrame:GetValue(req).Value < 0.5 then
		frame = frame + math.floor(req.Time + 0.5)
	end
	local planes = {}
	local why = nil
	planes.p_FromTexR, why = DvPlane(req, src, 0, flip)
	if not planes.p_FromTexR then
		return nil, "p_FromTexR: " .. tostring(why), true, src
	end
	planes.p_FromTexG, why = DvPlane(req, src, 1, flip)
	if not planes.p_FromTexG then
		return nil, "p_FromTexG: " .. tostring(why), true, src
	end
	planes.p_FromTexB, why = DvPlane(req, src, 2, flip)
	if not planes.p_FromTexB then
		return nil, "p_FromTexB: " .. tostring(why), true, src
	end
	planes.p_FromTexA = src -- the DCTL never reads this plane
	planes.p_ToTexR, why = DvPlane(req, inc, 0, flip)
	if not planes.p_ToTexR then
		return nil, "p_ToTexR: " .. tostring(why), true, src
	end
	planes.p_ToTexG, why = DvPlane(req, inc, 1, flip)
	if not planes.p_ToTexG then
		return nil, "p_ToTexG: " .. tostring(why), true, src
	end
	planes.p_ToTexB, why = DvPlane(req, inc, 2, flip)
	if not planes.p_ToTexB then
		return nil, "p_ToTexB: " .. tostring(why), true, src
	end
	planes.p_ToTexA = inc -- the DCTL never reads this plane
	local order = {}
	if DvWorking then
		order[1] = DvWorking
	end
	for k = 1, #DvSources do
		if k ~= DvWorking then
			order[#order + 1] = k
		end
	end
	local errs = {}
	for i = 1, #order do
		local ok, err = DvRun(req, order[i], src, inc, planes, out, frame, flip, progress)
		if ok then
			DvWorking = order[i]
			return out, "ok, the kernel runs from source " .. order[i], false, src
		end
		errs[#errs + 1] = tostring(err)
	end
	return nil, "the kernel ran from no source: " .. table.concat(errs, " || "), true, src
end

-- every failure is reported and shows as magenta; the input never passes through quietly
function Process(req)
	local res, msg, failed, ref = nil, nil, true, nil
	local called, err = xpcall(function()
		res, msg, failed, ref = DvProcess(req)
	end, DvTrace)
	if not called then
		res, msg, failed = nil, "Lua error in Process: " .. tostring(err), true
		if not ref then
			pcall(function()
				ref = InOutgoing:GetValue(req)
			end)
		end
	end
	if msg then
		DvNote(self, failed, msg)
	end
	if failed then
		res = DvFailImage(ref)
	end
	OutImage:Set(req, res)
end
