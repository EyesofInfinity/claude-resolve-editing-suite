--[[ Develop Tritone Dissolve as a Fusion Fuse: the transition DCTL effects/tones/build/Develop Tritone Dissolve.dctl run on the GPU through DVIPComputeNode,
every pixel calling the DCTL's own main function with the DCTL's own controls. Written by
effects/fusegen/fusegen.py; regenerate it, never edit it. The picture is read and written in the values
the DCTL sees in Resolve (Rec.709 gamma 2.4 display values in Develop), with no conversion.
Outgoing and Incoming are the two shots; animate Progress from 0 to 1 over the overlap.
Frame Offset adds to the comp frame for the DCTL's frame value; Hold Frame uses Frame Offset alone.
If the kernel cannot run, the output is solid magenta and the reason is in the Fusion console, in the
tool's data DevelopFuse.Status and in %TEMP%\DevelopFuse.log. MIT License. ]]

FuRegisterClass("DevelopTritoneDissolve", CT_Tool, {
	REGS_Category = "Fuses\\Develop",
	REGS_OpIconString = "DTD",
	REGS_OpDescription = "Develop Tritone Dissolve (Develop DCTL in a Fuse)",
	REG_NoObjMatCtrls = true,
	REG_NoMotionBlurCtrls = true,
	})

DvName = "Develop Tritone Dissolve"
DvKind = "transition"
DvDctl = "tones/build/Develop Tritone Dissolve.dctl"

-- the DCTL slider steps, for the record and the inverse mapping (Fusion sliders have no step)
DvSteps = { ttShH = 1.0, ttShS = 1.0, ttShV = 1.0, ttMiH = 1.0, ttMiS = 1.0, ttMiV = 1.0, ttHiH = 1.0, ttHiS = 1.0, ttHiV = 1.0, ttTone = 1.0, ttHold = 1.0, ttLead = 1.0, ttPulse = 1.0, ttPulses = 1.0 }

-- this Fuse's own C names for its kernels and parameter structs (never shared with another Fuse)
DvKernelName = "DevelopTritoneDissolveK51636871"
DvParamsName = "DevelopTritoneDissolveP51636871"
DvSplitName = "DevelopTritoneDissolveS51636871"
DvSplitParamsName = "DevelopTritoneDissolveSP51636871"

DvParams = [[
	float ttShH;
	float ttShS;
	float ttShV;
	float ttMiH;
	float ttMiS;
	float ttMiV;
	float ttHiH;
	float ttHiS;
	float ttHiV;
	float ttTone;
	float ttHold;
	float ttLead;
	float ttPulse;
	float ttPulses;
	float dvProgress;
	int dvFrame;
	int dvFlipY;
	int dvSize[2];
]]

DvSplitParams = [[
	int ch;
	int flipY;
	int size[2];
]]

DvSplitSource = [[
// one channel of an image as its own texture (the channel in every component), rows turned top-down when
// flipY is set, so a DCTL's _tex2D(plane, x, y) reads what Resolve hands it
__KERNEL__ void DevelopTritoneDissolveS51636871(__CONSTANTREF__ DevelopTritoneDissolveSP51636871 *params, __TEXTURE2D__ src, __TEXTURE2D_WRITE__ dst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->size[0] && y < params->size[1])
    {
        int sy = params->flipY != 0 ? params->size[1] - 1 - y : y;
        float4 c = _tex2DVec4(src, x, sy);
        float v = params->ch == 0 ? c.x : (params->ch == 1 ? c.y : (params->ch == 2 ? c.z : c.w));
        _tex2DVec4Write(dst, x, y, to_float4(v, v, v, v));
    }
}
]]

