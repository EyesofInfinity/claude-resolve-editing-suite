DvMapping = [[
// fusegen mapping (effects/fusegen/README.md section 2): a DCTL reads one channel with _tex2D(plane, x, y);
// here each plane is a texture holding that channel, read at whole-pixel coordinates by the default sampler
#define dvTex2D(dv_t, dv_x, dv_y) (_tex2DVec4((dv_t), (dv_x), (dv_y)).x)
]]

DvCompat = [[
// fusegen compatibility, used only when the plain source does not build: Resolve's DCTL names for the vector
// constructors, over Fusion's own
#ifndef make_float2
#define make_float2(a, b) to_float2((a), (b))
#endif
#ifndef make_float3
#define make_float3(a, b, c) to_float3((a), (b), (c))
#endif
#ifndef make_float4
#define make_float4(a, b, c, d) to_float4((a), (b), (c), (d))
#endif
]]

DvKernelText = [[
// Develop Tritone Dissolve: a dissolve through a printed tritone in one Transition DCTL. Lay
// it on a cut from Edit page > OpenFX > Transition > ResolveFX Color > DCTL and pick this file.
// A tritone prints a picture's tones with three inks: the darkest ink is the floor, the paper's tint is the ceiling,
// and a middle ink carries the mid tones. Here each shot's own luminance is its tone. The outgoing shot falls into a
// print of itself, the print's tones cross from the outgoing shot's to the incoming shot's (one plate printed from
// both), and the incoming shot rises out of its own print. The print keeps each tone's brightness between the floor
// and the ceiling: tone 0 prints at the Shadow colour, tone 1 at the Highlight colour, and the Mid colour sits at the
// tone of its own brightness, so the print re-colours the picture and keeps its light.
// Defaults are a classic print tritone: a warm near-black floor #1F1711, a sepia mid #A88A65 and a cream ceiling
// #F5EBD3. Each colour is Hue (degrees), Saturation and Level (HSV, percent).
//   Tone: how fully the picture goes into the print at the peak (0 is a plain dissolve)
//   Hold: how long the print holds around the cut, in percent of the dissolve
//   Tone Lead: positive brings the incoming shot in through its shadows first, negative through its highlights
//   Pulse, Pulses: the print breathes, its mid tones lifting and settling once to three times across the dissolve
// dvProgress runs it; it starts exactly on the outgoing shot and ends exactly on the incoming, easing off
// both. Rec.709 gamma 2.4 display values in and out. MIT License.

// fusegen ui: ttShH
// fusegen ui: ttShS
// fusegen ui: ttShV
// fusegen ui: ttMiH
// fusegen ui: ttMiS
// fusegen ui: ttMiV
// fusegen ui: ttHiH
// fusegen ui: ttHiS
// fusegen ui: ttHiV
// fusegen ui: ttTone
// fusegen ui: ttHold
// fusegen ui: ttLead
// fusegen ui: ttPulse
// fusegen ui: ttPulses

// fusegen tip: Tone
// fusegen tip: Hold
// fusegen tip: Tone Lead
// fusegen tip: Pulse

// Develop light: the shared code of Develop Leak, Develop Burn and Develop Light Dissolve.
// build.py writes it into each effect, so every installed .dctl stands alone. Rec.709 gamma 2.4 in and out;
// light is added in linear. Coordinates are in frame heights (y 0 to 1 top to bottom, x 0 to width/height),
// so a leak keeps its shape at any resolution and aspect. MIT License.

__DEVICE__ float toLin(float x) { return _powf(_fmaxf(x, 0.0f), 2.4f); }
__DEVICE__ float toDisp(float x) { return _powf(_fmaxf(x, 0.0f), 1.0f / 2.4f); }
__DEVICE__ float luma(float r, float g, float b) { return 0.2126f * r + 0.7152f * g + 0.0722f * b; }
__DEVICE__ float lerp1(float a, float b, float t) { return a + (b - a) * t; }
__DEVICE__ float sstep(float a, float b, float x) { float t = _saturatef((x - a) / (b - a)); return t * t * (3.0f - 2.0f * t); }

__DEVICE__ float3 shoulder(float r, float g, float b)
{
    float m = _fmaxf(r, _fmaxf(g, b));
    if (m <= 0.8f) return make_float3(r, g, b);
    float nm = 0.8f + 0.2f * _tanhf((m - 0.8f) / 0.2f);
    float k = nm / m, w = 0.6f * sstep(1.0f, 3.0f, m);
    return make_float3(lerp1(r * k, nm, w), lerp1(g * k, nm, w), lerp1(b * k, nm, w));
}

__DEVICE__ float3 lightOut(float r, float g, float b, float k)
{
    float3 s = shoulder(r, g, b);
    float w = _saturatef(k * 4.0f);
    return make_float3(_saturatef(toDisp(lerp1(r, s.x, w))), _saturatef(toDisp(lerp1(g, s.y, w))), _saturatef(toDisp(lerp1(b, s.z, w))));
}

__DEVICE__ float hash01(uint x, uint y, uint z)
{
    x = x * 1664525u + 1013904223u; y = y * 1664525u + 1013904223u; z = z * 1664525u + 1013904223u;
    x += y * z; y += z * x; z += x * y;
    x ^= x >> 16u; y ^= y >> 16u; z ^= z >> 16u;
    x += y * z; y += z * x; z += x * y;
    return (float)(x >> 8u) * (1.0f / 16777216.0f);
}

__DEVICE__ float fade(float t) { return t * t * t * (t * (t * 6.0f - 15.0f) + 10.0f); }

__DEVICE__ float vnoise3(float x, float y, float z, uint s)
{
    int ix = (int)(x), iy = (int)(y), iz = (int)(z);
    float tx = fade(x - (float)(ix)), ty = fade(y - (float)(iy)), tz = fade(z - (float)(iz));
    uint x0 = (uint)(ix), y0 = (uint)(iy), z0 = (uint)(iz) + s * 7919u;
    float a0 = lerp1(lerp1(hash01(x0, y0, z0), hash01(x0 + 1u, y0, z0), tx), lerp1(hash01(x0, y0 + 1u, z0), hash01(x0 + 1u, y0 + 1u, z0), tx), ty);
    float a1 = lerp1(lerp1(hash01(x0, y0, z0 + 1u), hash01(x0 + 1u, y0, z0 + 1u), tx), lerp1(hash01(x0, y0 + 1u, z0 + 1u), hash01(x0 + 1u, y0 + 1u, z0 + 1u), tx), ty);
    return lerp1(a0, a1, tz);
}

__DEVICE__ float fbm(float x, float y, float z, int n, uint s)
{
    float sum = 0.0f, amp = 0.5f, tot = 0.0f, f = 1.0f;
    for (int i = 0; i < 5; i++) {
        if (i >= n) break;
        sum += amp * vnoise3(x * f + 4096.0f + 37.1f * (float)(i), y * f + 4096.0f + 11.7f * (float)(i), z * f + 4096.0f, s + (uint)(i));
        tot += amp; amp *= 0.5f; f *= 2.03f;
    }
    float v = sum / tot;
    return _saturatef((v - 0.5f) * 1.6f + 0.5f);
}

__DEVICE__ float3 ramp(float pal, float t, float age)
{
    int p = (int)(pal + 0.5f);
    float c0r = 0.30f, c0g = 0.10f, c0b = 0.42f, c1r = 0.62f, c1g = 0.35f, c1b = 0.47f, c2r = 0.86f, c2g = 0.76f, c2b = 0.68f;
    float h0r = 0.73f, h0g = 0.16f, h0b = 0.26f, h1r = 0.89f, h1g = 0.35f, h1b = 0.17f, h2r = 0.94f, h2g = 0.50f, h2b = 0.22f;
    if (p == 1) {
        c0r = 0.45f; c0g = 0.08f; c0b = 0.05f; c1r = 0.85f; c1g = 0.30f; c1b = 0.08f; c2r = 0.98f; c2g = 0.70f; c2b = 0.35f;
        h0r = 0.80f; h0g = 0.20f; h0b = 0.04f; h1r = 0.98f; h1g = 0.55f; h1b = 0.12f; h2r = 1.00f; h2g = 0.85f; h2b = 0.55f;
    }
    if (p == 2) {
        c0r = 0.18f; c0g = 0.10f; c0b = 0.45f; c1r = 0.65f; c1g = 0.25f; c1b = 0.65f; c2r = 0.95f; c2g = 0.70f; c2b = 0.75f;
        h0r = 0.70f; h0g = 0.15f; h0b = 0.50f; h1r = 0.95f; h1g = 0.45f; h1b = 0.45f; h2r = 1.00f; h2g = 0.75f; h2b = 0.55f;
    }
    if (p == 3) {
        c0r = 0.05f; c0g = 0.10f; c0b = 0.35f; c1r = 0.15f; c1g = 0.40f; c1b = 0.75f; c2r = 0.70f; c2g = 0.85f; c2b = 0.98f;
        h0r = 0.10f; h0g = 0.25f; h0b = 0.60f; h1r = 0.35f; h1g = 0.65f; h1b = 0.95f; h2r = 0.85f; h2g = 0.95f; h2b = 1.00f;
    }
    float a = _saturatef(age);
    float r0 = lerp1(c0r, h0r, a), g0 = lerp1(c0g, h0g, a), b0 = lerp1(c0b, h0b, a);
    float r1 = lerp1(c1r, h1r, a), g1 = lerp1(c1g, h1g, a), b1 = lerp1(c1b, h1b, a);
    float r2 = lerp1(c2r, h2r, a), g2 = lerp1(c2g, h2g, a), b2 = lerp1(c2b, h2b, a);
    float u = _saturatef(t);
    float r, g, b;
    if (u < 0.5f) { float k = u * 2.0f; r = lerp1(r0, r1, k); g = lerp1(g0, g1, k); b = lerp1(b0, b1, k); }
    else { float k = u * 2.0f - 1.0f; r = lerp1(r1, r2, k); g = lerp1(g1, g2, k); b = lerp1(b1, b2, k); }
    float hot = sstep(1.0f, 1.4f, t);
    return make_float3(toLin(lerp1(r, 1.0f, hot)), toLin(lerp1(g, 0.96f, hot)), toLin(lerp1(b, 0.90f, hot)));
}

__DEVICE__ float leakField(float x, float y, float aspect, float deg, float w, float sc, float z, uint s)
{
    float a = deg * 0.0174533f, ca = _cosf(a), sa = _sinf(a);
    float ext = 0.5f * (_fabs(ca) * aspect + _fabs(sa));
    float sproj = (x - 0.5f * aspect) * ca + (y - 0.5f) * sa;
    float warp = fbm(x * 1.3f, y * 1.3f, z * 0.35f, 2, s + 40u) - 0.5f;
    float d = _fmaxf(ext - sproj + 0.45f * warp * w * aspect, 0.0f);
    float reach = _fmaxf(w * aspect, 0.02f);
    float e = _expf(-(d / reach) * (d / reach));
    float cloud = fbm(x / sc, y / sc, z, 3, s);
    return _saturatef(e * (0.35f + 1.3f * cloud));
}

__DEVICE__ float burnHeat(float x, float y, float cover, float sc, float z, uint s)
{
    float wx = fbm(x / sc * 0.7f, y / sc * 0.7f, z * 0.6f, 2, s + 90u) - 0.5f;
    float wy = fbm(x / sc * 0.7f + 31.0f, y / sc * 0.7f, z * 0.6f, 2, s + 91u) - 0.5f;
    float h = fbm((x + 0.6f * wx) / sc, (y + 0.6f * wy) / sc, z, 4, s);
    float th = 1.0f - cover;
    return _saturatef((h - th + 0.28f) / 0.62f);
}

__DEVICE__ float dust(int px, int py, int h, float amount, uint z)
{
    float sc = (float)(h) / 1080.0f;
    int cx = (int)((float)(px) / (2.5f * sc)), cy = (int)((float)(py) / (2.5f * sc));
    float r = hash01((uint)(cx), (uint)(cy), z * 13u + 5u);
    float lim = 0.00002f * amount;
    if (r > lim) return 0.0f;
    return hash01((uint)(cx), (uint)(cy), z * 13u + 6u) < 0.6f ? -1.0f : 1.0f;
}

__DEVICE__ float4 burnOver(float r, float g, float b, float x, float y, float aspect, int px, int py, int ph,
                           float cover, float pal, float age, float sc, float show, float grain, float dst,
                           float z, uint fz, uint s)
{
    float k = sstep(0.0f, 0.35f, burnHeat(x, y, cover, sc, z, s));
    uint zi = (uint)(z + 1000.0f);
    float ang = 6.2831853f * ((float)(zi % 1000u) * 0.37f + 0.25f * hash01(zi, s, 71u));
    float ca = _cosf(ang), sa = _sinf(ang), ext = 0.5f * (_fabs(ca) * aspect + _fabs(sa));
    float band = 0.5f + 0.5f * ((x - 0.5f * aspect) * ca + (y - 0.5f) * sa) / ext;
    float cl = fbm(x / (sc * 1.6f), y / (sc * 1.6f), z, 3, s + 200u);
    float t = 0.05f + 0.95f * _saturatef(0.8f * band + 0.95f * (cl - 0.5f) + 0.15f);
    float3 c = ramp(pal, t, age);
    float keep = lerp1(1.0f, show, k);
    float gr = 1.0f + grain * 0.22f * (hash01((uint)(px), (uint)(py), fz * 3u + s) - 0.5f) * k;
    float d = dust(px, py, ph, dst * 100.0f, fz + s) * k;
    float rr = (r * keep + c.x * k) * gr, gg = (g * keep + c.y * k) * gr, bb = (b * keep + c.z * k) * gr;
    if (d < 0.0f) { rr *= 0.15f; gg *= 0.12f; bb *= 0.12f; }
    if (d > 0.0f) { rr = rr + 0.6f; gg = gg + 0.55f; bb = bb + 0.45f; }
    return make_float4(rr, gg, bb, k);
}

__DEVICE__ float3 hsvF(float h, float s, float v)
{
    float hh = h / 60.0f;
    float kr = 5.0f + hh, kg = 3.0f + hh, kb = 1.0f + hh;
    kr = kr - 6.0f * _floorf(kr / 6.0f); kg = kg - 6.0f * _floorf(kg / 6.0f); kb = kb - 6.0f * _floorf(kb / 6.0f);
    float r = v - v * s * _fmaxf(0.0f, _fminf(kr, _fminf(4.0f - kr, 1.0f)));
    float g = v - v * s * _fmaxf(0.0f, _fminf(kg, _fminf(4.0f - kg, 1.0f)));
    float b = v - v * s * _fmaxf(0.0f, _fminf(kb, _fminf(4.0f - kb, 1.0f)));
    return make_float3(_saturatef(r), _saturatef(g), _saturatef(b));
}

__DEVICE__ float3 linC(float3 c) { return make_float3(toLin(c.x), toLin(c.y), toLin(c.z)); }

__DEVICE__ float lumL(float3 c) { return luma(toLin(_saturatef(c.x)), toLin(_saturatef(c.y)), toLin(_saturatef(c.z))); }

__DEVICE__ float3 chromaF(float3 lc)
{
    float L = luma(lc.x, lc.y, lc.z), e = 1e-4f;
    return make_float3((lc.x + e) / (L + e), (lc.y + e) / (L + e), (lc.z + e) / (L + e));
}

__DEVICE__ float3 printT(float u, float ts, float th, float pm, float3 S, float3 M, float3 Hc)
{
    float uu = _saturatef(u);
    float Lt = toLin(lerp1(ts, th, uu));
    float3 d;
    if (uu < pm) {
        float w = sstep(0.0f, pm, uu);
        d = make_float3(lerp1(S.x, M.x, w), lerp1(S.y, M.y, w), lerp1(S.z, M.z, w));
    } else {
        float w = sstep(pm, 1.0f, uu);
        d = make_float3(lerp1(M.x, Hc.x, w), lerp1(M.y, Hc.y, w), lerp1(M.z, Hc.z, w));
    }
    float3 c = chromaF(linC(d));
    return make_float3(_saturatef(toDisp(c.x * Lt)), _saturatef(toDisp(c.y * Lt)), _saturatef(toDisp(c.z * Lt)));
}

__DEVICE__ float4 dvMain(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE2D__ p_FromTexR, __TEXTURE2D__ p_FromTexG, __TEXTURE2D__ p_FromTexB, __TEXTURE2D__ p_FromTexA, __TEXTURE2D__ p_ToTexR, __TEXTURE2D__ p_ToTexG, __TEXTURE2D__ p_ToTexB, __TEXTURE2D__ p_ToTexA, int dvFrame, float dvProgress, float ttShH, float ttShS, float ttShV, float ttMiH, float ttMiS, float ttMiV, float ttHiH, float ttHiS, float ttHiV, float ttTone, float ttHold, float ttLead, float ttPulse, float ttPulses)
{
    float p = _saturatef(dvProgress);
    float ar = dvTex2D(p_FromTexR, p_X, p_Y), ag = dvTex2D(p_FromTexG, p_X, p_Y), ab = dvTex2D(p_FromTexB, p_X, p_Y);
    float br = dvTex2D(p_ToTexR, p_X, p_Y), bg = dvTex2D(p_ToTexG, p_X, p_Y), bb = dvTex2D(p_ToTexB, p_X, p_Y);
    if (p <= 0.0f) return make_float4(ar, ag, ab, 1.0f);
    if (p >= 1.0f) return make_float4(br, bg, bb, 1.0f);

    float3 S = hsvF(ttShH, ttShS / 100.0f, ttShV / 100.0f);
    float3 M = hsvF(ttMiH, ttMiS / 100.0f, ttMiV / 100.0f);
    float3 Hc = hsvF(ttHiH, ttHiS / 100.0f, ttHiV / 100.0f);
    float ts = toDisp(lumL(S)), tm = toDisp(lumL(M)), th = toDisp(lumL(Hc));
    float span = th - ts;
    float pm = _fabs(span) > 0.02f ? (tm - ts) / span : 0.5f;
    pm = _clampf(pm, 0.1f, 0.9f);

    float a = 0.5f - 0.5f * ttHold / 100.0f;
    float k = fade(_saturatef(p / a)) * fade(_saturatef((1.0f - p) / a)) * ttTone / 100.0f;
    float c0 = 0.6f * a;
    float tc = fade(_saturatef((p - c0) / (1.0f - 2.0f * c0)));

    float Ta = toDisp(luma(toLin(_saturatef(ar)), toLin(_saturatef(ag)), toLin(_saturatef(ab))));
    float Tb = toDisp(luma(toLin(_saturatef(br)), toLin(_saturatef(bg)), toLin(_saturatef(bb))));
    float t = _saturatef(tc + ttLead / 100.0f * 4.0f * tc * (1.0f - tc) * (0.5f - Tb));
    float T = lerp1(Ta, Tb, t);
    float n = _floorf(ttPulses + 0.5f);
    float br8 = 0.5f - 0.5f * _cosf(6.2831853f * n * p);
    T = _saturatef(T + ttPulse / 100.0f * 0.14f * br8 * 4.0f * T * (1.0f - T));

    float3 P = printT(T, ts, th, pm, S, M, Hc);
    float ur = lerp1(ar, br, t), ug = lerp1(ag, bg, t), ub = lerp1(ab, bb, t);
    float orr = lerp1(ur, P.x, k), og = lerp1(ug, P.y, k), ob = lerp1(ub, P.z, k);
    return make_float4(orr, og, ob, 1.0f);
}

// fusegen: the kernel entry (Fusion's rows run bottom up; py is the DCTL's top-down row)
__KERNEL__ void DevelopTritoneDissolveK51636871(__CONSTANTREF__ DevelopTritoneDissolveP51636871 *params, __TEXTURE2D__ p_FromTexR, __TEXTURE2D__ p_FromTexG, __TEXTURE2D__ p_FromTexB, __TEXTURE2D__ p_FromTexA, __TEXTURE2D__ p_ToTexR, __TEXTURE2D__ p_ToTexG, __TEXTURE2D__ p_ToTexB, __TEXTURE2D__ p_ToTexA, __TEXTURE2D_WRITE__ dvDst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x < params->dvSize[0] && y < params->dvSize[1])
    {
        int py = params->dvFlipY != 0 ? params->dvSize[1] - 1 - y : y;
        float4 c = dvMain(params->dvSize[0], params->dvSize[1], x, py, p_FromTexR, p_FromTexG, p_FromTexB, p_FromTexA, p_ToTexR, p_ToTexG, p_ToTexB, p_ToTexA, params->dvFrame, params->dvProgress, params->ttShH, params->ttShS, params->ttShV, params->ttMiH, params->ttMiS, params->ttMiV, params->ttHiH, params->ttHiS, params->ttHiV, params->ttTone, params->ttHold, params->ttLead, params->ttPulse, params->ttPulses);
        _tex2DVec4Write(dvDst, x, y, c);
    }
}
]]

-- the plain source first; the compatibility source only if the plain one does not build
DvSources = { DvMath .. DvMapping .. DvKernelText, DvCompat .. DvMath .. DvMapping .. DvKernelText }
DvWorking = nil

-- the last status of each tool, so a change is reported once
DvLast = {}

-- the compute node's error log (DVIPComputeNode:GetErrorLog, a name in fusionsystem.dll), or a note that it has none
function DvNodeLog(node)
	local log = nil
	if node then
		pcall(function()
			log = node:GetErrorLog()
		end)
	end
	if log == nil or log == "" then
		return "(the node gave no error log; see the Fusion console)"
	end
	return tostring(log)
end

-- report a status: the console, the tool's data and the log file, each once per change
function DvNote(tool, failed, msg)
	local key = DvName
	pcall(function()
		key = tool.Name
	end)
	key = tostring(key)
	local text = msg
	if failed then
		text = "FAILED: " .. msg
	end
	if DvLast[key] == text then
		return
	end
	DvLast[key] = text
	print(DvName .. " [" .. key .. "] " .. text)
	pcall(function()
		tool:SetData("DevelopFuse.Status", text)
	end)
	pcall(function()
		local dir = os.getenv("TEMP") or os.getenv("TMP") or "."
		local f = io.open(dir .. "/DevelopFuse.log", "a")
		if f then
			local line = (text:gsub("[\r\n]+", " | "))
			f:write(os.date("%Y-%m-%d %H:%M:%S") .. "\t" .. key .. "\t" .. DvName .. "\t" .. line .. "\n")
			f:close()
		end
	end)
end

-- a Lua error's message with its traceback when the debug library is there
function DvTrace(e)
	if debug and debug.traceback then
		return debug.traceback(tostring(e), 2)
	end
	return tostring(e)
end

-- the visible error: a solid magenta frame the size of ref (nil when there is no picture to size it by)
function DvFailImage(ref)
	local bad = nil
	if ref then
		pcall(function()
			bad = Image({IMG_Like = ref})
			bad:Fill(Pixel({R = 1.0, G = 0.0, B = 1.0, A = 1.0}))
		end)
	end
	return bad
end

function Create()
	InProgress = self:AddInput("Progress", "Progress", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 1.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 1.0,
		INPS_StatusText = "The transition from Outgoing (0) to Incoming (1): the DCTL's TRANSITION_PROGRESS",
		})
	InTtShH = self:AddInput("Shadow Hue", "ttShH", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 28.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 360.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 360.0,
		})
	InTtShS = self:AddInput("Shadow Sat", "ttShS", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 45.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InTtShV = self:AddInput("Shadow Level", "ttShV", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 12.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InTtMiH = self:AddInput("Mid Hue", "ttMiH", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 33.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 360.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 360.0,
		})
	InTtMiS = self:AddInput("Mid Sat", "ttMiS", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 40.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InTtMiV = self:AddInput("Mid Level", "ttMiV", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 66.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InTtHiH = self:AddInput("Highlight Hue", "ttHiH", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 42.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 360.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 360.0,
		})
	InTtHiS = self:AddInput("Highlight Sat", "ttHiS", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 14.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InTtHiV = self:AddInput("Highlight Level", "ttHiV", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 96.0,
		INP_MinScale = 0.0,
		INP_MaxScale = 100.0,
		INP_MinAllowed = 0.0,
		INP_MaxAllowed = 100.0,
		})
	InTtTone = self:AddInput("Tone", "ttTone", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
