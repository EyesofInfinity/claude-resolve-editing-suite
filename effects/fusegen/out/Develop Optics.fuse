		INP_Default = 35.0,
		INP_MinScale = -50.0,
		INP_MaxScale = 150.0,
		INP_MinAllowed = -50.0,
		INP_MaxAllowed = 150.0,
		INPS_StatusText = "Rainbow: the top of the bow; Soft Light: the source; Flag / Dot: its centre",
		})
	InOpPaper = self:AddInput("Paper", "opPaper", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
