__DEVICE__ float mistW(float y, float lo, float hi) { return 0.12f + 0.88f * sstep(lo, hi, y); }

__DEVICE__ float guardStep(float n) { return sstep(1.5f, 4.0f, n); }
__DEVICE__ float guardRamp(float n) { return _saturatef(1.2f - 2.4f / _fmaxf(n, 1e-6f)); }
__DEVICE__ float guardLone(float n) { return 1.0f - sstep(0.5f, 0.95f, 1.0f / _fmaxf(n, 1e-6f)); }

__DEVICE__ float knee(float x, float t)
{
    float k = 0.5f * t;
    float s = _clampf(x - t + k, 0.0f, 2.0f * k);
    return _fmaxf(s * s / (4.0f * k + 1e-5f), x - t);
}

__DEVICE__ float expandY(float y, float peak)
{
    if (y <= 0.75f || peak <= 1.0f) return y;
    float s = _fminf((y - 0.75f) / 0.25f, 1.0f);
    float a = 1.0f - 0.25f / (peak - 0.75f);
    return 0.75f + 0.25f * s / (1.0f - a * s);
}

__DEVICE__ float expandGain(float y, float peak) { return y > 0.75f ? expandY(y, peak) / y : 1.0f; }

__DEVICE__ float rgc(float d, float thr, float lim)
{
    if (d < thr) return d;
    float p = 1.2f;
    float s = (lim - thr) / _powf(_powf((1.0f - thr) / (lim - thr), -p) - 1.0f, 1.0f / p);
    float nd = (d - thr) / s;
    return thr + s * nd / _powf(1.0f + _powf(nd, p), 1.0f / p);
}

__DEVICE__ float hash01(uint x, uint y, uint z)
{
    x = x * 1664525u + 1013904223u; y = y * 1664525u + 1013904223u; z = z * 1664525u + 1013904223u;
    x += y * z; y += z * x; z += x * y;
    x ^= x >> 16u; y ^= y >> 16u; z ^= z >> 16u;
    x += y * z; y += z * x; z += x * y;
    return (float)(x >> 8u) * (1.0f / 16777216.0f);
}

// ------------------------------------------------------------------ main

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    float R = _tex2D(p_TexR, p_X, p_Y), G = _tex2D(p_TexG, p_X, p_Y), B = _tex2D(p_TexB, p_X, p_Y);

    float active = _fabs(temp) + _fabs(tint) + _fabs(expo) + _fabs(contr) + _fabs(hilite) + _fabs(shadow)
                 + _fabs(whites) + _fabs(blacks) + _fabs(texAmt) + _fabs(clarity) + _fabs(strAmt) + _fabs(vibr)
                 + _fabs(satur) + _fabs(density) + _fabs(recon) + _fabs(rolloff) + _fabs(pathW) + _fabs(gamutC)
                 + _fabs(hRed) + _fabs(sRed) + _fabs(lRed) + _fabs(hOra) + _fabs(sOra) + _fabs(lOra)
                 + _fabs(hYel) + _fabs(sYel) + _fabs(lYel) + _fabs(hGre) + _fabs(sGre) + _fabs(lGre)
                 + _fabs(hAqu) + _fabs(sAqu) + _fabs(lAqu) + _fabs(hBlu) + _fabs(sBlu) + _fabs(lBlu)
                 + _fabs(hPur) + _fabs(sPur) + _fabs(lPur) + _fabs(hMag) + _fabs(sMag) + _fabs(lMag)
                 + _fabs(shSat) + _fabs(miSat) + _fabs(hiSat) + _fabs(cContr) + _fabs(blkFloor)
                 + _fabs(glowAmt) + _fabs(veil) + _fabs(sparkle) + _fabs(halAmt) + _fabs(deband) + _fabs(vigAmt) + _fabs(grainAmt)
                 + _fabs(skinU) + _fabs(hlEven);
    if (active == 0.0f) return make_float3(R, G, B);

    float sc = (float)(p_Height) / 1080.0f;
    float clipC = clipOf(R, G, B);
    float R0 = R, G0 = G, B0 = B;

    float gain = _exp2f(expo) / luma(1.0f, 1.0f, 1.0f);
    float m00 = gain, m01 = 0.0f, m02 = 0.0f, m10 = 0.0f, m11 = gain, m12 = 0.0f, m20 = 0.0f, m21 = 0.0f, m22 = gain;
    if (temp != 0.0f || tint != 0.0f)
    {
        const float refM = 1.0e6f / 6504.0f;
        float3 ws = locusXYZ(refM - 55.2348f * temp / 100.0f, 0.016952f * tint / 100.0f);
        float3 wd = locusXYZ(refM, 0.0f);
        float kL = (0.401288f * wd.x + 0.650173f * wd.y - 0.051461f * wd.z) / (0.401288f * ws.x + 0.650173f * ws.y - 0.051461f * ws.z);
        float kM = (-0.250268f * wd.x + 1.204414f * wd.y + 0.045854f * wd.z) / (-0.250268f * ws.x + 1.204414f * ws.y + 0.045854f * ws.z);
        float kS = (-0.002079f * wd.x + 0.048952f * wd.y + 0.953127f * wd.z) / (-0.002079f * ws.x + 0.048952f * ws.y + 0.953127f * ws.z);
        const float a00 = 5.446162168f, a01 = -4.215164603f, a02 = -0.026213126f;
        const float a10 = -1.078494068f, a11 = 2.144599302f, a12 = -0.117804613f;
        const float a20 = 0.007798358f, a21 = -0.21913664f, a22 = 1.12018101f;
        const float b00 = 0.302793039f, b01 = 0.60232991f, b02 = 0.07043004f;
        const float b10 = 0.153808117f, b11 = 0.777314896f, b12 = 0.085346092f;
        const float b20 = 0.027980929f, b21 = 0.147869843f, b22 = 0.908918477f;
        m00 = a00 * kL * b00 + a01 * kM * b10 + a02 * kS * b20; m01 = a00 * kL * b01 + a01 * kM * b11 + a02 * kS * b21; m02 = a00 * kL * b02 + a01 * kM * b12 + a02 * kS * b22;
        m10 = a10 * kL * b00 + a11 * kM * b10 + a12 * kS * b20; m11 = a10 * kL * b01 + a11 * kM * b11 + a12 * kS * b21; m12 = a10 * kL * b02 + a11 * kM * b12 + a12 * kS * b22;
        m20 = a20 * kL * b00 + a21 * kM * b10 + a22 * kS * b20; m21 = a20 * kL * b01 + a21 * kM * b11 + a22 * kS * b21; m22 = a20 * kL * b02 + a21 * kM * b12 + a22 * kS * b22;
        float k = _exp2f(expo) / luma(m00 + m01 + m02, m10 + m11 + m12, m20 + m21 + m22);
        m00 *= k; m01 *= k; m02 *= k; m10 *= k; m11 *= k; m12 *= k; m20 *= k; m21 *= k; m22 *= k;
    }

    float aMist = glowAmt > 0.0f ? 0.45f * _powf(glowAmt / 100.0f, 1.4f) : 0.0f;
    float aVeil = 0.12f * veil / 100.0f;
    float aSpk  = 2.5f * sparkle / 100.0f;
    float aHal  = halAmt / 100.0f;
    float aRec  = recon / 100.0f;
    float aRoll = rolloff / 100.0f;
    float dbT   = 6.0f / 255.0f * deband / 100.0f;
    int detail  = (texAmt != 0.0f || clarity != 0.0f || strAmt != 0.0f) ? 1 : 0;

    int nT = 0;
    if (aMist > 0.0f || aVeil > 0.0f || aHal > 0.0f || clarity != 0.0f || strAmt != 0.0f) nT = 144;
    else if (aRec > 0.0f) nT = 104;
    else if (dbT > 0.0f) nT = 69;
    else if (aSpk > 0.0f) nT = 64;
    else if (texAmt != 0.0f) nT = 32;
    else if (aRoll > 0.0f) nT = 12;

    float thrL = _fmaxf(toLin(glowThr / 100.0f), 1e-4f);
    float mLo = thrL, mHi = _fmaxf(_fminf(5.0f * thrL, 1.0f), 1.5f * thrL);
    float s3 = sc * (4.32f + 0.1188f * glowSpr);
    float c3 = 0.5f / (s3 * s3);
    float r0h = sc * 5.94f * _exp2f((halSize - 50.0f) / 25.0f);
    float hThr = _fminf(3.0f * thrL, 0.6f);
    float sS = sc * 18.0f;
    float cS = 0.5f / (sS * sS);
    float sp = _fminf(s3 / 6.0f, 2.6f * sc);
    float cp = 0.5f / (sp * sp);
    float pTap = 1.0f + 7.0f * aRec;
    float Ac = sc * sc;

    // ---- one pass over the shared pattern
    float o0r = 0.0f, o0g = 0.0f, o0b = 0.0f, o0x = 0.0f, o0n = 0.0f;
    float o1r = 0.0f, o1g = 0.0f, o1b = 0.0f, o1x = 0.0f, o1n = 0.0f;
    float o2r = 0.0f, o2g = 0.0f, o2b = 0.0f, o2x = 0.0f, o2n = 0.0f;
    float o3r = 0.0f, o3g = 0.0f, o3b = 0.0f, o3x = 0.0f, o3n = 0.0f;
    float vr = 0.0f, vg = 0.0f, vb = 0.0f, vn = 0.0f;
    float pr = 0.0f, pg = 0.0f, pb = 0.0f, pn = 0.0f;
    float hr = 0.0f, hrn = 0.0f, hg = 0.0f, hgn = 0.0f;
    float xTw = 0.0f, xTl = 0.0f, xTq = 0.0f;
    float xCw = 0.0f, xCl = 0.0f, xCq = 0.0f;
    float xSw = 0.0f, xSl = 0.0f, xSq = 0.0f;
    float dr = 0.0f, dg = 0.0f, db = 0.0f, dn = 0.0f;
    float kr = 0.0f, kg = 0.0f, kb = 0.0f, kw = 0.0f, kc = 0.0f, kn = 0.0f;
    float fr = 0.0f, fg = 0.0f, fb = 0.0f, fc = 0.0f, fn = 0.0f;
    float q0r = 0.0f, q0g = 0.0f, q0b = 0.0f, q0x = 0.0f, q1r = 0.0f, q1g = 0.0f, q1b = 0.0f, q1x = 0.0f;
    float q2r = 0.0f, q2g = 0.0f, q2b = 0.0f, q2x = 0.0f, q3r = 0.0f, q3g = 0.0f, q3b = 0.0f, q3x = 0.0f;
    float qs = 0.0f, qq = 0.0f;
    float ur = 0.0f, ug = 0.0f, ub = 0.0f, us = 0.0f, uq = 0.0f;
    float lh1 = 0.0f, lh2 = 0.0f, ls = 0.0f, lq = 0.0f;
    float seC = 0.0f, aBr = 0.0f, gk1 = 1.0f, gk2 = 1.0f, gk3 = 1.0f, gk4 = 1.0f;
    if (aMist > 0.0f)
    {
        float lrC = toLin(R), lgC = toLin(G), lbC = toLin(B);
        float yC = luma(m00 * lrC + m01 * lgC + m02 * lbC, m10 * lrC + m11 * lgC + m12 * lbC, m20 * lrC + m21 * lgC + m22 * lbC)
                 * (aRec > 0.0f ? expandGain(luma(lrC, lgC, lbC), pTap) : 1.0f);
        seC = yC * mistW(yC, mLo, mHi);
        aBr = Ac;
    }

    for (int j = 0; j < nT; j++)
    {
        int dx = (int)(_round(TAPS[3 * j] * sc)), dy = (int)(_round(TAPS[3 * j + 1] * sc));
        float d2 = (float)(dx * dx + dy * dy), d = _sqrtf(d2);
        float A = TAPS[3 * j + 2] * Ac;
        int sx = clampi(p_X + dx, 0, p_Width - 1), sy = clampi(p_Y + dy, 0, p_Height - 1);
        float sR = _tex2D(p_TexR, sx, sy), sG = _tex2D(p_TexG, sx, sy), sB = _tex2D(p_TexB, sx, sy);
        float lr = toLin(sR), lg = toLin(sG), lb = toLin(sB), ly = luma(lr, lg, lb);
        float clipS = clipOf(sR, sG, sB);

        if (j < 12)
        {
            fc += clipS; fn += 1.0f;
            fr += m00 * lr + m01 * lg + m02 * lb; fg += m10 * lr + m11 * lg + m12 * lb; fb += m20 * lr + m21 * lg + m22 * lb;
        }
        if (dbT > 0.0f && j < 69)
        {
            float df = max3(_fabs(sR - R), _fabs(sG - G), _fabs(sB - B));
            float w = 1.0f - sstep(0.5f * dbT, dbT, df);
            dr += w * sR; dg += w * sG; db += w * sB; dn += w;
        }
        if (aRec > 0.0f && j >= 12 && j < 104)
        {
            float w = (1.0f - clipS) * ly * ly;
            kr += w * lr; kg += w * lg; kb += w * lb; kw += w; kc += clipS; kn += 1.0f;
        }

        float ex = aRec > 0.0f ? expandGain(ly, pTap) : 1.0f;
        float qr = m00 * lr + m01 * lg + m02 * lb, qg = m10 * lr + m11 * lg + m12 * lb, qb = m20 * lr + m21 * lg + m22 * lb;
        float qy = luma(qr, qg, qb);

        if (aMist > 0.0f || aVeil > 0.0f || aSpk > 0.0f)
        {
            float e3 = _expf(-d2 * c3);
            float e2 = e3 * e3; e2 = e2 * e2;
            float e1 = e2 * e2; e1 = e1 * e1;
            float e0 = e1 * e1; e0 = e0 * e0;
            if (aMist > 0.0f)
            {
                float mb = mistW(qy, mLo, mHi), ye = qy * ex, me = mistW(ye, mLo, mHi);
                float se = ye * me;
                float wh = sstep(0.90f, 0.985f, min3(sR, sG, sB));
                float cm = mb + (1.0f - wh) * (ex * me - mb);
                float hx = wh * (se - qy * mb);
                float w0 = e0 * A, w1 = e1 * A, w2 = e2 * A, w3 = e3 * A;
                q0r += w0 * qr * cm; q0g += w0 * qg * cm; q0b += w0 * qb * cm; q0x += w0 * hx; o0n += w0;
                q1r += w1 * qr * cm; q1g += w1 * qg * cm; q1b += w1 * qb * cm; q1x += w1 * hx; o1n += w1;
                q2r += w2 * qr * cm; q2g += w2 * qg * cm; q2b += w2 * qb * cm; q2x += w2 * hx; o2n += w2;
                q3r += w3 * qr * cm; q3g += w3 * qg * cm; q3b += w3 * qb * cm; q3x += w3 * hx; o3n += w3;
                qs += se; qq += se * se;
                aBr += A * _fminf(se, seC) / _fmaxf(seC, 1e-12f);
            }
            if (aVeil > 0.0f)
            {
                float w = e3 * A;
                vr += w * qr; vg += w * qg; vb += w * qb; vn += w;
            }
            if (aSpk > 0.0f)
            {
                float w = _expf(-d2 * cp) * A;
                float ye = qy * ex, bw = knee(ye, 1.4f * thrL) / _fmaxf(ye, 1e-6f) * ex;
                ur += w * qr * bw; ug += w * qg * bw; ub += w * qb * bw; pn += w;
                us += ye * bw; uq += ye * bw * ye * bw;
            }
        }
        if (aHal > 0.0f)
        {
            float e = _expf(-d / r0h) * (1.0f - sstep(20.0f * sc, 44.0f * sc, d));
            float w1 = e * A, w2 = e * e * A;
            float drv = knee(ex * (0.6f * qr + 0.3f * qg + 0.1f * qb), hThr);
            lh1 += w1 * drv; hrn += w1; lh2 += w2 * drv; hgn += w2;
            ls += drv; lq += drv * drv;
        }
        if (detail)
        {
            float L = _log2f(qy + 1e-4f);
            float eS = _expf(-d2 * cS);
            float eC = eS * eS; eC = eC * eC;
            float eT = eC * eC; eT = eT * eT; eT = eT * eT; eT = eT * eT; eT = eT * eT;
            xTw += eT * A; xTl += eT * A * L; xTq += eT * A * L * L;
            xCw += eC * A; xCl += eC * A * L; xCq += eC * A * L * L;
            xSw += eS * A; xSl += eS * A * L; xSq += eS * A * L * L;
        }
        if (j == 11 || j == 31 || j == 63 || j == 103 || j == nT - 1)
        {
            float gM = 1.0f, gS = 1.0f, gH = 1.0f;
            if (j != 11)
            {
                float nM = qs * qs / (qq + 1e-20f), nS = us * us / (uq + 1e-20f), nH = ls * ls / (lq + 1e-20f);
                gM = j == 63 ? guardRamp(nM) : guardStep(nM);
                gS = guardStep(nS);
                gH = j == 31 ? guardLone(nH) : guardStep(nH);
            }
            if (j == 31) gk1 = aBr;
            if (j == 63) gk2 = aBr;
            if (j == 103) gk3 = aBr;
            if (j == 143) gk4 = aBr;
            o0r += gM * q0r; o0g += gM * q0g; o0b += gM * q0b; o0x += gM * q0x;
            o1r += gM * q1r; o1g += gM * q1g; o1b += gM * q1b; o1x += gM * q1x;
            o2r += gM * q2r; o2g += gM * q2g; o2b += gM * q2b; o2x += gM * q2x;
            o3r += gM * q3r; o3g += gM * q3g; o3b += gM * q3b; o3x += gM * q3x;
            pr += gS * ur; pg += gS * ug; pb += gS * ub;
            hr += gH * lh1; hg += gH * lh2;
            q0r = 0.0f; q0g = 0.0f; q0b = 0.0f; q0x = 0.0f; q1r = 0.0f; q1g = 0.0f; q1b = 0.0f; q1x = 0.0f;
            q2r = 0.0f; q2g = 0.0f; q2b = 0.0f; q2x = 0.0f; q3r = 0.0f; q3g = 0.0f; q3b = 0.0f; q3x = 0.0f;
            qs = 0.0f; qq = 0.0f; ur = 0.0f; ug = 0.0f; ub = 0.0f; us = 0.0f; uq = 0.0f;
            lh1 = 0.0f; lh2 = 0.0f; ls = 0.0f; lq = 0.0f;
        }
    }

    // ---- deband the source: pull toward the mean of similar neighbours
    if (dbT > 0.0f)
    {
        float ar = (R + dr) / (1.0f + dn), ag = (G + dg) / (1.0f + dn), ab = (B + db) / (1.0f + dn);
        float k = 1.0f - sstep(0.5f * dbT, dbT, max3(_fabs(ar - R), _fabs(ag - G), _fabs(ab - B)));
        R += (ar - R) * k; G += (ag - G) * k; B += (ab - B) * k;
    }

    // ---- linear light and highlight recovery
    float r = toLin(R), g = toLin(G), b = toLin(B);
    float exC = 1.0f, hnr = 1.0f, hng = 1.0f, hnb = 1.0f;
    if (aRec > 0.0f)
    {
        float y = luma(r, g, b);
        float cr = 1.0f, cg = 1.0f, cb = 1.0f, ringY = 0.0f;
        if (kw > 1e-8f)
        {
            float mx = max3(kr, kg, kb);
            cr = kr / mx; cg = kg / mx; cb = kb / mx;
            ringY = luma(kr, kg, kb) / kw;
        }
        float trust = sstep(0.05f, 0.25f, ringY), ks = aRec * trust;
        float cl = luma(cr, cg, cb);
        hnr = mixf(1.0f, cr / cl, ks); hng = mixf(1.0f, cg / cl, ks); hnb = mixf(1.0f, cb / cl, ks);
        float peak = mixf(4.0f, 16.0f, kc / _fmaxf(kn, 1.0f));
        float cw = 0.5f * _saturatef((expandY(y, peak) - 1.0f) / (peak - 1.0f));
        float wr2 = mixf(cr, 1.0f, cw), wg2 = mixf(cg, 1.0f, cw), wb2 = mixf(cb, 1.0f, cw);
        float xr = clipOf(R0, R0, R0), xg = clipOf(G0, G0, G0), xb = clipOf(B0, B0, B0);
        float fit = 1.0f;
        float den = (1.0f - xr) * cr * cr + (1.0f - xg) * cg * cg + (1.0f - xb) * cb * cb;
        if (den > 1e-6f)
        {
            float sl = ((1.0f - xr) * toLin(R0) * cr + (1.0f - xg) * toLin(G0) * cg + (1.0f - xb) * toLin(B0) * cb) / den;
            float miss = xr * _fmaxf(1.0f - sl * cr, 0.0f) + xg * _fmaxf(1.0f - sl * cg, 0.0f) + xb * _fmaxf(1.0f - sl * cb, 0.0f)
                       + (1.0f - xr) * _fabs(sl * cr - toLin(R0)) + (1.0f - xg) * _fabs(sl * cg - toLin(G0)) + (1.0f - xb) * _fabs(sl * cb - toLin(B0));
            fit = 1.0f - sstep(0.05f, 0.3f, miss);
