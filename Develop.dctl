    }

    // ---- color mixer: the hue engine, in Oklab lightness, chroma and hue. Each slider acts around its
    float mixAct = _fabs(hRed) + _fabs(sRed) + _fabs(lRed) + _fabs(hOra) + _fabs(sOra) + _fabs(lOra)
                 + _fabs(hYel) + _fabs(sYel) + _fabs(lYel) + _fabs(hGre) + _fabs(sGre) + _fabs(lGre)
                 + _fabs(hAqu) + _fabs(sAqu) + _fabs(lAqu) + _fabs(hBlu) + _fabs(sBlu) + _fabs(lBlu)
                 + _fabs(hPur) + _fabs(sPur) + _fabs(lPur) + _fabs(hMag) + _fabs(sMag) + _fabs(lMag)
                 + _fabs(skinU) + _fabs(hlEven);
    if (mixAct > 0.0f)
    {
        float3 c = toOklab(spow(r, 2.4f), spow(g, 2.4f), spow(b, 2.4f));
        float L = c.x, C = _sqrtf(c.y * c.y + c.z * c.z);
        float gN = sstep(0.01f, 0.05f, C);
        float h = _atan2f(c.z, c.y) * 57.2957795f;
        float hh = h < MIXH[0] ? h + 360.0f : h;
        int k = 0;
        for (int j = 1; j < 8; j++)
        {
            if (hh >= MIXH[j]) k = j;
        }
        int k1 = k == 7 ? 0 : k + 1;
        float t = (hh - MIXH[k]) / (MIXH[k + 1] - MIXH[k]);
        float w1 = 0.5f - 0.5f * _cosf(3.14159265f * t), w0 = 1.0f - w1;
        float r0 = hRed, r1 = hOra, r2 = hYel, r3 = hGre, r4 = hAqu, r5 = hBlu, r6 = hPur, r7 = hMag;
        {
            const float kr = 0.95f * 2.0f / 3.14159265f / 0.30f;
            float l0 = kr * (MIXH[1] - MIXH[0]), l1 = kr * (MIXH[2] - MIXH[1]), l2 = kr * (MIXH[3] - MIXH[2]), l3 = kr * (MIXH[4] - MIXH[3]);
            float l4 = kr * (MIXH[5] - MIXH[4]), l5 = kr * (MIXH[6] - MIXH[5]), l6 = kr * (MIXH[7] - MIXH[6]), l7 = kr * (MIXH[8] - MIXH[7]);
            for (int it = 0; it < 8; it++)
            {
                float mv;
                mv = 0.5f * _fmaxf(r0 - r1 - l0, 0.0f); r0 -= mv; r1 += mv;
                mv = 0.5f * _fmaxf(r1 - r2 - l1, 0.0f); r1 -= mv; r2 += mv;
                mv = 0.5f * _fmaxf(r2 - r3 - l2, 0.0f); r2 -= mv; r3 += mv;
                mv = 0.5f * _fmaxf(r3 - r4 - l3, 0.0f); r3 -= mv; r4 += mv;
                mv = 0.5f * _fmaxf(r4 - r5 - l4, 0.0f); r4 -= mv; r5 += mv;
                mv = 0.5f * _fmaxf(r5 - r6 - l5, 0.0f); r5 -= mv; r6 += mv;
                mv = 0.5f * _fmaxf(r6 - r7 - l6, 0.0f); r6 -= mv; r7 += mv;
                mv = 0.5f * _fmaxf(r7 - r0 - l7, 0.0f); r7 -= mv; r0 += mv;
            }
            for (int it = 0; it < 2; it++)
            {
                r1 = _fmaxf(r1, r0 - l0); r2 = _fmaxf(r2, r1 - l1); r3 = _fmaxf(r3, r2 - l2); r4 = _fmaxf(r4, r3 - l3);
                r5 = _fmaxf(r5, r4 - l4); r6 = _fmaxf(r6, r5 - l5); r7 = _fmaxf(r7, r6 - l6); r0 = _fmaxf(r0, r7 - l7);
            }
        }
        float dH = 0.30f * (w0 * sel8(k, r0, r1, r2, r3, r4, r5, r6, r7)
                          + w1 * sel8(k1, r0, r1, r2, r3, r4, r5, r6, r7));
        float dS = (w0 * sel8(k, sRed, sOra, sYel, sGre, sAqu, sBlu, sPur, sMag)
                  + w1 * sel8(k1, sRed, sOra, sYel, sGre, sAqu, sBlu, sPur, sMag)) / 100.0f;
        float dL = (w0 * sel8(k, lRed, lOra, lYel, lGre, lAqu, lBlu, lPur, lMag)
                  + w1 * sel8(k1, lRed, lOra, lYel, lGre, lAqu, lBlu, lPur, lMag)) / 100.0f;
        float dsk = _fmod(h - 50.0f + 540.0f, 360.0f) - 180.0f;
        float wsk = skinW(dsk, C, L);
        float prot = 1.0f - skinP / 100.0f * wsk;
        float pk = skinP / 100.0f;
        float aSk = sstep(0.02f, 0.04f, C) * (1.0f - sstep(0.14f, 0.18f, C)) * sstep(0.30f, 0.40f, L) * (1.0f - sstep(0.80f, 0.90f, L));
        float hT = hueProtT(r7, r0, r1, r2, pk * aSk);
        if (pk * aSk * hT > 1.0f) pk = 1.0f / (aSk * hT);
        dH *= 1.0f - pk * wsk; dS *= prot; dL *= prot;
        float cw = _fminf(C / 0.2f, 1.0f);
        float h2 = h + gN * dH;
        if (skinU > 0.0f)
        {
            float dsk2 = _fmod(h2 - 50.0f + 540.0f, 360.0f) - 180.0f;
            h2 -= skinU / 100.0f * skinW(dsk2, C, L) * dsk2;
        }
        float C2 = C * (1.0f + gN * dS);
        float L2 = L * (1.0f + gN * cw * 0.30f * dL);
        if (hlEven > 0.0f)
        {
            float Lh = w0 * MIXL[k] + w1 * MIXL[k1];
            L2 *= 1.0f - hlEven / 100.0f * 0.5f * (Lh - 0.722f) * cw * gN;
        }
        float hRad = h2 * 0.0174532925f;
        float3 o = fromOklab(L2, C2 * _cosf(hRad), C2 * _sinf(hRad));
        float yl = _fmaxf(luma(o.x, o.y, o.z), 0.0f), mn = min3(o.x, o.y, o.z);
        float kk = mn < 0.0f ? yl / (yl - mn + 1e-12f) : 1.0f;
        float ox = yl + (o.x - yl) * kk, oy = yl + (o.y - yl) * kk, oz = yl + (o.z - yl) * kk;
        r = spow(ox, 1.0f / 2.4f); g = spow(oy, 1.0f / 2.4f); b = spow(oz, 1.0f / 2.4f);
    }
    else
    {
        float hue = hueOf(r, g, b);
        float mx = max3(r, g, b), mn = min3(r, g, b);
        float chroma = _saturatef((mx - mn) / (mx + 1e-4f));
        float w0 = band(hue, 0.0f, 30.0f),   w1 = band(hue, 30.0f, 30.0f), w2 = band(hue, 60.0f, 35.0f),  w3 = band(hue, 120.0f, 55.0f);
        float w4 = band(hue, 180.0f, 45.0f), w5 = band(hue, 225.0f, 40.0f), w6 = band(hue, 270.0f, 40.0f), w7 = band(hue, 315.0f, 40.0f);
        float wsum = _fmaxf(1.0f, w0 + w1 + w2 + w3 + w4 + w5 + w6 + w7);
        float dh = (w0 * hRed + w1 * hOra + w2 * hYel + w3 * hGre + w4 * hAqu + w5 * hBlu + w6 * hPur + w7 * hMag) / wsum;
        float ds = (w0 * sRed + w1 * sOra + w2 * sYel + w3 * sGre + w4 * sAqu + w5 * sBlu + w6 * sPur + w7 * sMag) / wsum;
        float dl = (w0 * lRed + w1 * lOra + w2 * lYel + w3 * lGre + w4 * lAqu + w5 * lBlu + w6 * lPur + w7 * lMag) / wsum;
        if (dh != 0.0f)
        {
            float3 c = hueRotate(r, g, b, dh * 0.3f * chroma);
            r = c.x; g = c.y; b = c.z;
        }
        float yl = luma(r, g, b);
        float sf = 1.0f + ds / 100.0f * chroma;
        r = yl + (r - yl) * sf; g = yl + (g - yl) * sf; b = yl + (b - yl) * sf;
        float lf = 1.0f + 0.5f * dl / 100.0f * chroma;
        r *= lf; g *= lf; b *= lf;
    }

    // ---- density: saturation the way dyes make it (colors deepen, greys hold)
    if (density != 0.0f)
    {
        float lr = toLin(r), lg = toLin(g), lb = toLin(b), y0 = luma(lr, lg, lb);
        float Dr = -_log10f(_fmaxf(lr, 1e-4f)), Dg = -_log10f(_fmaxf(lg, 1e-4f)), Db = -_log10f(_fmaxf(lb, 1e-4f));
        float Da = min3(Dr, Dg, Db);
        float mx = max3(r, g, b), mn = min3(r, g, b), ch = _saturatef((mx - mn) / (mx + 1e-4f));
        float f = density / 100.0f * (0.6f + 0.4f * sstep(0.05f, 0.5f, ch));
        f *= 1.0f - sstep(0.75f, 1.0f, max3(lr, lg, lb));
        lr *= _exp10f(-f * (Dr - Da)); lg *= _exp10f(-f * (Dg - Da)); lb *= _exp10f(-f * (Db - Da));
        float y1 = luma(lr, lg, lb);
        if (y1 > 1e-6f)
        {
            float hold = _powf(y0 / y1, f < 0.0f ? 1.0f : 0.2f);
            lr *= hold; lg *= hold; lb *= hold;
        }
        r = toDisp(lr); g = toDisp(lg); b = toDisp(lb);
    }

    // ---- vibrance and saturation
    {
        float yl = luma(r, g, b);
        float mx = max3(r, g, b), mn = min3(r, g, b);
        float cs = _saturatef((mx - mn) / (mx + 1e-4f));
        float f = (1.0f + satur / 100.0f) * (1.0f + vibr / 100.0f * (1.0f - cs));
        r = yl + (r - yl) * f; g = yl + (g - yl) * f; b = yl + (b - yl) * f;
    }

    // ---- vignette
    if (vigAmt != 0.0f)
    {
        float dx = ((float)(p_X) - 0.5f * p_Width) / (0.5f * p_Width), dy = ((float)(p_Y) - 0.5f * p_Height) / (0.5f * p_Width);
        float d = _sqrtf(dx * dx + dy * dy) / 1.2f;
        float v = sstep(vigMid / 100.0f * 0.8f, 1.0f, d) * (vigAmt / 100.0f);
        float f = v < 0.0f ? 1.0f + v : 1.0f;
        r = r * f + (v > 0.0f ? v * (1.0f - r) * 0.5f : 0.0f);
        g = g * f + (v > 0.0f ? v * (1.0f - g) * 0.5f : 0.0f);
        b = b * f + (v > 0.0f ? v * (1.0f - b) * 0.5f : 0.0f);
    }

    // ---- highlight rolloff, path to white, gamut compression (linear)
    if (aRoll > 0.0f || pathW > 0.0f || gamutC > 0.0f)
    {
        float lr = spow(r, 2.4f), lg = spow(g, 2.4f), lb = spow(b, 2.4f);
        float K = 1.0f - 0.5f * aRoll, W = 1.0f - 0.015f * aRoll;
        float n = _fmaxf(max3(lr, lg, lb), 0.0f);
        float nn = n;
        if (aRoll > 0.0f && n > K)
        {
            nn = K + (n - K) / (1.0f + (n - K) / (W - K));
            float s = nn / n;
            lr *= s; lg *= s; lb *= s;
        }
        if (pathW > 0.0f)
        {
            float pn = n > 0.7f ? 0.7f + (n - 0.7f) / (1.0f + (n - 0.7f) / 0.285f) : n;
            float tt = sstep(0.7f, 0.985f, pn), k = pathW / 100.0f * tt * tt;
            lr += (nn - lr) * k; lg += (nn - lg) * k; lb += (nn - lb) * k;
        }
        if (gamutC > 0.0f)
        {
            float A = max3(lr, lg, lb);
            if (A > 0.0f)
            {
                float k = gamutC / 100.0f;
                float er = (A - lr) / A, eg = (A - lg) / A, eb = (A - lb) / A;
                er += (rgc(er, 0.815f, 1.147f) - er) * k;
                eg += (rgc(eg, 0.803f, 1.264f) - eg) * k;
                eb += (rgc(eb, 0.880f, 1.312f) - eb) * k;
                lr = A - er * A; lg = A - eg * A; lb = A - eb * A;
            }
        }
        r = spow(lr, 1.0f / 2.4f); g = spow(lg, 1.0f / 2.4f); b = spow(lb, 1.0f / 2.4f);
    }

    // ---- black floor: a firmer toe, quiet color in the blacks, then a floor tinted with the Shadows Hue
    if (blkFloor > 0.0f)
    {
        float fa = blkFloor / 100.0f;
        float yt = _saturatef(luma(r, g, b)), q = 1.0f - yt;
        float y1 = yt - 0.5f * fa * yt * q * q * q * q;
        float k = (y1 + 1e-5f) / (yt + 1e-5f);
        r *= k; g *= k; b *= k;
        float dc = 1.0f - 0.8f * fa * (1.0f - sstep(0.05f, 0.25f, y1));
        r = y1 + (r - y1) * dc; g = y1 + (g - y1) * dc; b = y1 + (b - y1) * dc;
        float3 dir = hueDir(shHue);
        float F = 0.07f * fa;
        float qr = 1.0f - _saturatef(r), qg = 1.0f - _saturatef(g), qb = 1.0f - _saturatef(b);
        qr = qr * qr * qr; qg = qg * qg * qg; qb = qb * qb * qb;
        r += F * (1.0f + 0.9f * dir.x) * qr * qr;
        g += F * (1.0f + 0.9f * dir.y) * qg * qg;
        b += F * (1.0f + 0.9f * dir.z) * qb * qb;
    }

    // ---- grain: luminance noise, strongest in the midtones, new every frame in the plugin
    if (grainAmt > 0.0f)
    {
        float n = (hash01((uint)(p_X), (uint)(p_Y), (uint)(TIMELINE_FRAME_INDEX) * 2u) - 0.5f) * (grainAmt / 100.0f) * 0.12f;
        float yl = luma(r, g, b), mw = 4.0f * yl * (1.0f - yl) + 0.15f;
        r += n * mw; g += n * mw; b += n * mw;
    }

    // ---- dither (with Deband): triangular noise of one 10-bit step, a little more in the shadows
    if (dbT > 0.0f)
    {
        uint fi = (uint)(TIMELINE_FRAME_INDEX) * 2u + 1u;
        float u = hash01((uint)(p_X), (uint)(p_Y), fi) + hash01((uint)(p_X) + 7919u, (uint)(p_Y), fi) - 1.0f;
        float n = u / 1023.0f * (1.5f - 0.5f * sstep(0.1f, 0.2f, luma(r, g, b)));
        r += n; g += n; b += n;
    }

    return make_float3(_saturatef(r), _saturatef(g), _saturatef(b));
}
