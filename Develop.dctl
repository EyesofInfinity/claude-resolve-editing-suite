// ---- Hue engine: skin and evening, after every earlier slider so no earlier slider changes position
DEFINE_UI_PARAMS(skinU,    Skin Unify,        DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(skinP,    Skin Protect,      DCTLUI_SLIDER_FLOAT, 80.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(hlEven,   Hue Lum Evening,   DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)

DEFINE_UI_TOOLTIP(Texture, "Fine detail: pores, bark, grass. Negative values soften it")
DEFINE_UI_TOOLTIP(Clarity, "Midtone contrast at the scale of objects. Strong edges are mostly spared: high settings leave a faint halo beside them")
DEFINE_UI_TOOLTIP(Structure, "Broad local contrast at the scale of whole shapes")
DEFINE_UI_TOOLTIP(Density, "Film-style color: saturated colors deepen the way dyes do, greys stay grey")
DEFINE_UI_TOOLTIP(Highlight Recovery, "Rebuilds the brightness and color that clipping removed, so lamps and glints glow with their own color")
DEFINE_UI_TOOLTIP(Highlight Rolloff, "Highlights ease into white instead of hitting a hard clip. Use it with Highlight Recovery and Mist Glow")
DEFINE_UI_TOOLTIP(Path to White, "Very bright colors fade toward white, the way film handles light sources")
DEFINE_UI_TOOLTIP(Gamut Compression, "Softly limits the most saturated colors, legal Rec.709 colors included, so they ease off before the gamut edge")
DEFINE_UI_TOOLTIP(Color Contrast, "Pulls hues toward a warm and cool pair: orange light against blue shadow")
DEFINE_UI_TOOLTIP(Black Floor, "Lifts the blacks to a colored floor in the Shadows Hue while the toe keeps its contrast")
DEFINE_UI_TOOLTIP(Mist Glow, "A diffusion filter: highlights bloom softly into their surroundings. On its own it moves light and keeps the total within a few percent. With Highlight Recovery it also spreads the light that clipping hid, so it can brighten")
DEFINE_UI_TOOLTIP(Glow Spread, "Size of the mist halo")
DEFINE_UI_TOOLTIP(Light Threshold, "Where mist, sparkle and halation begin. Above about 50 halation stops following it, so white always drives the fringe")
DEFINE_UI_TOOLTIP(Glow Warmth, "Tints the scattered light warm or cool")
DEFINE_UI_TOOLTIP(Mist Veil, "A local haze: each pixel mixes a little toward the mean color within the glow's reach, so shadows near light lift and highlights calm")
DEFINE_UI_TOOLTIP(Sparkle, "A tight glow on small bright points: glints on water, specular highlights")
DEFINE_UI_TOOLTIP(Halation, "Film halation: a warm red-orange fringe on the dark side of bright edges")
DEFINE_UI_TOOLTIP(Halation Size, "Width of the halation fringe, from fine 65mm to wide 8mm film")
DEFINE_UI_TOOLTIP(Deband, "Smooths contour steps in gradients such as night skies, then dithers the output")
DEFINE_UI_TOOLTIP(Grain, "Plugin only: moves every frame in the ResolveFX DCTL plugin, and holds still on a LUT copy")
DEFINE_UI_TOOLTIP(Skin Unify, "Pulls skin tones toward one skin hue, so faces under mixed light match")
DEFINE_UI_TOOLTIP(Skin Protect, "Keys on colour: every skin-coloured pixel moves less under the Orange and Red sliders, faces and also warm wood, brick, lamp-lit walls and autumn leaves of that colour. Lower it to move them")
DEFINE_UI_TOOLTIP(Hue Lum Evening, "Evens the brightness of colours: yellows darken and blues lift toward one level")

// ------------------------------------------------------------------ helpers

__DEVICE__ float luma(float r, float g, float b) { return 0.2126f * r + 0.7152f * g + 0.0722f * b; }
__DEVICE__ float toLin(float x)  { return _powf(_fmaxf(x, 0.0f), 2.4f); }
__DEVICE__ float toDisp(float x) { return _powf(_fmaxf(x, 0.0f), 1.0f / 2.4f); }
__DEVICE__ float spow(float x, float p) { return _copysignf(_powf(_fabs(x), p), x); }
__DEVICE__ float sstep(float a, float b, float x) { float t = _saturatef((x - a) / (b - a)); return t * t * (3.0f - 2.0f * t); }
__DEVICE__ float mixf(float a, float b, float t) { return a + (b - a) * t; }
__DEVICE__ float max3(float a, float b, float c) { return _fmaxf(a, _fmaxf(b, c)); }
__DEVICE__ float min3(float a, float b, float c) { return _fminf(a, _fminf(b, c)); }
__DEVICE__ float mid3(float a, float b, float c) { return _fmaxf(_fminf(a, b), _fminf(_fmaxf(a, b), c)); }

__DEVICE__ float clipOf(float r, float g, float b) { return sstep(0.90f, 0.985f, mid3(r, g, b)); }
__DEVICE__ int clampi(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }

__DEVICE__ float hueOf(float r, float g, float b)
{
    float mx = max3(r, g, b), mn = min3(r, g, b), d = mx - mn;
    if (d < 1e-6f) return 0.0f;
    float h;
    if (mx == r)      h = _fmod((g - b) / d, 6.0f);
    else if (mx == g) h = (b - r) / d + 2.0f;
    else              h = (r - g) / d + 4.0f;
    h *= 60.0f;
    return h < 0.0f ? h + 360.0f : h;
}

__DEVICE__ float2 locusUV(float T)
{
    float u = (0.860117757f + 1.54118254e-4f * T + 1.28641212e-7f * T * T) / (1.0f + 8.42420235e-4f * T + 7.08145163e-7f * T * T);
    float v = (0.317398726f + 4.22806245e-5f * T + 4.20481691e-8f * T * T) / (1.0f - 2.89741816e-5f * T + 1.61456053e-7f * T * T);
    return make_float2(u, v);
}

__DEVICE__ float3 locusXYZ(float mired, float duv)
{
    float T = 1.0e6f / mired;
    float2 p = locusUV(T), q = locusUV(T * 1.01f);
    float du = q.x - p.x, dv = q.y - p.y, n = _sqrtf(du * du + dv * dv);
    float nu = -dv / n, nv = du / n;
    if (nv < 0.0f) { nu = -nu; nv = -nv; }
    float u = p.x + duv * nu, v = p.y + duv * nv;
    float d = 2.0f * u - 8.0f * v + 4.0f;
    float x = 3.0f * u / d, y = 2.0f * v / d;
    return make_float3(x / y, 1.0f, (1.0f - x - y) / y);
}

__DEVICE__ float3 hueDir(float hDeg)
{
    float h = _fmod(hDeg, 360.0f) / 60.0f;
    float x = 1.0f - _fabs(_fmod(h, 2.0f) - 1.0f);
    float r = 0.0f, g = 0.0f, b = 0.0f;
    if (h < 1.0f)      { r = 1.0f; g = x; }
    else if (h < 2.0f) { r = x; g = 1.0f; }
    else if (h < 3.0f) { g = 1.0f; b = x; }
    else if (h < 4.0f) { g = x; b = 1.0f; }
    else if (h < 5.0f) { r = x; b = 1.0f; }
    else               { r = 1.0f; b = x; }
    float y = luma(r, g, b);
    return make_float3(r - y, g - y, b - y);
}

__DEVICE__ float3 hueRotate(float r, float g, float b, float deg)
{
    float a = deg * 3.14159265f / 180.0f, c = _cosf(a), s = _sinf(a);
    float k = 1.0f / 3.0f, sq = _sqrtf(k);
    float m00 = c + (1.0f - c) * k, m01 = k * (1.0f - c) - sq * s, m02 = k * (1.0f - c) + sq * s;
    float m10 = k * (1.0f - c) + sq * s, m11 = c + k * (1.0f - c), m12 = k * (1.0f - c) - sq * s;
    float m20 = k * (1.0f - c) - sq * s, m21 = k * (1.0f - c) + sq * s, m22 = c + k * (1.0f - c);
    return make_float3(m00 * r + m01 * g + m02 * b, m10 * r + m11 * g + m12 * b, m20 * r + m21 * g + m22 * b);
}

__DEVICE__ float band(float h, float c, float w)
{
    float d = _fabs(h - c);
    d = _fminf(d, 360.0f - d);
    return d >= w ? 0.0f : 0.5f + 0.5f * _cosf(3.14159265f * d / w);
}

__CONSTANT__ float MIXH[9] = {29.0f, 50.0f, 110.0f, 138.0f, 195.0f, 260.0f, 292.0f, 328.0f, 389.0f};
__CONSTANT__ float MIXL[8] = {0.628f, 0.721f, 0.968f, 0.876f, 0.905f, 0.452f, 0.522f, 0.702f};

__DEVICE__ float sel8(int k, float a0, float a1, float a2, float a3, float a4, float a5, float a6, float a7)
{
    return k == 0 ? a0 : (k == 1 ? a1 : (k == 2 ? a2 : (k == 3 ? a3 : (k == 4 ? a4 : (k == 5 ? a5 : (k == 6 ? a6 : a7))))));
}

__DEVICE__ float skinW(float d, float C, float L)
{
    return _expf(-0.5f * (d / 18.0f) * (d / 18.0f)) * sstep(0.02f, 0.04f, C) * (1.0f - sstep(0.14f, 0.18f, C))
         * sstep(0.30f, 0.40f, L) * (1.0f - sstep(0.80f, 0.90f, L));
}

__CONSTANT__ float HSK[12] = {3.115e-5f, 0.03281839f, 0.002308909f, 0.03281839f,
                              0.5063305f, 0.0336965f, 0.03311142f, 0.01527162f,
                              0.003865880f, 0.0336965f, 0.02792710f, 0.01158346f};

__DEVICE__ float hueProtT(float m, float rd, float o, float y, float p)
{
    if (p <= 0.0f || (m == 0.0f && rd == 0.0f && o == 0.0f && y == 0.0f)) return 0.0f;
    float T = 0.0f;
    for (int s = 0; s < 3; s++)
    {
        float ua = 0.30f * (s == 0 ? m : (s == 1 ? rd : o)), ub = 0.30f * (s == 0 ? rd : (s == 1 ? o : y));
        float sp = MIXH[s == 0 ? 8 : s] - MIXH[s == 0 ? 7 : s - 1];
        float sg = s == 2 ? 1.0f : -1.0f;
        float pa = sg * ua, pb = sg * ub, cm = (pa < 0.0f && pb < 0.0f) ? _fmaxf(pa, pb) : 0.0f;
        float fall = _fminf((ub - ua) * 1.5707963f / sp, 0.0f);
        float lb = cm * HSK[4 * s + 1] + _fminf(pa - cm, 0.0f) * HSK[4 * s + 2] + _fminf(pb - cm, 0.0f) * HSK[4 * s + 3];
        float bt = lb - HSK[4 * s] * fall;
        if (bt < 0.0f) T = _fmaxf(T, -bt / (1.0f + fall));
    }
    if (p * T <= 1.0f) return T;
    float Tg = 0.0f;
    for (int s = 0; s < 3; s++)
    {
        float ua = 0.30f * (s == 0 ? m : (s == 1 ? rd : o)), ub = 0.30f * (s == 0 ? rd : (s == 1 ? o : y));
        float sp = MIXH[s == 0 ? 8 : s] - MIXH[s == 0 ? 7 : s - 1];
        float dA = s == 0 ? -82.0f : (s == 1 ? -21.0f : 0.0f), d0 = s == 0 ? -60.0f : dA;
        int n = s == 0 ? 40 : (s == 1 ? 22 : 61);
        float du = ub - ua, D1 = _fabs(du) * 1.5707963f / sp, D2 = D1 * 3.14159265f / sp, D3 = D2 * 3.14159265f / sp;
        float eA = 0.125f * D3;
        float eB = 0.125f * (2.367e-4f * _fmaxf(_fabs(ua), _fabs(ub)) + 3.0f * 0.0030865f * D1 + 3.0f * 0.0336965f * D2);
        for (int q = 0; q < n; q++)
        {
            float d = d0 + (float)(q), tq = (d - dA) / sp;
            float sl = du * 1.5707963f / sp * _sinf(3.14159265f * tq);
            float bt = _expf(-d * d / 648.0f) * (d / 324.0f * (ua + du * (0.5f - 0.5f * _cosf(3.14159265f * tq))) - sl);
            if (eB - bt > 0.0f) Tg = _fmaxf(Tg, (eB - bt) / (1.0f + sl - eA));
        }
    }
    return _fminf(T, Tg);
}

__DEVICE__ float3 toOklab(float r, float g, float b)
{
    float l = 0.4122214708f * r + 0.5363325363f * g + 0.0514459929f * b;
    float m = 0.2119034982f * r + 0.6806995451f * g + 0.1073969566f * b;
    float s = 0.0883024619f * r + 0.2817188376f * g + 0.6299787005f * b;
    l = spow(l, 1.0f / 3.0f); m = spow(m, 1.0f / 3.0f); s = spow(s, 1.0f / 3.0f);
    return make_float3(0.2104542553f * l + 0.7936177850f * m - 0.0040720468f * s,
                       1.9779984951f * l - 2.4285922050f * m + 0.4505937099f * s,
                       0.0259040371f * l + 0.7827717662f * m - 0.8086757660f * s);
}

__DEVICE__ float3 fromOklab(float L, float a, float b)
{
    float l = L + 0.3963377774f * a + 0.2158037573f * b;
    float m = L - 0.1055613458f * a - 0.0638541728f * b;
    float s = L - 0.0894841775f * a - 1.2914855480f * b;
    l = l * l * l; m = m * m * m; s = s * s * s;
    return make_float3( 4.0767416621f * l - 3.3077115913f * m + 0.2309699292f * s,
                       -1.2684380046f * l + 2.6097574011f * m - 0.3413193965f * s,
                       -0.0041960863f * l - 0.7034186147f * m + 1.7076147010f * s);
}

__DEVICE__ float2 abDir(float hDeg)
{
    float3 d = hueDir(hDeg);
    float3 c = toOklab(0.2f + 0.1f * d.x, 0.2f + 0.1f * d.y, 0.2f + 0.1f * d.z);
    float n = _sqrtf(c.y * c.y + c.z * c.z) + 1e-6f;
    return make_float2(c.y / n, c.z / n);
}

