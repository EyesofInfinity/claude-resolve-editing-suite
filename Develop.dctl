        float k = aHal * (1.0f - 0.7f * yo / (yo + 0.25f)) * (1.0f - 0.5f * _saturatef(drv));
        oR += k * red; oG += k * 0.35f * grn; oB += k * 0.03f * red;
    }

    // ---- back to display, tone on luma (values above white keep their headroom)
    r = toDisp(oR); g = toDisp(oG); b = toDisp(oB);
    {
        float Y = luma(r, g, b), Yc = _fminf(Y, 1.0f), Y2 = Yc;
        float k = contr / 100.0f;
