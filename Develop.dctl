        float wl = luma(wr2, wg2, wb2), k = clipC * ks * fit;
        r += (wr2 * y / wl - r) * k; g += (wg2 * y / wl - g) * k; b += (wb2 * y / wl - b) * k;
        exC = expandGain(y, pTap);
    }

    // ---- white balance and exposure
    {
        float wr = m00 * r + m01 * g + m02 * b, wg = m10 * r + m11 * g + m12 * b, wb = m20 * r + m21 * g + m22 * b;
        r = wr; g = wg; b = wb;
    }

    // ---- clip-edge feather (part of the rolloff): soften the hard rim of sources that were already clipped
    if (aRoll > 0.0f && fn > 0.0f)
    {
        float fa = (fc + clipC) / (fn + 1.0f), k = aRoll * fa * (1.0f - fa);
        r += ((fr + r) / (fn + 1.0f) - r) * k; g += ((fg + g) / (fn + 1.0f) - g) * k; b += ((fb + b) / (fn + 1.0f) - b) * k;
    }

    // ---- texture, clarity, structure: self-guided bands in log luminance, so strong edges get no halo
    if (detail)
    {
        float L = _log2f(luma(r, g, b) + 1e-4f);
        xTw += Ac; xTl += Ac * L; xTq += Ac * L * L;
        xCw += Ac; xCl += Ac * L; xCq += Ac * L * L;
        xSw += Ac; xSl += Ac * L; xSq += Ac * L * L;
        float mT = xTl / xTw, vT = _fmaxf(xTq / xTw - mT * mT, 0.0f), aT = vT / (vT + 0.09f);
        float mC = xCl / xCw, vC = _fmaxf(xCq / xCw - mC * mC, 0.0f), aC = vC / (vC + 0.5625f);
        float mS = xSl / xSw, vS = _fmaxf(xSq / xSw - mS * mS, 0.0f), aS = vS / (vS + 1.0f);
        float bT = aT * L + (1.0f - aT) * mT, bC = aC * L + (1.0f - aC) * mC, bS = aS * L + (1.0f - aS) * mS;
        float dT = L - bT, dC = bT - bC, dS = bC - bS;
        dT *= sstep(0.02f, 0.04f, _fabs(dT));
        dT = 0.3f * _tanhf(dT / 0.3f); dC = 0.3f * _tanhf(dC / 0.3f); dS = 0.3f * _tanhf(dS / 0.3f);
        float yd = toDisp(luma(r, g, b));
        float tw = sstep(0.02f, 0.18f, yd) * (1.0f - 0.5f * sstep(0.6f, 1.0f, yd));
        float k = _clampf(_exp2f(tw * (texAmt * dT + clarity * dC + strAmt * dS) / 100.0f), 0.5f, 2.0f);
        r *= k; g *= k; b *= k;
    }

    // ---- mist (energy-conserving diffusion), veil and sparkle
    float wt = glowWarm / 100.0f;
    float htr = 1.0f + 0.35f * wt, htg = 1.0f + 0.05f * wt, htb = 1.0f - 0.35f * wt;
    float htl = luma(htr, htg, htb);
    htr /= htl; htg /= htl; htb /= htl;
    float oR = r, oG = g, oB = b;
    if (aMist > 0.0f)
    {
        float qy = luma(r, g, b), mb = mistW(qy, mLo, mHi), ye = qy * exC, me = mistW(ye, mLo, mHi);
        float se = ye * me, wh = sstep(0.90f, 0.985f, min3(R0, G0, B0));
        float cm = mb + (1.0f - wh) * (exC * me - mb), hx = wh * (se - qy * mb);
        o0r += Ac * r * cm; o0g += Ac * g * cm; o0b += Ac * b * cm; o0x += Ac * hx; o0n += Ac;
        o1r += Ac * r * cm; o1g += Ac * g * cm; o1b += Ac * b * cm; o1x += Ac * hx; o1n += Ac;
        o2r += Ac * r * cm; o2g += Ac * g * cm; o2b += Ac * b * cm; o2x += Ac * hx; o2n += Ac;
        o3r += Ac * r * cm; o3g += Ac * g * cm; o3b += Ac * b * cm; o3x += Ac * hx; o3n += Ac;
        float sr = 0.1782f * o0r / o0n + 0.2193f * o1r / o1n + 0.2701f * o2r / o2n + 0.3324f * o3r / o3n;
        float sg = 0.1782f * o0g / o0n + 0.2193f * o1g / o1n + 0.2701f * o2g / o2n + 0.3324f * o3g / o3n;
        float sb = 0.1782f * o0b / o0n + 0.2193f * o1b / o1n + 0.2701f * o2b / o2n + 0.3324f * o3b / o3n;
        float sx = 0.1782f * o0x / o0n + 0.2193f * o1x / o1n + 0.2701f * o2x / o2n + 0.3324f * o3x / o3n;
        float sy = luma(sr, sg, sb);
        gk1 = guardStep(_fminf(2.0f * gk1, aBr) / (6.2832f * Ac)); gk2 = guardRamp(_fminf(2.0f * gk2, aBr) / (14.4316f * Ac));
        gk3 = guardStep(_fminf(2.0f * gk3, aBr) / (37.6991f * Ac)); gk4 = guardStep(_fminf(2.0f * gk4, aBr) / (98.9602f * Ac));
        float b3 = _expf(-9.0f * Ac * c3), b7 = _expf(-49.0f * Ac * c3), b14 = _expf(-196.0f * Ac * c3);
        float b26 = _expf(-676.0f * Ac * c3), b44 = _expf(-1936.0f * Ac * c3);
        float fS = 0.0f;
        for (int oc = 0; oc < 4; oc++)
        {
            float wo = oc == 0 ? 0.3324f : (oc == 1 ? 0.2701f : (oc == 2 ? 0.2193f : 0.1782f));
            fS += wo * (1.0f - ((b3 - b7) * (1.0f - gk1) + (b7 - b14) * (1.0f - gk2) + (b14 - b26) * (1.0f - gk3)
                               + (b26 - b44) * (1.0f - gk4)) / (1.0f - b44 + 1e-20f));
            b3 *= b3; b3 *= b3; b7 *= b7; b7 *= b7; b14 *= b14; b14 *= b14; b26 *= b26; b26 *= b26; b44 *= b44; b44 *= b44;
        }
        sr = sy + 0.8f * (sr - sy); sg = sy + 0.8f * (sg - sy); sb = sy + 0.8f * (sb - sy);
        sr += sx * hnr; sg += sx * hng; sb += sx * hnb;
        oR = r - aMist * r * mb * fS + aMist * sr * htr;
        oG = g - aMist * g * mb * fS + aMist * sg * htg;
        oB = b - aMist * b * mb * fS + aMist * sb * htb;
    }
    if (aVeil > 0.0f)
    {
        vr += Ac * r; vg += Ac * g; vb += Ac * b; vn += Ac;
        oR += (vr / vn - oR) * aVeil; oG += (vg / vn - oG) * aVeil; oB += (vb / vn - oB) * aVeil;
    }
    if (aSpk > 0.0f)
    {
        float ye = luma(r, g, b) * exC, bw = knee(ye, 1.4f * thrL) / _fmaxf(ye, 1e-6f) * exC;
        pr += Ac * r * bw; pg += Ac * g * bw; pb += Ac * b * bw; pn += Ac;
        oR += aSpk * pr / pn * htr; oG += aSpk * pg / pn * htg; oB += aSpk * pb / pn * htb;
    }

    // ---- halation: red-orange light on the dark side of bright edges
    if (aHal > 0.0f)
    {
