// Develop 1.0, node 1 of 2 for DCTL plugin nodes: white balance, exposure, tone, detail, highlight recovery,
// mist, veil, sparkle, halation and deband. Follow it with Develop 2 Color; together they give Develop.dctl's
// picture. A ResolveFX DCTL plugin node takes at most 64 sliders and Develop.dctl has 67, so as plugin
// nodes it runs as these two, cut where Develop's own processing turns from neighbourhood work to single pixels.
// Signal between the two nodes: Rec.709 gamma 2.4 display values, unclipped (values above 1 keep their headroom).
// Develop 2 Color always clips its output to 0 to 1, as Develop.dctl does once any slider moves; with every
// slider of both nodes at neutral the pair returns values inside 0 to 1 exactly and clips the rest.
// Highlight Rolloff and Deband act on both sides of the cut: both nodes declare them; set the same value on each.
// Generated by split_develop.py from Develop.dctl: edit Develop.dctl and run python -I split_develop.py, never
// this file. Applied as a LUT, use Develop.dctl itself. MIT License.
//
// Sampling: highlight recovery, deband, mist, sparkle, halation and the three detail bands share one fixed pattern
// of 144 taps in five rings out to 4.1% of the frame height, plus the centre pixel (see Develop.dctl).
// White balance adapts in the CAT16 cone space of CIECAM16, with the Planckian locus from Krystek's approximation
// (1985).

// ---- Basic
DEFINE_UI_PARAMS(temp,     Temp,       DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(tint,     Tint,       DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(expo,     Exposure,   DCTLUI_SLIDER_FLOAT, 0.0, -4.0, 4.0, 0.01)
DEFINE_UI_PARAMS(contr,    Contrast,   DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(hilite,   Highlights, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(shadow,   Shadows,    DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(whites,   Whites,     DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(blacks,   Blacks,     DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(texAmt,   Texture,    DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(clarity,  Clarity,    DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(strAmt,   Structure,  DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)

// ---- Highlights
DEFINE_UI_PARAMS(recon,    Highlight Recovery, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(rolloff,  Highlight Rolloff,  DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)

// ---- Light
DEFINE_UI_PARAMS(glowAmt,  Mist Glow,       DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(glowSpr,  Glow Spread,     DCTLUI_SLIDER_FLOAT, 40.0, 1.0, 100.0, 1.0)
DEFINE_UI_PARAMS(glowThr,  Light Threshold, DCTLUI_SLIDER_FLOAT, 60.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(glowWarm, Glow Warmth,     DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(veil,     Mist Veil,       DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(sparkle,  Sparkle,         DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(halAmt,   Halation,        DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(halSize,  Halation Size,   DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)

// ---- Finish
DEFINE_UI_PARAMS(deband,   Deband,            DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)

DEFINE_UI_TOOLTIP(Texture, "Fine detail: pores, bark, grass. Negative values soften it")
DEFINE_UI_TOOLTIP(Clarity, "Midtone contrast at the scale of objects. Strong edges are mostly spared: high settings leave a faint halo beside them")
DEFINE_UI_TOOLTIP(Structure, "Broad local contrast at the scale of whole shapes")
DEFINE_UI_TOOLTIP(Highlight Recovery, "Rebuilds the brightness and color that clipping removed, so lamps and glints glow with their own color")
DEFINE_UI_TOOLTIP(Highlight Rolloff, "Also on Develop 2 Color: set the same value on both. Here it softens the rim of sources that were already clipped")
DEFINE_UI_TOOLTIP(Mist Glow, "A diffusion filter: highlights bloom softly into their surroundings. On its own it moves light and keeps the total within a few percent. With Highlight Recovery it also spreads the light that clipping hid, so it can brighten")
DEFINE_UI_TOOLTIP(Glow Spread, "Size of the mist halo")
DEFINE_UI_TOOLTIP(Light Threshold, "Where mist, sparkle and halation begin. Above about 50 halation stops following it, so white always drives the fringe")
DEFINE_UI_TOOLTIP(Glow Warmth, "Tints the scattered light warm or cool")
DEFINE_UI_TOOLTIP(Mist Veil, "A local haze: each pixel mixes a little toward the mean color within the glow's reach, so shadows near light lift and highlights calm")
DEFINE_UI_TOOLTIP(Sparkle, "A tight glow on small bright points: glints on water, specular highlights")
DEFINE_UI_TOOLTIP(Halation, "Film halation: a warm red-orange fringe on the dark side of bright edges")
DEFINE_UI_TOOLTIP(Halation Size, "Width of the halation fringe, from fine 65mm to wide 8mm film")
DEFINE_UI_TOOLTIP(Deband, "Also on Develop 2 Color: set the same value on both. Here it smooths contour steps in gradients such as night skies")

// ------------------------------------------------------------------ helpers

__DEVICE__ float luma(float r, float g, float b) { return 0.2126f * r + 0.7152f * g + 0.0722f * b; }
__DEVICE__ float toLin(float x)  { return _powf(_fmaxf(x, 0.0f), 2.4f); }
__DEVICE__ float toDisp(float x) { return _powf(_fmaxf(x, 0.0f), 1.0f / 2.4f); }
__DEVICE__ float sstep(float a, float b, float x) { float t = _saturatef((x - a) / (b - a)); return t * t * (3.0f - 2.0f * t); }
__DEVICE__ float mixf(float a, float b, float t) { return a + (b - a) * t; }
__DEVICE__ float max3(float a, float b, float c) { return _fmaxf(a, _fmaxf(b, c)); }
__DEVICE__ float min3(float a, float b, float c) { return _fminf(a, _fminf(b, c)); }
__DEVICE__ float mid3(float a, float b, float c) { return _fmaxf(_fminf(a, b), _fminf(_fmaxf(a, b), c)); }

__DEVICE__ float clipOf(float r, float g, float b) { return sstep(0.90f, 0.985f, mid3(r, g, b)); }
__DEVICE__ int clampi(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }

__DEVICE__ float2 locusUV(float T)
{
    float u = (0.860117757f + 1.54118254e-4f * T + 1.28641212e-7f * T * T) / (1.0f + 8.42420235e-4f * T + 7.08145163e-7f * T * T);
    float v = (0.317398726f + 4.22806245e-5f * T + 4.20481691e-8f * T * T) / (1.0f - 2.89741816e-5f * T + 1.61456053e-7f * T * T);
    return make_float2(u, v);
}

__DEVICE__ float3 locusXYZ(float mired, float duv)
{
    float T = 1.0e6f / mired;
    float2 p = locusUV(T), q = locusUV(T * 1.01f);
    float du = q.x - p.x, dv = q.y - p.y, n = _sqrtf(du * du + dv * dv);
    float nu = -dv / n, nv = du / n;
    if (nv < 0.0f) { nu = -nu; nv = -nv; }
    float u = p.x + duv * nu, v = p.y + duv * nv;
    float d = 2.0f * u - 8.0f * v + 4.0f;
    float x = 3.0f * u / d, y = 2.0f * v / d;
    return make_float3(x / y, 1.0f, (1.0f - x - y) / y);
}

