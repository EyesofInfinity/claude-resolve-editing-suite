// Develop 1.0, node 2 of 2 for DCTL plugin nodes: split toning, colour contrast, the colour mixer and skin, density,
// vibrance, saturation, vignette, highlight shoulder, path to white, gamut compression, black floor and grain.
// It follows Develop 1 Light and takes its picture; together they give Develop.dctl's picture. A ResolveFX DCTL
// plugin node takes at most 64 sliders and Develop.dctl has 67, so as plugin nodes it runs as these two.
// Signal between the two nodes: Rec.709 gamma 2.4 display values, unclipped (values above 1 keep their headroom).
// Develop 2 Color always clips its output to 0 to 1, as Develop.dctl does once any slider moves; with every
// slider of both nodes at neutral the pair returns values inside 0 to 1 exactly and clips the rest.
// Highlight Rolloff and Deband act on both sides of the cut: both nodes declare them; set the same value on each.
// Generated by split_develop.py from Develop.dctl: edit Develop.dctl and run python -I split_develop.py, never
// this file. Applied as a LUT, use Develop.dctl itself. MIT License.
//
// Gamut compression follows the ACES Reference Gamut Compression specification (CC BY 4.0). The Oklab matrices
// are the published Oklab reference values. Grain and the deband dither are hashed from the frame index, so they
// move in the plugin.

// ---- Basic
DEFINE_UI_PARAMS(vibr,     Vibrance,   DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(satur,    Saturation, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(density,  Density,    DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)

// ---- Highlights
DEFINE_UI_PARAMS(rolloff,  Highlight Rolloff,  DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(pathW,    Path to White,      DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(gamutC,   Gamut Compression,  DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)

// ---- Color mixer: hue shift, saturation, luminance for eight colors
DEFINE_UI_PARAMS(hRed,  Red Hue,        DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(sRed,  Red Saturation, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(lRed,  Red Luminance,  DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(hOra,  Orange Hue,        DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(sOra,  Orange Saturation, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(lOra,  Orange Luminance,  DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(hYel,  Yellow Hue,        DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(sYel,  Yellow Saturation, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(lYel,  Yellow Luminance,  DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(hGre,  Green Hue,        DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(sGre,  Green Saturation, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(lGre,  Green Luminance,  DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(hAqu,  Aqua Hue,        DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(sAqu,  Aqua Saturation, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(lAqu,  Aqua Luminance,  DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(hBlu,  Blue Hue,        DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(sBlu,  Blue Saturation, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(lBlu,  Blue Luminance,  DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(hPur,  Purple Hue,        DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(sPur,  Purple Saturation, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(lPur,  Purple Luminance,  DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(hMag,  Magenta Hue,        DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(sMag,  Magenta Saturation, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(lMag,  Magenta Luminance,  DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)

// ---- Split toning (hue in degrees on the usual color wheel, amount 0 to 100), color contrast, tinted blacks
DEFINE_UI_PARAMS(shHue, Shadows Hue,           DCTLUI_SLIDER_FLOAT, 245.0, 0.0, 360.0, 1.0)
DEFINE_UI_PARAMS(shSat, Shadows Saturation,    DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(miHue, Midtones Hue,          DCTLUI_SLIDER_FLOAT, 40.0, 0.0, 360.0, 1.0)
DEFINE_UI_PARAMS(miSat, Midtones Saturation,   DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(hiHue, Highlights Hue,        DCTLUI_SLIDER_FLOAT, 45.0, 0.0, 360.0, 1.0)
DEFINE_UI_PARAMS(hiSat, Highlights Saturation, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(gBlend, Grading Blending,     DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(gBal,   Grading Balance,      DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(cContr, Color Contrast,       DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(blkFloor, Black Floor,        DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)

// ---- Finish
DEFINE_UI_PARAMS(deband,   Deband,            DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(vigAmt,   Vignette,          DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(vigMid,   Vignette Midpoint, DCTLUI_SLIDER_FLOAT, 50.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(grainAmt, Grain,             DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)

// ---- Hue engine: skin and evening, after every earlier slider so no earlier slider changes position
DEFINE_UI_PARAMS(skinU,    Skin Unify,        DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(skinP,    Skin Protect,      DCTLUI_SLIDER_FLOAT, 80.0, 0.0, 100.0, 1.0)
DEFINE_UI_PARAMS(hlEven,   Hue Lum Evening,   DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 100.0, 1.0)

DEFINE_UI_TOOLTIP(Density, "Film-style color: saturated colors deepen the way dyes do, greys stay grey")
DEFINE_UI_TOOLTIP(Highlight Rolloff, "Also on Develop 1 Light: set the same value on both. Here it eases highlights into white instead of a hard clip")
DEFINE_UI_TOOLTIP(Path to White, "Very bright colors fade toward white, the way film handles light sources")
DEFINE_UI_TOOLTIP(Gamut Compression, "Softly limits the most saturated colors, legal Rec.709 colors included, so they ease off before the gamut edge")
DEFINE_UI_TOOLTIP(Color Contrast, "Pulls hues toward a warm and cool pair: orange light against blue shadow")
DEFINE_UI_TOOLTIP(Black Floor, "Lifts the blacks to a colored floor in the Shadows Hue while the toe keeps its contrast")
DEFINE_UI_TOOLTIP(Deband, "Also on Develop 1 Light: set the same value on both. Here it dithers the output")
DEFINE_UI_TOOLTIP(Grain, "Plugin only: moves every frame in the ResolveFX DCTL plugin, and holds still on a LUT copy")
DEFINE_UI_TOOLTIP(Skin Unify, "Pulls skin tones toward one skin hue, so faces under mixed light match")
DEFINE_UI_TOOLTIP(Skin Protect, "Keys on colour: every skin-coloured pixel moves less under the Orange and Red sliders, faces and also warm wood, brick, lamp-lit walls and autumn leaves of that colour. Lower it to move them")
DEFINE_UI_TOOLTIP(Hue Lum Evening, "Evens the brightness of colours: yellows darken and blues lift toward one level")

// ------------------------------------------------------------------ helpers

__DEVICE__ float luma(float r, float g, float b) { return 0.2126f * r + 0.7152f * g + 0.0722f * b; }
__DEVICE__ float toLin(float x)  { return _powf(_fmaxf(x, 0.0f), 2.4f); }
__DEVICE__ float toDisp(float x) { return _powf(_fmaxf(x, 0.0f), 1.0f / 2.4f); }
__DEVICE__ float spow(float x, float p) { return _copysignf(_powf(_fabs(x), p), x); }
__DEVICE__ float sstep(float a, float b, float x) { float t = _saturatef((x - a) / (b - a)); return t * t * (3.0f - 2.0f * t); }
__DEVICE__ float max3(float a, float b, float c) { return _fmaxf(a, _fmaxf(b, c)); }
__DEVICE__ float min3(float a, float b, float c) { return _fminf(a, _fminf(b, c)); }

__DEVICE__ float hueOf(float r, float g, float b)
{
    float mx = max3(r, g, b), mn = min3(r, g, b), d = mx - mn;
    if (d < 1e-6f) return 0.0f;
    float h;
    if (mx == r)      h = _fmod((g - b) / d, 6.0f);
    else if (mx == g) h = (b - r) / d + 2.0f;
    else              h = (r - g) / d + 4.0f;
    h *= 60.0f;
    return h < 0.0f ? h + 360.0f : h;
}

__DEVICE__ float3 hueDir(float hDeg)
{
    float h = _fmod(hDeg, 360.0f) / 60.0f;
    float x = 1.0f - _fabs(_fmod(h, 2.0f) - 1.0f);
    float r = 0.0f, g = 0.0f, b = 0.0f;
    if (h < 1.0f)      { r = 1.0f; g = x; }
    else if (h < 2.0f) { r = x; g = 1.0f; }
    else if (h < 3.0f) { g = 1.0f; b = x; }
    else if (h < 4.0f) { g = x; b = 1.0f; }
    else if (h < 5.0f) { r = x; b = 1.0f; }
    else               { r = 1.0f; b = x; }
    float y = luma(r, g, b);
    return make_float3(r - y, g - y, b - y);
}

__DEVICE__ float3 hueRotate(float r, float g, float b, float deg)
{
    float a = deg * 3.14159265f / 180.0f, c = _cosf(a), s = _sinf(a);
    float k = 1.0f / 3.0f, sq = _sqrtf(k);
    float m00 = c + (1.0f - c) * k, m01 = k * (1.0f - c) - sq * s, m02 = k * (1.0f - c) + sq * s;
    float m10 = k * (1.0f - c) + sq * s, m11 = c + k * (1.0f - c), m12 = k * (1.0f - c) - sq * s;
    float m20 = k * (1.0f - c) - sq * s, m21 = k * (1.0f - c) + sq * s, m22 = c + k * (1.0f - c);
    return make_float3(m00 * r + m01 * g + m02 * b, m10 * r + m11 * g + m12 * b, m20 * r + m21 * g + m22 * b);
}

__DEVICE__ float band(float h, float c, float w)
{
    float d = _fabs(h - c);
    d = _fminf(d, 360.0f - d);
    return d >= w ? 0.0f : 0.5f + 0.5f * _cosf(3.14159265f * d / w);
}

__CONSTANT__ float MIXH[9] = {29.0f, 50.0f, 110.0f, 138.0f, 195.0f, 260.0f, 292.0f, 328.0f, 389.0f};
__CONSTANT__ float MIXL[8] = {0.628f, 0.721f, 0.968f, 0.876f, 0.905f, 0.452f, 0.522f, 0.702f};

__DEVICE__ float sel8(int k, float a0, float a1, float a2, float a3, float a4, float a5, float a6, float a7)
{
    return k == 0 ? a0 : (k == 1 ? a1 : (k == 2 ? a2 : (k == 3 ? a3 : (k == 4 ? a4 : (k == 5 ? a5 : (k == 6 ? a6 : a7))))));
}

__DEVICE__ float skinW(float d, float C, float L)
{
    return _expf(-0.5f * (d / 18.0f) * (d / 18.0f)) * sstep(0.02f, 0.04f, C) * (1.0f - sstep(0.14f, 0.18f, C))
         * sstep(0.30f, 0.40f, L) * (1.0f - sstep(0.80f, 0.90f, L));
}

__CONSTANT__ float HSK[12] = {3.115e-5f, 0.03281839f, 0.002308909f, 0.03281839f,
                              0.5063305f, 0.0336965f, 0.03311142f, 0.01527162f,
                              0.003865880f, 0.0336965f, 0.02792710f, 0.01158346f};

__DEVICE__ float hueProtT(float m, float rd, float o, float y, float p)
{
    if (p <= 0.0f || (m == 0.0f && rd == 0.0f && o == 0.0f && y == 0.0f)) return 0.0f;
    float T = 0.0f;
    for (int s = 0; s < 3; s++)
    {
        float ua = 0.30f * (s == 0 ? m : (s == 1 ? rd : o)), ub = 0.30f * (s == 0 ? rd : (s == 1 ? o : y));
        float sp = MIXH[s == 0 ? 8 : s] - MIXH[s == 0 ? 7 : s - 1];
        float sg = s == 2 ? 1.0f : -1.0f;
        float pa = sg * ua, pb = sg * ub, cm = (pa < 0.0f && pb < 0.0f) ? _fmaxf(pa, pb) : 0.0f;
        float fall = _fminf((ub - ua) * 1.5707963f / sp, 0.0f);
        float lb = cm * HSK[4 * s + 1] + _fminf(pa - cm, 0.0f) * HSK[4 * s + 2] + _fminf(pb - cm, 0.0f) * HSK[4 * s + 3];
        float bt = lb - HSK[4 * s] * fall;
        if (bt < 0.0f) T = _fmaxf(T, -bt / (1.0f + fall));
    }
    if (p * T <= 1.0f) return T;
    float Tg = 0.0f;
    for (int s = 0; s < 3; s++)
    {
        float ua = 0.30f * (s == 0 ? m : (s == 1 ? rd : o)), ub = 0.30f * (s == 0 ? rd : (s == 1 ? o : y));
        float sp = MIXH[s == 0 ? 8 : s] - MIXH[s == 0 ? 7 : s - 1];
        float dA = s == 0 ? -82.0f : (s == 1 ? -21.0f : 0.0f), d0 = s == 0 ? -60.0f : dA;
        int n = s == 0 ? 40 : (s == 1 ? 22 : 61);
        float du = ub - ua, D1 = _fabs(du) * 1.5707963f / sp, D2 = D1 * 3.14159265f / sp, D3 = D2 * 3.14159265f / sp;
        float eA = 0.125f * D3;
        float eB = 0.125f * (2.367e-4f * _fmaxf(_fabs(ua), _fabs(ub)) + 3.0f * 0.0030865f * D1 + 3.0f * 0.0336965f * D2);
        for (int q = 0; q < n; q++)
        {
            float d = d0 + (float)(q), tq = (d - dA) / sp;
            float sl = du * 1.5707963f / sp * _sinf(3.14159265f * tq);
            float bt = _expf(-d * d / 648.0f) * (d / 324.0f * (ua + du * (0.5f - 0.5f * _cosf(3.14159265f * tq))) - sl);
            if (eB - bt > 0.0f) Tg = _fmaxf(Tg, (eB - bt) / (1.0f + sl - eA));
        }
    }
    return _fminf(T, Tg);
}

__DEVICE__ float3 toOklab(float r, float g, float b)
{
    float l = 0.4122214708f * r + 0.5363325363f * g + 0.0514459929f * b;
    float m = 0.2119034982f * r + 0.6806995451f * g + 0.1073969566f * b;
    float s = 0.0883024619f * r + 0.2817188376f * g + 0.6299787005f * b;
    l = spow(l, 1.0f / 3.0f); m = spow(m, 1.0f / 3.0f); s = spow(s, 1.0f / 3.0f);
    return make_float3(0.2104542553f * l + 0.7936177850f * m - 0.0040720468f * s,
                       1.9779984951f * l - 2.4285922050f * m + 0.4505937099f * s,
                       0.0259040371f * l + 0.7827717662f * m - 0.8086757660f * s);
}

__DEVICE__ float3 fromOklab(float L, float a, float b)
{
    float l = L + 0.3963377774f * a + 0.2158037573f * b;
    float m = L - 0.1055613458f * a - 0.0638541728f * b;
    float s = L - 0.0894841775f * a - 1.2914855480f * b;
    l = l * l * l; m = m * m * m; s = s * s * s;
    return make_float3( 4.0767416621f * l - 3.3077115913f * m + 0.2309699292f * s,
                       -1.2684380046f * l + 2.6097574011f * m - 0.3413193965f * s,
                       -0.0041960863f * l - 0.7034186147f * m + 1.7076147010f * s);
}

__DEVICE__ float2 abDir(float hDeg)
{
    float3 d = hueDir(hDeg);
    float3 c = toOklab(0.2f + 0.1f * d.x, 0.2f + 0.1f * d.y, 0.2f + 0.1f * d.z);
    float n = _sqrtf(c.y * c.y + c.z * c.z) + 1e-6f;
    return make_float2(c.y / n, c.z / n);
}

__DEVICE__ float rgc(float d, float thr, float lim)
{
    if (d < thr) return d;
    float p = 1.2f;
    float s = (lim - thr) / _powf(_powf((1.0f - thr) / (lim - thr), -p) - 1.0f, 1.0f / p);
    float nd = (d - thr) / s;
    return thr + s * nd / _powf(1.0f + _powf(nd, p), 1.0f / p);
}

__DEVICE__ float hash01(uint x, uint y, uint z)
{
    x = x * 1664525u + 1013904223u; y = y * 1664525u + 1013904223u; z = z * 1664525u + 1013904223u;
    x += y * z; y += z * x; z += x * y;
    x ^= x >> 16u; y ^= y >> 16u; z ^= z >> 16u;
    x += y * z; y += z * x; z += x * y;
    return (float)(x >> 8u) * (1.0f / 16777216.0f);
}

// ------------------------------------------------------------------ main

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    float R = _tex2D(p_TexR, p_X, p_Y), G = _tex2D(p_TexG, p_X, p_Y), B = _tex2D(p_TexB, p_X, p_Y);

    // every effect of this node at neutral: give back the input, clipped to 0 to 1. Develop.dctl clips its
    // output whenever any slider is moved, and this node cannot see Develop 1 Light's sliders, so it always
    // clips: a look made on Develop 1 Light alone then hands the next node what Develop.dctl would
    float active = _fabs(vibr) + _fabs(satur) + _fabs(density) + _fabs(rolloff) + _fabs(pathW) + _fabs(gamutC)
                 + _fabs(hRed) + _fabs(sRed) + _fabs(lRed) + _fabs(hOra) + _fabs(sOra) + _fabs(lOra) + _fabs(hYel)
                 + _fabs(sYel) + _fabs(lYel) + _fabs(hGre) + _fabs(sGre) + _fabs(lGre) + _fabs(hAqu) + _fabs(sAqu)
                 + _fabs(lAqu) + _fabs(hBlu) + _fabs(sBlu) + _fabs(lBlu) + _fabs(hPur) + _fabs(sPur) + _fabs(lPur)
                 + _fabs(hMag) + _fabs(sMag) + _fabs(lMag) + _fabs(shSat) + _fabs(miSat) + _fabs(hiSat)
                 + _fabs(cContr) + _fabs(blkFloor) + _fabs(deband) + _fabs(vigAmt) + _fabs(grainAmt) + _fabs(skinU)
                 + _fabs(hlEven);
    if (active == 0.0f) return make_float3(_saturatef(R), _saturatef(G), _saturatef(B));

    // the picture from Develop 1 Light: display values after the tone, unclipped
    float r = R, g = G, b = B;
    float aRoll = rolloff / 100.0f;
    float dbT   = 6.0f / 255.0f * deband / 100.0f;

    // ---- split toning and color contrast, in Oklab
    if (shSat > 0.0f || miSat > 0.0f || hiSat > 0.0f || cContr != 0.0f)
    {
        float3 c = toOklab(spow(r, 2.4f), spow(g, 2.4f), spow(b, 2.4f));
        float L = c.x, ca = c.y, cb = c.z, C = _sqrtf(ca * ca + cb * cb);
        if (shSat > 0.0f || miSat > 0.0f || hiSat > 0.0f)
        {
            float mid = 0.5f + 0.2f * gBal / 100.0f, wd = 0.1f + 0.3f * gBlend / 100.0f;
            float tt = sstep(mid - wd, mid + wd, L), ws = (1.0f - tt) * (1.0f - tt), wh = tt * tt, wm = 1.0f - ws - wh;
            float keep = (1.0f - sstep(0.0f, 0.12f, C)) * _fminf(1.0f, L / 0.25f);
            float2 dS = abDir(shHue), dM = abDir(miHue), dH = abDir(hiHue);
            float aS = 0.06f * shSat / 100.0f * ws * keep, aM = 0.06f * miSat / 100.0f * wm * keep, aH = 0.06f * hiSat / 100.0f * wh * keep;
            ca += aS * dS.x + aM * dM.x + aH * dH.x;
            cb += aS * dS.y + aM * dM.y + aH * dH.y;
        }
        if (cContr != 0.0f)
        {
            C = _sqrtf(ca * ca + cb * cb);
            float h = _atan2f(cb, ca);
            float dh = -cContr / 100.0f * 0.5f * _sinf(2.0f * (h - 1.0471976f)) * sstep(0.02f, 0.06f, C);
            float cs = _cosf(dh), sn = _sinf(dh);
            float na = ca * cs - cb * sn, nb = ca * sn + cb * cs;
            ca = na; cb = nb;
        }
        float3 o = fromOklab(L, ca, cb);
        r = spow(o.x, 1.0f / 2.4f); g = spow(o.y, 1.0f / 2.4f); b = spow(o.z, 1.0f / 2.4f);
    }

    // ---- color mixer: the hue engine, in Oklab lightness, chroma and hue. Each slider acts around its
    float mixAct = _fabs(hRed) + _fabs(sRed) + _fabs(lRed) + _fabs(hOra) + _fabs(sOra) + _fabs(lOra)
                 + _fabs(hYel) + _fabs(sYel) + _fabs(lYel) + _fabs(hGre) + _fabs(sGre) + _fabs(lGre)
                 + _fabs(hAqu) + _fabs(sAqu) + _fabs(lAqu) + _fabs(hBlu) + _fabs(sBlu) + _fabs(lBlu)
                 + _fabs(hPur) + _fabs(sPur) + _fabs(lPur) + _fabs(hMag) + _fabs(sMag) + _fabs(lMag)
                 + _fabs(skinU) + _fabs(hlEven);
    if (mixAct > 0.0f)
    {
        float3 c = toOklab(spow(r, 2.4f), spow(g, 2.4f), spow(b, 2.4f));
        float L = c.x, C = _sqrtf(c.y * c.y + c.z * c.z);
        float gN = sstep(0.01f, 0.05f, C);
        float h = _atan2f(c.z, c.y) * 57.2957795f;
        float hh = h < MIXH[0] ? h + 360.0f : h;
        int k = 0;
        for (int j = 1; j < 8; j++)
        {
            if (hh >= MIXH[j]) k = j;
        }
        int k1 = k == 7 ? 0 : k + 1;
        float t = (hh - MIXH[k]) / (MIXH[k + 1] - MIXH[k]);
        float w1 = 0.5f - 0.5f * _cosf(3.14159265f * t), w0 = 1.0f - w1;
        float r0 = hRed, r1 = hOra, r2 = hYel, r3 = hGre, r4 = hAqu, r5 = hBlu, r6 = hPur, r7 = hMag;
        {
            const float kr = 0.95f * 2.0f / 3.14159265f / 0.30f;
            float l0 = kr * (MIXH[1] - MIXH[0]), l1 = kr * (MIXH[2] - MIXH[1]), l2 = kr * (MIXH[3] - MIXH[2]), l3 = kr * (MIXH[4] - MIXH[3]);
            float l4 = kr * (MIXH[5] - MIXH[4]), l5 = kr * (MIXH[6] - MIXH[5]), l6 = kr * (MIXH[7] - MIXH[6]), l7 = kr * (MIXH[8] - MIXH[7]);
            for (int it = 0; it < 8; it++)
            {
                float mv;
                mv = 0.5f * _fmaxf(r0 - r1 - l0, 0.0f); r0 -= mv; r1 += mv;
                mv = 0.5f * _fmaxf(r1 - r2 - l1, 0.0f); r1 -= mv; r2 += mv;
                mv = 0.5f * _fmaxf(r2 - r3 - l2, 0.0f); r2 -= mv; r3 += mv;
                mv = 0.5f * _fmaxf(r3 - r4 - l3, 0.0f); r3 -= mv; r4 += mv;
                mv = 0.5f * _fmaxf(r4 - r5 - l4, 0.0f); r4 -= mv; r5 += mv;
                mv = 0.5f * _fmaxf(r5 - r6 - l5, 0.0f); r5 -= mv; r6 += mv;
                mv = 0.5f * _fmaxf(r6 - r7 - l6, 0.0f); r6 -= mv; r7 += mv;
                mv = 0.5f * _fmaxf(r7 - r0 - l7, 0.0f); r7 -= mv; r0 += mv;
            }
            for (int it = 0; it < 2; it++)
            {
                r1 = _fmaxf(r1, r0 - l0); r2 = _fmaxf(r2, r1 - l1); r3 = _fmaxf(r3, r2 - l2); r4 = _fmaxf(r4, r3 - l3);
                r5 = _fmaxf(r5, r4 - l4); r6 = _fmaxf(r6, r5 - l5); r7 = _fmaxf(r7, r6 - l6); r0 = _fmaxf(r0, r7 - l7);
            }
        }
        float dH = 0.30f * (w0 * sel8(k, r0, r1, r2, r3, r4, r5, r6, r7)
                          + w1 * sel8(k1, r0, r1, r2, r3, r4, r5, r6, r7));
        float dS = (w0 * sel8(k, sRed, sOra, sYel, sGre, sAqu, sBlu, sPur, sMag)
                  + w1 * sel8(k1, sRed, sOra, sYel, sGre, sAqu, sBlu, sPur, sMag)) / 100.0f;
        float dL = (w0 * sel8(k, lRed, lOra, lYel, lGre, lAqu, lBlu, lPur, lMag)
                  + w1 * sel8(k1, lRed, lOra, lYel, lGre, lAqu, lBlu, lPur, lMag)) / 100.0f;
        float dsk = _fmod(h - 50.0f + 540.0f, 360.0f) - 180.0f;
        float wsk = skinW(dsk, C, L);
        float prot = 1.0f - skinP / 100.0f * wsk;
        float pk = skinP / 100.0f;
        float aSk = sstep(0.02f, 0.04f, C) * (1.0f - sstep(0.14f, 0.18f, C)) * sstep(0.30f, 0.40f, L) * (1.0f - sstep(0.80f, 0.90f, L));
        float hT = hueProtT(r7, r0, r1, r2, pk * aSk);
        if (pk * aSk * hT > 1.0f) pk = 1.0f / (aSk * hT);
        dH *= 1.0f - pk * wsk; dS *= prot; dL *= prot;
        float cw = _fminf(C / 0.2f, 1.0f);
        float h2 = h + gN * dH;
        if (skinU > 0.0f)
        {
            float dsk2 = _fmod(h2 - 50.0f + 540.0f, 360.0f) - 180.0f;
            h2 -= skinU / 100.0f * skinW(dsk2, C, L) * dsk2;
        }
        float C2 = C * (1.0f + gN * dS);
        float L2 = L * (1.0f + gN * cw * 0.30f * dL);
        if (hlEven > 0.0f)
        {
            float Lh = w0 * MIXL[k] + w1 * MIXL[k1];
            L2 *= 1.0f - hlEven / 100.0f * 0.5f * (Lh - 0.722f) * cw * gN;
        }
        float hRad = h2 * 0.0174532925f;
        float3 o = fromOklab(L2, C2 * _cosf(hRad), C2 * _sinf(hRad));
        float yl = _fmaxf(luma(o.x, o.y, o.z), 0.0f), mn = min3(o.x, o.y, o.z);
        float kk = mn < 0.0f ? yl / (yl - mn + 1e-12f) : 1.0f;
        float ox = yl + (o.x - yl) * kk, oy = yl + (o.y - yl) * kk, oz = yl + (o.z - yl) * kk;
        r = spow(ox, 1.0f / 2.4f); g = spow(oy, 1.0f / 2.4f); b = spow(oz, 1.0f / 2.4f);
    }
    else
    {
        float hue = hueOf(r, g, b);
        float mx = max3(r, g, b), mn = min3(r, g, b);
        float chroma = _saturatef((mx - mn) / (mx + 1e-4f));
        float w0 = band(hue, 0.0f, 30.0f),   w1 = band(hue, 30.0f, 30.0f), w2 = band(hue, 60.0f, 35.0f),  w3 = band(hue, 120.0f, 55.0f);
        float w4 = band(hue, 180.0f, 45.0f), w5 = band(hue, 225.0f, 40.0f), w6 = band(hue, 270.0f, 40.0f), w7 = band(hue, 315.0f, 40.0f);
        float wsum = _fmaxf(1.0f, w0 + w1 + w2 + w3 + w4 + w5 + w6 + w7);
        float dh = (w0 * hRed + w1 * hOra + w2 * hYel + w3 * hGre + w4 * hAqu + w5 * hBlu + w6 * hPur + w7 * hMag) / wsum;
        float ds = (w0 * sRed + w1 * sOra + w2 * sYel + w3 * sGre + w4 * sAqu + w5 * sBlu + w6 * sPur + w7 * sMag) / wsum;
        float dl = (w0 * lRed + w1 * lOra + w2 * lYel + w3 * lGre + w4 * lAqu + w5 * lBlu + w6 * lPur + w7 * lMag) / wsum;
        if (dh != 0.0f)
        {
            float3 c = hueRotate(r, g, b, dh * 0.3f * chroma);
            r = c.x; g = c.y; b = c.z;
        }
        float yl = luma(r, g, b);
        float sf = 1.0f + ds / 100.0f * chroma;
        r = yl + (r - yl) * sf; g = yl + (g - yl) * sf; b = yl + (b - yl) * sf;
        float lf = 1.0f + 0.5f * dl / 100.0f * chroma;
        r *= lf; g *= lf; b *= lf;
    }

    // ---- density: saturation the way dyes make it (colors deepen, greys hold)
    if (density != 0.0f)
    {
        float lr = toLin(r), lg = toLin(g), lb = toLin(b), y0 = luma(lr, lg, lb);
        float Dr = -_log10f(_fmaxf(lr, 1e-4f)), Dg = -_log10f(_fmaxf(lg, 1e-4f)), Db = -_log10f(_fmaxf(lb, 1e-4f));
        float Da = min3(Dr, Dg, Db);
        float mx = max3(r, g, b), mn = min3(r, g, b), ch = _saturatef((mx - mn) / (mx + 1e-4f));
        float f = density / 100.0f * (0.6f + 0.4f * sstep(0.05f, 0.5f, ch));
        f *= 1.0f - sstep(0.75f, 1.0f, max3(lr, lg, lb));
        lr *= _exp10f(-f * (Dr - Da)); lg *= _exp10f(-f * (Dg - Da)); lb *= _exp10f(-f * (Db - Da));
        float y1 = luma(lr, lg, lb);
        if (y1 > 1e-6f)
        {
            float hold = _powf(y0 / y1, f < 0.0f ? 1.0f : 0.2f);
            lr *= hold; lg *= hold; lb *= hold;
        }
        r = toDisp(lr); g = toDisp(lg); b = toDisp(lb);
    }

    // ---- vibrance and saturation
    {
        float yl = luma(r, g, b);
        float mx = max3(r, g, b), mn = min3(r, g, b);
        float cs = _saturatef((mx - mn) / (mx + 1e-4f));
        float f = (1.0f + satur / 100.0f) * (1.0f + vibr / 100.0f * (1.0f - cs));
        r = yl + (r - yl) * f; g = yl + (g - yl) * f; b = yl + (b - yl) * f;
    }

    // ---- vignette
    if (vigAmt != 0.0f)
    {
        float dx = ((float)(p_X) - 0.5f * p_Width) / (0.5f * p_Width), dy = ((float)(p_Y) - 0.5f * p_Height) / (0.5f * p_Width);
        float d = _sqrtf(dx * dx + dy * dy) / 1.2f;
        float v = sstep(vigMid / 100.0f * 0.8f, 1.0f, d) * (vigAmt / 100.0f);
        float f = v < 0.0f ? 1.0f + v : 1.0f;
        r = r * f + (v > 0.0f ? v * (1.0f - r) * 0.5f : 0.0f);
        g = g * f + (v > 0.0f ? v * (1.0f - g) * 0.5f : 0.0f);
        b = b * f + (v > 0.0f ? v * (1.0f - b) * 0.5f : 0.0f);
    }

    // ---- highlight rolloff, path to white, gamut compression (linear)
    if (aRoll > 0.0f || pathW > 0.0f || gamutC > 0.0f)
    {
        float lr = spow(r, 2.4f), lg = spow(g, 2.4f), lb = spow(b, 2.4f);
        float K = 1.0f - 0.5f * aRoll, W = 1.0f - 0.015f * aRoll;
        float n = _fmaxf(max3(lr, lg, lb), 0.0f);
        float nn = n;
        if (aRoll > 0.0f && n > K)
        {
            nn = K + (n - K) / (1.0f + (n - K) / (W - K));
            float s = nn / n;
            lr *= s; lg *= s; lb *= s;
        }
        if (pathW > 0.0f)
        {
            float pn = n > 0.7f ? 0.7f + (n - 0.7f) / (1.0f + (n - 0.7f) / 0.285f) : n;
            float tt = sstep(0.7f, 0.985f, pn), k = pathW / 100.0f * tt * tt;
            lr += (nn - lr) * k; lg += (nn - lg) * k; lb += (nn - lb) * k;
        }
        if (gamutC > 0.0f)
        {
            float A = max3(lr, lg, lb);
            if (A > 0.0f)
            {
                float k = gamutC / 100.0f;
                float er = (A - lr) / A, eg = (A - lg) / A, eb = (A - lb) / A;
                er += (rgc(er, 0.815f, 1.147f) - er) * k;
                eg += (rgc(eg, 0.803f, 1.264f) - eg) * k;
                eb += (rgc(eb, 0.880f, 1.312f) - eb) * k;
                lr = A - er * A; lg = A - eg * A; lb = A - eb * A;
            }
        }
        r = spow(lr, 1.0f / 2.4f); g = spow(lg, 1.0f / 2.4f); b = spow(lb, 1.0f / 2.4f);
    }

    // ---- black floor: a firmer toe, quiet color in the blacks, then a floor tinted with the Shadows Hue
    if (blkFloor > 0.0f)
    {
        float fa = blkFloor / 100.0f;
        float yt = _saturatef(luma(r, g, b)), q = 1.0f - yt;
        float y1 = yt - 0.5f * fa * yt * q * q * q * q;
        float k = (y1 + 1e-5f) / (yt + 1e-5f);
        r *= k; g *= k; b *= k;
        float dc = 1.0f - 0.8f * fa * (1.0f - sstep(0.05f, 0.25f, y1));
        r = y1 + (r - y1) * dc; g = y1 + (g - y1) * dc; b = y1 + (b - y1) * dc;
        float3 dir = hueDir(shHue);
        float F = 0.07f * fa;
        float qr = 1.0f - _saturatef(r), qg = 1.0f - _saturatef(g), qb = 1.0f - _saturatef(b);
        qr = qr * qr * qr; qg = qg * qg * qg; qb = qb * qb * qb;
        r += F * (1.0f + 0.9f * dir.x) * qr * qr;
        g += F * (1.0f + 0.9f * dir.y) * qg * qg;
        b += F * (1.0f + 0.9f * dir.z) * qb * qb;
    }

    // ---- grain: luminance noise, strongest in the midtones, new every frame in the plugin
    if (grainAmt > 0.0f)
    {
        float n = (hash01((uint)(p_X), (uint)(p_Y), (uint)(TIMELINE_FRAME_INDEX) * 2u) - 0.5f) * (grainAmt / 100.0f) * 0.12f;
        float yl = luma(r, g, b), mw = 4.0f * yl * (1.0f - yl) + 0.15f;
        r += n * mw; g += n * mw; b += n * mw;
    }

    // ---- dither (with Deband): triangular noise of one 10-bit step, a little more in the shadows
    if (dbT > 0.0f)
    {
        uint fi = (uint)(TIMELINE_FRAME_INDEX) * 2u + 1u;
        float u = hash01((uint)(p_X), (uint)(p_Y), fi) + hash01((uint)(p_X) + 7919u, (uint)(p_Y), fi) - 1.0f;
        float n = u / 1023.0f * (1.5f - 0.5f * sstep(0.1f, 0.2f, luma(r, g, b)));
        r += n; g += n; b += n;
    }

    return make_float3(_saturatef(r), _saturatef(g), _saturatef(b));
}
